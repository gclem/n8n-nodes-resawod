"longitude\":-15.727433},\"contact_info\":{\"email\":\"info@crossfitoceanus.com\",\"phone\":\"628822006\"},\"social_media\":{\"instagram\":\"crossfitoceanus\",\"facebook\":\"@crossfitoceanus\"}},{\"id_application\":\"98048870\",\"id_lead\":null,\"name\":\"Human Blossom CrossFit Molsheim\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/98048870\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/98048870\\/featured_images\\/6675580d1a7b3.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/98048870\\/featured_images\\/66755814d2fb5.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/98048870\\/featured_images\\/66755815d0f82.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/98048870\\/featured_images\\/66755816addbd.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/98048870\\/featured_images\\/LOGO-20205.png\"],\"address\":{\"street\":\"17 Rue des Vergers\",\"town\":\"Molsheim\",\"postal_code\":\"67120\",\"country\":\"France\"},\"location\":{\"latitude\":48.5342275,\"longitude\":7.5023579},\"contact_info\":{\"email\":\"contact@humanblossomcrossfit.fr\",\"phone\":\"03 68 38 57 58\"},\"social_media\":{\"instagram\":\"hbcrossfitmolsheim\",\"facebook\":\"people\\/Human-Blossom-CrossFit-Molsheim\\/100063942523842\\/\"}},{\"id_application\":null,\"id_lead\":\"3216\",\"name\":\"Crossfit Wuppertal\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3216\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3216\\/featured_images\\/Bildschirmfoto%202019-07-12%20um%2012.12.54.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3216\\/featured_images\\/Bildschirmfoto%202019-07-12%20um%2012.13.01.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3216\\/featured_images\\/Bildschirmfoto%202019-07-12%20um%2012.13.09.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3216\\/featured_images\\/Bildschirmfoto%202019-07-12%20um%2012.13.17.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3216\\/featured_images\\/Bildschirmfoto%202019-07-12%20um%2012.13.26.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3216\\/featured_images\\/Wuppertal_Box-37.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3216\\/featured_images\\/Wuppertal_Box-40.jpg\"],\"address\":{\"street\":\"Kohlenstra\\u00dfe 51-55\",\"town\":\"Bochum\",\"postal_code\":\"44795\",\"country\":\"Germany\"},\"location\":{\"latitude\":51.4658133,\"longitude\":7.1939213},\"contact_info\":{\"email\":\"info@crossfitwuppertal.de\",\"phone\":\"+49 1734274705\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitwuppertal\\/\"}},{\"id_application\":\"65488891\",\"id_lead\":null,\"name\":\"Crossfit Myrmica\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/65488891\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"14 Rue L\\u00e9onard de Vinci\",\"town\":\"Le Plessis-P\\u00e2te\",\"postal_code\":\"91220\",\"country\":\"France\"},\"location\":{\"latitude\":48.6187427,\"longitude\":2.3304146},\"contact_info\":{\"email\":\"cf_myrmica@nubapp-clients.com\",\"phone\":\"0659081214\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":\"93516971\",\"id_lead\":null,\"name\":\"CrossFit Mougins\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/93516971\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Route de la Roquette, 561\",\"town\":\"Mougins\",\"postal_code\":\"06250\",\"country\":\"France\"},\"location\":{\"latitude\":43.6130419,\"longitude\":6.9712051},\"contact_info\":{\"email\":\"contact@crossfitmougins.com\",\"phone\":\"0777384217\"},\"social_media\":{\"instagram\":\"crossfitmougins\",\"facebook\":\"CrossFit Mougins\"}},{\"id_application\":null,\"id_lead\":\"2893\",\"name\":\"Iconic Crossfit 3 Viles\",\"description\":\"Iconic Crossfit 3 Viles es m\\u00e1s que un gimnasio, es un box afiliado a CrossFit inaugurado en 2017 que cuenta con un equipo profesional cuya pasi\\u00f3n es el deporte y en especial el CrossFit.\\n\\nEn nuestro centro de entrenamiento garantizamos una mejora de la calidad de vida a trav\\u00e9s del deporte. Ayudamos a nuestros socios a alcanzar sus objetivos, ya sean relacionados con la salud y\\/o con el rendimiento. La principal idea es que cada uno tenga la sensaci\\u00f3n de haber realizado un entrenamiento personalizado dentro de cada sesi\\u00f3n grupal y que no s\\u00f3lo obtenga beneficios a nivel de salud sino que aprenda el por qu\\u00e9 y para qu\\u00e9 realiza cada entrenamiento.\\n\\nNo queremos que vengas, hagas una clase y te vayas sin m\\u00e1s, queremos que evoluciones y que valores lo que haces porque del deporte es salud y la salud es vida, tu vida.\\n\\nNo encontrar\\u00e1s un sitio mejor para ponerte en forma de verdad, adem\\u00e1s de entrar en una comunidad donde todos nos conocemos y nos apoyamos. \\u00a1Te esperamos!\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2893\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2893\\/featured_images\\/Crossfit-1.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2893\\/featured_images\\/img-04-512x512.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2893\\/featured_images\\/img-05.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2893\\/featured_images\\/instalacions-04.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2893\\/featured_images\\/mural-graffiti-box-crossfit-iconic-3viles.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2893\\/featured_images\\/slider06.jpg\"],\"address\":{\"street\":\"Av. Montaltnou, 58, nau 2.1\",\"town\":\"San Vicente de Montalt\",\"postal_code\":\"08394\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.5788743,\"longitude\":2.5118236},\"contact_info\":{\"email\":\"info@iconic-santvicencdemontalt.com\",\"phone\":\"938537062\"},\"social_media\":{\"instagram\":\"iconicthaibox\",\"facebook\":\"@Iconic3Viles\"}},{\"id_application\":null,\"id_lead\":\"2722\",\"name\":\"Laguna Crossfit\",\"description\":\"Il primo e unico Box sul litorale veneto con vista sulla laguna, a 100 mt dalla spiaggia di Bibione e a pochi km da Lignano Sabbiadoro. Ti aspettiamo!\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2722\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2722\\/featured_images\\/13082627_786939654741056_3279683636467687954_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2722\\/featured_images\\/13626523_827321547369533_4633829286954994519_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2722\\/featured_images\\/18485462_1060403894061296_7436089416493983276_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2722\\/featured_images\\/20861808_1136200883148263_1430772238713830413_o.jpg\"],\"address\":{\"street\":\"Viale dei Ginepri 206\",\"town\":\"Venezia\",\"postal_code\":\"30028\",\"country\":\"Italy\"},\"location\":{\"latitude\":45.6325747,\"longitude\":12.99736},\"contact_info\":{\"email\":\"info@lagunacrossfit.it\",\"phone\":\"+39 348 592 7321\"},\"social_media\":{\"instagram\":\"laguna_crossfit\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitdiamantik\\/\"}},{\"id_application\":\"19211612\",\"id_lead\":null,\"name\":\"Amplem Fit\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/19211612\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"25 Rue Daniel Fargeot\",\"town\":\"Amplepuis\",\"postal_code\":\"69550\",\"country\":\"France\"},\"location\":{\"latitude\":45.981795,\"longitude\":4.332949},\"contact_info\":{\"email\":\"cmonsportbienetre@gmail.com\",\"phone\":\"0679252084\"},\"social_media\":{\"instagram\":\"amplemfit_coaching\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2823\",\"name\":\"Crossfit Salnes\",\"description\":\"QU\\u00c9 ES CROSSFIT\\nCrossFit se define como un sistema de entrenamiento de fuerza y acondicionamiento basado en ejercicios funcionales usando la transferencia de diversas disciplinas deportivas(Halterofilia, Atletismo, Ciclismo, Boxeo, StrongMan, Kettelbell, Gimnasia Deportiva, Escalada...), realizados a alta intensidad.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2823\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2823\\/featured_images\\/41396845_484875911980909_3944684749258740821_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2823\\/featured_images\\/descarga%20%282%29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2823\\/featured_images\\/hqdefault%20%281%29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2823\\/featured_images\\/hqdefault.jpg\"],\"address\":{\"street\":\"Carretera de Sanxenxo a Nantes, Km. 2\",\"town\":\"Sanxenxo\",\"postal_code\":\"36969\",\"country\":\"Pontevedra\"},\"location\":{\"latitude\":42.4206163,\"longitude\":-8.8072505},\"contact_info\":{\"email\":\"celtic-box@celtic-box.com\",\"phone\":\"986 720 513\"},\"social_media\":{\"instagram\":\"crossfit_salnes\",\"facebook\":\"@celticboxsanxenxo\"}},{\"id_application\":null,\"id_lead\":\"3032\",\"name\":\"Crossfit Regensburg\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3032\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3032\\/featured_images\\/Bildschirmfoto%202019-06-06%20um%2010.30.11.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3032\\/featured_images\\/Bildschirmfoto%202019-06-06%20um%2010.30.18.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3032\\/featured_images\\/Bildschirmfoto%202019-06-06%20um%2010.30.25.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3032\\/featured_images\\/Bildschirmfoto%202019-06-06%20um%2010.30.29.png\"],\"address\":{\"street\":\"Ditthornstra\\u00dfe 11\",\"town\":\"Regensburg\",\"postal_code\":\"93055\",\"country\":\"Germany\"},\"location\":{\"latitude\":49.0150204,\"longitude\":12.1363296},\"contact_info\":{\"email\":\"\",\"phone\":\"\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2836\",\"name\":\"Crossfit V8\",\"description\":\"CrossFit V8 es el lugar perfecto para la pr\\u00e1ctica del CrossFit en Madrid. Aprender\\u00e1s y sufrir\\u00e1s, \\u00a1pero tendr\\u00e1s tu recompensa!\\n\\n\\u00a1\\u00a1Ven a disfrutar del CrossFit con nosotros!!\\n\\nCrossFit V8 es un centro oficial afiliado a CrossFit Inc.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2836\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2836\\/featured_images\\/ejercicio-crossfit-balon-2.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2836\\/featured_images\\/maxresdefault%20%281%29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2836\\/featured_images\\/maxresdefault.jpg\"],\"address\":{\"street\":\"Calle Guindos, 3\",\"town\":\"Madrid\",\"postal_code\":\"28029\",\"country\":\"Spain\"},\"location\":{\"latitude\":40.4665835,\"longitude\":-3.7020988},\"contact_info\":{\"email\":\"wod@crossfitv8.com\",\"phone\":\"915048473\"},\"social_media\":{\"instagram\":\"crossfitv8\",\"facebook\":\"@crossfitv8\"}},{\"id_application\":null,\"id_lead\":\"3080\",\"name\":\"Segle XX Workout Club\",\"description\":\"Entrenar con nosotros significa no estar obligado a nada.\\n\\nEn SegleXX CrossFit puedes entrenar en grupo o por tu cuenta, pas\\u00e1rtelo bien, competir (\\u00a1o ambos!), conocer a gente o simplemente ir a la tuya. \\n\\nPuedes seguir nuestra planificaci\\u00f3n general o, si quieres apretarte mucho m\\u00e1s, nuestra planificaci\\u00f3n para competir.\\n\\nTambi\\u00e9n puedes montarte tu propio entreno y si necesitas ayuda para ello, estaremos aqu\\u00ed para aconsejarte.\\n\\nEntrenar con nosotros significa crecer como persona y atleta, para convertirte en algo con que quiz\\u00e1s so\\u00f1abas, o tal vez ni hab\\u00edas imaginado.\\n\\n\\u200b\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3080\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3080\\/featured_images\\/476172584_3733936496868342_346246677861139512_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3080\\/featured_images\\/476430460_3733200906941901_7138946526059488521_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3080\\/featured_images\\/480665530_3748033472125311_5972219714866811525_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3080\\/featured_images\\/685128c8731e9.jpg\"],\"address\":{\"street\":\"Carrer Galicia, 40\",\"town\":\"Terrassa\",\"postal_code\":\"08223\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.551531,\"longitude\":2.0128106},\"contact_info\":{\"email\":\"info@seglexxclub.com\",\"phone\":\"633088047\"},\"social_media\":{\"instagram\":\"seglexx_box\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2992\",\"name\":\"Crossfit La Nau\",\"description\":\"CrossFit La Nau Granollers es el mayor box oficial de CrossfFit  en Barcelona. 1430 m2 repartidos en 630m2 de box interior y 800m2 exterior para poder disfrutar plenamente de este deporte. Un box de 630 m2 di\\u00e1fanos dedicados exclusivamente a zona de entreno,  equipada con material de la mejor calidad para practicar CrossFit con total comodidad. Amplios vestuarios y zonas comunes para que te sientas como en casa. Todo un espacio pensado para entrenar, disfrutar y vivir CrossFit en Granollers!\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2992\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2992\\/featured_images\\/C3kOf7oWcAA8HJC.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2992\\/featured_images\\/IMG-20151031-WA0013-1.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2992\\/featured_images\\/crossfit-la-nau-granollers.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2992\\/featured_images\\/crossfit-la-nau.jpg\"],\"address\":{\"street\":\"Granollers\",\"town\":\"Les franqueses del Vall\\u00e9s\",\"postal_code\":\"08520\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.6114094,\"longitude\":2.2976018},\"contact_info\":{\"email\":\"info@crossfitlanau.com\",\"phone\":\"616 81 30 82\"},\"social_media\":{\"instagram\":\"crossfitlanau_granollers\",\"facebook\":\"@CrossFitLaNau\"}},{\"id_application\":null,\"id_lead\":\"2747\",\"name\":\"Crossfit Hangover\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2747\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2747\\/featured_images\\/Bildschirmfoto%202019-05-13%20um%2012.17.16.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2747\\/featured_images\\/Bildschirmfoto%202019-05-13%20um%2012.17.50.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2747\\/featured_images\\/ab583a61-12f8-45cc-a611-052ac60e89a4-0e49d7a3.jpg.png\"],\"address\":{\"street\":\"Jathostr. 11\",\"town\":\"Hannover\",\"postal_code\":\"30163\",\"country\":\"Germany\"},\"location\":{\"latitude\":52.4046513,\"longitude\":9.7360233},\"contact_info\":{\"email\":\"info@crossfithangover.de\",\"phone\":\"+49\\u00a0511 37 13 35\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":\"76804537\",\"id_lead\":null,\"name\":\"A.WAY Dijon\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/76804537\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/76804537\\/featured_images\\/Panorma%201%20%281%29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/76804537\\/featured_images\\/Panorma%204.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/76804537\\/featured_images\\/Photos%20Salle%20A-WAY%20020.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/76804537\\/featured_images\\/Photos%20Salle%20A-WAY%20047.jpg\"],\"address\":{\"street\":\"Rue de la Broche\",\"town\":\"Qu\\u00e9tigny\",\"postal_code\":\"21800\",\"country\":\"France\"},\"location\":{\"latitude\":47.3071395,\"longitude\":5.1042847},\"contact_info\":{\"email\":\"contact@a-way.fr\",\"phone\":\"983421147\"},\"social_media\":{\"instagram\":\"a.waydijon\",\"facebook\":\"https:\\/\\/www.facebook.com\\/a.waydijon?fref=ts\"}},{\"id_application\":null,\"id_lead\":\"2591\",\"name\":\"CrossFit Area51\",\"description\":\"CrossFit Rome - Crossfit Area 51 in Rome - box affiliated in rome. CrossFit is a core strength \\u0026 conditioning program that delivers a fitness that is by design, broad, general, and inclusive. Elements of track \\u0026 field, gymnastics, weightlifting, and strongman are combined in short intense daily workouts to maximize results for any individual. CrossFit teaches functional movement patterns, or, movements that you find in real life -pushing, pulling, squatting, jumping, throwing, carrying, and sprinting.\\n\\nWhat is CrossFit?\\nCrossFit is the principal strength and conditioning program for many police academies and tactical operations teams, military special operations units, champion martial artists, and hundreds of other elite and professional athletes worldwide.\\n\\nOur program delivers a fitness that is, by design, broad, general, and inclusive. Our specialty is not specializing. Combat, survival, many sports, and life reward this kind of fitness and, on average, punish the specialist.\\n\\nThe CrossFit program is designed for universal scalability making it the perfect application for any committed individual regardless of experience. We\\u2019ve used our same routines for elderly individuals with heart disease and cage fighters one month out from televised bouts. We scale load and intensity; we don\\u2019t change programs.\\n\\nThe needs of Olympic athletes and our grandparents differ by degree not kind. Our hunters, skiers, mountain bike riders and housewives have found their best fitness from the same regimen.\\n\\nContent Courtesy of CrossFit, Inc.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2591\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2591\\/featured_images\\/13412981_492207237651657_5118750320026732040_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2591\\/featured_images\\/19055922_658062151066164_5887578289075014845_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2591\\/featured_images\\/25591841_744710005734711_873762381945176109_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2591\\/featured_images\\/35486531_822776671261377_9144875187328516096_n.jpg\"],\"address\":{\"street\":\"Via Della Fonte Meravigliosa, 27\",\"town\":\"Roma\",\"postal_code\":\"00143\",\"country\":\"Italia\"},\"location\":{\"latitude\":41.8262885,\"longitude\":12.5059986},\"contact_info\":{\"email\":\"crossfitarea51@gmail.com\",\"phone\":\"+39 06 5153 1498\"},\"social_media\":{\"instagram\":\"crossfit_area51\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitarea51\\/\"}},{\"id_application\":null,\"id_lead\":\"3093\",\"name\":\"CrossFit Emotion\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3093\\/featured_images\\/16586887_1303195556426064_4816569943575495186_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3093\\/featured_images\\/16601732_1303197189759234_6557628073797003875_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3093\\/featured_images\\/16722715_1303196686425951_922517506931588599_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3093\\/featured_images\\/26805097_1632162590196024_476268978110206354_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3093\\/featured_images\\/52838506_2155263001219311_4107329456262086656_o.jpg\"],\"address\":{\"street\":\"24 Rue Lixenbuhl\",\"town\":\"Illkirch-Graffenstaden\",\"postal_code\":\"67400\",\"country\":\"France\"},\"location\":{\"latitude\":48.5300308,\"longitude\":7.7289087},\"contact_info\":{\"email\":\"contact@michelbodin.com\",\"phone\":\"+33 6 60 76 32 50\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitemotion\\/\"}},{\"id_application\":\"28512737\",\"id_lead\":null,\"name\":\"Versus Tegernsee - Performance Training\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/28512737\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Schwaighofstra\\u00dfe 79a\",\"town\":\"Tegernsee\",\"postal_code\":\"83684\",\"country\":\"Germany\"},\"location\":{\"latitude\":47.695937,\"longitude\":11.7747289},\"contact_info\":{\"email\":\"versuscrossfittegernsee@nubapp-clients.com\",\"phone\":\"08022-9809301\\t\"},\"social_media\":{\"instagram\":\"versustegernsee\",\"facebook\":\"Versus Tegernsee CrossFit \\u0026 Martial Arts\"}},{\"id_application\":null,\"id_lead\":\"3009\",\"name\":\"Crossfit Garrotxa\",\"description\":\"CrossFit Garrotxa som el primer centre oficial de CrossFit a la Garrotxa, amb coaches titulats i certificats per CrossFit Inc.\\n\\nSom una comunitat d\\u0027atletes i el nostre objectiu \\u00e9s promoure la salut i el benestar mitjan\\u00e7ant la millora del nostre condicionament f\\u00edsic.\\nNo esperis trobar ni miralls ni m\\u00e0quines. En canvi, s\\u00ed que trobar\\u00e0s coses com kettlebells, pilotes medicinals, barres i discos ol\\u00edmpics o anelles.\\nEls entrenaments (o workouts) es basen en moviments funcionals d\\u0027alta intensitat, per\\u00f2 a l\\u0027abast de tothom sense importar quin sigui el teu nivell f\\u00edsic inicial. Valorem i respectem molt l\\u0027esfor\\u00e7 de cada persona.\\n\\nPer aix\\u00f2, trobar\\u00e0s un ambient inclusiu, on ning\\u00fa es deixat enrere i on cada membre del grup coneix el nom dels altres membres del grup. Un lloc on no nom\\u00e9s puguis venir a entrenar sin\\u00f3 tamb\\u00e9 un lloc on puguis fer amics i con\\u00e8ixer gent.\\nTamb\\u00e9 creiem que aix\\u00ed \\u00e9s com el treball s\\u0027acaba fent cada dia, que aix\\u00ed \\u00e9s com els resultats s\\u00f3n aconseguits i els reptes s\\u00f3n superats amb l\\u0027ajuda de la resta del grup.\\n\\nA CrossFit Garrotxa som una comunitat per damunt de qualsevol altra cosa.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3009\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3009\\/featured_images\\/15194578_224022448027077_5125019511662143467_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3009\\/featured_images\\/15235415_226448204451168_7790768953197968000_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3009\\/featured_images\\/21551707_355467718215882_8574769359066204142_o.jpg\"],\"address\":{\"street\":\"C\\/ De La T\\u00e8cnica 11\",\"town\":\"Las Presas\",\"postal_code\":\"17178\",\"country\":\"Spain\"},\"location\":{\"latitude\":42.14993,\"longitude\":2.4641813},\"contact_info\":{\"email\":\"crossfitgarrotxa@gmail.com\",\"phone\":\"640284540\"},\"social_media\":{\"instagram\":\"crossfitgarrotxa\",\"facebook\":\"@CrossfitGarrotxa\"}},{\"id_application\":null,\"id_lead\":\"3140\",\"name\":\"Crossfit Reden\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3140\\/logo\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Alexander-von-Humboldt-Stra\\u00dfe 3\",\"town\":\"Schiffweiler\",\"postal_code\":\"66578\",\"country\":\"Germany\"},\"location\":{\"latitude\":49.3507765,\"longitude\":7.1139281},\"contact_info\":{\"email\":\"info@crossfit-reden.de\",\"phone\":\"+49 15750149411\"},\"social_media\":{\"instagram\":\"crossfit_reden\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFit-Reden-776529162735825\\/\"}},{\"id_application\":null,\"id_lead\":\"3004\",\"name\":\"Crossfit Pracan\",\"description\":\"Te ofrecemos 400m2 de instalaciones, con diferentes espacios de entrenamiento totalmente equipados con jaulas y racks individules, material de entrenamiento de la mejor calidad, suministrados por AFW Y Reebok. para que desarrolles al m\\u00e1ximo tus capacidades en un ambiente de esfuerzo, respeto y compa\\u00f1erismo.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3004\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3004\\/featured_images\\/57384310_1031708933690765_229541271549509632_n.jpg\"],\"address\":{\"street\":\"Jos\\u00e9 Antonio, n15\",\"town\":\"San Cristobal de La Laguna\",\"postal_code\":\"38320\",\"country\":\"Spain\"},\"location\":{\"latitude\":28.467157,\"longitude\":-16.292768},\"contact_info\":{\"email\":\"crossfitpracan@gmail.com\",\"phone\":\"922 468 031\"},\"social_media\":{\"instagram\":\"crossfitpracan\",\"facebook\":\"@crossfitpracan\"}},{\"id_application\":null,\"id_lead\":\"2936\",\"name\":\"Heim Crossfit Pinto\",\"description\":\"Gimnasio de CrossFit en Pinto. Nuestro objetivo es mejorar tu fitness y tu salud. Queremos ayudarte a mejorar tu calidad de vida y orientarte para mejorar tus habilidades: coordinaci\\u00f3n, resistencia cardiovascular, resistencia muscular, fuerza y flexibilidad, tambi\\u00e9n la agilidad, precisi\\u00f3n, equilibrio, potencia y velocidad. \\nRealizamos todos los entrenamientos en equipo, trabajando la empat\\u00eda y la complicidad. \\nNuestras clases se imparten a un m\\u00e1ximo de 12 personas por clase. Esto nos permite atender a cada persona seg\\u00fan sus necesidades. Todos tenemos miedos, nos cuesta un ejercicio o tenemos X limitaciones. No importa. Estamos aqu\\u00ed para disfrutar con lo que hacemos.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2936\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2936\\/featured_images\\/crossfit_pinto_madrid%20%281%29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2936\\/featured_images\\/crossfit_pinto_madrid.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2936\\/featured_images\\/entrenamiento_accesorio_crossfit_pinto.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2936\\/featured_images\\/no_adelgazo_crossfit.jpg\"],\"address\":{\"street\":\"Calle Orop\\u00e9ndolas 4 (Pol. Ind. El Cascajal)\",\"town\":\"Pinto\",\"postal_code\":\"28320\",\"country\":\"Spain\"},\"location\":{\"latitude\":40.2461956,\"longitude\":-3.7147267},\"contact_info\":{\"email\":\"hola@heimcrossfit.com\",\"phone\":\"\"},\"social_media\":{\"instagram\":\"heimcrossfit\",\"facebook\":\"@heimcrossfit\"}},{\"id_application\":null,\"id_lead\":\"2695\",\"name\":\"Crossfit K\\u00f6rperschmiede\",\"description\":\"\",\"logo\":null,\"images\":