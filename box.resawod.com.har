aws.com\\/sport\\/applications\\/59166951\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Avenue des P\\u00e2querettes 55\",\"town\":\"Waterloo\",\"postal_code\":\"1410\",\"country\":\"Belgium\"},\"location\":{\"latitude\":50.7184132,\"longitude\":4.3857917},\"contact_info\":{\"email\":\"info@crossfit1815.com\",\"phone\":\"02 351 81 11\"},\"social_media\":{\"instagram\":\"crossfit815\",\"facebook\":\"\"}},{\"id_application\":\"92374981\",\"id_lead\":null,\"name\":\"Fitness Box Estella\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/92374981\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Calle Merkatondoa, 16p\",\"town\":\"Estella\",\"postal_code\":\"31200\",\"country\":\"Espa\\u00f1a\"},\"location\":{\"latitude\":42.6720856,\"longitude\":-2.0324524},\"contact_info\":{\"email\":\"info@fitnessboxestella.com\",\"phone\":\"692285574\"},\"social_media\":{\"instagram\":\"fitnessbox_estella\",\"facebook\":\"Fitness Box Estella\"}},{\"id_application\":null,\"id_lead\":\"2926\",\"name\":\"CrossFit Bailleul\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2926\\/featured_images\\/22046923_1923964301154152_2570844936999705846_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2926\\/featured_images\\/22049796_1923964327820816_7592009509892076038_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2926\\/featured_images\\/22050269_1923964277820821_4720879887966085172_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2926\\/featured_images\\/22089010_1923964287820820_6490551191608433968_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2926\\/featured_images\\/22195597_1923964291154153_2094175290896029053_n.jpg\"],\"address\":{\"street\":\"575 av de l\\u0027Europe\",\"town\":\"Bailleul\",\"postal_code\":\"59270\",\"country\":\"France\"},\"location\":{\"latitude\":50.7271114,\"longitude\":2.7343314},\"contact_info\":{\"email\":\"contact@onetcrossfitbailleul.com\",\"phone\":\"06 50 34 43 30\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/onetcrossfitbailleul\\/\"}},{\"id_application\":\"12771477\",\"id_lead\":null,\"name\":\"CrossFit Andarta\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/12771477\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"3 Rue du Portugal\",\"town\":\"Auray\",\"postal_code\":\"56400\",\"country\":\"France\"},\"location\":{\"latitude\":47.6674113,\"longitude\":-3.0091545},\"contact_info\":{\"email\":\"contact@crossfit-andarta.bzh\",\"phone\":\"0670836282\"},\"social_media\":{\"instagram\":\"crossfitandarta\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFit-Andarta-Auray-110731957401964\"}},{\"id_application\":null,\"id_lead\":\"2601\",\"name\":\"Crossfit Mediolanvm\",\"description\":\"CROSSFIT MEDIOLANVM\\nNON LA SOLITA PALESTRA, UN VERO BOX CROSSFIT A MILANO, CON I COMFORT DI UNA CLUB-HOUSE E LA PREPARAZIONE TECNICA DEI MIGLIORI TRAINER ITALIANI E NON.\\n\\nNOI DI CROSSFIT MEDIOLANVM SFATIAMO IL FALSO MITO DEI SUPER UOMINI: FACCIAMO DEL FITNESS LA RICERCA DEL BENESSERE PSICO-FISICO E NE APRIAMO LE PORTE A TUTTI: AGONISTI, AMATORI E CHIUNQUE ABBIA IL DESIDERIO DI SENTIRSI \\u2018FIT\\u2019.\\n\\nLe sue origini risalgono agli anni settanta, sebbene abbia iniziato a richiamare l\\u2019attenzione del pubblico soltanto verso la seconda met\\u00e0 degli anni novanta, quando Glassman fond\\u00f2 la propria palestra a Santa Cruz (California), nel 1995.\\n\\nLa societ\\u00e0 CrossFit Inc. fu inizialmente fondata in California, nel 2004. Il marchio \\u201cCrossFit\\u201d viene usato negli Stati Uniti per contraddistinguere servizi di personal fitness almeno a partire dal 1985. Le attivit\\u00e0 primarie della societ\\u00e0 consistono nel formare\\/accreditare dei personal trainer attraverso corsi, nel concedere in licenza a palestre affiliate il marchio CrossFit.\\n\\nNell\\u2019organizzare una competizione mondiale di fitness nota come CrossFit Games, oltre a diffondere informazioni nutrizionali e di fitness attraverso il CrossFit Journal ed il sito web.\\n\\nNel 2012 in tutto il mondo sono circa 4.000 le palestre o \\u2018punti\\u2019 affiliati CrossFit, in oltre 71 Paesi. Alcuni dei seguaci praticano il programma di esercizi CrossFit per proprio conto o presso una palestra affiliata, seguendo l\\u2019\\u201dAllenamento del Giorno\\u201d o il \\u201cWOD\\u201d, che viene pubblicato quotidianamente sul sito web della societ\\u00e0.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2601\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2601\\/featured_images\\/15972548_328803580846385_2300090970695027501_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2601\\/featured_images\\/16903500_355857628140980_5618849169503138760_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2601\\/featured_images\\/23915616_483331922060216_1473548184724209212_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2601\\/featured_images\\/45082932_689684794758260_6861113610005905408_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2601\\/featured_images\\/52417125_754549361605136_4808531078341984256_o.jpg\"],\"address\":{\"street\":\"Via Antonio Mambretti, 9\",\"town\":\"Milano\",\"postal_code\":\"20157\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.5081654,\"longitude\":9.1321148},\"contact_info\":{\"email\":\"info@crossfitmediolanvm.com\",\"phone\":\"+39 339 30 23 287\"},\"social_media\":{\"instagram\":\"crossfitmediolanvm\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitmediolanvm\\/\"}},{\"id_application\":\"43278294\",\"id_lead\":null,\"name\":\"North Athletics\",\"descri