essage\":\"Commencez ici ! Envoyez votre premier message\",\"no_messages_yet\":\"Aucun message pour le moment !\",\"cannot_send_messages\":\"Vous ne pouvez pas envoyer de messages\",\"cannot_send_messages_tip\":\"Si vous souhaitez \\u00e9crire des messages, vous devez modifier vos param\\u00e8tres de confidentialit\\u00e9.\",\"new_chat\":\"Nouveau chat\",\"open_chat\":\"Ouvrir chat\",\"write_message\":\"\\u00c9crire un message...\",\"sms\":\"SMS\",\"in_app\":\"In-app\",\"in_app_chat\":\"Chat\",\"hour\":\"Heure\",\"hours\":\"Heures\",\"minutes\":\"Minutes\",\"day\":\"Jour\",\"days\":[\"Jour\",\"Jours\"],\"week\":\"Semaine\",\"weeks\":[\"Semaine\",\"Semaines\"],\"month\":\"Mois\",\"months\":[\"Mois\",\"Mois\"],\"year\":\"Ann\\u00e9e\",\"years\":[\"Ann\\u00e9e\",\"Ann\\u00e9es\"],\"atimes\":{\"D\":\"Jours\",\"W\":\"Semaines\",\"M\":\"Mois\",\"Y\":\"Ann\\u00e9es\"},\"tournament_enrolment\":\"Inscription au tournoi\",\"format_tournament\":{\"1\":\"Ligue\",\"2\":\"Elimination seule\",\"3\":\"Elimination double\"},\"type_tournament\":{\"1\":\"Joueurs\",\"2\":\"\\u00c9quipes\"},\"teams\":\"\\u00c9quipes\",\"score\":\"Score\",\"ranking\":\"Classement\",\"team1\":\"Equipe 1\",\"team2\":\"Equipe 2\",\"players_no_team\":\"Pas de joueurs dans l\\u0027\\u00e9quipe\",\"error_adding_user_to_team\":\"L\\u0027utilisateur est d\\u00e9j\\u00e0 inscrit dans cette \\u00e9quipe.\",\"email_subject\":\"Confirmation de l\\u0027enregistrement\",\"email_content\":\"Voici vos informations pour ouvrir votre session et acc\\u00e9der \\u00e0 votre compte\",\"email_click_here_to_login\":\"Vous pouvez cliquer ici pour vous connecter\",\"email_hello\":\"Bonjour\",\"good_bye\":\"Au revoir\",\"missing\":\"Disparu\",\"new_email\":\"Nouvel email\",\"send_email\":\"Envoyer email\",\"subject\":\"Sujet\",\"destinataries\":\"Destinataires\",\"header_footer\":\"Inclure les haut et pied de page par d\\u00e9faut\",\"error_no_subject\":\"Erreur : Il n\\u0027y a pas de sujet\",\"error_no_message\":\"Erreur : Le message est vide\",\"error_no_destinataries\":\"Erreur : Vous devez s\\u00e9lectionner au moins un destinataire\",\"booking_block_booking_email_confirmed\":\"Vos r\\u00e9servations ont \\u00e9t\\u00e9 confirm\\u00e9es. Vous trouverez ici un r\\u00e9sum\\u00e9 :\",\"cancel_block_booking_email_confirmed\":\"Vos r\\u00e9servations ont \\u00e9t\\u00e9 annul\\u00e9es. Vous trouverez ici un r\\u00e9sum\\u00e9 :\",\"cancel_activity_session_email\":\"Nous sommes d\\u00e9sol\\u00e9s mais l\\u0027activit\\u00e9 %application% \\u00e0 laquelle vous \\u00e9tiez inscrit a \\u00e9t\\u00e9 annul\\u00e9e par un administrateur. Cette r\\u00e9servation sera ignor\\u00e9e pour vos limites de r\\u00e9servation.\",\"cancel_activity_session_email_admin\":\"Cette session d\\u0027activit\\u00e9 a \\u00e9t\\u00e9 annul\\u00e9e. Cette r\\u00e9servation sera ignor\\u00e9e pour les limites de r\\u00e9servation.\",\"activity_cancelled\":\"Activit\\u00e9 annul\\u00e9e\",\"has_been_cancelled\":\"a \\u00e9t\\u00e9 annul\\u00e9\",\"confirm_activity_session_email\":\"L\\u0027activit\\u00e9 a atteint le nombre minimum d\\u0027utilisateurs inscrits et a \\u00e9t\\u00e9 confirm\\u00e9e. A bient\\u00f4t !\",\"user_added_to_booking_subject\":\"Vous avez \\u00e9t\\u00e9 ajout\\u00e9 \\u00e0 une r\\u00e9servation\",\"user_added_to_booking_body\":\"%user%  vous a ajout\\u00e9 \\u00e0 la r\\u00e9servation suivante.\",\"booking_payment_pending_reminder_subject\":\"Rappel de paiement en attente\",\"booking_payment_pending_reminder_body\":\"Vous avez une r\\u00e9servation de paiement en attente. Vous devez payer votre r\\u00e9servation dans les 24 heures ou elle sera annul\\u00e9e.\",\"booking_payment_pending_hours_reminder_body\":\"Vous avez une r\\u00e9servation en attente de paiement. Vous devez payer votre r\\u00e9servation dans les prochaines  %hours_before_cancel%  heures ou elle sera annul\\u00e9e.\",\"booking_payment_request_subject\":\"%sportclub% paiement requis\",\"payment_request_body\":\"%sportclub% a demand\\u00e9 le paiement des articles suivants.\",\"booking_payment_request_body\":\"%sportclub% a demand\\u00e9 le paiement de la r\\u00e9servation suivante.\",\"booking_payment_request_body_dead_timestamp\":\"Vous devez payer votre r\\u00e9servation avant le %dead_timestamp% ou elle sera annul\\u00e9e.\",\"request_payment_to_user\":\"Demande de paiement \\u00e0 l\\u0027utilisateur\",\"user_not_have_email\":\"L\\u0027utilisateur ne dispose pas d\\u0027une adresse mail valide pour recevoir la demande de paiement\",\"request_payment_to_user_confirm\":\"Voulez-vous envoyer un email \\u00e0 l\\u0027utilisateur pour lui demander de payer cette r\\u00e9servation ?\",\"request_payment_to_user_general\":\"Voulez-vous envoyer un email \\u00e0 l\\u0027utilisateur lui demandant ce paiement ?\",\"request_payment_to_user_confirm_membership\":\"Souhaitez-vous envoyer un mail \\u00e0 l\\u0027adh\\u00e9rent r\\u00e9clamant le paiement de cette cotisation ?\",\"request_payment_to_user_confirm_payment\":\"Souhaitez-vous envoyer un mail \\u00e0 l\\u0027adh\\u00e9rent r\\u00e9clamant le paiement?\",\"request_payment_to_user_remember\":\"Rappelez-vous que vous pouvez demander manuellement le paiement de cette r\\u00e9servation \\u00e0 chaque utilisateur.\",\"draw_result_subject_user_in\":\"F\\u00e9licitations ! Vous avez une place sur %course_name%.\",\"draw_result_subject_user_out\":\"Le tirage au sort de %course_name% a \\u00e9t\\u00e9 effectu\\u00e9.\",\"draw_result_body_user_in\":\"Le tirage au sort pour %course_name% a \\u00e9t\\u00e9 effectu\\u00e9 et vous \\u00eates inscrit.\",\"draw_result_dead_timestamp_user_in\":\"Veuillez noter que vous avez jusqu\\u0027\\u00e0 %dead_timestamp% pour confirmer votre r\\u00e9servation, sinon elle sera automatiquement supprim\\u00e9e.\",\"draw_result_body_user_out\":\"Le tirage au sort du cours %course_name% a \\u00e9t\\u00e9 effectu\\u00e9. Malheureusement, vous n\\u0027avez pas eu la chance d\\u0027avoir une place.\",\"confirmation_of_attendance\":\"Confirmation de pr\\u00e9sence\",\"draw_result_attendance_confirmed\":\"F\\u00e9licitations! Pr\\u00e9sence confirm\\u00e9e au cours %course_name%\",\"position_in_waiting_list\":\"Vous \\u00eates maintenant en position #%position% sur la liste d\\u0027attente.\",\"check_current_position\":\"Vous recevrez un email  si une place se lib\\u00e8re. Vous pouvez \\u00e9galement v\\u00e9rifier votre position actuelle sur la liste d\\u0027attente \\u00e0 partir de votre profil utilisateur.\",\"go_to_profile\":\"Aller sur le profil\",\"confirm_booking\":\"Cliquez ici pour confirmer votre r\\u00e9servation\",\"see_upcoming_bookings\":\"Vous pouvez voir et annuler vos prochaines r\\u00e9servations en cliquant sur le bouton suivant.\",\"at\":\"\\u00e0 partir de\",\"on\":\"Le\",\"smtp_error\":\"Les param\\u00e8tres SMTP n\\u0027appartiennent pas \\u00e0 l\\u0027adresse mail\",\"email_user\":\"Utilisateurs\",\"facial_recognition_subject\":\"Document des termes et conditions pour la reconnaissance faciale\",\"email_sent_for_facial_recognition_notice\":\"Un e-mail a \\u00e9t\\u00e9 envoy\\u00e9 \\u00e0 l\\u0027utilisateur pour qu\\u0027il accepte les termes et conditions de la reconnaissance faciale.\",\"photo_updated_but_terms_not_accepted\":\"La photo a \\u00e9t\\u00e9 mise \\u00e0 jour avec succ\\u00e8s. Cependant, l\\u0027utilisateur n\\u0027a pas accept\\u00e9 le document relatif \\u00e0 l\\u0027utilisation de la reconnaissance faciale.\",\"take_picture\":\"Prendre une photo\",\"user_without_facial_recognition_accepted\":\"L\\u0027utilisateur n\\u0027a pas accept\\u00e9 le document relatif \\u00e0 l\\u0027utilisation de la reconnaissance faciale.\",\"picture_updated\":\"L\\u0027image a \\u00e9t\\u00e9 mise \\u00e0 jour avec succ\\u00e8s.\",\"minor_facial_recognition_advice\":\"Cependant, les utilisateurs de moins de 14 ans ne peuvent pas accepter les conditions eux-m\\u00eames. Une fois les conditions accept\\u00e9es, la photo sera t\\u00e9l\\u00e9charg\\u00e9e dans le syst\\u00e8me de reconnaissance faciale.\",\"upload_another_picture\":\"Voulez-vous t\\u00e9l\\u00e9charger une autre image ?\",\"yes_upload_picture\":\"Oui, t\\u00e9l\\u00e9chargez une autre photo\",\"email_not_sent_for_facial_recognition_notice\":\"Les utilisateurs \\u00e2g\\u00e9s de moins de 14 ans ne peuvent pas accepter eux-m\\u00eames les conditions, qui doivent donc \\u00eatre g\\u00e9r\\u00e9es \\u00e0 partir du panneau d\\u0027administration. dans la section \\u0027Documents\\u0027 du profil de l\\u0027utilisateur. Une fois les conditions accept\\u00e9es, la photo sera t\\u00e9l\\u00e9charg\\u00e9e dans le syst\\u00e8me de reconnaissance faciale.\",\"email_not_sent_application_is_not_client\":\"Les mails ne sont envoy\\u00e9s que depuis des plateformes enti\\u00e8rement configur\\u00e9es et marqu\\u00e9es comme livr\\u00e9es.\",\"facial_terms_and_conditions_document_name\":\"Termes et conditions de la reconnaissance faciale\",\"facial_terms_and_conditions_under_age_warning\":\"Les utilisateurs de moins de 14 ans ne sont pas autoris\\u00e9s \\u00e0 signer des documents par reconnaissance faciale.\",\"email_content_facial_terms_and_conditions\":\"Cher membre,\\u003Cbr\\u003E\\u003Cbr\\u003ENous vous informons que l\\u0027acc\\u00e8s \\u00e0 %application_name% se fera par le tourniquet install\\u00e9 \\u00e0 l\\u0027entr\\u00e9e des installations, en utilisant une reconnaissance faciale comme identifiant d\\u0027acc\\u00e8s qui sera effectu\\u00e9 par des lecteurs biom\\u00e9triques fabriqu\\u00e9s et avec une technologie fabriqu\\u00e9e en Navarre et avec un sceau de l\\u0027UE.\\u003Cbr\\u003E\\u003Cbr\\u003EAvec cela, nous avons l\\u0027intention de fournir aux membres un acc\\u00e8s confortable dans lequel \\\\\\u0027n\\u0027apportez rien pour entrer\\\\\\u0027 pr\\u00e9vaut et que la personne qui acc\\u00e8de aux installations est enregistr\\u00e9e dans notre syst\\u00e8me informatique.\\u003Cbr\\u003E\\u003Cbr\\u003EAfin de d\\u00e9marrer le syst\\u00e8me, nous vous demandons la permission d\\u0027utiliser vos donn\\u00e9es biom\\u00e9triques afin de g\\u00e9n\\u00e9rer les informations d\\u0027identification d\\u0027acc\\u00e8s. Si vous \\u00eates int\\u00e9ress\\u00e9 par un acc\\u00e8s facile et confortable avec cette reconnaissance faciale, vous pouvez acc\\u00e9der au lien ci-joint pour accepter le transfert de donn\\u00e9es (num\\u00e9ro de membre, photo et vecteur d\\u0027identification) \\u00e0 Nubapp Applications S.L. (en tant que d\\u00e9veloppeurs de %profile_name%, le logiciel de gestion du club) et Das-Gate (en tant que fabricants de lecteurs biom\\u00e9triques).\\u003Cbr\\u003E\\u003Cbr\\u003ESi vous souhaitez des \\u00e9claircissements suppl\\u00e9mentaires, vous pouvez consulter cette page Web (https:\\/\\/das-gate.com\\/) dans laquelle le fabricant Das-Gate explique en d\\u00e9tail en quoi consiste la technologie que nous allons mettre en \\u0153uvre ou \\u00e9crire au e-mail du club %application_email%.\",\"document_not_found\":\"Document non trouv\\u00e9\",\"document_saved\":\"Erreur, l\\u0027image n\\u0027a pas \\u00e9t\\u00e9 t\\u00e9l\\u00e9charg\\u00e9e\",\"document_not_saved\":\"Erreur\",\"photo_not_accepted\":\"Votre photo n\\u0027a pas \\u00e9t\\u00e9 accept\\u00e9e\",\"photo_uploaded\":\"Votre photo a \\u00e9t\\u00e9 correctement t\\u00e9l\\u00e9charg\\u00e9e\",\"photo_recommendations\":\"Recommandations pour que la photo soit correcte\",\"make_photo_correct\":\"Comment rendre votre photo correcte\",\"email_subject_user_bank_account_added\":\"Votre compte bancaire a \\u00e9t\\u00e9 li\\u00e9 \\u00e0 %linked_user_full_name%\",\"email_content_user_bank_account_added\":\"Bonjour %full_name%, Votre compte bancaire se terminant par %four_last_numbers% a \\u00e9t\\u00e9 li\\u00e9 \\u00e0 %linked_user_full_name%. Si vous pensez qu\\u0027il s\\u0027agit d\\u0027une erreur, veuillez nous contacter d\\u00e8s que possible. Cordialement, %application_name%.\",\"delete_membership_by_unpaid_subject\":\"Votre abonnement a \\u00e9t\\u00e9 annul\\u00e9\",\"delete_membership_by_unpaid_content\":\"Oups, malheureusement l\\u0027abonnement a \\u00e9t\\u00e9 annul\\u00e9 parce que le processus de paiement n\\u0027a pas \\u00e9t\\u00e9 finalis\\u00e9 \\u00e0 temps.\",\"receive_emails_tip\":\"Vous ne recevrez pas d\\u0027emails de r\\u00e9servation d\\u0027activit\\u00e9s, de rappels, ni aucune communication de la part du centre sportif.\",\"news_and_updates_tip\":\"Vous ne recevrez pas d\\u0027e-mails contenant des actualit\\u00e9s et des mises \\u00e0 jour du centre sportif.\",\"marketing_and_promotions_tip\":\"Vous ne recevrez pas d\\u0027e-mails concernant des promotions, des r\\u00e9ductions et des ventes de produits et de services.\",\"receive_email_events_tip\":\"Vous ne recevrez pas d\\u0027emails concernant les \\u00e9v\\u00e9nements organis\\u00e9s dans votre centre sportif.\",\"receive_email_conversations_tip\":\"Vous ne recevrez pas de courrier \\u00e9lectronique lorsqu\\u0027un autre utilisateur ou des administrateurs vous \\u00e9crivent dans une conversation.\",\"show_pending_payment_bookings\":\"Afficher les r\\u00e9servations de paiement en attente.\",\"show_all_bookings\":\"Afficher toutes vos r\\u00e9servations.\",\"processing_payment\":\"Traitement du paiement\",\"new_card\":\"Nouvelle carte\",\"processed\":\"Proc\\u00e9d\\u00e9\",\"its_being_processed\":\"En cours de traitement\",\"available_in_a_few_minutes\":\"Disponible dans quelques minutes\",\"email_user_online_deleted_for_main_contact_content\":\"Bonjour %first_name%, Nous souhaitons vous informer qu\\u0027un de vos clients a d\\u00e9cid\\u00e9 de supprimer son compte. Utilisateur : %full_name% Veuillez noter qu\\u0027aucune action suppl\\u00e9mentaire de votre part n\\u0027est requise concernant cette suppression de compte. %full_name% a volontairement choisi de supprimer son compte et a termin\\u00e9 le processus de mani\\u00e8re ind\\u00e9pendante. Si vous avez des questions ou des pr\\u00e9occupations concernant cette situation, n\\u0027h\\u00e9sitez pas \\u00e0 contacter notre \\u00e9quipe d\\u0027assistance. Nous sommes l\\u00e0 pour vous aider et vous fournir toute clarification n\\u00e9cessaire. Cordialement, L\\u0027\\u00e9quipe de %application_profile%\",\"email_user_online_deleted_for_main_contact_subject\":\"Notification: Suppression du compte client \\u2013 %full_name%\",\"email_user_online_created_for_main_contact_subject\":\"Notification: F\\u00e9licitations ! Vous avez un nouvel utilisateur \\u2013 %full_name%\",\"email_user_online_created_for_main_contact_content\":\"%full_name% a cr\\u00e9\\u00e9 un compte en ligne. Pour consulter le profil de %full_name%, veuillez cliquer \\u003Ca href=\\u0027%profile_url%\\u0027\\u003Eici\\u003C\\/a\\u003E. Cordialement, L\\u0027\\u00e9quipe de %application_profile%.\",\"email_online_purchase_for_main_contact_content\":\"Nous sommes ravis de vous informer que %full_name% a effectu\\u00e9 avec succ\\u00e8s un achat en ligne. Nous souhaitons partager les d\\u00e9tails de sa commande avec vous :\",\"email_online_purchase_for_main_contact_final_content\":\"Pour explorer le profil de %full_name%, veuillez cliquer ici. Cordialement, \\u00c9quipe %application_profile%\",\"email_online_purchase_for_main_contact_subject\":\"Notification: Achat en ligne effectu\\u00e9 par %full_name% - D\\u00e9tails de la commande \\u00e0 l\\u0027int\\u00e9rieur.\",\"email_resapayments_payoffs_bank_account_modification_for_admin_content\":\"Nous vous \\u00e9crivons pour vous informer d\\u0027un r\\u00e9cent changement concernant le compte bancaire associ\\u00e9 \\u00e0 votre compte. D\\u00e9tails du changement :\",\"email_resapayments_payoffs_bank_account_modification_for_admin_final_content\":\"Si ce changement est correct et autoris\\u00e9, aucune autre action n\\u0027est n\\u00e9cessaire. Votre compte a \\u00e9t\\u00e9 mis \\u00e0 jour avec les nouvelles informations bancaires et tous les paiements futurs seront dirig\\u00e9s vers le compte sp\\u00e9cifi\\u00e9. Toutefois, si ce changement n\\u0027a pas \\u00e9t\\u00e9 autoris\\u00e9 ou si vous soup\\u00e7onnez une erreur, n\\u0027h\\u00e9sitez pas \\u00e0 nous contacter imm\\u00e9diatement. Votre s\\u00e9curit\\u00e9 et votre vie priv\\u00e9e sont primordiales pour nous et notre \\u00e9quipe est l\\u00e0 pour vous aider avec toutes les questions ou pr\\u00e9occupations que vous pourriez avoir. Nous souhaitons assurer le traitement s\\u00e9curis\\u00e9 et pr\\u00e9cis de vos paiements. Meilleures salutations,  \\u00c9quipe %application_profile%\",\"email_resapayments_payoffs_bank_account_modification_for_admin_subject\":\"Important ! Changement dans votre compte bancaire de paiements de Resapayments\",\"email_order_created_to_main_contact_subject\":\"F\\u00e9licitations ! Vous avez un nouvel achat\",\"email_order_created_to_main_contact_content\":\"Nous esp\\u00e9rons quetout va bien. Nous sommes heureux de vous informer que vous avez re\\u00e7u une nouvelle commande sur  %platform%! Voici les d\\u00e9tails \\u00e0 examiner et \\u00e0 traiter\",\"email_order_created_to_main_contact_partially_delivered\":\"Certains articles sont d\\u00e9j\\u00e0 livr\\u00e9s car ils ont pu \\u00eatre r\\u00e9cup\\u00e9r\\u00e9s .\",\"email_order_created_to_main_contact_delivered\":\"La commande a d\\u00e9j\\u00e0 \\u00e9t\\u00e9 livr\\u00e9e car les articles ont \\u00e9t\\u00e9 r\\u00e9cup\\u00e9r\\u00e9s .\",\"email_order_created_to_main_contact_content_final\":\"Pour visualiser cette commande, veuillez cliquer sur %custom_link%here%custom_link%. %break_line%  Si vous avez des questions ou si vous avez besoin d\\u0027aide, notre \\u00e9quipe de support est l\\u00e0 pour vous aider. Vous pouvez nous contacter via le chat de la plateforme. %break_line% Merci d\\u0027utiliser %platform% pour d\\u00e9velopper votre activit\\u00e9. Nous sommes impatients de voir passer d\\u0027autres commandes ! %break_line% Salutations, %break_line% %platform%\",\"customer_name\":\"Nom du client\",\"add_customer\":\"Ajouter un client\",\"customer\":\"Client\",\"clients\":\"Clients\",\"send_upgrade_to_pro_request\":\"Envoyer la demande \\u00ab Passez \\u00e0 PRO ! \\u00bb\",\"upgrade_to_pro\":\"Passer \\u00e0 la version PRO\",\"welcome_to_pro\":\"Bienvenue \\u00e0 PRO\",\"accept_upgrade_to_pro\":\"Accepter et passer \\u00e0 PRO\",\"select_an_admin\":\"S\\u00e9lectionner un administrateur\",\"select_an_admin_or_employee\":\"S\\u00e9lectionnez un administrateur ou un employ\\u00e9\",\"email_doubts_title\":\"En cas de doute\",\"email_doubts\":\"Contactez votre centre par t\\u00e9l\\u00e9phone, par mail ou en personne pour obtenir de l\\u0027aide.\",\"email_can_do_question\":\"Que pouvez-vous faire ?\",\"email_continue_with_the_membership\":\"Rien, et continuer \\u00e0 b\\u00e9n\\u00e9ficier des avantages de l\\u0027abonnement %center_name%.\",\"email_cancel_the_membership\":\"Annulez votre abonnement, bien que vous ne pourriez plus acc\\u00e9der \\u00e0 votre centre ou profiter de ses activit\\u00e9s. Pour l\\u0027annuler, contactez votre centre ou acc\\u00e9dez \\u00e0 l\\u0027application.\",\"email_membership_renew_title\":\"Votre abonnement sera automatiquement renouvel\\u00e9 dans les prochains jours.\",\"email_membership_renew_paragraph\":\"Bonjour  %name%, \\u00e0 la prochaine %renew_date% votre abonnement %membership_name% sera renouvel\\u00e9 automatiquement.\",\"email_membership_renew_subject\":\"Votre abonnement %membership_name% sera automatiquement renouvel\\u00e9 dans les prochains jours.\",\"take_photo_tip\":{\"1\":\"1. Regarder la cam\\u00e9ra\",\"2\":\"2. Ne pas porter de lunettes de soleil, de casquettes ou de chapeaux.\",\"3\":\"3. Faites-le dans un endroit suffisamment \\u00e9clair\\u00e9\",\"4\":\"4. \\u00c9viter un arri\\u00e8re-plan avec beaucoup d\\u0027objets\"},\"email_membership_commitment_end_title\":\"Votre abonnement avec engagement prendra fin dans les prochains jours.\",\"email_membership_commitment_end_paragraph\":\"Bonjour  %name%, \\u00e0 la prochaine %commitment_end_date% votre abonnement %membership_name% prendra fin.\",\"email_membership_commitment_end_subject\":\"Votre abonnement avec engagement %membership_name% prendra fin dans les prochains jours.\",\"you_have_doubts\":\"Si vous avez des doutes\",\"ask_to_the_center\":\"Pour obtenir de l\\u0027aide merci de contacter votre centre par t\\u00e9l\\u00e9phone, email, ou en personne\",\"core_categories\":[\"Aucun\",\"Padel\",\"Tennis\",\"Squash\",\"Raquette\",\"Basket\"],\"item\":\"D\\u00e9signation\",\"items_and_stock\":\"Articles et stock\",\"aitems\":{\"BOOKING\":\"R\\u00e9servations\",\"ACTIVITY\":\"Activit\\u00e9s\",\"COURSE\":\"Cours\",\"POS\":\"Caisse\",\"LIGHT\":\"\\u00c9clairage\",\"TICKET\":\"Ticket\",\"CREDIT\":\"Recharge de l\\u0027ancien cr\\u00e9dit\",\"NEW_CREDIT\":\"Recharge de cr\\u00e9dit\",\"MEMBERSHIP_FEE\":\"Abonnement (Mensualit\\u00e9)\",\"MEMBERSHIP_WITHOUT_PRIVILEGES\":\"Cotisations\",\"MEMBERSHIP_JOINING_FEE\":\"Abonnement (Frais d\\u0027inscription)\",\"MEMBERSHIP_UNIQUE_PAYMENT\":\"Abonnement (Paiement unique)\",\"CREDIT_ADJUST\":\"Ajustement de l\\u0027ancien cr\\u00e9dit\",\"UNKNOWN\":\"Inconnu\",\"ITEM\":\"Article de caisse\",\"VOUCHER\":\"Vente de carte de pr\\u00e9pay\\u00e9es\",\"MEMBERSHIP\":\"Abonnement\",\"OTHER\":\"Autres\",\"TOURNAMENT\":\"Tournoi\",\"DELIVERY_NOTE\":\"Ordre de pr\\u00e9l\\u00e8vement\",\"EXTRA_FEE\":\"Frais suppl\\u00e9mentaires\",\"PACK\":\"Pack\",\"PENALTY\":\"P\\u00e9nalit\\u00e9\",\"ACTIVITY_LATE_CANCELLATION\":\"Annulation tardive de l\\u0027activit\\u00e9\"},\"stock\":\"Stock\",\"min_stock\":\"Stock Minimum\",\"image\":\"Image\",\"images\":\"Images\",\"open_in_pos\":\"Ouvrir la caisse\",\"vending_item\":\"Article vending\",\"open_drawer\":\"Ouvrir le tiroir-caisse\",\"select_memberships\":\"S\\u00e9lectionner les abonnements\",\"all_memberships\":\"Tous les abonnements.\",\"scheduled_payment_for_date_of_item\":\"Paiement pr\\u00e9vu pour %date% of %it