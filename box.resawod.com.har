mmencement r\\u00e9elle\",\"real_end_date\":\"Date de fin r\\u00e9elle\",\"real_dates\":\"Dates r\\u00e9elles\",\"duration_hours\":\"Dur\\u00e9e\",\"duration_hours_pack\":\"Dur\\u00e9e (heures)\",\"status_bug\":{\"1\":\"Ouvert\",\"2\":\"En attente\",\"3\":\"Ferm\\u00e9\"},\"activity_new\":\"Nouvelle activit\\u00e9\",\"contact\":\"Contact\",\"contact_us\":\"Contactez-nous\",\"zip\":\"Code postal\",\"state\":\"R\\u00e9gion\",\"id_application\":\"Demande r\\u00e9f\",\"city\":\"Ville\",\"region\":\"R\\u00e9gion\",\"currency\":\"Devise\",\"saving_error_fields\":\"Vous devez remplir tous les champs\",\"go\":\"Accepter\",\"style\":\"Style\",\"credentials\":\"Informations de connexion\",\"header\":\"En-t\\u00eate\",\"footer\":\"Pied de page\",\"personalize_hf\":\"Personnaliser l\\u0027en-t\\u00eate et le pied de page\",\"colors\":\"Couleurs\",\"icon\":\"Ic\\u00f4ne\",\"files\":\"Fichiers\",\"attached_files\":\"Fichiers joints\",\"select_file_JPG\":\"S\\u00e9lectionnez un fichier. Seul le format JPEG est accept\\u00e9.\",\"select_file_logo\":\"S\\u00e9lectionnez un fichier. Seuls les formats JPG et PNG sont accept\\u00e9s\",\"select_files\":\"S\\u00e9lectionnez un fichier. Formats accept\\u00e9s : doc, pdf et jpeg.\",\"redactor_valid_extensions_files\":\"S\\u00e9lectionnez un fichier. Formats accept\\u00e9s : jpg, jpeg, gif, png, pdf, txt, doc, docx\",\"credentials_message\":\"Ici, vous pouvez ajouter un texte et des fichiers qui vont \\u00eatres envoy\\u00e9s \\u00e0 l\\u0027utilisateur par email lorsqu\\u0027un compte est cr\\u00e9\\u00e9.\",\"bookings_message\":\"Ici, vous pouvez ajouter un texte et des fichiers qui vont \\u00eatres envoy\\u00e9s \\u00e0 l\\u0027utilisateur par email lorsqu\\u0027une r\\u00e9servation est faite.\",\"activities_message\":\"Ici, vous pouvez ajouter du texte et des fichiers qui seront envoy\\u00e9s \\u00e0 l\\u0027utilisateur par email lorsqu\\u0027une activit\\u00e9 est r\\u00e9serv\\u00e9e\",\"courses_message\":\"Ici vous pouvez ajouter un texte ou des fichiers qui seront envoy\\u00e9s par email quand un utilisateur s\\u0027inscrira \\u00e0 un cours\",\"memberships_message\":\"Ici vous pouvez ajouter un texte ou des fichiers qui seront envoy\\u00e9s par email quand un utilisateur ach\\u00e8te un abonnement\",\"atask_status\":[\"Non d\\u00e9fini\",\"En attente\",\"Pr\\u00eat \\u00e0 d\\u00e9marrer\",\"En progr\\u00e8s\",\"En suspend\",\"Termin\\u00e9\"],\"emails_settings\":\"Param\\u00e8tres d\\u0027email\",\"color_for_stats\":\"Cette couleur sera utilis\\u00e9e pour les rapports et statistiques\",\"legend\":\"L\\u00e9gende\",\"employees_in_task\":\"Employ\\u00e9s sur cette t\\u00e2che\",\"employees\":\"Employ\\u00e9s\",\"drop_employees\":\"Placez les employ\\u00e9s ici\",\"tasks_personalize\":\"Personnalisez vos t\\u00e2ches\",\"full_schedule\":\"Calendrier complet\",\"format_for_month_calendar_day_header\":\"ddd\",\"format_for_week_calendar_day_header\":\"ddd, d\",\"format_for_day_calendar_day_header\":\"dddd d MMMM\",\"format_for_month_calendar_title\":\"MMMM yyyy\",\"format_for_week_calendar_title\":\"d MMMM[ yyyy]{ \\u0027au\\u0027 d[ MMMM], yyyy}\",\"format_for_day_calendar_title\":\"ddd d MMMM yyyy\",\"format_date_day_and_month\":\"%day% %month%\",\"format_date_day_month_and_year\":\"%month% %day%, %year%\",\"button_day\":\"jour\",\"button_week\":\"semaine\",\"button_month\":\"mois\",\"button_today\":\"aujourd\\u0027hui\",\"tables\":\"Tables\",\"google_calendar\":\"Google Agenda\",\"i_calendar\":\"iCal\",\"selectFacilityToSubscribe\":\"S\\u00e9lectionnez l\\u0027\\u00e9quipement auquel vous souhaitez vous abonner\",\"syncGoogleCalendarFromAdminPanel\":\"Synchroniser avec Google Agenda\",\"re_sync\":\"Synchroniser \\u00e0 nouveau\",\"sync\":\"Synchroniser\",\"changes_before_re-sync\":\"Vous avez des modifications non sauvegard\\u00e9es. Pour synchroniser, veuillez d\\u0027abord sauvegarder les modifications\",\"subscribe_to_calendar\":\"S\\u0027abonner au calendrier\",\"clickOnIconToSynchronizeWithCalendar\":\"Cliquez sur l\\u0027une des ic\\u00f4nes ci-dessous pour vous synchroniser avec Google Calendar\\/iCal\",\"useGeneralLinkToSynchronizeWithOtherApps\":\"Utilisez le lien ci-dessous pour synchroniser dans d\\u0027autres applications\",\"redirectGoogleCalendarFromAdminPanelSteps\":{\"1\":\"1 - Vous allez \\u00eatre redirig\\u00e9 vers la version web de Google Agenda.\",\"2\":\"2 - Vous verrez une bo\\u00eete de dialogue que vous devez accepter afin de synchroniser votre calendrier.\",\"3\":\"3 - Cela peut prendre quelques minutes pour que les \\u00e9v\\u00e9nements apparaissent sur l\\u0027agenda Google.\",\"4\":\"4 - Vous devrez probablement ouvrir l\\u0027application Google Agenda dans votre t\\u00e9l\\u00e9phone portable et modifier les param\\u00e8tres afin d\\u0027afficher le calendrier r\\u00e9cemment ajout\\u00e9.\"},\"mobile_apps\":\"T\\u00e9l\\u00e9chargez les applications mobiles et restez connect\\u00e9s!\",\"email_change_settings\":\"Si vous ne souhaitez plus recevoir d\\u0027emails de votre centre de sport, vous pouvez modifier vos param\\u00e8tres personnels.\",\"email_settings\":\"Param\\u00e8tres d\\u0027email\",\"click_here\":\"Cliquez ici.\",\"here\":\"ici\",\"emails\":\"Emails\",\"receiver\":\"Destinataire\",\"opens\":\"Ouvertures\",\"clicks\":\"Clicks\",\"email_successfully_sent\":\"Email envoy\\u00e9 avec succ\\u00e8s\",\"email_not_sent\":\"Il y a eu une erreur lors de l\\u0027envoi de l\\u0027email\",\"membership_notification\":\"Ces informations d\\u0027adh\\u00e9sion peuvent \\u00eatre modifi\\u00e9es par le club sportif.\",\"email_not_sent_smtp_not_working\":\"Il y a eu une erreur dans votre configuration smtp.\",\"email_sent\":\"Email envoy\\u00e9\",\"save_email\":\"Enregistrer l\\u0027email\",\"check_settings\":\"V\\u00e9rifier les param\\u00e8tres\",\"add_on\":\"Ajout\",\"activate_add_on\":\"Activer le compl\\u00e9ment\",\"email_deliverability_title\":\"Taux de livraison des emails \\u00e9lev\\u00e9\",\"email_deliverability_text\":\"Avec AWS MailPro, vos emails arrivent plus facilement \\u00e0 destination et risquent moins de se retrouver dans les spams, ce qui garantit que vos messages parviennent toujours \\u00e0 vos utilisateurs.\",\"email_volume_title\":\"Augmentation du volume d\\u0027emails envoy\\u00e9s simultan\\u00e9ment\",\"email_volume_text\":\"Envoyez un grand nombre de mails en m\\u00eame temps sans souci, gagnez du temps et informez instantan\\u00e9ment tous vos contacts.\",\"ease_of_use_title\":\"Simplilcit\\u00e9 d\\u0027utilisation\",\"ease_of_use_text\":\"AWS MailPro s\\u0027int\\u00e8gre de mani\\u00e8re transparente \\u00e0 votre application web, ce qui facilite la gestion de vos campagnes d\\u0027e-mailing sans aucun probl\\u00e8me technique.\",\"benefits_of_using_aws\":\"Avantages de choisir AWS MailPro\",\"aws_mp_text\":\"Atteignez plus de clients gr\\u00e2ce \\u00e0 un envoi massif optimis\\u00e9 sans complications. Oubliez les spams et ind\\u00e9sirables, int\\u00e9grez facilement AWS MailPro dans votre application et g\\u00e9rez vos campagnes avec efficacit\\u00e9 d\\u00e8s le premier jour d\\u0027utilisation\",\"email_add_on_config_title\":\"Bienvenue dans l\\u0027installation de votre nouveau module compl\\u00e9mentaire de messagerie AWS MailPro\",\"email_add_on_config_text\":\"Pour commencer, vous devez le configurer correctement. N\\u0027oubliez pas que le service co\\u00fbte 10 euros par mois. Nous vous recommandons de vous faire assister par votre webmaster pour simplifier les configurations les plus avanc\\u00e9es. Commen\\u00e7ons par les premi\\u00e8res \\u00e9tapes !\",\"domain_type_title\":\"Choisir le type de domaine \\u00e0 utiliser\",\"enter_email\":\"Entrez votre email\",\"domain_name_nubapp\":\"Saisir votre nom de domaine Nubapp\",\"own_domain\":\"Domaine propre\",\"nubapp_domain\":\"Domaine de Nubapp\",\"install\":\"Installer\",\"nubapp_domain_warning\":\"Vous avez s\\u00e9lectionn\\u00e9 un domaine de Nubapp pour l\\u0027envoi d\\u0027emails. Veuillez noter qu\\u0027avec cette option, vous ne pourrez pas recevoir de r\\u00e9ponses de vos destinataires.\",\"nubapp_domain_name\":\"Choisissez un nom pour votre domaine de Nubapp\",\"sender_email\":\"Email de l\\u0027exp\\u00e9diteur\",\"sender_email_account_name\":\"Nom du compte de l\\u0027exp\\u00e9diteur de l\\u0027email\",\"aws_activated\":\"AWS Email Pro est activ\\u00e9. Vous l\\u0027avez d\\u00e9j\\u00e0 configur\\u00e9 ?\",\"share_server_config\":\"Partagez les informations de configuration du serveur avec votre webmaster afin que tout fonctionne correctement.\",\"view_settings\":\"Voir les param\\u00e8tres\",\"copy_settings_link\":\"Copier le lien des param\\u00e8tres\",\"setup_help_info\":[\"Si vous n\\u0027avez pas de webmaster,\",\"nous nous ferons un plaisir de vous aider \\u00e0 l\\u0027installer.\",\"Il s\\u0027agit d\\u0027un service suppl\\u00e9mentaire enti\\u00e8rement facultatif dont le co\\u00fbt unique est de 50 euros. Nous serons ravis de vous aider \\u00e0 tout mettre en \\u0153uvre !\"],\"spf_record\":\"Enregistrement SPF\",\"spf_not_configured\":\"Vous n\\u0027avez pas encore configur\\u00e9 d\\u0027enregistrement SPF\",\"spf_already_configured\":\"Vous avez d\\u00e9j\\u00e0 configur\\u00e9 des enregistrements SPF\",\"modify_spf_text\":\"Dans ce cas, vous devez le modifier pour y ins\\u00e9rer \\u0027include:amazonses.com\\u0027\",\"add_new_spf_values\":\"Dans ce cas, vous devez ajouter un nouvel enregistrement SPF avec les valeurs suivantes :\",\"record_name\":\"Nom du record\",\"record_type\":\"Type de record\",\"record_value\":\"Valeur du record\",\"original_value\":\"Valeur originale\",\"new_value\":\"Nouvelle valeur\",\"dkim_records\":\"Enregistrements DKIM\",\"dkim_setup\":[\"Pour configurer DKIM, vous devez mettre \\u00e0 jour les param\\u00e8tres DNS de votre domaine avec les informations de l\\u0027enregistrement CNAME de la section sur le set d\\u0027enregistrements DKIM dans le fichier de configuration fourni.\",\"En suivant l\\u0027exemple ci-dessous, vous devez cr\\u00e9er 3 enregistrements CNAME avec un nom et une valeur.\",\"Veuillez noter que la v\\u00e9rification de la configuration avec les serveurs d\\u0027Amazon peut prendre jusqu\\u0027\\u00e0 3 jours.\"],\"aws_activated_and_ready\":\"AWS Email Pro est activ\\u00e9 et pr\\u00eat \\u00e0 l\\u0027emploi.\",\"aws_benefits\":\"D\\u00e9sormais, la communication avec vos clients sera plus simple, plus rapide et plus efficace. G\\u00e9rez vos mailings sans effort et tenez vos contacts toujours inform\\u00e9s.\",\"use_own_domain\":\"Voulez-vous utiliser votre propre domaine ?\",\"use_own_domain_reminder\":\"N\\u0027oubliez pas que vous pouvez cr\\u00e9er votre propre domaine \\u00e0 tout moment.\",\"switch_own_domain\":\"Passez \\u00e0 votre propre domaine\",\"spf_record_success_text\":\"Nous avons v\\u00e9rifi\\u00e9 que votre configuration SPF est correcte. Tout fonctionne comme il se doit, aucune autre action n\\u0027est donc requise de votre part.\",\"verify_dkim_records\":\"V\\u00e9rifier les enregistrements DKIM\",\"dkim_record_error\":[\"L\\u0027enregistrement DKIM n\\u0027a pas \\u00e9t\\u00e9 trouv\\u00e9. Veuillez ajouter l\\u0027enregistrement DKIM \\u00e0 votre DNS.\",\"Le nom de l\\u0027enregistrement DKIM est incorrect. Trouv\\u00e9 :  \\u0027%bad_name%\\u0027 . Veuillez mettre \\u00e0 jour le nom de l\\u0027enregistrement.\",\"La valeur de l\\u0027enregistrement DKIM est incorrecte. Trouv\\u00e9 :\\u0027%bad_value%\\u0027. Veuillez mettre \\u00e0 jour la valeur de l\\u0027enregistrement.\",\"Le nom et la valeur de l\\u0027enregistrement DKIM sont incorrects. Nom trouv\\u00e9 : %bad_name%;Valeur trouv\\u00e9e : \\u0027%bad_value%\\u0027. Veuillez mettre \\u00e0 jour le nom et la valeur de l\\u0027enregistrement.\"],\"own_domain_error\":\"Nous ne pouvons pas envoyer d\\u0027e-mail en utilisant le domaine %domain_name% . Vous devez utiliser un domaine qui vous appartient\",\"your_user_accounts\":\"Vos comptes\",\"multiple_accounts\":\"Comptes multiples\",\"my_centers\":\"Mes centres\",\"other_accounts\":\"Autres comptes\",\"link_new_center\":\"Lien vers le nouveau centre\",\"unable_to_switch_account\":\"Il n\\u0027est pas possible de changer de compte\",\"no_linked_centers\":\"Vous n\\u0027avez aucun centre li\\u00e9 \\u00e0 votre compte.\",\"error_adding_account\":\"Erreur lors de l\\u0027ajout d\\u0027un compte\",\"draw_winner_amount\":\"Vous avez gagn\\u00e9 %amount% tirages au sort\",\"news\":\"Actualit\\u00e9s\",\"blog\":\"Blog\",\"new_post\":\"Nouveau post\",\"post_not_available\":\"L\\u0027article n\\u0027est plus disponible\",\"could_take_while\":\"Cela peut prendre un moment\",\"default_web_view\":\"Vue web par d\\u00e9faut\",\"default_web_view_explanation\":\"L\\u0027option Mensuel montre toutes les activit\\u00e9s du mois dans l\\u0027application. Id\\u00e9al pour les \\u00e9v\\u00e9nements comme un atelier d\\u0027une journ\\u00e9e, repas etc\",\"web_appearance\":\"Aper\\u00e7u web\",\"activate_theme_options\":\"Activer mes options de th\\u00e8mes personnels\",\"web_preview_tip\":\"Cet aper\\u00e7u web est une repr\\u00e9sentation g\\u00e9n\\u00e9rale du r\\u00e9sultat final; des ajustements peuvent \\u00eatre n\\u00e9cessaires. Nous vous recommandons de v\\u00e9rifier le rendu final avant de le partager avec vos clients.\",\"wrapped_no_weight_text\":\"Nous savons que vous avez consacr\\u00e9 beaucoup d\\u0027efforts \\u00e0 votre entra\\u00eenement, mais vous n\\u0027avez pas enregistr\\u00e9 vos r\\u00e9sultats. Commencez l\\u0027ann\\u00e9e 2026 avec un historique complet de vos entra\\u00eenements et de vos r\\u00e9sultats dans l\\u0027application.\",\"new_voucher_alert\":\"Vous devez renseigner les cat\\u00e9gories de sport prises en compte par vos cartes pr\\u00e9pay\\u00e9es. Cliquez sur le lien pour les mettre \\u00e0 jour.\",\"not_paid_remittance_alert\":\"Votre fichier de pr\\u00e9l\\u00e8vement est en attente d\\u0027\\u00eatre marqu\\u00e9 comme pay\\u00e9. Souvenez-vous de le faire dans le mois en cours.\",\"go_to_settings\":\"Aller dans param\\u00e8tres\",\"users_automatically_blocked\":\"Utilisateurs automatiquement bloqu\\u00e9s en fonction de vos param\\u00e8tres au cours des %d% jours\",\"users_penalties_in_last_days\":\"P\\u00e9nalit\\u00e9s pour les utilisateurs dans les %d% derniers jours\",\"automatic_rule_exceeded\":{\"1\":\"Seuil de paiements en attentes d\\u00e9pass\\u00e9\",\"2\":\"Dette maximum atteinte\",\"3\":\"Non-pr\\u00e9sentation \\u00e0 une activit\\u00e9\"},\"admins_and_employees\":\"Admins et employ\\u00e9s\",\"users_with_membership\":\"Abonn\\u00e9s\",\"users_without_membership\":\"Non abonn\\u00e9s\",\"users_without_voucher\":\"Sans carnet\",\"users_with_membership_or_vouchers\":\"Abonn\\u00e9s ou carnets\",\"users_without_membership_or_vouchers\":\"Sans abonnement ni carnet\",\"users_with_credit_card\":\"Utilisateurs avec carte de cr\\u00e9dit\",\"same_as_members\":\"Comme les abonn\\u00e9s\",\"personalized_price\":\"Personnalis\\u00e9\",\"filter_by_age\":\"Filter par age\",\"category_ages_label\":\"Cat\\u00e9gories d\\u0027\\u00e2ge (toutes deux incluses)\",\"filter_by_gender\":\"Filtrer par sexe\",\"what_to_do_when_maximum_age_is_reached\":\"Que faire lorsque l\\u0027\\u00e2ge maximum est atteint\",\"be_able_to_open_with_mobile\":\"Pouvoir utiliser ce lecteur \\u00e0 partir de l\\u0027application mobile\",\"delete_membership_with_active_users_warning\":\"Abonnement supprim\\u00e9, mais il y a des utilisateurs qui l\\u0027utilisent\",\"vitale\":\"Vitale\",\"cfwhiteboard\":\"CF Whiteboard\",\"new_update\":\"Nouvelle version\",\"new_version_update\":\"Une mise \\u00e0 jour est disponible et va \\u00eatre t\\u00e9l\\u00e9charg\\u00e9e automatiquement\",\"only_admins_app\":\"Cette apps est exclusivement r\\u00e9serv\\u00e9e aux administrateurs et employ\\u00e9s.\",\"select_from_gallery\":\"Choisir dans la galerie\",\"take_a_photo\":\"Prendre une photo\",\"use_camera\":\"Utiliser la cam\\u00e9r