ongitude\":-4.3509933},\"contact_info\":{\"email\":\"info@box1315crossfit.com\",\"phone\":\"722 644 533\"},\"social_media\":{\"instagram\":\"box1315Crossfit\",\"facebook\":\"Box1315crossfit\"}},{\"id_application\":null,\"id_lead\":\"2870\",\"name\":\"Puro Crossfit Marbella\",\"description\":\"Somos un equipo de entrenadores titulados en esta disciplina deportiva (Crossfit Level 1 Trainers y CrossFit Endurance Trainers) que nos hemos fijado el objetivo de ayudar a nuestros atletas a superar sus metas, ya sea el logro de una buena condici\\u00f3n f\\u00edsica, la preparaci\\u00f3n para oposiciones, competir en los niveles m\\u00e1s altos o simplemente para disfrutar del deporte y de sus beneficios.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2870\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2870\\/featured_images\\/hqdefault.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2870\\/featured_images\\/maxresdefault%20%281%29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2870\\/featured_images\\/maxresdefault.jpg\"],\"address\":{\"street\":\"Carb\\u00f3n, 9\",\"town\":\"Marbella\",\"postal_code\":\"29603\",\"country\":\"Spain\"},\"location\":{\"latitude\":36.5098584,\"longitude\":-4.8691608},\"contact_info\":{\"email\":\"info@purocrossfit.es\",\"phone\":\"616893664\"},\"social_media\":{\"instagram\":\"purocrossfitmarbella\",\"facebook\":\"@purocrossfit.es\"}},{\"id_application\":\"11900361\",\"id_lead\":null,\"name\":\"CrossFit Le Bercail\",\"description\":\"\",\"logo\":null,\"images\":[],\"address\":{\"street\":\"Avenue de Capestang\",\"town\":\"Montady\",\"postal_code\":\"34310\",\"country\":\"France\"},\"location\":{\"latitude\":43.3289144,\"longitude\":3.1163645},\"contact_info\":{\"email\":\"heros34@nubapp-clients.com\",\"phone\":\"0680967711\\t\"},\"social_media\":{\"instagram\":\"crossfit_lebercail\",\"facebook\":\"\"}},{\"id_application\":\"96538578\",\"id_lead\":null,\"name\":\"CrossFit Cham\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/96538578\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Further Str. 24\",\"town\":\"Cham\",\"postal_code\":\"93413\",\"country\":\"Deutschland\"},\"location\":{\"latitude\":49.2251649,\"longitude\":12.6760137},\"contact_info\":{\"email\":\"crossfitcham@nubapp-clients.com\",\"phone\":\"01590 4222268\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":\"88925674\",\"id_lead\":null,\"name\":\"Airicks Training\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/88925674\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Chemin de Finage 12\",\"town\":\"Saignel\\u00e9gier\",\"postal_code\":\"2350\",\"country\":\"Swtizerland\"},\"location\":{\"latitude\":47.2608422,\"longitude\":7.0037004},\"contact_info\":{\"email\":\"info@airicks.ch\",\"phone\":\"\"},\"social_media\":{\"instagram\":\"airicks_training\",\"facebook\":\"\"}},{\"id_application\":\"74239463\",\"id_lead\":null,\"name\":\"CrossFit Heresy\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/74239463\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/74239463\\/featured_images\\/heresy.png\"],\"address\":{\"street\":\"Rue Jean Monnet, 181\",\"town\":\"Croix\",\"postal_code\":\"59170\",\"country\":\"France\"},\"location\":{\"latitude\":50.6797317,\"longitude\":3.1414327},\"contact_info\":{\"email\":\"crossfitheresy@gmail.com\",\"phone\":\"06 42 75 28 79\\u202c\"},\"social_media\":{\"instagram\":\"crossfitheresy\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"3111\",\"name\":\"CrossFit Hem\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3111\\/featured_images\\/37734056_1051763238315214_647143441410555904_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3111\\/featured_images\\/37791094_1051764248315113_2082595720178696192_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3111\\/featured_images\\/52536859_1212056435619226_7026628077497090048_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3111\\/featured_images\\/59286080_1258234741001395_7044538662352060416_o.jpg\"],\"address\":{\"street\":\"10 Rue de la Blanchisserie\",\"town\":\"Hem\",\"postal_code\":\"59510\",\"country\":\"France\"},\"location\":{\"latitude\":50.660754,\"longitude\":3.2019196},\"contact_info\":{\"email\":\"crossfithem@gmail.com\",\"phone\":\"+33 3 59 52 74 20\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfithem\\/\"}},{\"id_application\":null,\"id_lead\":\"2569\",\"name\":\"Quarto Miglio CrossFit\",\"description\":\"Dal 1\\u00b0 Gennaio ci siamo trasferiti nella nuova sede di 360 mq. in Via Annia Regilla n. 10\\/16.\\nhome_page\\n\\nNovit\\u00e0 all\\u2019interno del box:\\nBrazilian jiu jitsu, Prepugilistica, Pole dance, Calisthenics, Judo bambini, Ginnastica artistica, Ginnastica adulti, Power joga, Posturale, Open Gym, Personal Trainer.\\nCos\\u2019\\u00e8 per noi il CrossFit\\n\\nIl Crossfit \\u00e8 un programma di forza centrale e di  ricondizionamento, basato su un fitness ampio, generale e comprensivo. Elementi di ginnastica, sollevamento pesi, ricondizionamento metabolico (cardio) e strongman sono combinati tra di loro in allenamenti intensi quotidiani per massimizzare i risultati di ogni individuo. CrossFit si basa su modelli di movimento funzionale o movimenti che si trovano nella vita reale e quotidiana come spingere, tirare, sedersi, saltare, lanciare e scattare.\\n\\nE\\u2019 uno \\u201d stile di vita\\u201d, il mezzo che ci ha permesso di raggiungere uno stato di benessere psicofisico.\\nLa forza del CrossFit sta nella community, cio\\u00e8 si crea un gruppo di persone, atleti e non, che vogliono come unico scopo migliorare il proprio stato di benessere, autostima, condividendo fatiche per raggiungere il miglior livello di fitness.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2569\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2569\\/featured_images\\/23800192_392728637837066_2315851886518753431_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2569\\/featured_images\\/39821272_550029145440347_8509210393908871168_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2569\\/featured_images\\/50294437_621757974934130_6813830753130905600_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2569\\/featured_images\\/50589143_630769130699681_5041493145313869824_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2569\\/featured_images\\/50792069_630769560699638_8913307657582936064_n.jpg\"],\"address\":{\"street\":\"Via Annia Regilla 10-16\",\"town\":\"Roma\",\"postal_code\":\"00178\",\"country\":\"Italia\"},\"location\":{\"latitude\":41.8398248,\"longitude\":12.5463934},\"contact_info\":{\"email\":\"quartomigliocrossfit@gmail.com\",\"phone\":\"+39 3921420886\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/quartomigliocrossfit\\/\"}},{\"id_application\":\"32110893\",\"id_lead\":null,\"name\":\"HO\\u0027OMAU Athletic Hub\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/32110893\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/32110893\\/featured_images\\/Logo_H.jpg\"],\"address\":{\"street\":\"Chem. des Champs Courbes 5\",\"town\":\"Ecublens\",\"postal_code\":\"1024\",\"country\":\"Switzerland\"},\"location\":{\"latitude\":46.515759,\"longitude\":6.5518117},\"contact_info\":{\"email\":\"info@hoomau.ch\",\"phone\":\"079 486 46 45\"},\"social_media\":{\"instagram\":\"hoomau.athletic.hub\",\"facebook\":\"\"}},{\"id_application\":\"75446005\",\"id_lead\":null,\"name\":\"CrossFit Atom\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/75446005\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Zone Artisanale Juge Gu\\u00e9rin\",\"town\":\"Beaumont\",\"postal_code\":\"74160\",\"country\":\"France\"},\"location\":{\"latitude\":46.1029005,\"longitude\":6.1044806},\"contact_info\":{\"email\":\"atomcf@nubapp-clients.com\",\"phone\":\"0781057815\"},\"social_media\":{\"instagram\":\"crossfitatom\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2996\",\"name\":\"Crossfit Val d\\u0027Aran\",\"description\":\"CrossFit Val d\\u0027 Aran se encuentra en la parte alta de una nave industrial que comparte con el Club Mountain Padel Indoor de Vielha.\\n\\nTe sorprender\\u00e1 como hemos aprovechado el espacio para que 8 personas puedan entrenar al tiempo con todo el material necesario garantizado para la pr\\u00e1ctica del CrossFit. \\u00a1Peque\\u00f1os pero matones!\\n\\nJaula 8 puestos de diferentes alturas, tres puestos para anillas, uno para cuerda, 3 racks para trabajo de fuerza, dianas para wall ball, zona Weigthlifting, pizarr\\u00f3n...y lo que nos queda por llegar!\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2996\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2996\\/featured_images\\/2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2996\\/featured_images\\/43340024_1930080767057110_2856016354052407296_n.jpg\"],\"address\":{\"street\":\"Pol\\u00edgono Industrial Aiguaprima Nave 7\",\"town\":\"Vielha\",\"postal_code\":\"25530\",\"country\":\"Spain\"},\"location\":{\"latitude\":42.7102794,\"longitude\":0.7975535},\"contact_info\":{\"email\":\"crossfitvaldaran@gmail.com\",\"phone\":\"657892678\"},\"social_media\":{\"instagram\":\"crossfitvaldaran\",\"facebook\":\"@crossfitvaldaran\"}},{\"id_application\":null,\"id_lead\":\"2723\",\"name\":\"CrossFit Diamantik - Gaiarine\",\"description\":\"Chi siamo\\nL\\u2019intensit\\u00e0 \\u00e8 relativa alla tolleranza ed alla capacit\\u00e0 fisiologica e psicologica di ognuno di noi. Ci\\u00f2 significa che il programma \\u00e8 universalmente scalabile in intensit\\u00e0 e difficolt\\u00e0! Per questo gli Allenamenti creati da CrossFit Mentana possono essere utilizzati da chiunque. Facciamo si che l\\u2019allenamento si adatti alla persona e non viceversa.\\n\\nChe tu sia un guerriero della domenica, uno sportivo professionista, una persona anziana o semplicemente il tuo scopo \\u00e8 tornare in forma, il programma CrossFit \\u00e8 progettato per essere adattato ad ogni individuo indipendentemente dall\\u2019esperienza.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2723\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2723\\/featured_images\\/18268125_1058118440954249_8506542277430248162_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2723\\/featured_images\\/22496029_1193111304121628_6783798593630124147_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2723\\/featured_images\\/26804649_1261591703940254_4204044583858569514_n.jpg\"],\"address\":{\"street\":\"Via Vizza, 14\",\"town\":\"Venezia\",\"postal_code\":\"31018\",\"country\":\"Italy\"},\"location\":{\"latitude\":45.883519,\"longitude\":12.489793},\"contact_info\":{\"email\":\"info@crossfitdiamantik.com\",\"phone\":\"392 034 1560\"},\"social_media\":{\"instagram\":\"crossfitdiamantik\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitdiamantik\\/\"}},{\"id_application\":null,\"id_lead\":\"2566\",\"name\":\"CrossFit Casalotti\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-w