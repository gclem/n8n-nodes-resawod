:{\"instagram\":\"olympuscrossfitroma\",\"facebook\":\"https:\\/\\/www.facebook.com\\/OlympusCrossFitRoma\\/\"}},{\"id_application\":null,\"id_lead\":\"2672\",\"name\":\"Crossfit Mitte\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2672\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2672\\/featured_images\\/4.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2672\\/featured_images\\/Gilrs-who-row.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2672\\/featured_images\\/Lars-and-Brokklyn.jpg\"],\"address\":{\"street\":\"Heidestrasse 48\",\"town\":\"10557 Berlin\",\"postal_code\":\"10557\",\"country\":\"Deutschland\"},\"location\":{\"latitude\":52.5308781,\"longitude\":13.3650709},\"contact_info\":{\"email\":\"Lars@crossfitmitte.de\",\"phone\":\"\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitmitteberlin\"}},{\"id_application\":null,\"id_lead\":\"2792\",\"name\":\"Brick Crossfit Santiago de Compostela\",\"description\":\"Comunidad de Brick Santiago de Compostela. Afiliaci\\u00f3n Brick Los Angeles Brick New York\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2792\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2792\\/featured_images\\/BEST-brick_1.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2792\\/featured_images\\/bricknewyork.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2792\\/featured_images\\/image-2.jpeg\"],\"address\":{\"street\":\"Traves\\u00eda do Porto S\\/N,\",\"town\":\"Milladoiro\",\"postal_code\":\"15895\",\"country\":\"Spain\"},\"location\":{\"latitude\":42.8477733,\"longitude\":-8.6155754},\"contact_info\":{\"email\":\"info@clubcamm.es\",\"phone\":\"635011737\"},\"social_media\":{\"instagram\":\"brickcrossfitsantiago\",\"facebook\":\"@BrickCrossFit.Santiago\"}},{\"id_application\":\"35139101\",\"id_lead\":null,\"name\":\"Immanis CF\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/35139101\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/35139101\\/featured_images\\/14242492_1745235972393263_437302656873611169_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/35139101\\/featured_images\\/31676583_2037022319881292_7720491842441052160_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/35139101\\/featured_images\\/31755396_2037022263214631_5607474014206296064_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/35139101\\/featured_images\\/32205789_2041010569482467_6038292421207392256_o.jpg\"],\"address\":{\"street\":\"rue Pierre et Marie Curie\",\"town\":\"OSTWALD\",\"postal_code\":\"67540\",\"country\":\"France\"},\"location\":{\"latitude\":48.5357553,\"longitude\":7.6988754},\"contact_info\":{\"email\":\"immanis.crossfit@gmail.com\",\"phone\":\"0954842185 - 0631368331\"},\"social_media\":{\"instagram\":\"immanis_crossfit\",\"facebook\":\"https:\\/\\/www.facebook.com\\/Immanis-CrossFit-1691736351076559\"}},{\"id_application\":null,\"id_lead\":\"2951\",\"name\":\"Crossfit 11520\",\"description\":\"Nuestro Box tiene 200m cuadrados de superficie de entrenamiento, una estructura de 14 puestos de dominadas con sus respectivas anillas, tres calles de halterofilia de 15m. Aqu\\u00ed encontraras el espacio suficiente para entrenar con seguridad y comodidad.\\nNo encontraras ning\\u00fan espejo, el motivo es que en CrossFit 11520 nuestro objetivo,  no es la apariencia f\\u00edsica, sino que es la salud y un estado de forma f\\u00edsica \\u00f3ptimo, como resultado obtendremos un cambio f\\u00edsico radical, la mejor versi\\u00f3n de nosotros mismos.\\n\\nTampoco encontraras el\\u00edpticas, sino pesos reales y nuestro peso corporal para crear movimientos naturales, las maquinas que tenemos imitan el comportamiento funcional del ser humano (Assault Bikes y Concept2), aqu\\u00ed las maquinas sois vosotros.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2951\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2951\\/featured_images\\/10369689_1519492318353115_1583403162856780188_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2951\\/featured_images\\/45453392_1925095167792826_5615199221557755904_n.jpg\"],\"address\":{\"street\":\"Calle Escultores, 8\",\"town\":\"Rota\",\"postal_code\":\"11520\",\"country\":\"Spain\"},\"location\":{\"latitude\":36.6344331,\"longitude\":-6.3684426},\"contact_info\":{\"email\":\"CrossFit11520.info@crossfit11520.com\",\"phone\":\"695 331 956\"},\"social_media\":{\"instagram\":\"crossfit11520\",\"facebook\":\"@CrossFitisComingtoRota\"}},{\"id_application\":null,\"id_lead\":\"2797\",\"name\":\"Free Move Crossfit\",\"description\":\"FreeMove CrossFit es probablemente el box de CrossFit mejor equipado de todo Palma de Mallorca. Disponemos de dos zonas completas de entrenamiento, m\\u00e1s de 450 metros cuadrados de suelo deportivo, lo que nos brinda de capacidad para llevar a cabo dos clases de forma totalmente simult\\u00e1neas.\\n\\nMejor ubicaci\\u00f3n imposible, justo en el P\\u00f3ligono Son Castell\\u00f3, a 5 minutos del centro de Palma. Parking propio, Zona Chill-Out con Wi-Fi. Aseos, vestuarios y duchas completos femenino y masculino.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2797\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2797\\/featured_images\\/descarga-1.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2797\\/featured_images\\/descarga-2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2797\\/featured_images\\/descarga-3%20%281%29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2797\\/featured_images\\/descarga-3.jpg\"],\"address\":{\"street\":\"Avenida 16 de julio, 11, Carrer B\",\"town\":\"Palma de Mallorca\",\"postal_code\":\"07009\",\"country\":\"Spain\"},\"location\":{\"latitude\":39.5957473,\"longitude\":2.6630392},\"contact_info\":{\"email\":\"info@freemovecrossfit.com\",\"phone\":\"630628212\"},\"social_media\":{\"instagram\":\"freemovecrossfit\",\"facebook\":\"@FreeMoveCrossFit\"}},{\"id_application\":\"14343858\",\"id_lead\":null,\"name\":\"CrossFit 975\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/14343858\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/14343858\\/featured_images\\/CF%20975%20-%201.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/14343858\\/featured_images\\/CF%20975-%202.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/14343858\\/featured_images\\/CF%20975-%203.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/14343858\\/featured_images\\/CF%20975-%204.PNG\"],\"address\":{\"street\":\"Chemin des Devins 26\",\"town\":\"Cressier\",\"postal_code\":\"2088\",\"country\":\"Switzerland\"},\"location\":{\"latitude\":47.0526294,\"longitude\":7.0422055},\"contact_info\":{\"email\":\"info@crossfit975.com\",\"phone\":\"41799169819\"},\"social_media\":{\"instagram\":\"crossfit975\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfit975\"}},{\"id_application\":\"56514502\",\"id_lead\":null,\"name\":\"Crossfit Albstadt\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/56514502\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/56514502\\/featured_images\\/Albstadt2.JPG\"],\"address\":{\"street\":\"Friedrich-Kr