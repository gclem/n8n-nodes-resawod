g\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2559\\/featured_images\\/16708429_1672122353080330_3521729789067823447_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2559\\/featured_images\\/21199633_1755042388121659_6339647120649950653_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2559\\/featured_images\\/crossfit%20monteverde%20image%201.jpg\"],\"address\":{\"street\":\"via Ludovica Albertoni 59\\/61\",\"town\":\"Roma\",\"postal_code\":\"00152\",\"country\":\"Italia\"},\"location\":{\"latitude\":41.877607,\"longitude\":12.4448639},\"contact_info\":{\"email\":\"info@crossfitmonteverde.it\",\"phone\":\"+39 06 534 2233\"},\"social_media\":{\"instagram\":\"crossfit_monteverde\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitmonteverde\\/\"}},{\"id_application\":null,\"id_lead\":\"2689\",\"name\":\"My Leo Crossfit\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2689\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2689\\/featured_images\\/Bildschirmfoto%202019-04-10%20um%2012.00.54.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2689\\/featured_images\\/Bildschirmfoto%202019-04-10%20um%2012.02.00.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2689\\/featured_images\\/Bildschirmfoto%202019-04-10%20um%2012.02.26.png\"],\"address\":{\"street\":\"Franklinstr. 10\",\"town\":\"Berlin\",\"postal_code\":\"10587\",\"country\":\"Deutschland\"},\"location\":{\"latitude\":52.5202852,\"longitude\":13.3260141},\"contact_info\":{\"email\":\"mail@myleo.de\",\"phone\":\"+ 49 (0) 30 308 23 878\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/myleoCrossFit\\/?ref=page_internal\"}},{\"id_application\":\"13264669\",\"id_lead\":null,\"name\":\"PERFORMIX \",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/13264669\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"176 Birkirkara, Road\",\"town\":\"San \\u0120wann\",\"postal_code\":\"SGN 4190\",\"country\":\"Malta\"},\"location\":{\"latitude\":35.9066875,\"longitude\":14.4805625},\"contact_info\":{\"email\":\"kirstyfalzon@outlook.com\",\"phone\":\"79230211\"},\"social_media\":{\"instagram\":\"_performixone\",\"facebook\":\"_performixone\"}},{\"id_application\":null,\"id_lead\":\"3109\",\"name\":\"CrossFit Hanuman\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3109\\/featured_images\\/49422720_1973256572795396_7162393823379718144_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3109\\/featured_images\\/49899344_1973255999462120_7812778960076406784_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3109\\/featured_images\\/49913092_1973256499462070_6533668735037734912_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3109\\/featured_images\\/49947390_1973256119462108_1981787520572063744_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3109\\/featured_images\\/50100619_1973255956128791_68876002524135424_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3109\\/featured_images\\/50464562_1973250596129327_6150554628577558528_n.jpg\"],\"address\":{\"street\":\"16 Rue des Piboules\",\"town\":\"Venelles\",\"postal_code\":\"13770\",\"country\":\"France\"},\"location\":{\"latitude\":43.5921777,\"longitude\":5.4776992},\"contact_info\":{\"email\":\"contact@crossfit-hanuman.com\",\"phone\":\"+33 6 87 48 41 85\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfithanuman\\/\"}},{\"id_application\":null,\"id_lead\":\"2618\",\"name\":\"CrossFit Avanguardia\",\"description\":\"PERCHE\\u2019 CROSSFIT AVANGUARDIA? \\n\\nDa noi avrai la possibilit\\u00e0 di metterti in gioco e di raggiungere i tuoi obiettivi. Con la tua motivazione e la nostra professionalit\\u00e0 possiamo farti raggiungere i risultati che desideri, che tu sia un atleta con il bisogno di migliorare le tue performance o una persona che desidera rimettersi in forma e stare bene.\\n\\n\\n IN COSA SIAMO DIFFERENTI?\\n\\nSe sei stanco di routinari allenamenti in palestra, schede di allenamento pre-confezionate e corsi di aerobica che non sono riusciti a farti perdere i chili di troppo o farti raggiungere ci\\u00f2 che desideri\\u2026 CrossFit Avanguardia \\u00e8 quello che stavi cercando!\\n\\n Da noi ogni giorno \\u00e8 una sfida diversa: sollevare pesi, saltare, correre, spingere, tirare, resistere alla fatica, divertendosi insieme.\\n\\nI nostri WOD (Workout Of the Day) non sono mai svelati in anticipo: prima di ogni lezione, non saprai mai quello che ti aspetta, perch\\u00e8, cosi come nella vita, vogliamo che tu sia pronto a quasiasi sfida ti si presenti davanti. Noi ti aiuteremo a superare i tuoi limiti, sfruttando al massimo le tue potenzialit\\u00e0.\\n\\n La nostra non \\u00e8 una palestra, \\u00e8 una grande famiglia che condivide la stessa \\u201cPASSIONE\\u201d; un club, dove ci si conosce tutti per nome, dove ci si aiuta, si suda insieme, ci si allena duramente e si celebrano con orgoglio i risultati raggiunti.\\n\\n Per capire meglio cos\\u2019\\u00e8 il CrossFit raggiungici e partecipa ad una delle nostre classi prova \\u201cFree Trial\\u201d. Ti aspettiamo!\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2618\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2618\\/featured_images\\/11021114_831074676939130_4869163206352647980_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2618\\/featured_images\\/22459549_1505370262842898_607043139484042980_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2618\\/featured_images\\/23215575_1523037714409486_6263578119066423489_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2618\\/featured_images\\/48406294_2007138399332746_2626328898996011008_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2618\\/featured_images\\/943992_988852237828039_4187219228995247151_n.jpg\"],\"address\":{\"street\":\"Viale Lombardia, 23\",\"town\":\"Milano\",\"postal_code\":\"20131\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.4829498,\"longitude\":9.2233906},\"contact_info\":{\"email\":\"info@crossfitavanguardia.com\",\"phone\":\"+39 344 294 4432\"},\"social_media\":{\"instagram\":\"crossfit_avanguardia\",\"facebook\":\"https:\\/\\/www.facebook.com\\/pg\\/crossfitavanguardia\"}},{\"id_application\":null,\"id_lead\":\"2984\",\"name\":\"Crossfit Spayer\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2984\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2984\\/featured_images\\/Bildschirmfoto%202019-06-03%20um%2011.50.12.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2984\\/featured_images\\/Bildschirmfoto%202019-06-03%20um%2011.50.24.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2984\\/featured_images\\/Bildschirmfoto%202019-06-03%20um%2011.50.46.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2984\\/featured_images\\/crossfitspeyer-background-min.jpg\"],\"address\":{\"street\":\"Auestra\\u00dfe 20\",\"town\":\"Speyer\",\"postal_code\":\"67346\",\"country\":\"Germany\"},\"location\":{\"latitude\":49.3339828,\"longitude\":8.4350073},\"contact_info\":{\"email\":\"info@crossfitspeyer.com\",\"phone\":\"+49 1601576419\"},\"social_media\":{\"instagram\":\"crossfit_speyer\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CFSpeyer\\/\"}},{\"id_application\":\"56821998\",\"id_lead\":null,\"name\":\"Wall Ball Street\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.e