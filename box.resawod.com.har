"-12\":\"Lecteur non assign\\u00e9 \\u00e0 un lieu valide\",\"-13\":\"Utilisateur d\\u00e9j\\u00e0 \\u00e0 l\\u0027int\\u00e9rieur du lieu\",\"-14\":\"L\\u0027utilisateur n\\u0027est pas \\u00e0 l\\u0027int\\u00e9rieur du centre\",\"-15\":\"Le ticket n\\u0027est pas \\u00e0 l\\u0027int\\u00e9rieur du centre\",\"-16\":\"Le ticket n\\u0027est pas \\u00e0 l\\u0027int\\u00e9rieur du centre\",\"-17\":\"L\\u0027utilisateur ne se trouve pas dans le b\\u00e2timent principal\",\"-18\":\"Le centre a atteint sa capacit\\u00e9 maximale\",\"-19\":\"L\\u0027utilisateur est bloqu\\u00e9 par une sanction\",\"-20\":\"L\\u0027utilisateur a des impay\\u00e9s\",\"-21\":\"L\\u0027utilisateur n\\u0027a pas l\\u0027\\u00e2ge requis pour ce lecteur\",\"-22\":\"L\\u0027utilisateur a un genre invalide pour ce lecteur\",\"-23\":\"Le code QR a expir\\u00e9\",\"-24\":\"L\\u0027utilisateur n\\u0027a pas de passeport covid\",\"-25\":\"L\\u0027utilisateur n\\u0027a pas acc\\u00e8s aux documents sign\\u00e9s\",\"-26\":\"Le code QR de l\\u0027utilisateur n\\u0027est pas valide\",\"-27\":\"L\\u0027utilisateur a un casier occup\\u00e9 %ojmar_locked_lockers%\",\"-28\":\"L\\u0027utilisateur doit attendre le temps minimum requis avant d\\u0027acc\\u00e9der \\u00e0 nouveau au centre ou d\\u0027en sortir.\",\"-29\":\"Le Centre est ferm\\u00e9.\"},\"access_granted_reason\":\"Raison pour laquelle l\\u0027acc\\u00e8s est autoris\\u00e9 \\/ refus\\u00e9\",\"access_granted_reasons\":{\"facility\":\"Installations\",\"activity\":\"Activit\\u00e9\",\"course\":\"Cours\",\"membership\":\"Abonnement\",\"ticket\":\"Ticket\",\"employee_or_admin\":\"Employ\\u00e9 ou admin\",\"unknown\":\"Inconnu\",\"forced\":\"Forc\\u00e9\",\"timetable_profile\":\"Il peut acc\\u00e9der car il est dans son horaire pr\\u00e9d\\u00e9fini.\"},\"why_error\":\"Pourquoi cette erreur appara\\u00eet-elle ?\",\"causes_and_solutions\":\"Causes et solutions les plus probables\",\"no_access\":\"Cela peut \\u00eatre d\\u00fb \\u00e0 diverses causes ind\\u00e9pendantes de notre volont\\u00e9. Il se peut que quelque chose ne soit pas configur\\u00e9 comme vous le souhaitez, mais nous ne savons pas si cette configuration est correcte ou incorrecte (nous ne pouvons pas lire dans vos pens\\u00e9es... pour l\\u0027instant).\",\"user_try_access\":\"Si l\\u0027utilisateur avait tent\\u00e9 d\\u0027acc\\u00e9der au centre en dehors des heures d\\u0027ouverture, il n\\u0027aurait pas \\u00e9t\\u00e9 autoris\\u00e9 \\u00e0 y entrer.\",\"set_center\":\"Pour d\\u00e9finir les heures d\\u0027ouverture de votre centre, ainsi que les jours de fermeture, vous devez vous rendre sur %link%.\",\"need_information\":\"Si vous avez besoin de plus d\\u0027informations, l\\u0027article suivant vous aidera :\",\"access_control_settings\":\"Param\\u00e8tres de contr\\u00f4le d\\u0027acc\\u00e8s\",\"set_center_opening_hours\":\"D\\u00e9finir les heures d\\u0027ouverture et les jours f\\u00e9ri\\u00e9s du centre\",\"settings_link\":\"Param\\u00e8tres\\u003E G\\u00e9n\\u00e9ral\\u003E Heures locales et jours ferm\\u00e9s\",\"review_entry_access_gap\":\"Vous pouvez consulter et modifier les param\\u00e8tres g\\u00e9n\\u00e9raux d\\u0027acc\\u00e8s dans le module Param\\u00e8tres, ainsi que les param\\u00e8tres sp\\u00e9cifiques aux activit\\u00e9s et aux cours.\",\"reader_not_activate\":\"Lecteur non activ\\u00e9 pour cet abonnement.\",\"outside_membership_schedule\":\"En dehors du calendrier de l\\u0027abonnement\",\"no_booking_access\":\"Il n\\u0027y a pas de r\\u00e9servation donnant acc\\u00e8s \\u00e0 ce moment-l\\u00e0.\",\"facility_reader_activated\":\"Le lecteur n\\u0027est pas activ\\u00e9 dans l\\u0027\\u00e9tablissement.\",\"activity_not_block_facility\":\"L\\u0027activit\\u00e9 ne bloque pas une installation dont le lecteur est activ\\u00e9.\",\"course_not_block_facility\":\"Le cours ne bloque pas une installation lorsque le lecteur est activ\\u00e9.\",\"review_venue_schedule\":\"Vous pouvez consulter et modifier le calendrier des installations dans  %link%\",\"venues_link\":\"Contr\\u00f4le d\\u0027acc\\u00e8s \\u003E Ressources \\u003E Installations\",\"controller\":\"Controller\",\"controllers\":\"Controllers\",\"add_controller\":\"Ajouter un contr\\u00f4leur\",\"edit_controller\":\"\\u00c9diter un contr\\u00f4leur\",\"new_controller\":\"Nouveau contr\\u00f4leur\",\"save_controller\":\"Le contr\\u00f4leur a \\u00e9t\\u00e9 sauvegard\\u00e9 avec succ\\u00e8s !\",\"update_controller_settings\":\"mettre \\u00e0 jour les param\\u00e8tres du controller\",\"controller_identifier\":\"Identifiant du controller\",\"turn_off\":\"\\u00c9teindre\",\"show_access\":\"Voir acc\\u00e8s\",\"last_records\":\"Derniers enregistrements\",\"error\":{\"create_card\":\"Erreur lors de la cr\\u00e9ation de la carte de contr\\u00f4le d\\u0027acc\\u00e8s\",\"fetch_controllers\":\"Erreur dans l\\u0027extraction des contr\\u00f4leurs\",\"save_controller\":\"Erreur de sauvegarde du contr\\u00f4leur\",\"fetch_timetable_profiles\":\"Erreur dans l\\u0027extraction des profils horaires\",\"save_timetable_profile\":\"Erreur de sauvegarde du profil horaire\",\"delete_timetable_profile\":\"Erreur lors de la suppression d\\u0027un profil horaire\"},\"add_reader\":\"Ajouter un lecteur\",\"new_reader\":\"Nouveau lecteur\",\"edit_reader\":\"\\u00c9diter lecteur\",\"save_reader\":\"Enregistrer le lecteur\",\"delete_reader\":\"Supprimer le lecteur\",\"get_reader_log\":\"Afficher l\\u0027historique du lecteur\",\"get_persistent_reader_log\":\"Obtenir l\\u0027historique persistant du lecteur\",\"delete_persistent_reader_log\":\"Supprimer l\\u0027historique persistant du lecteur\",\"\":\"Supprimer le journal persistant des lecteurs\",\"user_has_no_access_to_reader\":\"L\\u0027utilisateur n\\u0027a pas acc\\u00e8s pour le moment au lecteur s\\u00e9lectionn\\u00e9. \\u00cates-vous s\\u00fbr de vouloir autoriser l\\u0027acc\\u00e8s ?\",\"location_type\":\"Type de localisation\",\"board_model\":\"Mod\\u00e8le de plaque\",\"relay_to_activate\":\"Relais pour activ\\u00e9\",\"before_minutes\":\"Avant %n_minutes% minutes\",\"after_minutes\":\"Apr\\u00e8s %n_minutes% minutes\",\"save_reader_successfully\":\"Lecteur sauvegard\\u00e9 avec succ\\u00e8s !\",\"delete_reader_successfully\":\"Lecteur supprim\\u00e9 avec succ\\u00e8s !\",\"reverse_msb_to_lsb\":\"Inverser MSB vers LSB\",\"milliseconds\":\"millisecondes\",\"restart_access_control\":\"Pour appliquer ces changements, il est n\\u00e9cessaire de red\\u00e9marrer le service de contr\\u00f4le d\\u0027acc\\u00e8s. L\\u0027op\\u00e9ration ne prendra pas plus d\\u0027une minute.\",\"restart_now\":\"Voulez-vous red\\u00e9marrer le service maintenant ?\",\"add_profile\":\"Ajouter un profil\",\"new_timetable_profile\":\"Nouveau profil horaire\",\"edit_timetable_profile\":\"\\u00c9diter profil horaires\",\"save_timetable_profile\":\"Enregistrer le profil horaire\",\"save_edit_schedule\":\"Sauvegarder et modifier l\\u0027horaire\",\"edit_profile\":\"\\u00c9diter profil\",\"delete_timetable_profile\":\"\\u00c9liminer profil\",\"add_timetable_profile_information_text\":\"Cr\\u00e9er des horaires sp\\u00e9ciaux pour permettre aux non-abonn\\u00e9s d\\u0027acc\\u00e9der au centre (par exemple, un accompagnateur pour un enfant qui suit un cours) ou aux utilisateurs ayant des besoins particuliers d\\u0027ouvrir d\\u0027autres portes (par exemple, une poussette qui ne peut pas passer par un tourniquet).\",\"timetable_profile_saved\":\"Enregistrement r\\u00e9ussi du profil horaire\",\"timetable_profile_deleted\":\"Profil horaire supprim\\u00e9 avec succ\\u00e8s\",\"provider\":{\"nr\":\"NR\",\"digitek\":\"Digitek\",\"dasnano\":\"Das Nano\",\"veridas\":\"Veridas\",\"doelectric\":\"Doelectric\",\"kimaldi\":\"Kimaldi\"},\"generic_usb\":\"USB G\\u00e9n\\u00e9rique\",\"relay_model\":\"Model de relais\",\"no_board\":\"Pas de carte de relais\",\"relay\":{\"old_4_pin\":\"Plaque de relais ancienne \\u00e0 4 pins\",\"3_pin\":\"Plaque de relais \\u00e0 3 pins\",\"4_pin\":\"Plaque de relais \\u00e0 4 pins\",\"8_pin\":\"Plaque de relais \\u00e0 8 pins\"},\"authentication\":{\"rfid\":\"RFID\",\"barcode\":\"Code barre\",\"fingerprint\":\"Empreinte\",\"facial\":\"Facial\"},\"attendance_entrance_reader\":\"Vous ne pouvez pas enregistrer la pr\\u00e9sence depuis un lecteur de sortie.\",\"unattendance_exit_reader\":\"Vous ne pouvez pas d\\u00e9cocher la pr\\u00e9sence pour un %readerType%.\",\"unattendance_main_exit_reader\":\"Ce lecteur correspond \\u00e0 la sortie principale ; la non-pr\\u00e9sence est synchronis\\u00e9e avec le r\\u00e9glage du contr\\u00f4le d\\u0027acc\\u00e8s et ne peut pas \\u00eatre modifi\\u00e9e ind\\u00e9pendamment.\"},\"mremittances\":{\"name\":\"Nom\",\"date\":\"Date\",\"amount\":\"Montant\",\"originalAmount\":\"Montant original\",\"charged\":\"Montant re\\u00e7u\",\"refunded\":\"Montant non pay\\u00e9s\",\"refunded_or_not_charged\":\"Rembours\\u00e9 \\/ Non factur\\u00e9\",\"actions\":\"Actions\",\"new_remittance\":\"Nouveau pr\\u00e9l\\u00e8vement\",\"manage_refunds\":\"G\\u00e9rer les rejets\",\"payment_reference\":\"R\\u00e9f\\u00e9rence du paiement\",\"beginning_time\":\"Depuis le d\\u00e9but\",\"download_remittance_summary\":\"T\\u00e9l\\u00e9charger le r\\u00e9sum\\u00e9 des pr\\u00e9l\\u00e8vements\",\"refund_remittance_items\":\"Articles rembourser dans les pr\\u00e9l\\u00e8vements\",\"go_back\":\"Revenir en arri\\u00e8re\",\"great_get_started\":\"Parfait, commen\\u00e7ons\",\"payments_to_refund\":\"Paiements \\u00e0 rembourser\",\"select_dates\":\"S\\u00e9lectionner les dates des paiements programm\\u00e9s\",\"new_remittance_wizard\":[\"Nouveau pr\\u00e9l\\u00e8vement\",\"Paiements\",\"R\\u00e9sum\\u00e9\"],\"remittance_name\":\"Nom du fichier\",\"create_new_remittance\":\"Vous allez cr\\u00e9er un nouveau pr\\u00e9l\\u00e8vement\",\"what_do_you_want_to_remit\":\"Que souhaitez-vous inclure dans ce pr\\u00e9l\\u00e8vement?\",\"what_memberships_do_you_want_to_remit\":\"Quels abonnements souhaitez-vous pr\\u00e9lever?\",\"pending_payments_until\":\"Inclure tous les paiements en attente ant\\u00e9rieurs \\u00e0 la date s\\u00e9lectionn\\u00e9e ci-dessous\",\"scheduled_payments_from\":\"Paiements pr\\u00e9vus d\\u00e8s\",\"scheduled_payments_until\":\"Paiements pr\\u00e9vus jusqu\\u0027\\u00e0\",\"execution\":\"Ex\\u00e9cution\",\"execution_date\":\"Date d\\u0027ex\\u00e9cution\",\"remittance_of\":\"Pr\\u00e9l\\u00e8vement du\",\"number_charges\":\"Nombre de pr\\u00e9l\\u00e8vements\",\"bank_account\":\"Compte bancaire\",\"remittance_data\":\"Donn\\u00e9es des pr\\u00e9l\\u00e8vements\",\"remittance_payments\":\"Paiements pr\\u00e9lev\\u00e9s\",\"select_all_memberships_to_remit\":\"S\\u00e9lectionnez tout les abonnements que vous souhaitez prelever\",\"scheduled_payments_table\":\"Paiements pr\\u00e9vus dans ce pr\\u00e9l\\u00e8vement\",\"remittance_payments_table\":\"Paiements dans ce pr\\u00e9l\\u00e8vement\",\"memberships_to_remit\":\"Abonnements \\u00e0 pr\\u00e9lever\",\"memberships_remitted\":\"Abonnements pr\\u00e9lev\\u00e9s\",\"create_the_remittance\":\"Cr\\u00e9er un nouveau pr\\u00e9l\\u00e8vement\",\"check_the_data\":\"V\\u00e9rifier les donn\\u00e9es\",\"download_file\":\"T\\u00e9l\\u00e9charger le fichier\",\"set_paid\":\"Marquer comme pay\\u00e9\",\"mark_as_denied\":\"Marquer comme rejet\\u00e9\",\"mark_as_unpaid\":\"Marquer comme impay\\u00e9\",\"paid_date\":\"Date de reception du paiement\",\"refunded_date\":\"Date de remboursement\",\"mark_items_as_paid_title\":\"S\\u00e9lectionnez les paiements qui doivent \\u00eatre marqu\\u00e9s comme pay\\u00e9s\",\"action_unpaid_payments\":\"%paid_payments% paiements ont \\u00e9t\\u00e9 marqu\\u00e9s comme pay\\u00e9s. Que voulez-vous faire avec %not_paid_payments% non pay\\u00e9s ?\",\"unpaid_actions_text\":\"Vous pouvez g\\u00e9rer les paiements s\\u00e9lectionn\\u00e9s, ils dispara\\u00eetront au fur et \\u00e0 mesure.\",\"mark_items_as_refunded_title\":\"S\\u00e9lectionnez les paiements qui doivent \\u00eatre marqu\\u00e9s comme rembours\\u00e9s\",\"action_refund_payments\":\"Que voulez-vous faire avec ces %refunded_items% paiements rembours\\u00e9s ?\",\"refund_actions_text\":\"Vous pouvez ex\\u00e9cuter des actions sur les paiements rembours\\u00e9s. Au fur et \\u00e0 mesure que les actions sont appliqu\\u00e9es, ces lignes dispara\\u00eetront.\",\"reschedule\":\"Reprogrammer\",\"set_as_unpaid\":\"Marquer comme impay\\u00e9\",\"execute\":\"Ex\\u00e9cuter\",\"import_remittance_file_button\":\"Fichier de d\\u00e9claration des remises import\\u00e9es\",\"import_remittance_file\":\"Ici, vous pouvez importer le fichier de d\\u00e9claration de remise (format XML ou CODA):\",\"error_importing_remittance_return_file\":\"Il y a eu une erreur lors de l\\u0027importation du fichier ou le fichier n\\u0027est pas valide. V\\u00e9rifiez que le fichier t\\u00e9l\\u00e9charg\\u00e9 est le bon. Extensions valides : XML et COD\",\"remittance_return_payments_in_remittance\":\"Les paiements %num_payments% ont \\u00e9t\\u00e9 trouv\\u00e9s dans le fichier et ils ont \\u00e9t\\u00e9 d\\u00e9coch\\u00e9s de la liste.\",\"remittance_return_payments_in_completed_remittance\":\"%num_payments% les paiements ont \\u00e9t\\u00e9 trouv\\u00e9s dans le dossier et ont \\u00e9t\\u00e9 v\\u00e9rifi\\u00e9s dans la liste.\",\"remittance_return_payments_not_in_remittance\":\"%num_payments% Les paiements du fichier n\\u0027ont pas \\u00e9t\\u00e9 trouv\\u00e9s dans ce versement.\",\"remittance_return_payments_no_payments_to_select\":\"Il n\\u0027y a pas de paiement \\u00e0 s\\u00e9lectionner.\",\"remittance_file_not_of_remittance\":\"Le fichier t\\u00e9l\\u00e9charg\\u00e9 n\\u0027est pas un fichier valide pour ce pr\\u00e9l\\u00e8vement.\",\"no_creditor_identifier_warning_title\":\"Identifiant cr\\u00e9ancier sepa requis\",\"no_creditor_identifier_warning_text\":\"Ce compte bancaire n\\u0027a pas d\\u0027identifiant cr\\u00e9ancier sepa configur\\u00e9. Cet identifiant est obligatoire pour le traitement des transferts de fonds. Vous devez demander \\u00e0 votre banque un identifiant cr\\u00e9ancier sepa et le configurer dans Param\\u00e8tres \\u003E G\\u00e9n\\u00e9ral \\u003E Param\\u00e8tres Financier \\u003E Comptes bancaires.\",\"refund_remittance_action_text\":\"Vous pouvez ex\\u00e9cuter des actions sur les paiements s\\u00e9lectionn\\u00e9s. Au fur et \\u00e0 mesure de l\\u0027ex\\u00e9cution des actions, les paiements s\\u00e9lectionn\\u00e9s disparaissent.\",\"only_new_remittances_have_data\":\"Seulement visibles les donn\\u00e9es des pr\\u00e9l\\u00e8vements cr\\u00e9\\u00e9s apr\\u00e8s %update_date%\",\"check_uncheck_all\":\"Cocher\\/ D\\u00e9cocher\",\"paidStatus\":{\"1\":\"En attente\",\"2\":\"En cours de paiement\",\"3\":\"Compl\\u00e9t\\u00e9\"},\"save_remittance_error\":{\"1\":\"Paiements manquants\",\"2\":\"Le montant du pr\\u00e9l\\u00e8vement est vide\",\"3\":\"Vous avez choisi une version de fichier SEPA non valide.\",\"4\":\"Les informations financi\\u00e8res du compte bancaire sont incompl\\u00e8tes\",\"5\":\"La date de paiement n\\u0027est pas valide.\",\"6\":\"Le pr\\u00e9l\\u00e8vement est d\\u00e9j\\u00e0 en cours\",\"7\":\"Le nom l\\u00e9gal de l\\u0027application est vide\"},\"error_creating_remittance\":\"Erreur de cr\\u00e9ation du pr\\u00e9l\\u00e8vement\",\"error_saving_remittance\":\"Le pr\\u00e9l\\u00e8vement ne peut pas \\u00eatre sauvegard\\u00e9\",\"resolve_bank_details\":\"Certains des adh\\u00e9rents s\\u00e9lectionn\\u00e9s ont des coordonn\\u00e9es bancaires non valables. Corrigez-les et essayez de cr\\u00e9er \\u00e0 nouveau le virement\",\"iban_bic_not_belong\":\"L\\u0027IBAN et le BIC ne se correspondent pas\",\"invalid_values_remittance\":\"Invalide %invalid_values%.\",\"admin_invalid_values\":\"Le %invalid_values% pour le compte s\\u00e9lectionn\\u00e9 n\\u0027est pas valable. Vous pouvez le modifier dans param\\u00e8tres financiers.\",\"admin_iban_bic_not_belong\":\"L\\u0027IBAN et le BIC du compte s\\u00e9lectionn\\u00e9 ne correspondent pas. Vous pouvez les modifier dans ses param\\u00e8tres financiers.\",\"missingBankAccount\":\"Le compte bancaire est manquant. Vous pouvez d\\u00e9finir les d\\u00e9tails de votre compte bancaire dans les param\\u00e8tres financiers.\",\"missingIban\":\"L\\u0027IBAN est manquant. Vous pouvez d\\u00e9finir vos coordonn\\u00e9es bancaires dans les param\\u00e8tres financiers.\",\"missingBic\":\"Le BIC est manquant. Vous pouvez d\\u00e9finir vos coordonn\\u00e9es bancaires dans les param\\u00e8tres financiers.\",\"missingCi\":\"L\\u0027identifiant cr\\u00e9ancier Sepa est manquant. Vous pouvez d\\u00e9finir vos coordonn\\u00e9es bancaires dans les param\\u00e8tres financiers.\",\"missingLegalName\":\"Le nom l\\u00e9gal est manquant. Vous pouvez le d\\u00e9finir dans les param\\u00e8tres financiers.\",\"missingCurrency\":\"Votre devise est inconnue. Vous pouvez choisir une devise dans les param\\u00e8tres financiers.\",\"error_in_sepa_file_creation\":\"Une erreur s\\u0027est produite lors de la cr\\u00e9ation du fichier SEPA.\",\"go_general_finnantial_settings\":\"Allez dans param\\u00e8tres financiers g\\u00e9n\\u00e9raux\",\"error_creditor_identifier_text\":{\"1\":\"num\\u00e9ro ICS manquant\",\"2\":\"Pour cr\\u00e9er un pr\\u00e9l\\u00e8vement, il est n\\u00e9cessaire d\\u0027introduire l\\u0027identifiant du cr\\u00e9ancier SEPA.\",\"3\":\"Si vous ne le connaissez pas, contactez votre banque pour l\\u0027obtenir.\",\"4\":\"Allez dans Param\\u00e8tres \\u003E Param\\u00e8tres financiers g\\u00e9n\\u00e9raux \\u003E Comptes bancaires, et dans le compte bancaire o\\u00f9 vous voulez recevoir le pr\\u00e9l\\u00e8vement, entrez l\\u0027identifiant.\"},\"remittance_cannot_be_mark_as_paid\":\"Le pr\\u00e9l\\u00e8vement ne peut \\u00eatre marqu\\u00e9 comme pay\\u00e9\",\"remittance_file_not_downloaded_dialog_text\":\"Vous ne pouvez pas marquer ce pr\\u00e9l\\u00e8vement comme pay\\u00e9 car vous n\\u0027avez pas t\\u00e9l\\u00e9charg\\u00e9 le fichier \\u00e0 envoyer \\u00e0 votre banque. Vous devez d\\u0027abord t\\u00e9l\\u00e9charger le fichier de pr\\u00e9l\\u00e8vement.\",\"remittance_cannot_be_mark_as_paid_invalid_date\":\"Vous ne pouvez pas marquer ce pr\\u00e9l\\u00e8vement comme pay\\u00e9 avant %min_date%\",\"error_get_remittance_payments\":{\"1\":\"Ce pr\\u00e9l\\u00e8vement est en cours de paiement. Ces informations ne peuvent \\u00eatre t\\u00e9l\\u00e9charg\\u00e9es durant le processus. Veuillez patienter quelques minutes.\"},\"summary_grouped_by_concept\":\"Agroup\\u00e9s par concept\",\"summary_all_charges\":\"Toutes les charges\",\"payments_in_remittance\":\"Paiements dans %remittance_name%\",\"scheduled_payments_in_remittance\":\"Paiements programm\\u00e9s dans %remittance_name%\",\"manage_remittance_refunds\":\"G\\u00e9rer les rejets de %remittance_name%\",\"set_remittance_paid\":\"Indiquer %remittance_name%  payer\",\"select_paid_date\":\"S\\u00e9lectionnez la date de paiement pour les paiements de ce pr\\u00e9l\\u00e8vement :\",\"delete_refund_remittance\":\"\\u00cates-vous s\\u00fbr de vouloir supprimer ce remboursement ? Cette action ne peut \\u00eatre annul\\u00e9e.\",\"include_unpaids\":\"Inclure les impay\\u00e9s?\",\"not_refundable_remittance\":\"Ce pr\\u00e9l\\u00e8vement n\\u0027a pas de paiement en attente de remboursement.\",\"question_reminder_creating_the_remittance\":\"Que va-t-il se passer ?\",\"paragraph_reminder_creating_the_remittance\":{\"1\":\"Tout d\\u0027abord, nous devons nous assurer que la m\\u00e9thode par d\\u00e9faut des utilisateurs que nous voulons envoyer est \\u0027Pr\\u00e9l\\u00e8vements\\u0027\",\"2\":\"Dans l\\u0027\\u00e9tape suivante, vous pouvez choisir ce que vous voulez pr\\u00e9lever (abonnements, frais,...).\",\"3\":\"Une fois l\\u0027op\\u00e9ration termin\\u00e9e, un fichier sera g\\u00e9n\\u00e9r\\u00e9 et vous devrez l\\u0027envoyer \\u00e0 votre banque.\",\"4\":\"Tant que vous ne l\\u0027envoyez pas et que vous indiquez que le pr\\u00e9l\\u00e8vement s\\u0027est bien d\\u00e9roul\\u00e9e, les paiements resteront en suspens\"},\"text_reminder_creating_the_remittance\":\"Rappelez-vous : vous pouvez mettre l\\u0027application en mode test et effectuer un test sans \\u0027affecter\\u0027 \\u00e0 quoi que ce soit.\",\"do_not_show_more\":\"Ne plus afficher cette publicit\\u00e9\",\"question_creating_the_remittance\":\"Que se passera-t-il lors de la cr\\u00e9ation du pr\\u00e9l\\u00e8vement ?\",\"include_unpaids_subtext\":\"Seuls les montants impay\\u00e9s des types de paiements que vous avez s\\u00e9lectionn\\u00e9s sont inclus\",\"cannot_select_memberships\":\"Vous ne pouvez pas pr\\u00e9lev\\u00e9s ces abonnements si vous ne s\\u00e9lectionnez pas l\\u0027un des \\u00e9l\\u00e9ments suivants  %category_name%\",\"paragraph_creating_the_remittance\":{\"1\":\"Le fichier sera cr\\u00e9\\u00e9 pour \\u00eatre envoy\\u00e9 \\u00e0 votre banque. Ne vous inqui\\u00e9tez pas, vous pouvez le supprimer sans rien facturer et sans qu\\u0027il ne se passe quoi que ce soit.\",\"2\":\"Les frais passent \\u00e0 l\\u0027\\u00e9tat \\u0027En cours de pr\\u00e9l\\u00e8vement\\u0027.\",\"3\":\"Une fois que vous avez re\\u00e7u le versement \\u00e0 votre banque, n\\u0027oubliez pas de le marquer comme pay\\u00e9 afin d\\u0027\\u00e9viter que des paiements soient marqu\\u00e9s comme impay\\u00e9s.\"}},\"mwods\":{\"wod\":\"WOD\",\"wods\":\"Wods\",\"new_wod\":\"Nouveau Wod\",\"new_benchmark\":\"Nouvelle r\\u00e9f\\u00e9rence\",\"workout\":\"Workout\",\"new_wod_wizard\":[\"Info\",\"Options\"],\"wod_formats\":\"Formats\",\"wod_name\":\"Nom\",\"rx\":\"Rx\",\"scale\":\"Scale\",\"girls\":\"Girls\",\"wod_exercises\":\"Exercices\",\"select_activity\":\"Choisissez une activit\\u00e9\",\"no_activities\":\"Il n\\u0027y a pas d\\u0027activit\\u00e9 \\u00e0 cette date\",\"show_wod_always\":\"Toujours montrer cet entra\\u00eenement\",\"hide_wod_until_finished\":\"Cacher cet entra\\u00eenement aux utilisateurs jusqu\\u0027\\u00e0 ce qu\\u0027ils l\\u0027aient termin\\u00e9.\",\"show_wod_from_scheduled_day\":\"Montrer cet entra\\u00eenement  le jour de l\\u0027entra\\u00eenement  et apr\\u00e8s\",\"show_to_all_users\":\"Montrer \\u00e0 tous les adh\\u00e9rents\",\"show_to_attending_users\":\"Ne montrer qu\\u0027aux adh\\u00e9rents qui assistent aux activit\\u00e9s\",\"no_exercise_selected\":\"Choisissez au moins 1 exercice\",\"todays_workout\":\"Workout of the day\",\"workouts_for_date\":\"WOD du %date%\",\"no_workouts_planned\":\"Aucun Wod planifi\\u00e9\",\"delete_wod_confirm\":\"Etes-vous s\\u00fbr de vouloir supprimer ce Wod?\",\"warm_up\":\"Warm up\",\"cash_out\":\"Cash out\",\"instructions\":\"Instructions\",\"wod_favorite\":\"Marquer comme favoris pour le r\\u00e9utiliser plus tard\",\"select_benchmark\":\"Rechercher un benchmark (Girls, Heroes...)\",\"select_exercise\":\"Rechercher un exercice\",\"benchmark\":\"Benchmark\",\"skill_strength\":\"Skill \\/ Strength\",\"mandatory\":\"Obligatoire\",\"optional\":\"Optionnel\",\"kilograms_abrev\":\"kg\",\"meters_abrev\":\"m\",\"minutes_abrev\":\"min.\",\"skill\":\"Skill\",\"strength\":\"Strength\",\"these_tags_will_be_added\":\"Les exercices ci-dessous ont \\u00e9t\\u00e9 reconnus. Vous pouvez en ajouter d\\u0027autre manuellement ou en retirer.\",\"select_scoring_method\":\"Format des r\\u00e9sultats\",\"exercise_missing\":\"Il manque un mouvement? R\\u00e9clamez-le ici\",\"category_name\":{\"1\":\"Competitions\",\"2\":\"Girls\",\"3\":\"Gymnastics\",\"4\":\"Heroes\",\"5\":\"Endurance\",\"6\":\"Notables\",\"7\":\"Weightlifting\",\"8\":\"Autre\",\"9\":\"Favoris\"},\"result_format\":{\"reps\":\"Reps\",\"rounds\":\"Rounds\",\"time\":\"Temps\",\"weight\":\"Poids\",\"distance\":\"Distance\",\"text\":\"Texte\"},\"no_benchmarks\":\"Aucun benchmark pr\\u00e9vu pour aujourd\\u0027hui\",\"no_benchmark_results\":\"Pas de r\\u00e9sultats pour le moment\",\"create_edit_competition_wizard\":[\"Informations g\\u00e9n\\u00e9rales\",\"Cat\\u00e9gories\",\"Wods\"],\"weightlifting\":\"Weightlifting\",\"strongman\":\"Strongman\",\"gymnastics\":\"Gymnastics\",\"other\":\"Autres\",\"cardio\":\"Cardio\",\"yoga\":\"Yoga\",\"conditioning\":\"Conditioning\",\"nutrition\":\"Nutrition\"},\"mtickets\":{\"tickets\":\"Tickets\",\"tickets_not_used\":\"Tickets non utilis\\u00e9s\",\"ticket_schedule\":\"Calendrier des tickets\",\"add_ticket_by_card_title\":\"Ajouter un ticket en scannant son QR code\",\"cannot_refund\":\"Ce ticket ne peut pas \\u00eatre rembours\\u00e9\",\"error\":{\"fetch_ticket_user\":\"Erreur dans la recherche du ticket de l\\u0027utilisateur\",\"fetch_tickets_not_used\":\"Erreur dans la recherche de tickets non utilis\\u00e9s\",\"fetch_uses_by_user\":\"Erreur dans la recherche d\\u0027utilisations de tickets par l\\u0027utilisateur\",\"fetch_latest_used\":\"Erreur dans la recherche des derniers tickets utilis\\u00e9s\",\"use_ticket\":\"Erreur lors de l\\u0027utilisation du ticket\",\"check_ticket\":\"Erreur de v\\u00e9rification du ticket\",\"send_email\":\"Erreur dans l\\u0027envoi de l\\u0027email du ticket\",\"prepare_refund\":\"Erreur dans la pr\\u00e9paration de la transaction de remboursement\",\"refund\":\"Erreur de remboursement du re\\u00e7u\",\"remove_use\":\"Erreur lors de l\\u0027\\u00e9limination de l\\u0027utilisation d\\u0027un ticket\"},\"ticket_use_used_successfully\":\"L\\u0027utilisation d\\u0027un ticket a \\u00e9t\\u00e9 correctement enregistr\\u00e9e\"},\"msocial\":{\"social\":\"Social\",\"metricool_not_set\":\"Le module social n\\u0027est pas encore configur\\u00e9. Si vous souhaitez y acc\\u00e9der, cliquez ici pour demander un acc\\u00e8s.\",\"metricool_ask_for_metricool_access\":\"Bonjour ! Je voudrais avoir acc\\u00e8s au module social. S\\u0027il vous pla\\u00eet, pouvez-vous nous l\\u0027activer ? Merci d\\u0027avance.\"},\"mplanner\":{\"planner\":\"Trhade\",\"asigned\":\"Assign\\u00e9\",\"wods\":\"WODS\",\"pattern\":\"Motif\",\"muscles\":\"Muscles\",\"know_as\":\"\\u00c9galement connu sous le nom de\",\"mov