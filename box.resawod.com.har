ssfit_sg\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitSG\"}},{\"id_application\":null,\"id_lead\":\"2920\",\"name\":\"Crossfit Trocadero\",\"description\":\"Nuestro box dispone de 450 m2 di\\u00e1fanos, unas instalaciones y materiales totalmente nuevos disponibles para la practica del crossfit.\\n\\nPor nuestro origen, ofrecemos otras actividades como entrenamiento funcional y en suspensi\\u00f3n, entre otras, en las que estamos altamente especializados.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2920\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2920\\/featured_images\\/16388413_1044743198962924_6141980802260736335_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2920\\/featured_images\\/17203034_1077037039066873_6267692682967960232_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2920\\/featured_images\\/ElPuerto-1.jpg\"],\"address\":{\"street\":\"C\\/Finlandia nave 12\",\"town\":\"Puerto Real\",\"postal_code\":\"11519\",\"country\":\"Spain\"},\"location\":{\"latitude\":36.5367681,\"longitude\":-6.2431889},\"contact_info\":{\"email\":\"crossfitrocadero@gmail.com\",\"phone\":\"600354652\"},\"social_media\":{\"instagram\":\"crossfit_trocadero\",\"facebook\":\"@crossfitrocadero\"}},{\"id_application\":\"26146227\",\"id_lead\":null,\"name\":\"Kastell Paol Crossfit\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/26146227\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"39 Av. des Carmes\",\"town\":\"Saint-Pol-de-L\\u00e9on\",\"postal_code\":\"29250\",\"country\":\"France\"},\"location\":{\"latitude\":48.6805015,\"longitude\":-3.9940282},\"contact_info\":{\"email\":\"kastellpaol_cf@nubapp-clients.com\",\"phone\":\"0648156945\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":\"96597861\",\"id_lead\":null,\"name\":\"Crossfit Strong Bear\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/96597861\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/96597861\\/featured_images\\/54434741_378661972980813_8010252416656080896_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/96597861\\/featured_images\\/54728079_380128579500819_313880633807994880_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/96597861\\/featured_images\\/54798317_380124069501270_3642864558931968000_o.jpg\"],\"address\":{\"street\":\"Rue\",\"town\":\"Beauvais\",\"postal_code\":\"60000\",\"country\":\"France\"},\"location\":{\"latitude\":49.4598789,\"longitude\":2.048572},\"contact_info\":{\"email\":\"contact@crossfitstrongbear.fr\",\"phone\":\"0695543282 \\/ 0632286203\"},\"social_media\":{\"instagram\":\"crossfit_strong_bear\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitStrongBear\"}},{\"id_application\":null,\"id_lead\":\"2889\",\"name\":\"Crossfit Zwickau\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2889\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2889\\/featured_images\\/1542692291.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2889\\/featured_images\\/image-1.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2889\\/featured_images\\/image-2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2889\\/featured_images\\/image-3.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2889\\/featured_images\\/image.jpg\"],\"address\":{\"street\":\"Saarstra\\u00dfe 21\",\"town\":\"Zwickau\",\"postal_code\":\"08056\",\"country\":\"Germany\"},\"location\":{\"latitude\":50.7066756,\"longitude\":12.4891274},\"contact_info\":{\"email\":\"info@crossfit-zwickau.de\",\"phone\":\"+49 37528332264\"},\"social_media\":{\"instagram\":\"crossfitzwickau\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitzwickau\"}},{\"id_application\":\"91149637\",\"id_lead\":null,\"name\":\"Gorilla Squad CrossFit\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/91149637\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/91149637\\/featured_images\\/64521a6272ede.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/91149637\\/featured_images\\/645227b5aa035.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/91149637\\/featured_images\\/645229ac05d16.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/91149637\\/featured_images\\/Waiblingen%20LOGO%20APP.jpg\"],\"address\":{\"street\":\"Industriestra\\u00dfe 18\",\"town\":\"Winterbach\",\"postal_code\":\"73650\",\"country\":\"Deutschland\"},\"location\":{\"latitude\":48.8293519,\"longitude\":9.3185739},\"contact_info\":{\"email\":\"info@crossfitwaiblingen.de\",\"phone\":\"+4915170026364\"},\"social_media\":{\"instagram\":\"gorillasquadcrossfit\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossfitWaiblingen\"}},{\"id_application\":null,\"id_lead\":\"2543\",\"name\":\"CrossFit Villa Albani\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2543\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2543\\/featured_images\\/10866269_926906687343565_5286501624077604972_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2543\\/featured_images\\/11069631_1053124868055079_7078464199974212177_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2543\\/featured_images\\/11990409_1036604693040430_4069279584180914338_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2543\\/featured_images\\/51851946_2282296721804548_2639573800747794432_o.jpg\"],\"address\":{\"street\":\"via Salaria, 105\",\"town\":\"Roma\",\"postal_code\":\"00198\",\"country\":\"Italia\"},\"location\":{\"latitude\":41.9136719,\"longitude\":12.4973388},\"contact_info\":{\"email\":\"crossfitvillalbani@libero.it\",\"phone\":\"+39 06 88 933 115\"},\"social_media\":{\"instagram\":\"crossfitvillalbani\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfit.villaalbani\\/\"}},{\"id_application\":\"63054407\",\"id_lead\":null,\"name\":\"CrossFit Selent\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/63054407\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/63054407\\/featured_images\\/Bild%20App%20CF%20Selent.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/63054407\\/featured_images\\/Bild%20App%20CF%20Selent1.png\"],\"address\":{\"street\":\"Haverkamp 10\",\"town\":\"Selent\",\"postal_code\":\"24238\",\"country\":\"Deutschland\"},\"location\":{\"latitude\":54.2898814,\"longitude\":10.4309121},\"contact_info\":{\"email\":\"crossfitselent@nubapp-clients.com\",\"phone\":\"017662913428\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2590\",\"name\":\"CrossFit Mentana\",\"description\":\"The Sport of Fitness has arrived\\n\\n\\u200bCapovolgi la routine scoprendo una variet\\u00e0 di stimoli che ti faranno cambiare il modo di intendere lo sport.\\nScopri un nuovo modo di allenare il tuo corpo ma anche il tuo spirito. Mettiti alla prova affrontando ogni giorno un allenamento sempre diverso. Vieni a scoprire cosa sei in grado di fare.\\nL\\u0027unico Box con un\\u0027 area per le classi di 500mq e un\\u0027 area per l\\u0027allenamento autonomo di 250mq, entrambe con attrezzatura dedicata e rig separato. \\nSiamo il PRIMO Centro Affiliato CrossFit di Mentana Dove sappiamo far bene una cosa, FARVI ALLENARE!\\n\\n ...Stanco delle solite routine? Stanco di perdere tempo tra una 3x8 ed un 4x10? ...Stanco di non avere risultati reali? CrossFit Mentana non \\u00e8 la solita palestra, ma un ambiente insolito dove allenarsi!!! Siamo come la bottega dietro l\\u0027angolo, con poche cose, magari anche complesse, ma decisamente insuperabili. Quindi non ti aspettare prezzi da Discount del fitness. L\\u0027esperienza ci ha insegnato che bastano gesti semplici e concetti base per farvi toccare con mano RISULTATI TANGIBILI!\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2590\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2590\\/featured_images\\/12238431_796073833836519_309366085277105482_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2590\\/featured_images\\/13308527_894687567308478_4507968026486143213_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2590\\/featured_images\\/19693767_1230722647038300_8835400708854763333_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2590\\/featured_images\\/45805351_1744811158962777_8937449642983948288_o.jpg\"],\"address\":{\"street\":\"Via Enrico Fermi, 10-10A\",\"town\":\"Roma\",\"postal_code\":\"00013\",\"country\":\"Italia\"},\"location\":{\"latitude\":42.0484635,\"longitude\":12.647795},\"contact_info\":{\"email\":\"info@crossfitmentana.com\",\"phone\":\"+39 333.7604061\"},\"social_media\":{\"instagram\":\"crossfitmentana\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitmentana\\/\"}},{\"id_application\":null,\"id_lead\":\"3161\",\"name\":\"Crossfit T\\u00fcbingen\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3161\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3161\\/featured_images\\/eeeb9b_0e6e467bad76450aaf4b9802ca19b963~mv2_d_6000_3376_s_4_2.jpg\",\"https:\\/