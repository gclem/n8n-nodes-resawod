st-1.amazonaws.com\\/applications\\/46918441\\/featured_images\\/14112120_1347161835312128_1943670141_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/46918441\\/featured_images\\/20170526_122817.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/46918441\\/featured_images\\/grillen01.jpg\"],\"address\":{\"street\":\"rue louis joseph gay lussac\",\"town\":\"Colmar\",\"postal_code\":\"68000\",\"country\":\"France\"},\"location\":{\"latitude\":48.1054927,\"longitude\":7.3800765},\"contact_info\":{\"email\":\"crossfitgrillen@gmail.com\",\"phone\":\"0660893209\"},\"social_media\":{\"instagram\":\"crossfitgrillen\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitGrillen\\/?fref=ts\"}},{\"id_application\":\"93104178\",\"id_lead\":null,\"name\":\"The Fitnetics\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/93104178\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/93104178\\/featured_images\\/2023-07-31-09-28-04-603.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/93104178\\/featured_images\\/2023-07-31-09-29-18-751.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/93104178\\/featured_images\\/2023-07-31-09-29-57-587.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/93104178\\/featured_images\\/2023-07-31-09-31-23-624.jpg\"],\"address\":{\"street\":\"Triq Domenico Cachia, 144\",\"town\":\"Birkirkara\",\"postal_code\":\"BKR1010\",\"country\":\"Malta\"},\"location\":{\"latitude\":35.9016845,\"longitude\":14.4547721},\"contact_info\":{\"email\":\"gail@thefitnetics.com\",\"phone\":\"0035679252655 \\/ 0035699875574\"},\"social_media\":{\"instagram\":\"thefitnetics\",\"facebook\":\"thefitnetics\"}},{\"id_application\":null,\"id_lead\":\"2803\",\"name\":\"Isla Blanca Crossfit\",\"description\":\"Diplomado Certificate Level 1, Level 2, CrossFit KIDS, CrossFit Gymnastics, Endurance, Weightlifting,Competitor\\u0027s y Strongman.\\n\\nPara  principiantes ,para todas y todos CrossFitters y Futuros Crossfitters :))a partir de 3 a\\u00f1os...\\n\\nSomos un Box Oficial y Afiliado a CrossFit, no somos un gimnasio tradicional..no utilizamos maquinas ,somos maquinas..\\nCumplimos con los requisitos y las exigencias de la licencia marca REGISTRADA CrossFit \\nHACEMOS LA DIFERENCIA : NO HACEMOS otro derivado del m\\u00e9todo CrossFit..\\nHACEMOS CrossFIT con su diploma, su metodolog\\u00eda, su seguridad, su eficiencia, su eficacia, su profesionalidad y su buena fama...\\n\\nNosotros estamos contentos de ofreceros nuestro box en Ibiza.\\nLa revoluci\\u00f3n en el mundo del fitness..\\nSomos una comunidad en todo el mundo y tenemos ganas de veros al box..\\n\\nOS Esperamos para probar una clase de iniciaci\\u00f3n.\\n\\nSPORT OF FITNESS HAS ARRIVED..see you soon..\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2803\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2803\\/featured_images\\/10568686_10152557097123629_520830079_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2803\\/featured_images\\/CrossFit-6.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2803\\/featured_images\\/facebook-2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2803\\/featured_images\\/isla-blanca-ibiza-crossfit-reserva-fitness-sport-exercices-health-course-cross-fit-espana-spain-horarios-coach-nico-001-1.jpg\"],\"address\":{\"street\":\"Carrer del Music Rafel Zornoza\",\"town\":\"Ibiza\",\"postal_code\":\"07800\",\"country\":\"Spain\"},\"location\":{\"latitude\":38.9022596,\"longitude\":1.4056713},\"contact_info\":{\"email\":\"nico.energyfit@gmail.com\",\"phone\":\"682120196\"},\"social_media\":{\"instagram\":\"crossfit.islablanca.ibiza\",\"facebook\":\"@crossfitislablancaibiza\"}},{\"id_application\":null,\"id_lead\":\"3120\",\"name\":\"CrossFit La Buse\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3120\\/featured_images\\/21199524_1509016049160030_6015068757550691584_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3120\\/featured_images\\/21200823_1509095525818749_8548039254874090532_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3120\\/featured_images\\/41797761_1922338564494441_1836200906765369344_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3120\\/featured_images\\/49203562_2066630020065294_615979493718228992_o.jpg\"],\"address\":{\"street\":\"65 Chemin Piton Leon\",\"town\":\"Saint-Paul\",\"postal_code\":\"97460\",\"country\":\"France\"},\"location\":{\"latitude\":-20.9617834,\"longitude\":55.2963949},\"contact_info\":{\"email\":\"romualdseguin@me.com\",\"phone\":\"+262 693 92 78 59\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitlabuse\\/\"}},{\"id_application\":\"73356085\",\"id_lead\":null,\"name\":\"Crossfit Douai\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/73356085\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Maurice Caullery\",\"town\":\"Douai\",\"postal_code\":\"5950\",\"country\":\"France\"},\"location\":{\"latitude\":50.3943553,\"longitude\":3.0953653},\"contact_info\":{\"email\":\"crossfitdouai@nubapp.com\",\"phone\":\"03 27 76 22 97\"},\"social_media\":{\"instagram\":\"crossfitdouai\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFit-Douai-171585479943656\\/?fref=ts\"}},{\"id_application\":\"83048929\",\"id_lead\":null,\"name\":\"CF Casteu\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/83048929\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazon