social.s3.eu-west-1.amazonaws.com\\/leads\\/2643\\/featured_images\\/44735374_2008817375852548_8312349524219658240_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2643\\/featured_images\\/45831348_2036384476429171_725430859741528064_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2643\\/featured_images\\/49578039_2115816615152623_9042062908736929792_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2643\\/featured_images\\/50035181_2132268520174099_4035819036762701824_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2643\\/featured_images\\/51129479_2138790706188547_849917536173555712_o.jpg\"],\"address\":{\"street\":\"via Spirano 635\",\"town\":\"Bergamo\",\"postal_code\":\"24059\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.592029,\"longitude\":9.6860294},\"contact_info\":{\"email\":\"info@reflexoupside.it\",\"phone\":\"+393283539896\"},\"social_media\":{\"instagram\":\"upsidecrossfit\",\"facebook\":\"https:\\/\\/www.facebook.com\\/AsdReflexoUpside\\/\"}},{\"id_application\":\"24012670\",\"id_lead\":null,\"name\":\"Crossfit 6.15\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/24012670\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"23 Av. du Gulf Stream\",\"town\":\"Pornichet\",\"postal_code\":\"44380\",\"country\":\"France\"},\"location\":{\"latitude\":47.2578079,\"longitude\":-2.3086027},\"contact_info\":{\"email\":\"contact@crossfit615.fr\",\"phone\":\"0788945785\\t\"},\"social_media\":{\"instagram\":\"crossfit6.15\",\"facebook\":\"crossfit6.15\"}},{\"id_application\":null,\"id_lead\":\"2605\",\"name\":\"Crossfit Arctos\",\"description\":\"CrossFit Arctos nasce con il desiderio di portare i benefici del CrossFit nell\\u0027area sud di Milano.\\n\\nDisciplina ancora poco conosciuta, il CrossFit sta diventando sempre pi\\u00f9 famoso per la tipologia di allenamento, che consiste in movimenti funzionali, costantemente variati e ad alta intensit\\u00e0. \\nQuesto significa che allenerete tutto il corpo con circuiti sempre diversi ad alta intensit\\u00e0 e tutto questo in 1 ora.\\n\\nLa nostra palestra sorge tra Rogoredo e San Donato Milanese, a 5\\u0027 a piedi dalle rispettive fermate della M3. Vi invitiamo a provare una lezione per capire di cosa parliamo, perch\\u00e9 crediamo che qualsiasi spiegazione sia superflua, provare per credere!\\n\\nVi aspettiamo.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2605\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2605\\/featured_images\\/40316872_848026605401753_6283683148576325632_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2605\\/featured_images\\/44057803_869282926609454_963599509407924224_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2605\\/featured_images\\/44593723_873250352879378_6949273478818168832_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2605\\/featured_images\\/45235050_878021169068963_4918103747126624256_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2605\\/featured_images\\/52864525_938602766344136_4151741724500164608_o.jpg\"],\"address\":{\"street\":\"Via Privata Fidenza, 1\",\"town\":\"Milano\",\"postal_code\":\"20138\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.4277208,\"longitude\":9.2498038},\"contact_info\":{\"email\":\"asdarctosgym@virgilio.it\",\"phone\":\"+39  3351480912\"},\"social_media\":{\"instagram\":\"crossfit_arctos\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitarctos\\/\"}},{\"id_application\":\"18062116\",\"id_lead\":null,\"name\":\"CrossFit Del\\u00e9mont\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/18062116\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\