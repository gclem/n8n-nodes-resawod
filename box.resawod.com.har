-1.amazonaws.com\\/leads\\/3178\\/featured_images\\/Captura4.PNG\"],\"address\":{\"street\":\"Martin-Behaim-Str. 17\",\"town\":\"Neu-Isenburg\",\"postal_code\":\"63263\",\"country\":\"Germany\"},\"location\":{\"latitude\":50.0471323,\"longitude\":8.7132011},\"contact_info\":{\"email\":\"jens@jabav.de\",\"phone\":\"+49 61023719560\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.instagram.com\\/crossfitjabav\\/\"}},{\"id_application\":null,\"id_lead\":\"2784\",\"name\":\"Crossfit SJD\",\"description\":\"Nuestras instalaciones disponen de casi 600m2 equipados con todo el material necesario para la pr\\u00e1ctica del CrossFit. Material de alta calidad de las marcas Powerkan, Again Faster y SingularWOD, que incluye por ejemplo barras ol\\u00edmpicas, pelotas medicinales, cuerdas para trepar y saltar, anillas, kettlebells y mancuernas, etc. Disponemos de 2 zonas de entrenamientos (WOD\\u2019s y Open) con 2 plataformas con 6 y 5 rack\\u2019s que nos permiten tener muchos espacios para dominadas y muscle-ups. Tambi\\u00e9n disponemos de 2 vestuarios con duchas y de zona comedor.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2784\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2784\\/featured_images\\/SJD-GAMES-2017_0151.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2784\\/featured_images\\/maxresdefault.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2784\\/featured_images\\/mediterranean-games-2016-crossfit.jpg\"],\"address\":{\"street\":\"Vallespir 8\",\"town\":\"Sant Joan Desp\\u00ed\",\"postal_code\":\"08970\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.3714258,\"longitude\":2.0566191},\"contact_info\":{\"email\":\"info@crossfitsjd.com\",\"phone\":\"934773764\"},\"social_media\":{\"instagram\":\"crossfitsjd\",\"facebook\":\"@CrossFitSJD\"}},{\"id_application\":null,\"id_lead\":\"2546\",\"name\":\"CrossFit Trastevere\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2546\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2546\\/featured_images\\/10357249_395512903970379_2873887356362643281_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2546\\/featured_images\\/32871750_876552562533075_8033965171615465472_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2546\\/featured_images\\/43153089_981421562046174_4561532396821807104_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2546\\/featured_images\\/46139850_1001961229992207_6841872173699694592_n.jpg\"],\"address\":{\"street\":\"Viale di Trastevere, 233-237\",\"town\":\"Roma\",\"postal_code\":\"00153\",\"country\":\"Italia\"},\"location\":{\"latitude\":41.8770736,\"longitude\":12.4662116},\"contact_info\":{\"email\":\"info@crossfittrastevere.com\",\"phone\":\"+39 06 580 9174\"},\"social_media\":{\"instagram\":\"cf_trastevere\",\"facebook\":\"https:\\/\\/www.facebook.com\\/Crossfittrastevere\\/\"}},{\"id_application\":\"55894234\",\"id_lead\":null,\"name\":\"Crossfit Le Mans\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/55894234\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/55894234\\/featured_images\\/02.jpeg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/55894234\\/featured_images\\/03.jpeg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/55894234\\/featured_images\\/04.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/55894234\\/featured_images\\/photo-1470240946-448249.jpg\"],\"address\":{\"street\":\"21 avenue du Maine\",\"town\":\"SAINT PAVACE\",\"postal_code\":\"72190\",\"country\":\"France\"},\"location\":{\"latitude\":48.0257661,\"longitude\":0.175868},\"contact_info\":{\"email\":\"contact@crossfitlemans.com\",\"phone\":\"663745039\"},\"social_media\":{\"instagram\":\"crossfitlemans\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitLeMans?fref=ts\"}},{\"id_application\":null,\"id_lead\":\"3098\",\"name\":\"CrossFit Eysines\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3098\\/featured_images\\/24831382_1114052892063518_5919582110752636735_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3098\\/featured_images\\/28698583_1169576346511172_6131787193843844684_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3098\\/featured_images\\/62090284_1510111875790949_28267602136530944_n.jpg\"],\"address\":{\"street\":\"6 Rue Pierre Gauthier\",\"town\":\"Eysines\",\"postal_code\":\"33320\",\"country\":\"France\"},\"location\":{\"latitude\":44.8787226,\"longitude\":-0.6476435},\"contact_info\":{\"email\":\"contact@crossfiteysines.com\",\"phone\":\"+33 6 21 29 30 77\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitEysines\\/\"}},{\"id_application\":null,\"id_lead\":\"2838\",\"name\":\"Room 5 Crossfit\",\"description\":\"L\\u0027\\u00fanic box oficial Crossfit a Manresa\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2838\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2838\\/featured_images\\/512ad7e69616c7783b8045a14e867f0b.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2838\\/featured_images\\/DrYNf_MWsAAQ5Ds.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2838\\/featured_images\\/IMG_0994-1024x683-600x300.jpg\"],\"address\":{\"street\":\"Carrer del Bisbe Torras i Bages, 38\",\"town\":\"Manresa\",\"postal_code\":\"08242\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.7341308,\"longitude\":1.8269399},\"contact_info\":{\"email\":\"info@room5crossfit.com\",\"phone\":\"935484700\"},\"social_media\":{\"instagram\":\"room5crossfit\",\"facebook\":\"@room5crossfit\"}},{\"id_application\":\"17327250\",\"id_lead\":null,\"name\":\"Magic Crossfit\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/17327250\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/17327250\\/featured_images\\/47465532_1059413037553063_5483018287308603392_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/17327250\\/featured_images\\/52993928_1119155558245477_3245367569070161920_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/17327250\\/featured_images\\/54353503_1121340624693637_8559788710470615040_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/17327250\\/featured_images\\/54522223_1127196087441424_5700329261525630976_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/17327250\\/featured_images\\/55465035_1127195990774767_3023196491465359360_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/17327250\\/featured_images\\/logo%20power%20point.png\"],\"address\":{\"street\":\"avenue de Paris\",\"town\":\"Romorantin\",\"postal_code\":\"41200\",\"country\":\"France\"},\"location\":{\"latitude\":47.3761519,\"longitude\":1.7372035},\"contact_info\":{\"email\":\"contact@magic-crossfit.com\",\"phone\":\"0650841945\"},\"social_media\":{\"instagram\":\"magiccrossfit\",\"facebook\":\"https:\\/\\/www.facebook.com\\/magiccrossfit\"}},{\"id_application\":\"17412886\",\"id_lead\":null,\"name\":\"Crossfit Sturmflut\",\"description\":\"Willkommen in Rostocks erster CrossFit Box.\\nWillkommen im Zuhause von CrossFit Sturmflut.\\n\\nDu m\\u00f6chtest an deine Grenzen gehen, suchst eine coole Community \\u0026 mehr als ein normales Fitnessstudio in Rostock?\\n\\nDann bist du bei uns genau richtig!\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/17412886\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/17412886\\/featured_images\\/Fotos%20Sturmflut%201%20.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/17412886\\/featured_images\\/Sturmflut%202%20.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/17412886\\/featured_images\\/Sturmflut%203.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/17412886\\/featured_images\\/Sturmflut%204%20.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/17412886\\/featured_images\\/Sturmflut%205.jpg\"],\"address\":{\"street\":\"Erich-Schlesinger-Str. 62\",\"town\":\"Rostock\",\"postal_code\":\"18059\",\"country\":\"Germany\"},\"location\":{\"latitude\":54.0736239,\"longitude\":12.135722},\"contact_info\":{\"email\":\"mail@crossfit-sturmflut.com\",\"phone\":\"0049 1788213462\"},\"social_media\":{\"instagram\":\"cf_sturmflut\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2606\",\"name\":\"Crossfit NoLo\",\"description\":\"CrossFit NoLo \\u00e8 un box di CrossFit ufficialmente affiliato. La nostra sede \\u00e8 in via Temperanza 6, nel cuore di NoLo, un quartiere vivace e in rapida crescita a nord di piazzale Loreto, a Milano. La metropolitana, vicinissima, \\u00e8 la M1 rossa, fermata Pasteur.\\n\\n\\u003E\\u003E\\u003E Per vivere al meglio l\\u0027esperienza del nostro box, scarica l\\u0027APP CROSSFIT NOLO!  \\u003C\\u003C\\u003C\\n\\n\\u003E\\u003E\\u003E OPEN CROSSFIT GAMES - SCARICA LE INFO  E IL CALENDARIO!  \\u003C\\u003C\\u003C\\n\\nCHE COS\\u2019E\\u2019 IL CROSSFIT\\n\\nIl CrossFit \\u00e8 un\\u2019attivit\\u00e0 innovativa, stimolante e adatta a tutti, che porta ciascuno di noi a confrontarsi ogni volta con le proprie capacit\\u00e0 e a sfidare i propri limiti. Siamo felici di trasmettere questa nostra passione a tutti coloro che vogliano mettersi in forma e migliorare la propria vita.\\n\\n\\u00c8 nato nel 2000 in California dall\\u2019idea di Greg Glassman e Lauren Jenai, che hanno proposto una valida alternativa all\\u2019attivit\\u00e0 routinaria e ripetitiva della maggioranza delle palestre, che a lungo andare perdono attrattivit\\u00e0 ed affezione da parte dei propri iscritti.\\n\\nViceversa, il Crossfit \\u00e8 un modello di allenamento nuovo, in cui l\\u2019attivit\\u00e0 \\u00e8 diversa ad ogni lezione: diverse tipologie di allenamento (ginnastica tradizionale, pesistica, cardio) vengono proposte insieme conferendo variet\\u00e0, oltre che efficacia, agli allenamenti.\\n\\nLe caratteristiche principali che rendono il CrossFit un\\u2019idea unica sono le seguenti:\\n\\n- i movimenti funzionali, che coinvolgono cio\\u00e8 tutte le parti del corpo, armonizzando l\\u2019allenamento e coinvolgendo tutti i distretti motori;\\n- gli esercizi costantemente variati: ogni giorno ci troviamo ad affrontare un allenamento diverso e di conseguenza pi\\u00f9 stimolante ed interessante;\\n- l\\u2019alta intensit\\u00e0: lo sforzo e l\\u2019impegno concentrati in un periodo di tempo limitato conferiscono particolare efficacia all\\u2019attivit\\u00e0 eseguita, e stimolano a voler ripetere l\\u2019esperienza;\\n- la scalabilit\\u00e0, ovvero la possibilit\\u00e0 per tutti di eseguire gli stessi esercizi con pesi adatti al proprio fisico: a prescindere dal livello di preparazione atletica, quindi, ogni esercizio pu\\u00f2 essere adattato per intensit\\u00e0 e tipologia.\\n \\nCHI PU\\u00d2 FARLO E COME SI INIZIA\\n\\nGrazie alla possibilit\\u00e0 di modulare l\\u2019attivit\\u00e0 in base alla forza e all\\u2019impegno fisico, iI Crossfit \\u00e8 uno sport adatto a tutti, dai bambini, ai teenager, dalle donne agli over 65.\\n\\nSe hai gi\\u00e0 praticato CrossFit puoi frequentare tutte le classi e gestire i pesi a seconda dei tuoi standard.\\n\\nSe invece \\u00e8 la prima volta che ti avvicini al CrossFit e sei curiosa\\/o anche solo di provare, puoi venire e fare una prova gratuita, e vedere se ti piace. Se decidi di proseguire, abbiamo ideato delle classi \\u201con ramp\\u201d, dedicate cio\\u00e8 ai principianti, per insegnare alcuni elementi fondamentali del CrossFit in modo dedicato e in piccoli gruppi. Nel frattempo puoi comunque seguire le classi normali, modulando pesi e attivit\\u00e0 sulla base delle tue capacit\\u00e0.\\n\\nCHIAMACI O SCRIVICI PER PRENOTARE LA TUA LEZIONE DI PROVA GRATUITA!\\n \\n\\nDOMANDE E DUBBI FREQUENTI\\n\\n- \\u201cIl CrossFit \\u00e8 per atleti gi\\u00e0 esperti\\u201d: fraintendimento che nasce dal fatto che la parte pi\\u00f9 \\u201csocial\\u201d del CrossFit sia popolata da superuomini e superdonne che rappresentano effettivamente l\\u2019\\u00e9lite del fitness. Ma il CrossFit come sport \\u00e8 solo la punta dell\\u2019iceberg di un movimento molto pi\\u00f9 ampio che coinvolge persone di tutte le et\\u00e0, che si sono avvicinate a questa l\\u2019esperienza partendo da livelli di fitness molto diversi tra loro. Tante persone oggi non sanno ancora cosa sia questa disciplina e possono scoprirla proprio attraverso l\\u2019attento accompagnamento di coach qualificati.\\n- \\u201cCon il CrossFit si corre il rischio di farsi male\\u201d: \\u00e8 certamente un\\u2019attivit\\u00e0 che non teme l\\u2019intensit\\u00e0, e come tale presenta i normali rischi di infortunio di uno sport. Questo \\u00e8 il motivo per cui ci proponiamo di minimizzare questi rischi con un accurato insegnamento della tecnica dei movimenti e con la strategia della compresenza di pi\\u00f9 coach quando le classi superino un certo numero di presenze.\\n- \\u201cIl CrossFit fa diventare grosse le donne\\u201d: al di l\\u00e0 del fatto che non esiste un solo modello di bellezza a cui tutte le donne debbano assomigliare, \\u00e8 doveroso precisare che i corpi iper-muscolosi a cui spesso ci si riferisce sono quelli di atlete che dedicano tutto il loro tempo, una speciale alimentazione e spesso un\\u2019integrazione molto intensa allo scopo di costruirli. Nessuna donna che pratichi regolarmente o anche intensamente CrossFit avr\\u00e0 mai la sorpresa improvvisa di vedere mutato il proprio corpo.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2606\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2606\\/featured_images\\/37028754_705658739808722_5691304753552687104_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2606\\/featured_images\\/47580034_819431751764753_7044730552900911104_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2606\\/featured_images\\/51109529_852823625092232_2822018269110599680_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2606\\/featured_images\\/51920765_859799321061329_4068617086367170560_n.jpg\"],\"address\":{\"street\":\"via Temperanza 6\",\"town\":\"Milano\",\"postal_code\":\"20127\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.4900684,\"longitude\":9.2204373},\"contact_info\":{\"email\":\"info@crossfitnolo.com\",\"phone\":\"+39 3755226047\"},\"social_media\":{\"instagram\":\"crossfit_nolo\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CFNoLo\\/\"}},{\"id_application\":null,\"id_lead\":\"2644\",\"name\":\"CrossFit Begin\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2644\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2644\\/featured_images\\/21740276_861054104062211_2575301943513362855_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2644\\/featured_images\\/33020985_1000314600136160_7905384833004601344_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2644\\/featured_images\\/47300739_1156789214488697_7307971009733197824_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2644\\/featured_images\\/49083390_1176799942487624_3420655045664833536_o.jpg\"],\"address\":{\"street\":\"Via Giovanna d\\u0027Arco, 6\",\"town\":\"Bergamo\",\"postal_code\":\"24066\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.6952602,\"longitude\":9.7578174},\"contact_info\":{\"email\":\"info@crossfitbegin.it\",\"phone\":\"+39 035291727\"},\"social_media\":{\"instagram\":\"crossfitbegin\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitBegin.it\\/\"}},{\"id_application\":\"79691392\",\"id_lead\":null,\"name\":\"Rur\\u00f4ni Crossfit\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/79691392\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/79691392\\/featured_images\\/12049333_1897137867178175_586440102864494965_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/79691392\\/featured_images\\/12301678_1923994521159176_2176081932123760634_n-600x338.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/79691392\\/featured_images\\/15972643_2180302392195053_902487043251522518_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/79691392\\/featured_images\\/IMG_1302.png\"],\"address\":{\"street\":\"Rue du Dr. L\\u00e9once Basset\",\"town\":\"Saint-Ouen\",\"postal_code\":\"93400\",\"country\":\"France\"},\"location\":{\"latitude\":48.9155102,\"longitude\":2.3345563},\"contact_info\":{\"email\":\"ruronicrossfit@gmail.com\",\"phone\":\"06 07 52 41 17\"},\"social_media\":{\"instagram\":\"ruroni_crossfit\",\"facebook\":\"https:\\/\\/www.facebook.com\\/ronincrossfit93\\/?ref=hl\"}},{\"id_application\":null,\"id_lead\":\"2769\",\"name\":\"Crosffit Zaragoza\",\"description\":\"CrossFit Zaragoza es el \\u00fanico centro oficial Reebok-CrossFit en Arag\\u00f3n y uno de los pocos que hay en Espa\\u00f1a. Su calidad est\\u00e1 reconocida y acreditada por CrossFit Inc. USA. Contamos con personal certificado internacionalmente y que viaja por todo el mundo para trabajar con los mejores entrenadores y atletas de este deporte. Nuestro deseo, desde hace una d\\u00e9cada, es impartir la formaci\\u00f3n y metodolog\\u00eda del sistema CrossFit.\\nNuestro box nace con un objetivo muy concreto, ofrecer todo lo que CrossFit puede brindar tanto a nivel de salud como de alto rendimiento deportivo. Somos una verdadera escuela de fitness. Nuestros entrenadores cuentan con una d\\u00e9cada de experiencia entrenando y divulgando la metodolog\\u00eda de CrossFit. Muy pocos boxes en Europa cuentan con esa trayectoria en su plantilla. CrossFit ZGZ fue el tercer Box creado en Espa\\u00f1a.\\nOrientados tanto al p\\u00fablico en general, como a los atletas que quieren competir en esta disciplina internacional, CrossFit ZGZ cuenta con una detallada y estudiada programaci\\u00f3n y planificaci\\u00f3n anual en ambos aspectos.\\nNuestro centro s\\u00f3lo imparte CrossFit. No lo hacemos como una actividad que se preste en una sala de un gimnasio comercial, con otro nombre o realizando burdas imitaciones. Somos pura y exclusivamente CrossFit. Es nuestra pasi\\u00f3n y es lo que nos mueve.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2769\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2769\\/featured_images\\/Entrenador-Personal.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2769\\/featured_images\\/porQueCFZgz-476594_900x345.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2769\\/featured_images\\/queEsCrossfit.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2769\\/featured_images\\/transf-491914_900x345.jpg\"],\"address\":{\"street\":\"Benjamin Franklin, 6\",\"town\":\"Zaragoza\",\"postal_code\":\"50014\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.6659896,\"longitude\":-0.8685233},\"contact_info\":{\"email\":\"info@crossfitzaragoza.es\",\"phone\":\"976 464 271\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitter.ZGZ\\/\"}},{\"id_application\":\"80818172\",\"id_lead\":null,\"name\":\"CrossFit Valenton\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/80818172\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/80818172\\/featured_images\\/44051342_739639936403254_7837121546219945984_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/80818172\\/featured_images\\/48429897_779818309052083_5769157817546047488_o.jpg\"],\"address\":{\"street\":\"place thomas edison\",\"town\":\"valenton\",\"postal_code\":\"94460\",\"country\":\"France\"},\"location\":{\"latitude\":48.7497874,\"longitude\":2.4554316},\"contact_info\":{\"email\":\"thefraternityvalenton@gmail.com\",\"phone\":\"0980597812\"},\"social_media\":{\"instagram\":\"crossfit_valenton\",\"facebook\":\"https:\\/\\/www.facebook.com\\/cfvalenton\"}},{\"id_application\":null,\"id_lead\":\"3046\",\"name\":\"Crossfit Grau\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3046\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3046\\/featured_images\\/19274910_1299629266822925_7694228425642734561_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3046\\/featured_images\\/2016-06-21.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3046\\/featured_images\\/crossfitgrau-3.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3046\\/featured_images\\/maxresdefault.jpg\"],\"address\":{\"street\":\"Carrer de Joan Verdeguer, 2B\",\"town\":\"Valencia\",\"postal_code\":\"46024\",\"country\":\"Spain\"},\"location\":{\"latitude\":39.4588684,\"longitude\":-0.3422554},\"contact_info\":{\"email\":\"infocrossfitgrau@gmail.com\",\"phone\":\"963 441 421\"},\"social_media\":{\"instagram\":\"crossfit_grau\",\"facebook\":\"@CrossfitGrau\"}},{\"id_application\":null,\"id_lead\":\"2943\",\"name\":\"Crossfit Maspalomas\",\"description\":\"Experimenta fitness que sea un reto, divertido y ofrezca una recompensa. CrossFit es fitness funcional que te preparar\\u00e1 para cualquier cosa en la vida, y es apto para personas de cualquier edad. Cada ejercicio te har\\u00e1 sentir como un super h\\u00e9roe, en el sentido que habr\\u00e1s realizado algo por ti mismo, e inspirado a otros a la misma vez. Combinamos varios tipos de ejercicios para ponerte en la mejor forma de tu vida. Los ejercicios programados est\\u00e1n compuestos de movimientos funcionales, constantemente variados, desarrollados a un nivel de alta intensidad y pueden modificarse para adaptarse a las necesidades de cualquiera. Ya seas un atleta establecido buscando mejorar tu juego, o simplemente una persona que quiere estar sano y en forma, CROSSFIT MASPALOMAS te ayudar\\u00e1 a cumplir tus objetivos.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2943\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2943\\/featured_images\\/instalaciones.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2943\\/featured_images\\/wod.jpg\"],\"address\":{\"street\":\"C\\/Cartago, 26\",\"town\":\"Maspalomas\",\"postal_code\":\"35109\",\"country\":\"Spain\"},\"location\":{\"latitude\":27.7764342,\"longitude\":-15.6189475},\"contact_info\":{\"email\":\"info@crossfitmaspalomas.com\",\"phone\":\"722802023\"},\"social_media\":{\"instagram\":\"crossfitmaspalomas\",\"facebook\":\"@crossfit.maspalomas\"}},{\"id_application\":null,\"id_lead\":\"3176\",\"name\":\"Crossfit Rabbit Hole\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3176\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3176\\/featured_images\\/Bildschirmfoto%202019-07-02%20um%2013.16.28.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3176\\/featured_images\\/Bildschirmfoto%202019-07-02%20um%2013.16.48.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3176\\/featured_images\\/Bildschirmfoto%202019-07-02%20um%2013.16.55.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3176\\/featured_images\\/Bildschirmfoto%202019-07-02%20um%2013.17.11.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3176\\/featured_images\\/Bildschirmfoto%202019-07-02%20um%2013.17.49.png\"],\"address\":{\"street\":\"STUBBENWEG 30\",\"town\":\"OLDENBURG\",\"postal_code\":\"26125\",\"country\":\"Germany\"},\"location\":{\"latitude\":53.1789711,\"longitude\":8.2265336},\"contact_info\":{\"email\":\"MOIN@CROSSFITRABBITHOLE.DE\",\"phone\":\"0174 9091458\"},\"social_media\":{\"instagram\":\"crossfit_rabbit_hole\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFit.Rabbit.Hole\"}},{\"id_application\":\"37212633\",\"id_lead\":null,\"name\":\"Crossfit Sirocco\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/37212633\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/37212633\\/featured_images\\/19884288_641064939428036_2913345345062558259_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/37212633\\/featured_images\\/35901358_791566147711247_4555052111510896640_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/37212633\\/featured_images\\/40325474_858063891061472_7056281034219847680_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/37212633\\/featured_images\\/42892596_873544126180115_9146379525393743872_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/37212633\\/featured_images\\/42925539_873738159494045_9194842557677305856_o.jpg\"],\"address\":{\"street\":\"Route d\\u0027Amizmiz\",\"town\":\"Marrakech\",\"postal_code\":\"40000\",\"country\":\"Morocco\"},\"location\":{\"latitude\":31.587182,\"longitude\":-8.010972},\"contact_info\":{\"email\":\"sirocco@crossfitsirocco.com\",\"phone\":\"212 6 14 929 929\"},\"social_media\":{\"instagram\":\"crossfit.sirocco.marrakech\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitsirocco\"}},{\"id_application\":\"90716507\",\"id_lead\":null,\"name\":\"Ikigai Crossfit\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/90716507\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/90716507\\/featured_images\\/6478f8f9257d1.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/90716507\\/featured_images\\/6478f8fcae554.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/90716507\\/featured_images\\/6478f9014b554.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/90716507\\/featured_images\\/6478f902e908c.jpg\"],\"address\":{\"street\":\"Allersberger Str. 185\\/gebaude a5\",\"town\":\"N\\u00fcrnberg\",\"postal_code\":\"90461\",\"country\":\"Deutschland\"},\"location\":{\"latitude\":49.4324342,\"longitude\":11.0976784},\"contact_info\":{\"email\":\"ikigaicrossfit@nubapp-clients.com\",\"phone\":\"01629843231\"},\"social_media\":{\"instagram\":\"Ikigai_CrossFit\",\"facebook\":\"https:\\/\\/www.facebook.com\\/search\\/top?q=ikigai%20crossfit\"}},{\"id_application\":\"41965276\",\"id_lead\":null,\"name\":\"CrossFit Alvilda\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/41965276\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Zone du parc, 12B rue de la No\\u00e9\",\"town\":\"Muzillac\",\"postal_code\":\"56190\",\"country\":\"France\"},\"location\":{\"latitude\":47.553903,\"longitude\":-2.482314},\"contact_info\":{\"email\":\"contact@crossfit-alvilda.bzh\",\"phone\":\"0673495930\"},\"social_media\":{\"instagram\":\"crossfitalvilda\",\"facebook\":\"\"}},{\"id_application\":\"89409345\",\"id_lead\":null,\"name\":\"Hybrid Performance Crossfit\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/89409345\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"30 Rue du Bois de la Remise\",\"town\":\"Varennes-Jarcy\",\"postal_code\":\"91480\",\"country\":\"France\"},\"location\":{\"latitude\":48.6870245,\"longitude\":2.5715906},\"contact_info\":{\"email\":\"cf_hybridperformance@nubapp-clients.com\",\"phone\":\"0682876631\"},\"social_media\":{\"instagram\":\"hybridperformance91480\",\"facebook\":\"\"}},{\"id_application\":\"27722342\",\"id_lead\":null,\"name\":\"Crossfit Saumur\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/27722342\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"154 Bd Jean Moulin\",\"town\":\"Saumur\",\"postal_code\":\"49400\",\"country\":\"France\"},\"location\":{\"latitude\":47.2388356,\"longitude\":-0.0686829},\"contact_info\":{\"email\":\"crossfit_saumur@nubapp-clients.com\",\"phone\":\"0640373172\"},\"social_media\":{\"instagram\":\"crossfitsaumur\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2611\",\"name\":\"Meccanica CrossFit Seregno\",\"description\":\"Siamo a Seregno Crossfit \\u2013 Meccanica CrossFit Seregno organizza corsi di crossfit a seregno, weightlifting e calisthenics. Vieni a scoprire il box pi\\u00f9 attrezzato della zona \\u2013 brianza. Meccanica CrossFit, con i suoi 700mq di spazio interno e 600mq di spazio esterno, \\u00e8 il luogo ideale sia per chi si avvicina per la prima volta a questo sport sia per chi la pratica gi\\u00e0 da tempo e magari partecipa anche a gare e competizioni.\\n\\nLe aree sono organizzate in maniera funzionale ed in modo tale che ognuno abbia tutta l\\u2019attrezzatura a disposizione, il giusto spazio per allenarsi ed il coach di riferimento con cui confrontarsi. Se abiti a Seregno, Desio, Meda, Lissone, Carate Brianza, Verano Brianza, Albiate, Mariano Comense o nei paesi qui attorno contattaci per una prova gratuita.\\n\\nQuesto sport migliora lo stato di fitness aumentando la capacit\\u00e0 di lavoro grazie ad un adattamento neurologico ed ormonale di tutte le vie metaboliche: durata, resistenza, forza e flessibilit\\u00e0 si esercitano con l\\u2019allenamento (attivit\\u00e0 che migliorano le prestazioni attraverso un cambiamento organico misurabile del corpo); coordinazione, agilit\\u00e0, equilibrio e precisione si esercitano con la pratica (attivit\\u00e0 che migliorano le prestazioni attraverso cambiamenti del sistema nervoso); potenza e velocit\\u00e0 si esercitano sia con la pratica che con l\\u2019allenamento.\\nSe vuoi maggiori informazioni visita la nostra pagina \\u201cCos\\u2019\\u00e8 il CrossFit\\u201d oppure contattaci.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2611\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2611\\/featured_images\\/18839274_714753615363873_7893936390039114242_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2611\\/featured_images\\/21034235_758118457694055_760604140533506619_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2611\\/featured_images\\/30582071_871332559705977_4716363077962530777_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2611\\/featured_images\\/31195615_877384219100811_1364433819202451818_n.jpg\"],\"address\":{\"street\":\"Via Cascina Ida 3, Seregno\",\"town\":\"Monza\",\"postal_code\":\"20831\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.6382183,\"longitude\":9.2049339},\"contact_info\":{\"email\":\"info@meccanicacrossfit.com\",\"phone\":\"+39 328 2928024\"},\"social_media\":{\"instagram\":\"meccanicacrossfit\",\"facebook\":\"https:\\/\\/www.facebook.com\\/MeccanicaCrossFitSeregno\\/\"}},{\"id_application\":null,\"id_lead\":\"2982\",\"name\":\"Crossfit Main Taunus\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2982\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2982\\/featured_images\\/Bildschirmfoto%202019-06-03%20um%2011.36.47.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2982\\/featured_images\\/Bildschirmfoto%202019-06-03%20um%2011.36.54.png\"],\"address\":{\"street\":\"Nassaustra\\u00dfe 32\",\"town\":\"Hofheim am Taunus\",\"postal_code\":\"65719\",\"country\":\"Germany\"},\"location\":{\"latitude\":50.070462,\"longitude\":8.3810341},\"contact_info\":{\"email\":\"info@crossfit-maintaunus.de\",\"phone\":\"+49 1736603161\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitmaintaunus\\/\"}},{\"id_application\":null,\"id_lead\":\"2857\",\"name\":\"Crossfit Jerez\",\"description\":\"CrossFit se define como un sistema de entrenamiento de fuerza y acondicionamiento basado en ejercicios funcionales constantemente variados realizados a una alta intensidad. Esto significa que nos valemos de una gran cantidad de ejercicios y disciplinas deportivas (gimnasia, halterofilia, carrera\\u2026), de entre las cuales seleccionamos t\\u00e9cnicas o movimientos aplicables a la vida diaria y los combinamos de muchas formas diferentes en entrenamientos intensos, resultando no solo un experiencia exigente durante la cual el car\\u00e1cter l\\u00fadico y la camarader\\u00eda cobran un papel primordial, sino tambi\\u00e9n un programa insuperable para desarrollar las diez capacidades f\\u00edsicas generales.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2857\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2857\\/featured_images\\/22814001_2059689267598219_2923633735258559270_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2857\\/featured_images\\/lg-280.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2857\\/featured_images\\/maxresdefault.jpg\"],\"address\":{\"street\":\"C\\/ de la Miner\\u00eda, 3, nave 13\",\"town\":\"Jerez de la Frontera\",\"postal_code\":\"11407\",\"country\":\"Spain\"},\"location\":{\"latitude\":36.70882,\"longitude\":-6.1189904},\"contact_info\":{\"email\":\"crossfitjerez@hotmail.com\",\"phone\":\"629 221 207 \\/ 649 485 707\"},\"social_media\":{\"instagram\":\"crossfitjerez\",\"facebook\":\"@crossfitjerez2014\"}},{\"id_application\":\"13848571\",\"id_lead\":null,\"name\":\"Hybrid Training Vall\\u00e9e \",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/13848571\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"910 bis all\\u00e9e B Avenue Andr\\u00e9 Lasquin\",\"town\":\"Sallanches\",\"postal_code\":\"74700\",\"country\":\"France\"},\"location\":{\"latitude\":45.9474731,\"longitude\":6.6363134},\"contact_info\":{\"email\":\"no-reply@nubapp-clients.com\",\"phone\":\"07 82 93 84 17\"},\"social_media\":{\"instagram\":\"crossfit_vallee_sallanches\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"3082\",\"name\":\"Dark Phoenix Labs\",\"description\":\"El Box es como se llama al lugar donde entrenamos, pero no es solo eso, es un sitio para divertirse, compartir esfuerzo y conocer gente que comparte tu pasi\\u00f3n.\\n\\nLas clases las hacemos todos juntos y se adaptan a tu nivel con plazas limitadas y un coach siempre pendiente de ti.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3082\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3082\\/featured_images\\/68512e293058f.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3082\\/featured_images\\/68512e31b9e43.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3082\\/featured_images\\/darkphoenix.jpg\"],\"address\":{\"street\":\"Calle Txomin Egileor, 52 Pol\\u00edgono zugutzu nave 12\",\"town\":\"Gald\\u00e1cano\",\"postal_code\":\"48960\",\"country\":\"Spain\"},\"location\":{\"latitude\":43.2302558,\"longitude\":-2.8531614},\"contact_info\":{\"email\":\"\",\"phone\":\"695 71 73 41\"},\"social_media\":{\"instagram\":\"dark_phoenix_labs\",\"facebook\":\"@Dark-Phoenix-labs\"}},{\"id_application\":null,\"id_lead\":\"2902\",\"name\":\"Crossfit Zurriola\",\"description\":\"El \\u00fanico box de Crossfit en el centro de Donostia\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2902\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2902\\/featured_images\\/DLTKwSpXoAAFPvx.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2902\\/featured_images\\/crossfit_zurriola.jpg\"],\"address\":{\"street\":\"Av. Zurriola, n\\u00ba46\",\"town\":\"San Sebasti\\u00e1n\",\"postal_code\":\"20002\",\"country\":\"Spain\"},\"location\":{\"latitude\":43.3262148,\"longitude\":0},\"contact_info\":{\"email\":\"crossfitzurriola@gmail.com\",\"phone\":\"602698205\"},\"social_media\":{\"instagram\":\"crossfit_zurriola\",\"facebook\":\"@crossfitzurriola\"}},{\"id_application\":null,\"id_lead\":\"2628\",\"name\":\"CrossFit Gorgonzola\",\"description\":\"Nasce con questo spirito Seven Infinity, il mondo dello sport e del divertimento in un\\u2019area verde di 12.000 mq sulle sponde della Martesana a Gorgonzola. Emozioni, energia, relax e socializzazione in una community dello sport dove provare diverse attivit\\u00e0 sportive: dalle splendide aree piscina, al fitness con i corsi pi\\u00f9 evoluti, dai campi da tennis, al calcio e al volley. Uno spazio moderno nel quale potrai allenarti tutto l\\u2019anno con il supporto di uno staff di professionisti, un luogo dove uomini, donne, bambini e famiglie, troveranno la meta ideale per il loro benessere. A completare la ricca serie di servizi e attivit\\u00e0, verr\\u00e0 inaugurato a breve il nuovo centro spa \\u0026 wellness per offrire il relax fisico e mentale di cui spesso si ha bisogno. Seven infinity \\u00e8 ben servito dai mezzi pubblici ed \\u00e8 collegato alla pista ciclabile della Martesana. Non resta che venire a trovarci per scoprire che le vie dello sport\\u2026 sono Infinity.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2628\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2628\\/featured_images\\/19875334_1380249165428668_3250234984103464949_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2628\\/featured_images\\/19959431_1380248888762029_714214717382974577_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2628\\/featured_images\\/19984012_1382230848563833_380688547127708606_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2628\\/featured_images\\/35162073_1708214022632179_643853741274955776_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2628\\/featured_images\\/46492219_1933664326753813_1562960872714797056_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2628\\/featured_images\\/46510617_1942394782547434_4184181071320973312_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2628\\/featured_images\\/50767755_2037018363085075_3900791930765705216_n.jpg\"],\"address\":{\"street\":\"Via Toscana, 7\",\"town\":\"Gorgonzola, MI\",\"postal_code\":\"20064\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.5316916,\"longitude\":9.4158128},\"contact_info\":{\"email\":\"fitness@seveninfinity.it\",\"phone\":\"+39 02 9530 5516\"},\"social_media\":{\"instagram\":\"crossfit.gorgonzola\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitgorgonzola\\/\"}},{\"id_application\":null,\"id_lead\":\"2929\",\"name\":\"CrossFit Ballers\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2929\\/featured_images\\/13268249_1402228276750614_4550741612137831488_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2929\\/featured_images\\/13892252_1406940692946039_6952399013474929491_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2929\\/featured_images\\/14591590_1413586615614780_6215973774731683507_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2929\\/featured_images\\/18157355_1439514403022001_6296555065014069485_n.jpg\"],\"address\":{\"street\":\"8 Rue Saint-Eloi\",\"town\":\"Rouen\",\"postal_code\":\"76000\",\"country\":\"France\"},\"location\":{\"latitude\":49.4405292,\"longitude\":0},\"contact_info\":{\"email\":\"contact@crossfitballers.com\",\"phone\":\"+33 9 81 11 34 64\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitBallers\\/\"}},{\"id_application\":null,\"id_lead\":\"2767\",\"name\":\"Crosfit Erding\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2767\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2767\\/featured_images\\/Bildschirmfoto%202019-05-15%20um%2011.52.26.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2767\\/featured_images\\/Bildschirmfoto%202019-05-15%20um%2011.52.36.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2767\\/featured_images\\/Bildschirmfoto%202019-05-15%20um%2011.52.44.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2767\\/featured_images\\/Bildschirmfoto%202019-05-15%20um%2011.52.52.png\"],\"address\":{\"street\":\"Neuendorfer Str. 39e\",\"town\":\"Potsdam\",\"postal_code\":\"14480\",\"country\":\"Germany\"},\"location\":{\"latitude\":52.3732494,\"longitude\":13.1252381},\"contact_info\":{\"email\":\"info@crossfit-erding.de\",\"phone\":\"+49 1799540093\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2745\",\"name\":\"Crossfit BN-SU\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2745\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2745\\/featured_images\\/portfolio-img1.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2745\\/featured_images\\/portfolio-img20.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2745\\/featured_images\\/portfolio-img22.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2745\\/featured_images\\/portfolio-img23.jpg\"],\"address\":{\"street\":\"Holzlarer\\u00a0Weg\\u00a042\",\"town\":\"Bonn\",\"postal_code\":\"53229\",\"country\":\"Germany\"},\"location\":{\"latitude\":50.74384,\"longitude\":7.1572713},\"contact_info\":{\"email\":\"sonja.brucksch@betterstrong.de\",\"phone\":\"+49\\u00a0(0)\\u00a0171\\u00a0830\\u00a01037\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":\"39780420\",\"id_lead\":null,\"name\":\"CrossFit B\\u00e9l\\u00e9nos\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/39780420\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Rue Edouard Pottier  Porte du Littoral\",\"town\":\"Leulinghem\",\"postal_code\":\"62500\",\"country\":\"France\"},\"location\":{\"latitude\":50.733603,\"longitude\":2.171485},\"contact_info\":{\"email\":\"infos@crossfit-belenos.fr\",\"phone\":\"0682910734\"},\"social_media\":{\"instagram\":\"crossfit_belenos_stomer\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"3073\",\"name\":\"Waiura Crossfit\",\"description\":\"Primer CrossFit Oficial en Rub\\u00ed.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3073\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3073\\/featured_images\\/48164907_292445091618885_7559634317794607104_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3073\\/featured_images\\/a71c2f2559959d2e9b97121d4a5ac3e3f1ab1254.jpg\"],\"address\":{\"street\":\"Carretera Molins de Rei, km13, nave 70\",\"town\":\"Rub\\u00ed\",\"postal_code\":\"08191\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.5067717,\"longitude\":2.0384993},\"contact_info\":{\"email\":\"info@wairuacrossfit.com\",\"phone\":\"657199155\"},\"social_media\":{\"instagram\":\"wairuacrossfit\",\"facebook\":\"@Wairua-CrossFit-Tu-Box-en-Rub\\u00ed-292438108286250\"}},{\"id_application\":null,\"id_lead\":\"2934\",\"name\":\"Crossfit 7879\",\"description\":\"Crossfit 78\\/79 es un box situado en la Calle Eraso 36, con entrada por Francisco Santos 33, en el barrio de \\u0022La Guindalera\\u0022 entre Ventas y Diego de Le\\u00f3n. Tenemos 400 m2 preparados para la pr\\u00e1ctica del CrossFit con material de primera calidad de la mano de Hatlex.\\nTodo lo que puedes esperar de un box de CrossFit, plataformas de halterofilia, jaulas para gimn\\u00e1sticos y racks, cuerdas, cajones, balones medicinales, remos, assault bikes, skiergs y una air runner.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2934\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2934\\/featured_images\\/banner-index02.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2934\\/featured_images\\/imagenblog-noticia-crossfit-diciembre.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2934\\/featured_images\\/imagenblog-noticia-crossfit-enero-1024x567.jpg\"],\"address\":{\"street\":\"Calle Eraso, 36\",\"town\":\"Madrid\",\"postal_code\":\"28028\",\"country\":\"Spain\"},\"location\":{\"latitude\":40.4356078,\"longitude\":-3.6702606},\"contact_info\":{\"email\":\"info@crossfit7879.com\",\"phone\":\"600 93 98 65\"},\"social_media\":{\"instagram\":\"crossfit7879\",\"facebook\":\"@CrossFit7879\"}},{\"id_application\":null,\"id_lead\":\"2651\",\"name\":\"HeavyTools CrossFit\",\"description\":\"DAL 2011 A BRESCIA\\nNasce con lo scopo di creare un programma di allenamento ampio e generale; che si possa adattare a qualsiasi tipo di sport ed attivit\\u00e0 fisica.\\n\\nPrevede movimenti funzionali, gesti che il nostro corpo impara inconsciamente e poi dimentica con lo sviluppo sedentario dei giorni nostri.\\n\\nMovimenti funzionali eseguiti ad alt\\u00e0 intensit\\u00e0 in modalit\\u00e0 costantemente variata.\\n\\nIl CrossFit non \\u00e8 un programma di fitness specializzato, ma un tentativo di ottimizzare la competenza fisica in ognuna delle dieci categorie del fitness riconosciute.\\n\\n\\u00c8 ADATTO A ME?\\nCerto! Le vostre esigenze e quelle degli atleti olimpionici sono di livello diverso, ma non di tipo diverso.\\n\\nIl Crosstraining \\u00e8 basato sullo sviluppo e sulla pratica della forza e di tutte le sue varianti.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2651\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2651\\/featured_images\\/22308939_1814541481908141_8330557624459161954_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2651\\/featured_images\\/22366518_1814545741907715_3260605719195548742_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2651\\/featured_images\\/22382452_1814545225241100_8024369797196086703_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2651\\/featured_images\\/45420182_2316953098333641_1233331328271777792_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2651\\/featured_images\\/51424796_2452300254798924_3496077368622055424_o.jpg\"],\"address\":{\"street\":\"via Lunga, 16\",\"town\":\"Brescia\",\"postal_code\":\"25126\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.5375969,\"longitude\":10.1912427},\"contact_info\":{\"email\":\"mtabossi@yahoo.it\",\"phone\":\"+39 338 113 5035\"},\"social_media\":{\"instagram\":\"heavytoolscrossfit\",\"facebook\":\"https:\\/\\/www.facebook.com\\/heavytools.bs\\/\"}},{\"id_application\":\"30872459\",\"id_lead\":null,\"name\":\"Crossfit Mont Blanc\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/30872459\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"332 Avenue des Raches\",\"town\":\"Passy\",\"postal_code\":\"74190\",\"country\":\"France\"},\"location\":{\"latitude\":45.9139146,\"longitude\":6.713853},\"contact_info\":{\"email\":\"infos@crossfit-montblanc.fr\",\"phone\":\"0986577385\"},\"social_media\":{\"instagram\":\"crossfitmontblanc\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitmontblanc\"}},{\"id_application\":null,\"id_lead\":\"2629\",\"name\":\"Ironfit Monza CrossFit 20900\",\"description\":\"Ironfit nasce dalla passione per il CrossFit e per gli sport combat, dal desiderio di evolvere il corpo e la mente, superando i propri limiti!\\nPer questo preferiamo dirvi \\u201cchi stiamo diventando\\u201d anzich\\u00e8 \\u201cchi siamo\\u201d.\\n\\nStiamo crescendo come crossfitter, ginnasti, weightlifter, powerlifter, combattenti, lottatori, atleti, ma soprattutto uomini e donne!\\n\\nLe giornate al box iniziano presto, alle 7 parte la prima classe di CrossFit, per finire alle 21-22 con l\\u2019ultima!\\nDurante la giornata si susseguono e aggiungono alle classi di CrossFit, quelle di acrobatica, weightlifting, kettlebell e strength, poi ci sono i corsi di Sanda, MMA, Muay Thai, Brazilian jiu jitsu NO-GI, Pugilato, K1, Krav Maga, Tai Chi, Street Defence e la programmazione per bambini e ragazzi che prevede oltre agli sport combat anche ginnastica.\\n\\nLa famiglia IronFit accoglie tutti, dalle nuove leve, che scopriranno cosa significa fare sport, ai veterani, che troveranno un luogo dove coltivare le proprie passioni.\\n\\nVieni a provare, non sar\\u00e0 una lezione soft, non cercheremo di convincerti a frequentare un corso, perch\\u00e8 sarai tu a chiederci:\\n\\n\\u201cBene, sono distrutto\\u2026quando posso tornare?\\u201d\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2629\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2629\\/featured_images\\/28796021_2051434211765927_6405073518660157440_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2629\\/featured_images\\/29793519_2066672756908739_4230419933315465216_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2629\\/featured_images\\/37130350_2131370877105593_4744631912121761792_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2629\\/featured_images\\/49896770_2259031851006161_5865366686999248896_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2629\\/featured_images\\/51816637_2277536629155683_2083759858179375104_n.jpg\"],\"address\":{\"street\":\"via Mentana, 17\",\"town\":\"Monza\",\"postal_code\":\"20900\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.577813,\"longitude\":9.277269},\"contact_info\":{\"email\":\"monza@crossfit.com\",\"phone\":\"+39 393 999 5554\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/ironfitmonza\\/\"}},{\"id_application\":null,\"id_lead\":\"2553\",\"name\":\"CrossFit Little HELL\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2553\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2553\\/featured_images\\/18920858_1501988846489189_7703660660824766083_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2553\\/featured_images\\/25542785_1696856290335776_1925907699513281430_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2553\\/featured_images\\/26166043_1702953926392679_8004588128555025215_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2553\\/featured_images\\/26805476_1720722567949148_8708975976165334875_n.jpg\"],\"address\":{\"street\":\"Via Arturo Toscanini 7\",\"town\":\"Roma\",\"postal_code\":\"00124\",\"country\":\"Italia\"},\"location\":{\"latitude\":41.746978,\"longitude\":12.3609227},\"contact_info\":{\"email\":\"info@crossfitlittlehell.com\",\"phone\":\"+39 0650930384\"},\"social_media\":{\"instagram\":\"crossfitlittlehell\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitlittlehell\\/\"}},{\"id_application\":null,\"id_lead\":\"3228\",\"name\":\"Crossfit Aalen\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3228\\/featured_images\\/CrossFitAalen-100-7f6986d6.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3228\\/featured_images\\/CrossFitAalen-172-8de8c370.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3228\\/featured_images\\/CrossFitAalen-189-b40fc74b.jpg\"],\"address\":{\"street\":\"Kochertalstra\\u00dfe 45\",\"town\":\"Aalen\",\"postal_code\":\"73431\",\"country\":\"Germany\"},\"location\":{\"latitude\":48.82722,\"longitude\":10.1137813},\"contact_info\":{\"email\":\"training@crossfitaalen.com\",\"phone\":\"\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2854\",\"name\":\"Crossfit box Castelldefels\",\"description\":\"Le llamamos Box por lo que representa. Una caja vac\\u00eda donde lo \\u00fanico que necesitamos es tu motivaci\\u00f3n. En nuestro Box no encontrar\\u00e1s m\\u00e1quinas, no las utilizamos porque creemos que no hay m\\u00e1quina mejor que tu cuerpo; y con eso trabajamos. Aprender\\u00e1s a moverte, a saltar, a correr y a levantar pesos, te sentir\\u00e1s fuerte, \\u00e1gil, r\\u00e1pido y m\\u00e1s vivo que nunca. Nuestra motivaci\\u00f3n es tu mejora.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2854\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2854\\/featured_images\\/11357094_468607759967027_6121294452565425825_o-600x400.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2854\\/featured_images\\/11891009_1621217698146360_615869248190392780_n-600x400.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2854\\/featured_images\\/_DSC4691.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2854\\/featured_images\\/_DSC7159-2.jpg\"],\"address\":{\"street\":\"Carrer de Raurell, 2, Nave 1\",\"town\":\"Casteldefels\",\"postal_code\":\"08860\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.284016,\"longitude\":1.9855837},\"contact_info\":{\"email\":\"box@crossfitboxcastelldefels.com\",\"phone\":\"649645557\"},\"social_media\":{\"instagram\":\"crossfitboxcastelldefels\",\"facebook\":\"@crossfitboxcastelldefels\"}},{\"id_application\":null,\"id_lead\":\"3148\",\"name\":\"CrossFit Louvre II\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3148\\/featured_images\\/12806151_604513839703364_494436290283853097_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3148\\/featured_images\\/19510546_872214069600005_8417830756952245893_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3148\\/featured_images\\/45013127_1211914912296584_6820194786562015232_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3148\\/featured_images\\/58461486_1339641189523955_5475123673562087424_o.jpg\"],\"address\":{\"street\":\"7 Rue Louis de Fun\\u00e8s\",\"town\":\"Villenave-d\\u0027Ornon\",\"postal_code\":\"33140\",\"country\":\"France\"},\"location\":