ail\":\"no-reply@resawod.com\",\"phone\":\"004915206395167\"},\"social_media\":{\"instagram\":\"dboxcrossfit\",\"facebook\":\"https:\\/\\/www.facebook.com\\/dboxcf\\/\"}},{\"id_application\":null,\"id_lead\":\"2991\",\"name\":\"Crossfit Alzira\",\"description\":\"CrossFit Alzira - Tu Box oficial de CrossFit en Alzira (Valencia)\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2991\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2991\\/featured_images\\/17990327_1872754066197666_1101329067990364955_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2991\\/featured_images\\/42825742_2206309106175492_4321210297797836800_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2991\\/featured_images\\/42851108_2206308426175560_1003443835113570304_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2991\\/featured_images\\/42856398_2206308826175520_6256477013247262720_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2991\\/featured_images\\/42889969_2206308452842224_7088060442135756800_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2991\\/featured_images\\/42919077_2206308409508895_3244836268730744832_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2991\\/featured_images\\/42950852_2206308716175531_4121763449774538752_o.jpg\"],\"address\":{\"street\":\"Pla\\u00e7a, Carrer de Tavernes de la Valldigna, 45B\",\"town\":\"Alzira\",\"postal_code\":\"46600\",\"country\":\"Spain\"},\"location\":{\"latitude\":39.1765501,\"longitude\":-0.4211848},\"contact_info\":{\"email\":\"facutraining@gmail.com\",\"phone\":\"699925084\"},\"social_media\":{\"instagram\":\"crossfitalzira\",\"facebook\":\"@crossfitalzira\"}},{\"id_application\":null,\"id_lead\":\"2801\",\"name\":\"Exit 23 Box\",\"description\":\"M\\u00e1s all\\u00e1 de la definici\\u00f3n te\\u00f3rica de lo que es CrossFit (movimientos funcionales con constante variaci\\u00f3n ejecutados a una alta intensidad). Para nosotros es una manera de vivir, en la cual queremos incluir a todos los que est\\u00e1n alrededor nuestro.\\n\\nCrossfit Exit 23 es nutrici\\u00f3n, es deporte, es factor sorpresa, sufrimiento y solidaridad. Todo el mundo es bienvenido; nos marcaremos unos objetivos individuales y os trataremos a todos los atletas por igual; como si de magia se tratara esas superaciones individuales har\\u00e1n que toda la comunidad progrese. La honestidad y el respeto son la base de nuestras relaciones.\\n\\nMuchos atletas que pertenecen a Crossfit Exit 23 son campeones en diferentes deportes a nivel local, regional, nacional e incluso mundial, pero dentro de nuestro Box son un compa\\u00f1ero m\\u00e1s con los cuales tendremos las suerte de aprender de ellos y ellos de nosotros, nuestra primera norma es \\u201cdeja tu ego fuera\\u0022.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2801\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2801\\/featured_images\\/descarga-2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2801\\/featured_images\\/descarga.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2801\\/featured_images\\/maxresdefault.jpg\"],\"address\":{\"street\":\"Calle de la Garlopa, 62\",\"town\":\"Las Palmas\",\"postal_code\":\"35118\",\"country\":\"Spain\"},\"location\":{\"latitude\":27.8762355,\"longitude\":-15.4199499},\"contact_info\":{\"email\":\"\",\"phone\":\"639 542 760\"},\"social_media\":{\"instagram\":\"exit23box\",\"facebook\":\"\"}},{\"id_application\":\"62264948\",\"id_lead\":null,\"name\":\"Myrmidon Squad\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/62264948\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"30 faubourg de Chalons\",\"town\":\"vitry le fran\\u00e7ois\