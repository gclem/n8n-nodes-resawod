many\"},\"location\":{\"latitude\":50.9642934,\"longitude\":10.3204713},\"contact_info\":{\"email\":\"office@kampfsportschule-berk.de\",\"phone\":\"+49 36918290265\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"3145\",\"name\":\"CrossFit Limoges\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3145\\/featured_images\\/29872615_1247861665345825_4554687879172529403_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3145\\/featured_images\\/33663292_1280847888713869_8097531520819920896_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3145\\/featured_images\\/38016051_1345704212228236_2560364562176016384_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3145\\/featured_images\\/38186363_1347699985361992_3077497062909018112_o.jpg\"],\"address\":{\"street\":\"36 Rue de Nexon\",\"town\":\"Limoges\",\"postal_code\":\"87000\",\"country\":\"France\"},\"location\":{\"latitude\":45.8194276,\"longitude\":1.2636889},\"contact_info\":{\"email\":\"contact@thebox-limoges.fr\",\"phone\":\"\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/ExpressionAthletique\\/\"}},{\"id_application\":\"45839647\",\"id_lead\":null,\"name\":\"CrossFit Callisto\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/45839647\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"47 Avenue Pierre Mend\\u00e8s France\",\"town\":\"Quimper\",\"postal_code\":\"29000\",\"country\":\"France\"},\"location\":{\"latitude\":47.9778556,\"longitude\":-4.1250357},\"contact_info\":{\"email\":\"crossfitbesafe@nubapp-clients.com\",\"phone\":\"02 98 82 01 71\"},\"social_media\":{\"instagram\":\"crossfitcallisto\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2597\",\"name\":\"CrossFit Lambrate\",\"description\":\"CrossFit Lambrate \\u00e8 il primo Box di CrossFit nel quartiere Lambrate di Milano. Di certo una della poche palestre in citt\\u00e0, al confine tra Lambrate e Rubattino, con una superficie di oltre 600 mq interni e pi\\u00f9 di 900 mq esterni recintati, in cui allenarsi in assoluta sicurezza e concentrazione, sotto l\\u2019occhio vigile dei nostri Coach. CrossFit Lambrate si prefigge l\\u2019obiettivo di promuovere le discipline del CrossFit e della Pesistica Olimpica a tutti coloro i quali desiderano ottenere e mantenere un elevato livello di Fitness e benessere. Corsi di ginnastica, stretching e mobility completano il ventaglio delle attivit\\u00e0 di istruzione e didattica nei confronti dei nostri associati. CrossFit Lambrate si rivolge proprio a tutti, adulti e bambini, lavoratori e studenti, e il nostro motto \\u00e8 :\\n\\n\\u201cChi non sorride: NO REP!\\u201d\\n\\nVieni a fare una prova gratuita, diventa nostro socio e potrai seguire tutti i nostri corsi!\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2597\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2597\\/featured_images\\/39206556_1123735947778230_909733953726840832_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2597\\/featured_images\\/39441339_1127552970729861_3802857274733494272_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2597\\/featured_images\\/40898160_1142252285926596_3707577299332235264_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2597\\/featured_images\\/41661471_1146455788839579_7344236493809909760_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2597\\/featured_images\\/45124880_1174748532676971_1393783304926265344_n.jpg\"],\"address\":{\"street\":\"Via Privata Oslavia 1\",\"town\":\"Milano\",\"postal_code\":\"20134\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.481747,\"longitude\":9.245643},\"contact_info\":{\"email\":\"info@crossfitlambrate.com\",\"phone\":\"+39 391 152 9220\"},\"social_media\":{\"instagram\":\"crossfit_lambrate\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitLambrate\\/?ref=br_rs\"}},{\"id_application\":\"27669538\",\"id_lead\":null,\"name\":\"Crossfit Happy Hearts\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/27669538\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/27669538\\/featured_images\\/49561080_358269344960505_3231971939736092672_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/27669538\\/featured_images\\/50914185_370952043692235_4747910226299060224_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/27669538\\/featured_images\\/54358735_393409274779845_5967857130806444032_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/27669538\\/featured_images\\/54419107_393407664780006_4196312021764931584_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/27669538\\/featured_images\\/57216698_408418659945573_5157686931387056128_n.jpg\"],\"address\":{\"street\":\"9 Route de boys\",\"town\":\"Narrosse\",\"postal_code\":\"40180\",\"country\":\"France\"},\"location\":{\"latitude\":43.6992453,\"longitude\":-1.0306487},\"contact_info\":{\"email\":\"contact@crossfithappyhearts.fr\",\"phone\":\"\"},\"social_media\":{\"instagram\":\"crossfithappyhearts\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfithappyhearts\"}},{\"id_application\":\"37548536\",\"id_lead\":null,\"name\":\"Sparte\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/37548536\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"600 Rue de Terre rouge\",\"town\":\"Ch\\u00e2teau-Gontier-sur-Mayenne\",\"postal_code\":\"53200\",\"country\":\"France\"},\"location\":{\"latitude\":47.8