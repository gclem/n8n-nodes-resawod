:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2727\\/featured_images\\/cflex-box_0005-kl-420x280.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2727\\/featured_images\\/cflex-box_0007-kl-420x280.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2727\\/featured_images\\/cflex-box_0008-kl-420x280.jpg\"],\"address\":{\"street\":\"Stettenstr. 44\",\"town\":\"Frankfurt\",\"postal_code\":\"60322\",\"country\":\"Deutschland\"},\"location\":{\"latitude\":50.1121005,\"longitude\":8.7288236},\"contact_info\":{\"email\":\"info@crossfitlex.de\",\"phone\":\"+49 1634671356\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":\"76818875\",\"id_lead\":null,\"name\":\"Crossfit Sainte-Marie\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/76818875\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/76818875\\/featured_images\\/Cfit-22.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/76818875\\/featured_images\\/Cfit-3.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/76818875\\/featured_images\\/Cfit-31.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/76818875\\/featured_images\\/IMG_6946.jpg\"],\"address\":{\"street\":\"Impasse Mercure\",\"town\":\"Sainte-Marie\",\"postal_code\":\"97438\",\"country\":\"France\"},\"location\":{\"latitude\":-20.8986477,\"longitude\":55.5345948},\"contact_info\":{\"email\":\"contact@crossfitsaintemarie.com\",\"phone\":\"0692139016\"},\"social_media\":{\"instagram\":\"crossfit_sainte_marie\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitsaintemarie\"}},{\"id_application\":null,\"id_lead\":\"2983\",\"name\":\"Lifelong Crossfit\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2983\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2983\\/featured_images\\/Bildschirmfoto%202019-06-03%20um%2011.44.56.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2983\\/featured_images\\/Bildschirmfoto%202019-06-03%20um%2011.45.04.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2983\\/featured_images\\/Bildschirmfoto%202019-06-03%20um%2011.45.11.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2983\\/featured_images\\/Bildschirmfoto%202019-06-03%20um%2011.45.19.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2983\\/featured_images\\/Bildschirmfoto%202019-06-03%20um%2011.45.27.png\"],\"address\":{\"street\":\"An der Sparkasse 1\",\"town\":\"Greifswald\",\"postal_code\":\"17489\",\"country\":\"Germany\"},\"location\":{\"latitude\":54.073781,\"longitude\":13.3909278},\"contact_info\":{\"email\":\"info@Lifelong-CrossFit.de\",\"phone\":\"+49 1721657981\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/Lifelong.CrossFit\"}},{\"id_application\":null,\"id_lead\":\"3015\",\"name\":\"La Jaula\",\"description\":\"Crossfit La Jaula es un centro especializado en esta pr\\u00e1ctica deportiva situado en Las Chafiras en el sur de Tenerife. Un box de entrenamiento funcional que se encuentra afiliado y que cuenta con la autorizaci\\u00f3n de CrossFit Inc para impartir el programa original creado por Greg Glassman. Un lugar en el que se trabaja diariamente comprometidos con los siguientes par\\u00e1metros:\\nContar con entrenadores titulados y certificados con \\u201cLEVEL 1 TRAINER CERTIFICATED\\u201d para impartir CrossFit con total garant\\u00eda.\\nPreocupaci\\u00f3n por la correcta aplicaci\\u00f3n del Sistema de Entrenamiento, dise\\u00f1ado por Greg Glassman y constatado con toda la Comunidad CF Global.\\nEstar en constante aprendizaje para conocer a la perfecci\\u00f3n todas las actualizaciones de los nuevos m\\u00e9todos que CrossFit integra en su programa oficial.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3015\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3015\\/featured_images\\/14681980_1195920017169569_297194508313264911_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3015\\/featured_images\\/CGG6317_klein.jpg\"],\"address\":{\"street\":\"Arujo, n\\u00ba8, nave 22\",\"town\":\"Las Charifas\",\"postal_code\":\"38639\",\"country\":\"Spain\"},\"location\":{\"latitude\":28.0541546,\"longitude\":-16.6099189},\"contact_info\":{\"email\":\"crossfitlajaula@hotmail.com\",\"phone\":\"673 714 464\"},\"social_media\":{\"instagram\":\"crossfitlajaula\",\"facebook\":\"@Crossfitlajaula\"}},{\"id_application\":\"21891030\",\"id_lead\":null,\"name\":\"CrossFit Versailles\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/21891030\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/21891030\\/featured_images\\/CrossFit%20Versailles.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/21891030\\/featured_images\\/CrossFit%20Versailles2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/21891030\\/featured_images\\/CrossFit%20Versailles3.jpg\"],\"address\":{\"street\":\"34 Rue Edouard Charton\",\"town\":\"Versailles\",\"postal_code\":\"78000\",\"country\":\"France\"},\"location\":{\"latitude\":48.7931723,\"longitude\":2.128857},\"contact_info\":{\"email\":\"contact@crossfit-versailles.com\",\"phone\":\"0603008843\"},\"social_media\":{\"instagram\":\"crossfitversailles\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFit-Versailles-544455319388040\"}},{\"id_application\":\"58649591\",\"id_lead\":null,\"name\":\"La Cave\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/58649591\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"4 Rue du march\\u00e9 au fil\\u00e9\",\"town\":\"Arras\",\"postal_code\":\"62000\",\"country\":\"France\"},\"location\":{\"latitude\":50.2932089,\"longitude\":2.7777997},\"contact_info\":{\"email\":\"contact@lacave-arras.com\",\"phone\":\"06 59 73 58 15\"},\"social_media\":{\"instagram\":\"lacave_arras\",\"facebook\":\"La Cave Arras\"}},{\"id_application\":null,\"id_lead\":\"3057\",\"name\":\"Crossfit Astorga\",\"description\":\"CrossFit Astorga tiene diferentes espacios de entrenamiento totalmente equipados para que desarrolles al ma\\u0301ximo tus capacidades.\\nLos ejercicios se adaptan a todos los niveles y capacidades. Adema\\u0301s, las clases esta\\u0301n siempre dirigidas y supervisadas por, al menos, un coach profesional de CrossFit.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3057\\/logo\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Calle Gaspar Becerra, 25\",\"town\":\"Astorga\",\"postal_code\":\"24700\",\"country\":\"Spain\"},\"location\":{\"latitude\":42.4628013,\"longitude\":-6.0641031},\"contact_info\":{\"email\":\"info@crossfitastorga.com\",\"phone\":\"626509760\"},\"social_media\":{\"instagram\":\"crossfitastorga\",\"facebook\":\"@crossfitastorga\"}},{\"id_application\":null,\"id_lead\":\"2589\",\"name\":\"CrossFit SoulNest\",\"description\":\"The Sport of Fitness has arrived\\n\\n\\u200bCapovolgi la routine scoprendo una variet\\u00e0 di stimoli che ti faranno cambiare il modo di intendere lo sport.\\nScopri un nuovo modo di allenare il tuo corpo ma anche il tuo spirito. Mettiti alla prova affrontando ogni giorno un allenamento sempre diverso. Vieni a scoprire cosa sei in grado di fare.\\nL\\u0027unico Box con un\\u0027 area per le classi di 500mq e un\\u0027 area per l\\u0027allenamento autonomo di 250mq, entrambe con attrezzatura dedicata e rig separato.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2589\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2589\\/featured_images\\/32154071_1622893234454100_2187404995354165248_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2589\\/featured_images\\/36053106_1673382702738486_7944873857540685824_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2589\\/featured_images\\/44076972_1828829953860426_6747342202667532288_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2589\\/featured_images\\/46351764_1873450166065071_2527220419811868672_n.jpg\"],\"address\":{\"street\":\"Via Tiberina 44\",\"town\":\"Roma\",\"postal_code\":\"00060\",\"country\":\"Italia\"},\"location\":{\"latitude\":42.107228,\"longitude\":12.581283},\"contact_info\":{\"email\":\"crossfitsoulnest@gmail.com\",\"phone\":\"+39 0683776441\"},\"social_media\":{\"instagram\":\"crossfit_soulnest\",\"facebook\":\"https:\\/\\/www.facebook.com\\/Crossfitsoulnest\\/\"}},{\"id_application\":null,\"id_lead\":\"3036\",\"name\":\"Crossfit Wiesbaden\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3036\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3036\\/featured_images\\/Bildschirmfoto%202019-06-06%20um%2010.52.33.png\"],\"address\":{\"street\":\"Hasengartenstra\\u00dfe 22\",\"town\":\"Wiebaden\",\"postal_code\":\"65189\",\"country\":\"Germany\"},\"location\":{\"latitude\":50.063466,\"longitude\":8.2552072},\"contact_info\":{\"email\":\"info@crossfitwiesbaden.com\",\"phone\":\"+49 17682061435\"},\"social_media\":{\"instagram\":\"crossfitwiesbaden\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2923\",\"name\":\"Crossfit Orihuela\",\"description\":\"Primer y \\u00fanico BOX Oficial de CrossFit en Orihuela\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2923\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2923\\/featured_images\\/33873808_367306240427316_231185415095189504_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2923\\/featured_images\\/48397794_499622653862340_4852017738178101248_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2923\\/featured_images\\/dsc00386-nhcvfdtyt902f1hgu98wzk1tvdlogl46cl7h0zzvjk.jpg\"],\"address\":{\"street\":\"Oriolanos Ausentes s\\/n Edificio HIspania\",\"town\":\"Alicante\",\"postal_code\":\"03300\",\"country\":\"Spain\"},\"location\":{\"latitude\":38.1512705,\"longitude\":-1.2056172},\"contact_info\":{\"email\":\"paloma@crossfitorihuela.com\",\"phone\":\"656 339 412\"},\"social_media\":{\"instagram\":\"crossfitorihuela\",\"facebook\":\"@CrossFit-Orihuela-289618908196050\"}},{\"id_application\":null,\"id_lead\":\"2705\",\"name\":\"Crossfit 20457\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2705\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2705\\/featured_images\\/Bildschirmfoto%202019-04-15%20um%2013.26.01.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2705\\/featured_images\\/Bildschirmfoto%202019-04-15%20um%2013.26.23.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2705\\/featured_images\\/Bildschirmfoto%202019-04-15%20um%2013.26.31.png\"],\"address\":{\"street\":\"Shanghaiallee 17\",\"town\":\"Hamburg\",\"postal_code\":\"20457\",\"country\":\"Deustchaland\"},\"location\":{\"latitude\":53.5424103,\"longitude\":10.0010891},\"contact_info\":{\"email\":\"lars@crossfit20457.com\",\"phone\":\"+49 4030384156\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":\"79416923\",\"id_lead\":null,\"name\":\"FGT SPORT\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/79416923\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"81 Rue de l\\u0027Abrivado\",\"town\":\"Castries\",\"postal_code\":\"34160\",\"country\":\"France\"},\"location\":{\"latitude\":43.6697424,\"longitude\":3.9751463},\"contact_info\":{\"email\":\"bonjour@fgtsport.fr\",\"phone\":\"06 37 32 32 96\"},\"social_media\":{\"instagram\":\"fgtsportcastries\",\"facebook\":\"https:\\/\\/www.facebook.com\\/FGTCrossFit\"}},{\"id_application\":null,\"id_lead\":\"3121\",\"name\":\"CrossFit La Croix-Valmer\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3121\\/featured_images\\/33152689_374953963012135_2669896768073760768_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3121\\/featured_images\\/42924787_473403269833870_6073042249980051456_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3121\\/featured_images\\/43075320_473403209833876_5094777042163990528_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3121\\/featured_images\\/61839759_606086309898898_6634037331856719872_o.jpg\"],\"address\":{\"street\":\"Z.A. le Gourbenet\",\"town\":\"La Croix-Valmer\",\"postal_code\":\"83420\",\"country\":\"France\"},\"location\":{\"latitude\":43.214834,\"longitude\":6.568543},\"contact_info\":{\"email\":\"power-training@hotmail.com\",\"phone\":\"+33 6 22 44 72 86\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitLaCroixValmer\\/\"}},{\"id_application\":\"23836643\",\"id_lead\":null,\"name\":\"Rednose Academy\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/23836643\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Chemin des moles\",\"town\":\"Pinsaguel\",\"postal_code\":\"31120\",\"country\":\"France\"},\"location\":{\"latitude\":43.4919252,\"longitude\":1.394011},\"contact_info\":{\"email\":\"crossfitrednose@nubapp-clients.com\",\"phone\":\"0648041241\"},\"social_media\":{\"instagram\":\"rednosecrossfit31120\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2800\",\"name\":\"Crossfit El Tiro\",\"description\":\"CrossFit es un novedoso m\\u00e9todo de entrenamiento ideado por expertos en condicionamiento f\\u00edsico. Cada entrenamiento es distinto al anterior y novedoso.\\n\\nTodo el cuerpo se trabaja en conjunto. Este entrenamiento no a\\u00edsla el trabajo muscular como ocurre cuando ejercitamos nuestro cuerpo con m\\u00e1quinas convencionales. Los movimientos practicados en CrossFit son los que se utilizan a diario en la vida cotidiana, por ello que sus resultados sean tan efectivos.\\n\\nSe prepara el cuerpo para que pueda superar grandes esfuerzos y as\\u00ed se notar\\u00e1n mejor\\u00edas significativas en la forma f\\u00edsica desde el primer d\\u00eda. Cada d\\u00eda se superan nuevos retos y a futuro se conseguir\\u00e1n muchos m\\u00e1s.\\n\\nSe trata de un programa de entrenamiento que ayuda a conseguir varios objetivos (p\\u00e9rdida de peso, fortalecer y tonificar m\\u00fasculos, aumentar capacidad cardiovascular\\u2026) dado que no nos especializamos en competencias f\\u00edsicas concretas, sino que procuramos optimizar todas las competencias f\\u00edsicas por igual. De esta forma, aparte de estar en el mejor estado f\\u00edsico que se puede llegar a alcanzar, se est\\u00e1 preparado para superar cualquier obst\\u00e1culo.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2800\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2800\\/featured_images\\/B6L3GkhIYAANJJP.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2800\\/featured_images\\/Bw21BgdCYAE33cH.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2800\\/featured_images\\/s01%402x.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2800\\/featured_images\\/s04%402x.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2800\\/featured_images\\/s05%402x.jpg\"],\"address\":{\"street\":\"Antonio Belmonte Abell\\u00e1n\",\"town\":\"Murcia\",\"postal_code\":\"30100\",\"country\":\"Spain\"},\"location\":{\"latitude\":38.019074,\"longitude\":-1.1636976},\"contact_info\":{\"email\":\"info@crossfiteltiro.com\",\"phone\":\"968 85 91 53\"},\"social_media\":{\"instagram\":\"crossfiteltiro\",\"facebook\":\"@boxmurcia\"}},{\"id_application\":null,\"id_lead\":\"2739\",\"name\":\"CrossFit Padova\",\"description\":\"Nel cuore di Padova \\u2013 in  via Makall\\u00e9 73\\/A \\u2013 ma perfettamente collegata alle tangenziali, Dinamica \\u00e8 un  complesso sportivo e centro polifunzionale con spazi dedicati e perfettamente strutturati per le discipline proposte.\\n\\nNel suoi 1000 metri quadrati, Dinamica ha un box di CrossFit, un Squash Club con tre campi climatizzati, una Sala Corsi, una Sala Isotonica con zona Kinesis e comodi spazi con spogliatoi e docce.\\n\\nLa struttura \\u00e8 dotata delle migliori tecnologiche ed attrezzature, ogni disciplina \\u00e8 coordinata e gestita da istruttori qualificati e tutto il personale di Dinamica \\u00e8 a disposizione delle esigenze del cliente. Dal personal trainer al nutrizionista, sono tante le figure professionali che il Club mette a disposizione per soddisfare ogni tipo di richiesta del cliente.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2739\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2739\\/featured_images\\/45469192_1983919658354945_2423178857155657728_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2739\\/featured_images\\/45506229_1983882855025292_2349154339894853632_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2739\\/featured_images\\/45573636_1983908561689388_2201664961086750720_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2739\\/featured_images\\/51912013_2114409655305944_3343623926742777856_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2739\\/featured_images\\/57543528_2215709811842594_7092723801661636608_o.jpg\"],\"address\":{\"street\":\"Via Makall\\u00e8, 73\\/A\",\"town\":\"Padova\",\"postal_code\":\"35138\",\"country\":\"Italy\"},\"location\":{\"latitude\":45.4127538,\"longitude\":11.8556719},\"contact_info\":{\"email\":\"squashclubpadova@gmail.com\",\"phone\":\"+39 0490971490\"},\"social_media\":{\"instagram\":\"crossfitpadova\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitPadova1\\/\"}},{\"id_application\":null,\"id_lead\":\"3129\",\"name\":\"Crossfit Pirmasens\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3129\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3129\\/featured_images\\/about-pic-1.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3129\\/featured_images\\/about-pic-2.png\"],\"address\":{\"street\":\"Adam-M\\u00fcller-Stra\\u00dfe 4,\",\"town\":\"Pirmasens\",\"postal_code\":\"66954\",\"country\":\"Germany\"},\"location\":{\"latitude\":49.199806,\"longitude\":7.5981802},\"contact_info\":{\"email\":\"crossfitpirmasens@web.de\",\"phone\":\"+49 1622761285\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":\"48494667\",\"id_lead\":null,\"name\":\"Ardennes CrossFit\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/48494667\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/48494667\\/featured_images\\/Logo_Ardennes_CrossFit.png\"],\"address\":{\"street\":\"Boulevard Pieret 28\",\"town\":\"Hamoir\",\"postal_code\":\"4180\",\"country\":\"Belgium\"},\"location\":{\"latitude\":50.4312219,\"longitude\":5.5339355},\"contact_info\":{\"email\":\"ardennescrossfit@nubapp-clients.com\",\"phone\":\"0495167901\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2998\",\"name\":\"Crossfit Naranco\",\"description\":\"El box es el lugar donde se practica CrossFit. Basado en la filosof\\u00eda de entrenar en tu propio garaje, normalmente se caracterizan por el ambiente industrial y la decoraci\\u00f3n austera, frente a la cl\\u00e1sica comodidad de un gimnasio convencional.\\n\\nCrossFit Naranco ofrece m\\u00e1s de 600 metros cuadrados de instalaciones para entrenar CrossFit, espec\\u00edficamente ideadas para tal fin y con el material necesario para la correcta pr\\u00e1ctica del mismo.\\n\\nBarras y Discos de todos los pesos, Dumbell, Remos, Cajones, Cuerdas, Wall Ball, Slam Ball, Kettlebell... as\\u00ed como dos espacios de barras y anillas, para el trabajo de gimn\\u00e1sticos.\\n\\nAdem\\u00e1s, cuenta con un carril de c\\u00e9sped artificial para el trabajo de empuje y para los estiramientos.\\n\\nTe invitamos a que pases a conocer el Box y a sentirte como nosotros: en tu casa.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2998\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2998\\/featured_images\\/1010813_1474555716160980_5064277053882067368_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2998\\/featured_images\\/12144815_1634609640155586_4580627504178149082_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2998\\/featured_images\\/fiestaverano.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2998\\/featured_images\\/home-video.png\"],\"address\":{\"street\":\"Juan Varela, 9 bajo\",\"town\":\"Oviedo\",\"postal_code\":\"33012\",\"country\":\"Spain\"},\"location\":{\"latitude\":43.3728358,\"longitude\":-5.8537338},\"contact_info\":{\"email\":\"boxcrossfitnaranco@gmail.com\",\"phone\":\"650 30 21 39\"},\"social_media\":{\"instagram\":\"crossfitnaranco_\",\"facebook\":\"@crossfitnarancooviedo\"}},{\"id_application\":\"2495438