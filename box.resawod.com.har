/applications\\/12595147\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"4 impasse Paul S\\u00e9journ\\u00e9 - ZAC NATUROPOLE III\",\"town\":\"Toulouges\",\"postal_code\":\"66350\",\"country\":\"France\"},\"location\":{\"latitude\":42.6629287,\"longitude\":2.817549},\"contact_info\":{\"email\":\"franckcobo@orange.fr\",\"phone\":\"0659425528\"},\"social_media\":{\"instagram\":\"crossfitaltisea\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFit-Altisea-105420601087394\\/\"}},{\"id_application\":null,\"id_lead\":\"2586\",\"name\":\"CrossFit Trionfale\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2586\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2586\\/featured_images\\/27858748_1244280565706020_4883740133447790555_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2586\\/featured_images\\/29510994_1270798973054179_7756174572470140928_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2586\\/featured_images\\/515A1274rid.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2586\\/featured_images\\/515A1302rid.jpg\"],\"address\":{\"street\":\"via Acquedotto del Peschiera, 148\",\"town\":\"Roma\",\"postal_code\":\"00135\",\"country\":\"Italia\"},\"location\":{\"latitude\":41.9380552,\"longitude\":12.4220637},\"contact_info\":{\"email\":\"info@starfitnessroma.it\",\"phone\":\"+39 06 30600129\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFit-Trionfale-795359217264826\\/\"}},{\"id_application\":null,\"id_lead\":\"2957\",\"name\":\"Crossfit Eixample\",\"description\":\"Te entendemos. Nos tomamos el tiempo para conocerte. Llegamos a saber qu\\u00e9 es lo que realmente te importa y c\\u00f3mo podemos ayudarte a conseguirlo.\\n\\nCuando entras en un gimnasio t\\u00edpico, notar\\u00e1s que pocas personas realmente se comunican. No hay una comunidad real, pagas una suscripci\\u00f3n y ya. En CFX pagas por excelentes entrenamientos junto con una gran comunidad.\\n\\nEstas personas se preocupan cuando no vienes por unos d\\u00edas y se aseguran de que todo est\\u00e9 bien. Estas personas se preocupan si pasas las vacaciones s\\u00f3lo. Estas personas se ayudan cada vez que pueden. Se trata de mejorar la salud y el rendimiento junto con la mejor comunidad que puedas encontrar.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2957\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2957\\/featured_images\\/WhatsApp-Image-2019-02-08-at-12.15.58-3.jpeg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2957\\/featured_images\\/crossfit-eixample.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2957\\/featured_images\\/maxresdefault.jpg\"],\"address\":{\"street\":\"C\\/Ausias Marc, 45\",\"town\":\"Barcelona\",\"postal_code\":\"08010\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.3925352,\"longitude\":2.1748076},\"contact_info\":{\"email\":\"info@crossfiteixample.com\",\"phone\":\"637544546\"},\"social_media\":{\"instagram\":\"crossfiteixample\",\"facebook\":\"@crossfiteixample\"}},{\"id_application\":null,\"id_lead\":\"2706\",\"name\":\"Hanseatik Crossfit\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2706\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2706\\/featured_images\\/Bildschirmfoto%202019-04-15%20um%2013.36.19.png\"],\"address\":{\"street\":\"Warnholtzstra\\u00dfe 4,\",\"town\":\"Hamburg\",\"postal_code\":\"22767\",\"country\":\"Germany\"},\"location\":{\"latitude\":53.5550065,\"longitude\":9.9432411},\"contact_info\":{\"email\":\"\",\"phone\":\"+49 1736366607\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/Hanseatic-CrossFit-1400963126825814\\/\"}},{\"id_application\":\"31308791\",\"id_lead\":null,\"name\":\"CrossFit Muratum\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/31308791\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/31308791\\/featured_images\\/CF-Muratum-new-500.png\"],\"address\":{\"street\":\"Au Tombex 31\",\"town\":\"Courgevaux\",\"postal_code\":\"1796\",\"country\":\"Switzerland\"},\"location\":{\"latitude\":46.9160227,\"longitude\":7.1073968},\"contact_info\":{\"email\":\"info@crossfitmuratum.ch\",\"phone\":\"+41794268548\"},\"social_media\":{\"instagram\":\"Crossfitmuratum\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFit-Muratum-323839964755050\"}},{\"id_application\":\"82550190\",\"id_lead\":null,\"name\":\"CrossFit Pontarlier\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/82550190\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"4 GRANDE RUE\",\"town\":\"Granges-Narboz\",\"postal_code\":\"25300\",\"country\":\"France\"},\"location\":{\"latitude\":46.8793774,\"longitude\":6.3170029},\"contact_info\":{\"email\":\"cfpontarlier@nubapp-clients.com\",\"phone\":\"0668118762\"},\"social_media\":{\"instagram\":\"crossfitpontarlier\",\"facebook\":\"CrossFit Pontarlier\"}},{\"id_application\":\"33181590\",\"id_lead\":null,\"name\":\"CrossFit Tampon\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/33181590\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Rue Evenor Lallemand\",\"town\":\"Le Tampon\",\"postal_code\":\"97430\",\"country\":\"Reunion\"},\"location\":{\"latitude\":-21.2846011,\"longitude\":55.5205264},\"contact_info\":{\"email\":\"contact@crossfit-tampon.re\",\"phone\":\"06 92 18 12 72\"},\"social_media\":{\"instagram\":\"crossfittampon\",\"facebook\":\"Crossfit Tampon\"}},{\"id_application\":\"68768854\",\"id_lead\":null,\"name\":\"Crossfit Atalante\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/68768854\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"55 Av. Larribau\",\"town\":\"Pau\",\"postal_code\":\"64000\",\"country\":\"France\"},\"location\":{\"latitude\":43.321638,\"longitude\":-0.313522},\"contact_info\":{\"email\":\"crossfitatalante@gmail.com\",\"phone\":\"0559984384\"},\"social_media\":{\"instagram\":\"crossfitatalante\",\"facebook\":\"\"}},{\"id_application\":\"28709373\",\"id_lead\":null,\"name\":\"Crossfit Cenabum\",\"description\":\"rossFit Cenabum (mot latin pour \\u0022Orl\\u00e9ans\\u0022) a \\u00e9t\\u00e9 fond\\u00e9 par deux coachs, Florent Doradoux et Cl\\u00e9ment Perrin. Forts de leur exp\\u00e9rience et passion pour la discipline, ces deux coachs ont tr\\u00e8s vite compris tout l\\u2019int\\u00e9r\\u00eat de ce programme de pr\\u00e9paration physique et se sont form\\u00e9s sp\\u00e9cifiquement \\u00e0 la discipline (voir leurs profil ici) avant d\\u2019obtenir leur affiliation CrossFit.\\n\\nD\\u00e9marr\\u00e9 en 2014, CrossFit Cenabum a officiellement vu le jour en 2015 pour devenir la premi\\u00e8re Box affili\\u00e9e de la r\\u00e9gion Centre.\\nSuivant le protocole CrossFit de mani\\u00e8re traditionnelle, les deux coachs de CrossFit Cenabum vous apporteront leur exp\\u00e9rience personnelle afin de vous aider \\u00e0 atteindre au mieux vos objectifs.\\nCenabum en hommage \\u00e0 Orl\\u00e9ans, la box est situ\\u00e9e en p\\u00e9riph\\u00e9rie de la ville, au 90 rue d\\u2019Alsace 45160, dans la zone commerciale d\\u2019Olivet. La salle se veut accessible, familiale et chaleureuse. Elle offre un coaching de qualit\\u00e9 et du mat\\u00e9riel haut de gamme : Eleiko pour le rig et le mat\\u00e9riel d\\u2019halt\\u00e9rophilie, Rogue pour le petit mat\\u00e9riel de gymnastique et Strongman, Concept 2 pour les rameurs. La salle dispose \\u00e9galement d\\u2019un Skierg, d\\u2019un Wattbike, d\\u2019Assaut air bikes et de toute une gamme professionnelle de Kettlebell.\\n\\nLes adh\\u00e9rents pourront r\\u00e9server leur WOD via notre planning de r\\u00e9servation sur internet et\\/ou application mobile. Les WOD seront ouverts \\u00e0 tous dans une limite de 16 personnes avec des cr\\u00e9neaux le matin, midi et soir et des planifications individualis\\u00e9es pour les comp\\u00e9titeurs.\\n\\nParce qu\\u2019il n\\u2019est pas toujours facile de prendre son entrainement et sa vie en main, CrossFit peut \\u00eatre la solution et c\\u2019est tout pr\\u00eat de chez vous, alors n\\u2019attendez plus !\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/28709373\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/28709373\\/featured_images\\/image%20cenabum.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/28709373\\/featured_images\\/image%20cenabum2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/28709373\\/featured_images\\/image%20cenabum3.jpg\"],\"address\":{\"street\":\"537 Rue de la Juine\",\"town\":\"Olivet\",\"postal_code\":\"45160\",\"country\":\"France\"},\"location\":{\"latitude\":47.8479375,\"longitude\":1.9166875},\"contact_info\":{\"email\":\"contact@crossfitcenabum.com\",\"phone\":\"(+33) 02 38 44 88 18\"},\"social_media\":{\"instagram\":\"crossfitcenabum\",\"facebook\":\"CrossFitCenabum\"}},{\"id_application\":null,\"id_lead\":\"2940\",\"name\":\"La Galerna Training Club\",\"description\":\"No se abre un box de CF de la noche a la ma\\u00f1ana. El primer paso NECESARIO y OBLIGATORIO es CONOCER TU DEPORTE.\\n\\nUna vez que contraes la responsabilidad de tener la salud de otras personas en tus manos, aprendes que no existen protocolos universales, que cada deportista es un mundo, con una trayectoria, historial de lesiones y fisiolog\\u00eda \\u00fanicos, que no todos tus clientes responden al entrenamiento igual y que las indicaciones que sirven para unos, no funcionan para otros. Aprendes a que, si no conf\\u00edan en ti, no hay nada que hacer, que es esencial establecer v\\u00ednculos con tus deportistas, escuchar sus inquietudes e interesarte sinceramente por sus preocupaciones.\\n\\nA todo ello hay que a\\u00f1adir las incontables horas de estudio que nadie ve, pero que se perciben inmediatamente cuando abres la boca: fisiolog\\u00eda del ejercicio, biomec\\u00e1nica, psicomotricidad, periodizaci\\u00f3n del entrenamiento, psicolog\\u00eda deportiva\\u2026 Dise\\u00f1ar protocolos para un deporte como el CrossFit es una labor harto complicada. El trabajo del entrenador es, ante todo, una profesi\\u00f3n INTELECTUAL, RACIONAL y EMP\\u00cdRICA. Aprendes a rodearte de profesionales que saben m\\u00e1s que t\\u00fa, a segregar al oportunista del experto.\\n\\nEn definitiva, para convertirse en un buen entrenador se necesita tiempo y paciencia para dejar que las cosas ocurran. No existen atajos. NO SE PUEDEN FORZAR ETAPAS, NO HAY OTRA MANERA DE HACER LAS COSAS.\\n\\nLa Galerna no nace de la noche a la ma\\u00f1ana: es la culminaci\\u00f3n de un proceso que ha durado casi 8 a\\u00f1os\\u2026 y es tambi\\u00e9n un comienzo, un punto de partida para lo mucho y muy bueno que est\\u00e1 por llegar.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2940\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2940\\/featured_images\\/FB_IMG_1436648248388-01-2.jpeg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2940\\/featured_images\\/Untitled-design-1.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2940\\/featured_images\\/gimn%C3%A1sticos-1.jpg\"],\"address\":{\"street\":\"Av. del Transporte, 11, nave 7\",\"town\":\"Gijon\",\"postal_code\":\"33211\",\"country\":\"Spain\"},\"location\":{\"latitude\":43.5294906,\"longitude\":-5.7078817},\"contact_info\":{\"email\":\"cflagalerna@gmail.com\",\"phone\":\"617938050\"},\"social_media\":{\"instagram\":\"cflagalerna\",\"facebook\":\"@CFLaGalerna\"}},{\"id_application\":null,\"id_lead\":\"2900\",\"name\":\"Crossfit bergara\",\"description\":\"El Box equipado con el mejor material a nivel Espa\\u00f1ol y Europeo de la mano de Singular WOD, lideres en material CrossFit. Dispondras de todo lo necesario para trabajar correctamente cualquier movimiento de CrossFit\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2900\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2900\\/featured_images\\/36382080_2163478520604189_2828328001270185984_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2900\\/featured_images\\/50839993_1903527103102935_1061418034017131845_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2900\\/featured_images\\/53593532_2740888135951420_5293999493670239276_n.jpg\"],\"address\":{\"street\":\"Antziturri kalea 6A\",\"town\":\"Bergara\",\"postal_code\":\"20570\",\"country\":\"Spain\"},\"location\":{\"latitude\":43.125275,\"longitude\":-2.42153},\"contact_info\":{\"email\":\"info@crossfitbergara.com\",\"phone\":\"660378008\"},\"social_media\":{\"instagram\":\"crossfitbergara\",\"facebook\":\"@crossfitbergara\"}},{\"id_application\":\"32953646\",\"id_lead\":null,\"name\":\"CrossFit Vauban \\u0026 Hygie \\u0026 Alea\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/32953646\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/32953646\\/featured_images\\/40600213_381668822370622_7984394634769989632_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/32953646\\/featured_images\\/42953269_392559067948264_1414486924193693696_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/32953646\\/featured_images\\/49842986_441001963103974_271964274144837632_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/32953646\\/featured_images\\/55644623_477549926115844_3893597199119941632_o.jpg\"],\"address\":{\"street\":\"28 Rue d\\u0027Esquermes\",\"town\":\"Lille\",\"postal_code\":\"59000\",\"country\":\"France\"},\"location\":{\"latitude\":50.6245392,\"longitude\":3.0440822},\"contact_info\":{\"email\":\"contact@crossfit-vauban.fr\",\"phone\":\"03 20 95 20 80\"},\"social_media\":{\"instagram\":\"crossfitvauban\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitvauban\"}},{\"id_application\":null,\"id_lead\":\"2664\",\"name\":\"Arsenale CrossFit Vecchia Ferriera\",\"description\":\"LA STRUTTURA\\nPer diverso tempo abbiamo ricercato una location che fosse davvero UNICA e non replicabile, un luogo che da solo fosse identificativo di se stesso, la cui storia potesse comunicare esclusivit\\u00e0.\\n\\nDopo un anno di ricerca siamo approdati a uno stabile di fine 800, il vecchio Arsenale dei treni di Vicenza, ubicato nello stesso stabile della discoteca Totem di fronte al centro orafo.\\n\\nAbbiamo iniziato i lavori per riportarlo alla sua vecchia origine e, mano a mano che scrostavamo i recenti intonaci sui muri, la bellezza e la storia di Arsenale ci hanno fatto innamorare sempre di pi\\u00f9 di questo luogo che vive di un\\u2019energia propria.\\n\\nAl fine di valorizzare la sua essenza, abbiamo scelto per l\\u2019interno un design molto industriale riportando a vista le pietre e i mattoni originali. \\n\\nAnche gli altri dettagli del design parlano della sua storia: il  legno di recupero come elemento decorativo, gli armadietti   degli anni 70 restaurati e il pavimento industriale opportunamente trattato.\\n\\nLe due sale in cui si svolgeranno le classi si differenziano sia da una palestra tradizionale che da un box di CrossFit: gli spazi sono completamente modulabili e trasformabili a seconda della necessit\\u00e0. Tutta l\\u2019attrezzatura pu\\u00f2 in questo modo essere utilizzata per soddisfare le diverse esigenze dei nostri trainer.\\n\\n\\n1\\/1\\n\\nARSENALE Train Different\\nIn Arsenale ogni settimana avete la possibilit\\u00e0 di scegliere tra quasi 50 classi.\\n\\nLa scelta sar\\u00e0 fra tre principali programmi di allenamento tutti ad alta intensit\\u00e0 e costantemente variabili. \\n\\n \\n\\nTutte le nostre classi di Fitness Funzionale uniscono elementi di cardio, forza, agilit\\u00e0 e molto altro.\\n\\nSono tenute da coach preparati che studiano e si allenano coi nostri programmi e che ti accompagneranno durante lo svolgimento della lezione.\\n\\n \\n\\nI NOSTRI PROGRAMMI DI ALLENAMENTO\\nIn Arsenale al primo posto viene la persona.\\n\\nIl suo movimento funzionale \\u00e8 alla base dei nostri sistemi di allenamento.\\n\\n \\n\\nIL NOSTRO METODO\\nI nostri programmi sono studiati per funzionare.\\n\\nEcco la ragione per cui utilizziamo movimenti funzionali.\\n\\nLa loro intensit\\u00e0 \\u00e8 variabile e sono totalmente scalabili, consentendo di adattare il programma allo stato fisico di chi li pratica.\\n\\nI NOSTRI TRAINER\\nI nostri trainer sono tutti altamente specializzati in allenamento ad alta intensit\\u00e0 costantemente variabile.\\n\\nOgnuno di loro si allena secondo i principi dei nostri programmi.\\n\\n\\nGABRIELE CONEGO\\nHead coach\\n\\n\\u200b\\n\\nDopo una laurea in scienze della comunicazione e molti anni come responsabile organizzativo di eventi fitness, gli viene affidata la gestione del reparto fitness di un grande centro sportivo a Padova.\\n\\nIn questi anni conosce il CrossFit e se ne innamora, abbandonando completamente ogni altro ambito del fitness per concentrarsi sulla formazione in questa materia.\\n\\nCrossFit Level 2 Trainer (CF-L2).\\n\\nCrossFit Competitor Trainer, Gymnastics Trainer, Advance Gymnastics Trainer, Mobility Trainer, Strongman Trainer, Judges Certificate.\\n\\nSpeaker ufficiale per Fall Series, la gara italiana di CrossFit pi\\u00f9 importante sul nostro territorio.\\n\\nNel 2011, quando ancora questo sport era conosciuto solo da pochi appassionati, fonda Urban Block CrossFit, uno dei primi 10 box ufficiali in Italia.\\n\\nIn Arsenale Gabriele si occupa di coordinare lo staff trainer oltre che stilare il programma Asenale 30 e Arsenale 45. \\n\\n\\n\\n\\nLEONARDO RANZATO\\nCoach\\n\\n\\u200b\\n\\nCome spesso succede, Leonardo si avvicina al CrossFit perch\\u00e8 stufo di allenarsi con i soliti programmi di fitness noiosi e ripetitivi. Da buon Italiano il suo primo approccio con lo sport avviene attraverso il calcio.\\n\\nNegli anni si appassiona cos\\u00ec tanto al CrossFit, che decide di conseguire la certificazione CrossFit L1 e l\\u2019abilitazione all\\u2019insegnamento. Atleta agonista partecipa a diverse competizioni nazionali. L\\u2019esperienza come trainer presso Urban Block Crossfit ha reso il suo insegnamento solido e ben strutturato. In breve tempo \\u00e8 diventato un punto di riferimento per molti allievi che ritrovano in lui una figura seria, professionale e sempre disponibile.\\n\\nIn Arsenale coordiner\\u00e0 Arsenale 60 oltre ad insegnare Arsenale 30 e Arsenale 45.\\n\\n\\nENRICO \\u201cFARMA\\u201d BOVOLENTA\\nCoach\\n\\n\\u200b\\n\\nUn passato da cestista e una laurea specialistica in farmacia assieme a una grande passione per le alzate olimpiche sono i tratti principali di Farma.\\n\\nMetodico, molto preparato e sempre sorridente, comincia ad affiancare Gabriele presso Urban Block CrossFit nell\\u2019insegnamento e nel 2018 segue il corso specialistico FIPE di strappo e slancio.\\n\\nDal 2015 al 2017 atleta agonista e finalista a Fall Series.\\n\\n \\n\\nEnrico sar\\u00e0 l\\u2019insegnante di weightlifting di Arsenale e il capitano della squadra agonistica.\\n\\n\\n\\n\\nLUCA \\u201cPIZZA\\u201d MATTEAZZI\\nCoach\\n\\n\\u200b\\n\\nLuca ha un passato da ciclista professionista, dal 2010 al 2012 nella categoria elite under 23, in cui consegue ottimi risultati sia a livello nazionale che internazionale.\\n\\nDopo il suo trascorso come atleta agonista decide di passare dall\\u2019altra parte della barricata e dal 2012 a luglio 2013 svolge il compito di allenatore e direttore sportivo presso la \\u201cG.S.D. Mainetti PamaFlock Damas\\u201d di Creazzo (Vi), squadra di ciclismo agonista. \\n\\nNegli anni successivi prende l\\u2019 abilitazione di Personal Trainer frequentando i corsi organizzati dalla \\u201cFederazione Italiana Fitness\\u201d, conseguendo anche una formazione a livello integrativo e alimentare per il cliente.\\n\\nNel 2013 scopre il CrossFit, se ne innamora, si butta con anima e corpo in questo sport, conseguendo diverse qualificazioni alle fasi finali in competizioni internazionali.\\n\\nLuca ha un talento innato, la capacit\\u00e0 di coinvolgere e insegnare ai bambini fuori dal comune. Dal 2011 infatti gestisce corsi di attivit\\u00e0 motoria e avviamento allo sport per bambini delle scuole dell\\u2019infanzia e primaria.\\n\\nIn Asenale Luca sar\\u00e0 il responsabile per l\\u2019attivit\\u00e0 Kids di avviamento allo sport, oltre che Trainer nei nostri programmi base.\\n\\n\\nGiulia\\nCoach\\n\\n\\u200b\\n\\nLaurea in Scienze Motorie e diploma in massofisioterapia   anni di esperienza nell\\u2019ambito educativo motorio presso strutture sportive e riabilitative, nell\\u2019ambito terapeutico (riabilitazione attraverso la kinesiologia e l\\u2019attivit\\u00e0 di rieducazione funzionale e posturale) sono solo alcuni dei titoli di Giulia che  gestir\\u00e0 il programma Primo Mattino in Arsenale.\\n\\nLa sua porfessionalit\\u00e0 \\u00e8 seconda sola alla sua energia, alla sua solarit\\u00e0 e alla carica. Giulia \\u00e8 specializzata da anni nell\\u2019insegnamento a un pubblico femminile, ma le sue classi metteranno alla prova anche uomini allenati.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2664\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2664\\/featured_images\\/19149200_1345838525470549_1151809450630634865_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2664\\/featured_images\\/19702166_1366473396740395_8904503705918811138_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2664\\/featured_images\\/45390877_1892160254171704_3768282818065465344_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2664\\/featured_images\\/53597407_2075194209201640_1352659306599677952_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2664\\/featured_images\\/54800008_2075194602534934_6838120635730755584_n.jpg\"],\"address\":{\"street\":\"Via Vecchia Ferriera, 145\",\"town\":\"Vicenza\",\"postal_code\":\"36100\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.5370336,\"longitude\":11.5026605},\"contact_info\":{\"email\":\"gabriele.conego@gmail.com\",\"phone\":\"+39 347 784 5233\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/vecchiaferrieracrossfit\\/\"}},{\"id_application\":null,\"id_lead\":\"2944\",\"name\":\"Crossfit Valencia\",\"description\":\"Box Oficial de CrossFit en el centro de Valencia.\\nNo uses maquinas, convi\\u00e9rtete en una!\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2944\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2944\\/featured_images\\/36331411_655092498164123_1366834811800387584_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2944\\/featured_images\\/52599258_818629618477076_8259222007128784896_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2944\\/featured_images\\/52602124_818629525143752_8880634488447565824_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2944\\/featured_images\\/52898403_818629541810417_6110453223309443072_n.jpg\"],\"address\":{\"street\":\"C\\/Doctor Gil y Morter, 2 bajo derecha\",\"town\":\"Valencia\",\"postal_code\":\"46007\",\"country\":\"Spain\"},\"location\":{\"latitude\":39.4727493,\"longitude\":-0.4674411},\"contact_info\":{\"email\":\"info@crossfit-valencia.com\",\"phone\":\"636491534\"},\"social_media\":{\"instagram\":\"crossfitvalenciaoficial\",\"facebook\":\"@CrossFit-Valencia-606055806401126\"}},{\"id_application\":\"11469390\",\"id_lead\":null,\"name\":\"Crossfit BeTribe\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/11469390\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Las Beatas, 37\",\"town\":\"San Pedro del Pinatar\",\"postal_code\":\"30740\",\"country\":\"Espa\\u00f1a\"},\"location\":{\"latitude\":37.8263053,\"longitude\":-0.8060885},\"contact_info\":{\"email\":\"info@crossfitbetribe.com\",\"phone\":\"674149610\"},\"social_media\":{\"instagram\":\"betribecrossfit\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2910\",\"name\":\"CrossFit 83 Le Beausset\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2910\\/featured_images\\/22851874_1996101014002643_8460956746366986328_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2910\\/featured_images\\/22885926_1996101100669301_4989592835390434491_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2910\\/featured_images\\/45862138_2218092648470144_8582342988196216832_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2910\\/featured_images\\/45899564_2218092678470141_1174071925027110912_n.jpg\"],\"address\":{\"street\":\"DN8, Quartier la Daby\",\"town\":\"Le Beausset\",\"postal_code\":\"83330\",\"country\":\"France\"},\"location\":{\"latitude\":43.2061594,\"longitude\":5.8106216},\"contact_info\":{\"email\":\"contact@crossfit83.com\",\"phone\":\"04.94.90.22.75\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFit-83-Le-Beausset-1553644921581590\\/\"}},{\"id_application\":null,\"id_lead\":\"3139\",\"name\":\"CrossFit Le Havre\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3139\\/featured_images\\/11822562_701670349965941_890853817265381726_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3139\\/featured_images\\/11866251_705656729567303_4548610034989490439_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3139\\/featured_images\\/11952773_711975052268804_3150877638084253225_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3139\\/featured_images\\/14409875_894897380643236_4745172909591006619_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3139\\/featured_images\\/18620085_1053658608100445_6424787548518834790_n.jpg\"],\"address\":{\"street\":\"70 Quai Frissard\",\"town\":\"Le Havre\",\"postal_code\":\"76600\",\"country\":\"France\"},\"location\":{\"latitude\":49.490959,\"longitude\":0.1308584},\"contact_info\":{\"email\":\"contact@crossfit-lehavre.com\",\"phone\":\"+33 9 64 44 66 47\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitlh\\/\"}},{\"id_application\":\"18236205\",\"id_lead\":null,\"name\":\"CrossFit Blue Arena\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/18236205\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"42 L Avenue Marchande\",\"town\":\"Grosbliederstroff\",\"postal_code\":\"57520\",\"country\":\"France\"},\"location\":{\"latitude\":49.1318022,\"longitude\":7.0435295},\"contact_info\":{\"email\":\"cf_bluearena@nubapp-clients.com\",\"phone\":\"0637479911\"},\"social_media\":{\"instagram\":\"_crossfitbluearena_\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2962\",\"name\":\"Crossfit Bad Marienberg\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-we