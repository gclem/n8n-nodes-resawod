_images\\/53761339_2177589142554607_7962849519740125184_n-2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2683\\/featured_images\\/Bildschirmfoto%202019-04-08%20um%2012.12.15.png\"],\"address\":{\"street\":\"Belziger Stra\\u00dfe 33\",\"town\":\"Berlin\",\"postal_code\":\"10823\",\"country\":\"Deutschland\"},\"location\":{\"latitude\":52.4867381,\"longitude\":13.3504024},\"contact_info\":{\"email\":\"mail@crossfitmins.com\",\"phone\":\"0049177 3086569\"},\"social_media\":{\"instagram\":\"crossfitmins\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitMINS\\/?ref=br_rs\"}},{\"id_application\":null,\"id_lead\":\"2986\",\"name\":\"Coraz\\u00f3n Negro Crossfit\",\"description\":\"Coraz\\u00f3n negro no es un gimnasio convencional, donde hay infinitas m\\u00e1quinas sin saber usar la mitad. Aqu\\u00ed entrenar\\u00e1s junto a otras personas a la vez, donde cada uno se habr\\u00e1 marcado un objetivo. \\u00c1nimo, competitividad, compa\\u00f1erismo, son varias de las muchas cosas que te encontrar\\u00e1s en cada entrenamiento. Nuestro centro deportivo cuenta con 750m2 acondicionados totalmente para la pr\\u00e1ctica de Funcional Fitness. Contamos con m\\u00e1s de 700m2 de zona exclusiva de entrenamiento y 2 vestuarios con ba\\u00f1os y duchas totalmente adaptados a minusv\\u00e1lidos en la planta baja. Tambi\\u00e9n tenemos en la planta superior una zona mixta, con sillas, mesas, cafetera y TV A disposici\\u00f3n de los clientes se encuentra una amplia zona exterior donde tambi\\u00e9n se podr\\u00e1n realizar entrenamientos al aire libre, en los d\\u00edas soleados (o no lluviosos).\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2986\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2986\\/featured_images\\/maxresdefault.jpg\"],\"address\":{\"street\":\"Los Sotos 32\",\"town\":\"Langreo\",\"postal_code\":\"33920\",\"country\":\"Spain\"},\"location\":{\"latitude\":43.323446,\"longitude\":-5.7303235},\"contact_info\":{\"email\":\"corazonnegrocrossfit@gmail.com\",\"phone\":\"669 79 47 52\"},\"social_media\":{\"instagram\":\"corazonnegroasturias\",\"facebook\":\"@CorazonNegroAsturias\"}},{\"id_application\":null,\"id_lead\":\"2562\",\"name\":\"CrossFit Kelevra\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2562\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2562\\/featured_images\\/keleva%20image%202.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2562\\/featured_images\\/kelevra%20image%201.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2562\\/featured_images\\/kelevra%20image%203.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2562\\/featured_images\\/kelevra%20image%204.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2562\\/featured_images\\/kelevra%20image%205.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2562\\/featured_images\\/kelevra%20image%206.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2562\\/featured_images\\/kelevra%20image%207.jpg\"],\"address\":{\"street\":\"Via Silicella, 103\",\"town\":\"Roma\",\"postal_code\":\"00169\",\"country\":\"Italia\"},\"location\":{\"latitude\":41.8606157,\"longitude\":12.5987045},\"contact_info\":{\"email\":\"info@crossfitkelevra.it\",\"phone\":\"+39 392 812 3914\"},\"social_media\":{\"instagram\":\"crossfitkelevra\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitkelevra\\/\"}},{\"id_application\":\"24564161\",\"id_lead\":null,\"name\":\"Crossfit Oozaru\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/24564161\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"16 Av. de la Loge\",\"town\":\"Mign\\u00e9-Auxances\",\"postal_code\":\"86440\",\"country\":\"France\"},\"locat