            "text": "[{\"id_application\":\"31348235\",\"id_lead\":null,\"name\":\"CrossFit Mayenne 3\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/31348235\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Impasse Claude Chappe, 87\",\"town\":\"Mayenne\",\"postal_code\":\"53100\",\"country\":\"France\"},\"location\":{\"latitude\":48.2835299,\"longitude\":-0.625428},\"contact_info\":{\"email\":\"crossfit.mayenne3@outlook.fr\",\"phone\":\"0669960835\"},\"social_media\":{\"instagram\":\"crossfitmayenne3\",\"facebook\":\"https:\\/\\/www.facebook.com\\/profile.php?id=61578907243210\"}},{\"id_application\":null,\"id_lead\":\"2865\",\"name\":\"Crossfit Unterwelt\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2865\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2865\\/featured_images\\/Bildschirmfoto%202019-05-22%20um%2010.04.22.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2865\\/featured_images\\/a9fa9b_63d2f206d44d4668ace168782205d77b~mv2_d_4032_3024_s_4_2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2865\\/featured_images\\/a9fa9b_995399b7c05744ac9cbf5f10621e00a0~mv2_d_4032_3024_s_4_2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2865\\/featured_images\\/a9fa9b_ac1cbb9525c040db915bd1edbb6b04e7~mv2_d_4592_3448_s_4_2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2865\\/featured_images\\/a9fa9b_c456ea7d59b74e17b7d4126dff71e317~mv2_d_4592_3448_s_4_2.jpg\"],\"address\":{\"street\":\"Rudolf-Diesel-Stra\\u00dfe 1\",\"town\":\"Freising\",\"postal_code\":\"85356\",\"country\":\"Germany\"},\"location\":{\"latitude\":48.4004695,\"longitude\":11.7677258},\"contact_info\":{\"email\":\"Info@unterwelt-freising.de\",\"phone\":\"+49 1728289673\"},\"social_media\":{\"instagram\":\"unterwelt_freising\",\"facebook\":\"https:\\/\\/www.facebook.com\\/Unterwelt-CrossFit-1965580183745110\\/\"}},{\"id_application\":\"38076784\",\"id_lead\":null,\"name\":\"Volta Athletic Club\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/38076784\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/38076784\\/featured_images\\/36652879_272902633286019_2859008245450670080_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/38076784\\/featured_images\\/38726085_304796580096624_6635398918093930496_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/38076784\\/featured_images\\/43177444_335799160329699_2824116893210640384_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/38076784\\/featured_images\\/49419781_376491392927142_4495414459086405632_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/38076784\\/featured_images\\/51472134_392605944649020_6832173446055591936_n.jpg\"],\"address\":{\"street\":\"rue Newton\",\"town\":\"Clermont-Ferrand\",\"postal_code\":\"63100\",\"country\":\"France\"},\"location\":{\"latitude\":45.7868089,\"longitude\":3.1286097},\"contact_info\":{\"email\":\"contact@crossfitcaldeira.fr\",\"phone\":\"06 59 74 56 46\"},\"social_media\":{\"instagram\":\"crossfitcaldeira\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitcaldeira\"}},{\"id_application\":\"88750147\",\"id_lead\":null,\"name\":\"The Fit Geek\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/88750147\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Rue Bon air, 7\",\"town\":\"Baisy Thy\",\"postal_code\":\"1470\",\"country\":\"Belgium\"},\"location\":{\"latitude\":50.5970946,\"longitude\":4.4750543},\"contact_info\":{\"email\":\"no-reply@nubapp-clients.com\",\"phone\":\"+32 490 11 69 41\"},\"social_media\":{\"instagram\":\"the_fit_g33k\",\"facebook\":\"https:\\/\\/fr-fr.facebook.com\\/francois.dewez.thefitgeek\\/\"}},{\"id_application\":null,\"id_lead\":\"2946\",\"name\":\"Crossfit Altoetting\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2946\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2946\\/featured_images\\/Werbepic5_1.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2946\\/featured_images\\/Werbepic6_1.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2946\\/featured_images\\/Werbepic7_1.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2946\\/featured_images\\/Werbepic_2.jpg\"],\"address\":{\"street\":\"August-Unterholzner-Strasse 7\",\"town\":\"Neu\\u00f6tting\",\"postal_code\":\"D-84524\",\"country\":\"Germany\"},\"location\":{\"latitude\":48.2566036,\"longitude\":12.6885313},\"contact_info\":{\"email\":\"info@crossfit-altoetting.de\",\"phone\":\"+49 1715333398\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitAltoetting\\/?__tn__=%2Cd%2CP-R\\u0026eid=ARB594Ljja1ic9NnsSX1nO6DepHAG5Eem5_ClAE29hC7nYBw_C5RyqaBX3Nm_14HRR_w9iNyDJntZySR\"}},{\"id_application\":null,\"id_lead\":\"2639\",\"name\":\"CrossFit Bergamo\",\"description\":\"Nasce alla fine degli anni \\u201970 da un\\u2019intuizione di Greg Glassman, che decide di combinare insieme l\\u2019atletica, il nuoto e il karate in un unico ritmo pi\\u00f9 intenso e veloce, che richiede una resistenza senza precedenti. Cross significa \\u201ccombinare\\u201d e \\u201cincrociare\\u201d. L\\u2019allenamento dura circa 20 minuti, il tempo utile per scaricare lo stress e godere al massimo dei benefici recati da questa disciplina.\\n\\nScopri il movimento.\\nPensato per facilitare le persone a conquistare un benessere completo e totale, il CrossFit \\u00e8 un programma di rafforzamento fisico.\\nIl CrossFit consiste in una serie di movimenti funzionali che variano costantemente, eseguiti a forte intensit\\u00e0 per conseguire una prestanza fisica massima, al fine di preparare le persone ad ogni genere di sfida fisica.\\n\\nGreg Glassman afferma:\\n\\u201cMangia carne e verdure, noci e semi, un po\\u2019 di frutta, pochi amidi e niente zucchero. Mantieni l\\u2019apporto calorico a un livello tale che favorisca l\\u2019allenamento ma non l\\u2019accumulo di grasso. Esercitati e allenati con i sollevamenti principali: Deadlift, clean, squat, presse, C\\u0026J e snatch. Allo stesso modo, impadronisciti delle basi della ginnastica: pull-up, dip, arrampicata sulla corda, push-up, sit-up, presse in piedi, piroette, flip, spaccate e prese. Vai in bici, corri, nuota, fai vogate, etc., forte e veloce. Cinque o sei giorni a settimana mescola questi elementi in tutte le combinazioni e i percorsi che ti suggerisce la tua creativit\\u00e0. La routine \\u00e8 il tuo nemico. Continua a fare allenamenti brevi e intensi. Impara e pratica regolarmente nuovi sport.\\u201d\\n\\nQuale \\u00e8 la consuetudine del nostro lavoro?\\nIl CrossFit non ha una routine, il principio di questa attivit\\u00e0 \\u00e8 la diversificazione dell\\u2019allenamento al fine di massimizzare la risposta neuroendocrina ed ottenere un fisico asciutto e muscoloso.\\n\\nUn approccio efficace.\\nAl contrario della tradizionali palestre noi proponiamo allenamenti composti da sedute di lavoro cardiovascolare brevi ma molto intense compiute con movimenti compositi.\\n \\nSostituiamo le alzate laterali con la push-press, i curl con i pull-ups e la leg extension con lo squat.\\n \\nPer ogni seduta di sforzo su lunga distanza, le successive 5-6 sedute degli atleti consisteranno in sforzi a corta distanza. Solidi ed indiscutibili dati scientifici attestano che movimenti composti e l\\u2019attivit\\u00e0 cardiovascolare ad alta intensit\\u00e0 sono decisamente pi\\u00f9 efficaci per migliorare il proprio fitness.\\nCrossFit tenta di trasmettere l\\u2019arte della tecnica di allenamento alla persona comune e agli atleti, con lo stesso approccio praticato nei programmi di allenamento d\\u2019elite usati dai maggiori team sportivi universitari e professionali. \\n\\nTi stai chiedendo se questo tipo di allenamento fa per te?\\nLa risposta \\u00e8 s\\u00ec! Anche se a livello diverso le vostre esigenze sono le stesse degli atleti olimpionici che praticano CrossFit. Raggiungere la competenza fisica ottimale di tutte le abilit\\u00e0 fisiche quali: resistenza respiratoria e cardiovascolare, flessibilit\\u00e0, forza, coordinazione, potenza, velocit\\u00e0, agilit\\u00e0 ed equilibrio \\u00e8 importante per chiunque.\\nRiteniamo che gli stessi esercizi, eseguiti con carichi differenti, siano adatti a tutti, dallo sciatore olimpionico all\\u2019anziano pensionato, la verit\\u00e0 \\u00e8 che il metodo che produce risultati su uno lo fa anche per l\\u2019altro.\\nLo squat ad esempio \\u00e8 un esercizio fondamentale per la funzionalit\\u00e0 motoria, un movimento universale che viene inserito negli allenamenti troppo poco. Noi insegniamo a tutti, anche ai meno esperti, movimenti efficaci e professionali come questo.\\n\\nLe vostre abitudini attuali.\\nL\\u2019attivit\\u00e0 fisica aerobica tradizionale che sta alla base del fitness vi permette di raggiungere un certo livello di forza, ma non il massimo.\\nAbbiamo scoperto con stupore che molti degli atleti migliori che hanno raggiunto il successo internazionale, sono in realt\\u00e0 ancora lontani dal loro massimo potenziale, poich\\u00e9 non hanno beneficiato di allenamenti eccezionali come quelli del CrossFit.\\n\\nPosso godere di una salute ottimale senza essere un atleta?\\nNo! Gli atleti godono di una difesa dall\\u2019invecchiamento e dai malesseri che i non-atleti non raggiungono mai.\\n \\nPer esempio, esistono atleti di 70 anni pi\\u00f9 forti di non-atleti di 25 anni al massimo della loro forma.\\nNon sottovalutate l\\u2019importanza della forza fisica, la maggior parte degli anziani che sono costretti ad assistenza continua risentono della perdita delle forze. Un atleta mostra maggiore densit\\u00e0 ossea, sistemi immunitari pi\\u00f9 forti, con un rischio minore di malattie coronariche, tumori e ictus, inoltre soffrono meno di depressione rispetto ai non-atleti.\\n \\nIn cosa consiste un programma di forza centrale e condizionamento?\\nCrossFit \\u00e8 un programma di forza centrale e condizionamento con due significati.\\nPrimo: il fitness che sviluppiamo \\u00e8 fondamentale per tutte le altre esigenze atletiche. Questo \\u00e8 lo stesso senso in cui i corsi universitari di base in una facolt\\u00e0 sono chiamati il \\u2018curriculum centrale\\u2019. Questa \\u00e8 la cosa di cui tutti abbiamo bisogno.\\nSecondo: siamo un programma \\u2019centrale\\u2019 di forza e condizionamento nel senso letterale del termine, che significa il centro di qualcosa. La maggior parte del nostro lavoro \\u00e8 mirata sui princiapali assi funzionali del corpo umano, l\\u2019estensione e la flessione dell\\u2019anca e l\\u2019estensione e la flessione e la rotazione del tronco.\\nLa supremazia della forza centrale del condizionamento, in questo senso \\u00e8 supportata dalla semplice osservazione che la sola potente estensione dell\\u2019anca \\u00e8 necessaria \\u00e8 quasi unicamente sufficiente per ottenere risultati atletici d\\u2019\\u00e9lite. Correre, saltare, tirare pugni e lanciare oggetti, sono tutte attivit\\u00e0\\/movimenti che originano dal centro del corpo. E dalla nostra esperienza abbiamo osservato anche che nessuno di quelli incapaci di ottenere una potente estensione nell\\u2019anca, era in grado di raggiungere grandi performance atletiche, e viceversa, la quasi totalit\\u00e0 di coloro che hanno questa capacit\\u00e0 sono anche grandi atleti.\\n\\nNoi di CrossFit di Bergamo ci impegniamo costantemente nello sviluppare i nostri atleti dall\\u2019interno verso l\\u2019esterno, dal centro verso le estremit\\u00e0.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2639\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2639\\/featured_images\\/14088419_1736153769940544_8927699037563637171_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2639\\/featured_images\\/21006_1573972996158623_5143840901632396589_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2639\\/featured_images\\/21743204_1927774580778461_1979383699215017278_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2639\\/featured_images\\/22195795_1935006446721941_3959243677640164956_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2639\\/featured_images\\/25299595_1967005720188680_5183672801365384231_o.jpg\"],\"address\":{\"street\":\"Rotonda dei Mille\",\"town\":\"2\",\"postal_code\":\"24122\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.6952997,\"longitude\":9.6649573},\"contact_info\":{\"email\":\"wellnessboutiquebg@gmail.com\",\"phone\":\"+39 035247078\"},\"social_media\":{\"instagram\":\"crossfitbergamo\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitbergamo\\/\"}},{\"id_application\":null,\"id_lead\":\"2888\",\"name\":\"Crossfit Simbach am Inn\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2888\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2888\\/featured_images\\/Bildschirmfoto%202019-05-27%20um%2011.17.28.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2888\\/featured_images\\/Bildschirmfoto%202019-05-27%20um%2011.17.46.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2888\\/featured_images\\/Bildschirmfoto%202019-05-27%20um%2011.17.54.png\"],\"address\":{\"street\":\"Kreuzberger Weg 9a\",\"town\":\"Simbach am Inn\",\"postal_code\":\"84359\",\"country\":\"Germany\"},\"location\":{\"