92,\"longitude\":7.3294773},\"contact_info\":{\"email\":\"contact@crossfitleopards.com\",\"phone\":\"+33 6 62 55 50 89\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitleopards\\/\"}},{\"id_application\":\"86562093\",\"id_lead\":null,\"name\":\"Vallis Aurea Training\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/86562093\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Chemin de Puissanton\",\"town\":\"Valllauris\",\"postal_code\":\"6220\",\"country\":\"France\"},\"location\":{\"latitude\":43.5906014,\"longitude\":7.0584805},\"contact_info\":{\"email\":\"performance.training06@gmail.com\",\"phone\":\"06.59.32.39.64\"},\"social_media\":{\"instagram\":\"vallis_aurea_training\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CFVallisAurea\\/?locale=fr_FR\"}},{\"id_application\":\"44406202\",\"id_lead\":null,\"name\":\"CrossFit Bessan\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/44406202\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"27 RUE DE LA TRAMONTANE\",\"town\":\"BESSAN\",\"postal_code\":\"34550\",\"country\":\"France\"},\"location\":{\"latitude\":43.3710801,\"longitude\":3.4247294},\"contact_info\":{\"email\":\"crossfitbessan@nubapp-clients.com\",\"phone\":\"+33626285334\"},\"social_media\":{\"instagram\":\"crossfitbessan\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitBessan\"}},{\"id_application\":\"71078707\",\"id_lead\":null,\"name\":\"CrossFit Flipside\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/71078707\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Frankfurter Weg 34\",\"town\":\"Paderborn\",\"postal_code\":\"33106\",\"country\":\"Deutschland\"},\"location\":{\"latitude\":51.7026148,\"longitude\":8.7256939},\"contact_info\":{\"email\":\"info@crossfit-flipside.de\",\"phone\":\"5251 5480172\"},\"social_media\":{\"instagram\":\"crossfit_flipside\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"3037\",\"name\":\"Terral Crossfit\",\"description\":\"El Box de CrossFit t\\u00e9cnicamente es el espacio f\\u00edsico donde se realizan los entrenamientos diarios o WODS de CrossFit. Estos pueden realizarse bien de forma individual, en los horarios Open Box, o bien en las clases en grupo. Podr\\u00e1s encontrar m\\u00e1s informaci\\u00f3n sobre nuestras formas de entrenamiento en la secci\\u00f3n W.O.D.\\n\\n \\n\\nPara nosotros un Box significa mucho m\\u00e1s:\\n\\nEl Box va a ser el lugar donde pongas a prueba tus limites y para batirlos es imprescindible un ambiente agradable, donde te encuentres a gusto y centrado en llegar a donde no hab\\u00edas llegado antes. \\nEs el punto de encuentro de una comunidad Crossfiter donde compartir nuestra pasi\\u00f3n por este estilo de vida. Podr\\u00e1s conocer a otros crossfiters compa\\u00f1eros de entrenamiento y a tu Coach personal. Factores muy importantes para poder superarte.\\n \\n\\nNuestro Box de Crossfit en M\\u00e1laga cuenta con una certificaci\\u00f3n oficial de CrossFit lo que significa que cumplimos con los requisitos m\\u00e1s exigentes de la marca.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3037\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3037\\/featured_images\\/60656611_338736756841174_358342513213308928_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3037\\/featured_images\\/crossfit_contenido_04-11-2018_0710pm_Capturadepantalla2018-04-11alas19.07.49.png\"],\"address\":{\"street\":\"Calle Riogordo, 11\",\"town\":\"M\\u00e1laga\",\"postal_code\":\"29006\",\"country\":\"Spain\"},\"location\":{\"latitude\":36.7014017,\"longitude\":-4.4656228},\"contact_info\":{\"email\":\"terral.crossfit@gmail.com\",\"phone\":\"634553882\"},\"social_media\":{\"instagram\":\"terralcrossfit\",\"facebook\":\"@terralcrossfit\"}},{\"id_application\":null,\"id_lead\":\"2571\",\"name\":\"Training Connection asd\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2571\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2571\\/featured_images\\/10499483_642422562554372_3756598362808615935_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2571\\/featured_images\\/15385539_910175619112397_1932924532225411739_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2571\\/featured_images\\/19029605_1055774297885861_6173076092477972620_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2571\\/featured_images\\/22140997_1124977614298862_3690641626977764752_n.jpg\"],\"address\":{\"street\":\"Via Ruggero Fauro, 150\",\"town\":\"Roma\",\"postal_code\":\"00197\",\"country\":\"Italia\"},\"location\":{\"latitude\":41.9306038,\"longitude\":12.4861217},\"contact_info\":{\"email\":\"info@trainingconnection.it\",\"phone\":\"+39 320 243 1001\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/TrainingConnectionTC\\/\"}},{\"id_application\":\"60914465\",\"id_lead\":null,\"name\":\"Wolfspirit Fit Community\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/60914465\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/60914465\\/featured_images\\/29354903_10211883783832547_402062869649749693_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/60914465\\/featured_images\\/29355021_10211883901555490_3885416450672281827_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/60914465\\/featured_images\\/crossfit-wolfspirit-la-salle-02.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/60914465\\/featu