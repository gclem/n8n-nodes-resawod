"Verge de Montserrat s\\/n\",\"town\":\"Cornella de Llobregat\",\"postal_code\":\"08940\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.348395,\"longitude\":2.0672123},\"contact_info\":{\"email\":\"info@crossfitcornella.com\",\"phone\":\"664614338\"},\"social_media\":{\"instagram\":\"crossfitcornella\",\"facebook\":\"@crossfitcornella\"}},{\"id_application\":\"35109428\",\"id_lead\":null,\"name\":\"Cotignac Sport Academy\",\"description\":\"\",\"logo\":null,\"images\":[],\"address\":{\"street\":\"Lot 4 ZA Loup \\u00e0 Loup\",\"town\":\"Cotignac\",\"postal_code\":\"83570\",\"country\":\"France\"},\"location\":{\"latitude\":43.529171,\"longitude\":6.148583},\"contact_info\":{\"email\":\"cotignacsportacademy@nubapp-clients.com\",\"phone\":\"0650895001\"},\"social_media\":{\"instagram\":\"cotisportacademy\",\"facebook\":\"https:\\/\\/www.facebook.com\\/cotignacsportacademy\"}},{\"id_application\":\"12719148\",\"id_lead\":null,\"name\":\"Training Room\",\"description\":\"GET FIT. HAVE FUN. BE HEALTHY.\\nCircuit training is a form of body conditioning or resistance training using high-intensity aerobics. It targets strength building and muscular endurance.\\nEffects of circuit training:\\nStudies at Baylor University and The Cooper Institute show that circuit training is the most time efficient way to enhance cardiovascular fitness and muscle endurance. Studies show that circuit training helps women to achieve their goals and maintain them longer than other forms of exercise or diet.\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/12719148\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/12719148\\/featured_images\\/IMG-20210106-WA0000.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/12719148\\/featured_images\\/IMG-20210106-WA0001.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/12719148\\/featured_images\\/IM