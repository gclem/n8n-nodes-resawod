31_n.jpg\"],\"address\":{\"street\":\"2 Impasse Paradou, SWEN - B\\u00e2timent C7\",\"town\":\"Marseille\",\"postal_code\":\"13009\",\"country\":\"France\"},\"location\":{\"latitude\":43.2418758,\"longitude\":5.398434},\"contact_info\":{\"email\":\"contact@fitfactorymarseille.com\",\"phone\":\"+33 4 91 49 78 28\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/FitFactoryMarseille.CrossFitMassilia\\/\"}},{\"id_application\":null,\"id_lead\":\"2788\",\"name\":\"Urban Box Crossfit Embajadores\",\"description\":\"Entrenamientos en grupo, siempre con personal especializado, usando movimientos funcionales, similares a los utilizados en la vida diaria, y de una forma siempre diferente. \\u00a1Ning\\u00fan d\\u00eda repetir\\u00e1s el mismo entrenamiento!\\n\\nMejorar\\u00e1s tu forma f\\u00edsica en todas sus caracter\\u00edsticas (resistencia cardiovascular, resistencia muscular, fuerza, flexibilidad, potencia, velocidad, coordinaci\\u00f3n, agilidad, equilibrio y precisi\\u00f3n), adaptando los ejercicios a tu edad y tu nivel.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2788\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2788\\/featured_images\\/coachs-2644-1-460x460.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2788\\/featured_images\\/image1-29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2788\\/featured_images\\/ruben-7071-460x460.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2788\\/featured_images\\/urbann-7nov-8002-940x415.jpg\"],\"address\":{\"street\":\"Martin de Vargas, 22\",\"town\":\"Madrid\",\"postal_code\":\"28005\",\"country\":\"Spain\"},\"location\":{\"latitude\":40.4027655,\"longitude\":-3.7041208},\"contact_info\":{\"email\":\"info@urbanboxcrossfit.com\",\"phone\":\"914 74 19 17\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"CrossfitEmbajadores\"}},{\"id_application\":null,\"id_lead\":\"2890\",\"name\":\"Versus Crossfit Fuenlabrada\",\"description\":\"Entrenamientos funcionales variados y de alta intensidad !!!!. Sal de la rutina y entrena con nosotros !!!!!!\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2890\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2890\\/featured_images\\/49318319_2036098816478711_5358960046749253632_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2890\\/featured_images\\/maxresdefault%20%281%29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2890\\/featured_images\\/maxresdefault%20%282%29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2890\\/featured_images\\/maxresdefault.jpg\"],\"address\":{\"street\":\"C\\/Nicol\\u00e1s Cop\\u00e9rnico, 9\",\"town\":\"Fuenlabrada\",\"postal_code\":\"28946\",\"country\":\"Spain\"},\"location\":{\"latitude\":40.284921,\"longitude\":-3.7853487},\"contact_info\":{\"email\":\"versus@crossfitfuenlabrada.com\",\"phone\":\"910859589\"},\"social_media\":{\"instagram\":\"crossfit_versus\",\"facebook\":\"@VersusCrossfitFuenlabrada\"}},{\"id_application\":\"74970953\",\"id_lead\":null,\"name\":\"STANDUP TRAINING CLUB\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/74970953\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Rue Cahorday\",\"town\":\"Saive\",\"postal_code\":\"4671\",\"country\":\"Belgium\"},\"location\":{\"latitude\":50.6520885,\"longitude\":5.675662},\"contact_info\":{\"email\":\"fittesttherapy@gmail.com\",\"phone\":\"+32478497794\"},\"social_media\":{\"instagram\":\"crossfitstandup\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitstandup\"}},{\"id_application\":null,\"id_lead\":\"3045\",\"name\":\"Crossfit Sant Cugat\",\"description\":\"Valhalla Training Camp \\u00e9s un nou espai on podr\\u00e0s entrenar di\\u00e0riament principalment 3 disciplines.\\nCrossFit - \\u00e9s la manera m\\u00e9s divertida de fer preparaci\\u00f3 f\\u00edsica general. Un model d\\u0027entrenament america que ja ha triomfat a tot el m\\u00f3n.\\nMuay Thai i Kick Boxing - El Muay Thai \\u00e9s un art marcial amb una gran tradici\\u00f3 hist\\u00f2rica i cultural a Tail\\u00e0ndia.\\n\\u00c9s una activitat molt completa que permet desenvolupar habilitats tant f\\u00edsiques com mentals. Treballa l\\u0027elasticitat, el refor\\u00e7 muscular, millora els reflexos i l\\u0027equilibri, la voluntat, el coratge, el companyerisme i el respecte. A m\\u00e9s, \\u00e9s un m\\u00e8tode infal\\u00b7lible per estilitzar la figura.\\nFitBoxing - \\u00e9s el boxeig de tota la vida per\\u00f2 sense contacte. Aprens a boxejar per\\u00f2 la classe no est\\u00e0 focalitzada al combat sin\\u00f3 que est\\u00e0 focalitzada a la t\\u00e8cnica, la for\\u00e7a i la velocitat perqu\\u00e8 et beneficis de fer un esport molt complet.\\nAl Valhalla practiquem l\\u0027esport buscant un alt nivell t\\u00e8cnic i d\\u0027una manera que sigui assequible a tots els nivells i tipus de persones.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3045\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3045\\/featured_images\\/38744348_2183105211972217_2908016068565925888_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3045\\/featured_images\\/40409734_2203550799927658_6993085456657154048_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3045\\/featured_images\\/40684662_2207858956163509_5740970110391156736_o.jpg\"],\"address\":{\"street\":\"Carrer de Vic, 11\",\"town\":\"Sant Cugat del Valles\",\"postal_code\":\"08173\",\"country\":\"Spain\"},\"location\":{\"latitude\":1.4791113,\"longitude\":2.0724541},\"contact_info\":{\"email\":\"valhallatrainingcamp@gmail.com\",\"phone\":\"675923324\"},\"social_media\":{\"instagram\":\"\