1.amazonaws.com\\/applications\\/82678023\\/featured_images\\/652546d1834e0.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/82678023\\/featured_images\\/652546d623903.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/82678023\\/featured_images\\/652546d808e7c.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/82678023\\/featured_images\\/652546dd6b60c.jpg\"],\"address\":{\"street\":\"Clos du Parnasse, 3a\",\"town\":\"Ixelles\",\"postal_code\":\"1050\",\"country\":\"Belgium\"},\"location\":{\"latitude\":50.8376001,\"longitude\":4.3701791},\"contact_info\":{\"email\":\"gabriela.dimitrova@brusselsbarbell.com\",\"phone\":\"+32 472 74 28 26\"},\"social_media\":{\"instagram\":\"brusselsbarbell\",\"facebook\":\"Brussels Barbell\"}},{\"id_application\":null,\"id_lead\":\"2627\",\"name\":\"CrossFit Buriacus\",\"description\":\"SCEGLI CROSSFIT E ALLENATI CON IL CERVELLO\\nBuriacus il box CrossFit ufficiale a due passi da Vimercate.\\n\\nSe vuoi assistere comodamente ai workout, vedere i tuoi amici che si allenano, prendere un caff\\u00e8 pre-wod che ti da la carica o semplicemente fare quattro chiacchiere, c\\u2019\\u00e8 un\\u2019area soppalcata detta area relax.\\n\\nGli allenamenti CrossFit sono basati sull\\u2019alternanza di movimenti funzionali che cambiano ad ogni lezione con la caratteristica di essere eseguiti ad alta intensit\\u00e0.\\n\\u00c8 un allenamento completo e scalabile a qualsiasi livello, pensato per aiutare le persone a conquistare un benessere a 360\\u00b0.\\n\\nL\\u2018head coach afferma che \\u201clo sport \\u00e8 prima di tutto condivisione, ognuno deve porsi degli obiettivi, anche di un certo livello, ma affrontarli in un contesto e atmosfera piacevole.\\nAnche chi non ha mai fatto sport o chi prova soggezione verso pesi ed esercizi ad alta intensit\\u00e0 pu\\u00f2 iniziare un percorso graduale di allenamento definito sulle proprie caratteristiche fisiche ed esigenze personali\\u201c.\\nLa community \\u00e8 un altro punto di forza del Buriacus: i legami che si creano all\\u2019interno del box sono molto forti, nascono delle piccole seconde famiglie dove tutti si aiutano, confrontano i loro risultati, parlano degli obiettivi futuri e molto altro.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2627\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2627\\/featured_images\\/21192721_1938052969785306_2024874756794149516_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2627\\/featured_images\\/31819086_2052284995028769_7578649074316869632_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2627\\/featured_images\\/44849644_2175477772709490_8519771550986010624_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2627\\/featured_images\\/44959247_2176112055979395_3218745716797079552_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2627\\/featured_images\\/45696402_2182896985300902_3096175386053050368_n.jpg\"],\"address\":{\"street\":\"Via Primo Villa, 15\",\"town\":\"Burago di Molgora, MB\",\"postal_code\":\"20875\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.5987722,\"longitude\":9.3756726},\"contact_info\":{\"email\":\"info@crossfitburiacus.com\",\"phone\":\"+39 3201735835\"},\"social_media\":{\"instagram\":\"crossfitburiacus\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitBuriacus\\/\"}},{\"id_application\":\"45455501\",\"id_lead\":null,\"name\":\"Crossfit Schmiede\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/45455501\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Miramstra\\u00dfe 74\",\"town\":\"Kassel\",\"postal_code\":\"34123\",\"country\":\"Deutschland\"},\"location\":{\"latitude\":51.3102903,\"longitude\":9.5389993},\"contact_info\":{\"email\":\"crossfitschmiede@nubapp-clients.com\",\"phone\":\"15735987443\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2837\",\"name\":\"WbCrossfit\",\"description\":\"No te equivoques, esto no es un gimnasio al uso, no tenemos maquinas, no tenemos sala de musculaci\\u00f3n, no veras clientes realizando sus propios ejercicios, veras alumnos intentando rendir al m\\u00e1ximo.\\n\\nApostamos por el aprendizaje, la t\\u00e9cnica y los movimientos correctamente ejecutados para que consigas lograr tus metas, pases tus pruebas f\\u00edsicas y te superes d\\u00eda a d\\u00eda.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2837\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2837\\/featured_images\\/image003.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2837\\/featured_images\\/maxresdefault%20%281%29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2837\\/featured_images\\/maxresdefault.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2837\\/featured_images\\/whitebox-crossfit-valladolid-4.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2837\\/featured_images\\/whitebox-crossfit-valladolid.jpg\"],\"address\":{\"street\":\"Avenida de Salamanca. 102\",\"town\":\"Valladolid\",\"postal_code\":\"47014\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.626807,\"longitude\":-4.7641807},\"contact_info\":{\"email\":\"info@wbcrossfit.com\",\"phone\":\"661586105\"},\"social_media\":{\"instagram\":\"wbcrossfit\",\"facebook\":\"@WBCrossFit\"}},{\"id_application\":null,\"id_lead\":\"3010\",\"name\":\"CrossFit Cannes\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3010\\/featured_images\\/43108229_1241775182629618_1664342012368781312_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3010\\/featured_images\\/43134404_1241775402629596_648097804618563584_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3010\\/featured_images\\/43143610_1241775359296267_7712510796772671488_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3010\\/featured_images\\/43153044_1241775219296281_117251885626294272_o.jpg\"],\"address\":{\"street\":\"47 Avenue Maurice Chevalier\",\"town\":\"Cannes\",\"postal_code\":\"06150\",\"country\":\"France\"},\"location\":{\"latitude\":43.553741,\"longitude\":6.959247},\"contact_info\":{\"email\":\"contact@crossfitcannes.com\",\"phone\":\"07 83 87 82 37\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CFCannes\\/\"}},{\"id_application\":null,\"id_lead\":\"2581\",\"name\":\"CrossFit Casal Palocco\",\"description\":\"We Take Care Of You\\nUno dei nostri coach si prender\\u00e0 cura di te prima, durante e dopo la prova. Avrai modo di conoscere \\u0022l\\u0027ambiente\\u0022 in cui ti allenerai, e noi avremo modo di consigliarti il percorso pi\\u00f9 adatto alle tue esigenze.\\n\\nOn Ramp Academy\\nDopo la lezione di prova ti siederai con il coach per capire insieme a lui se e quando iniziare un percorso di 5 lezioni individuali per imparare i \\u201cfundamentals\\u201d del Crossfit ed iniziare in totale Sicurezza.\\n\\nTrainings\\nAvrai a tua disposizione una serie di \\u201cMembership Cards\\u201d in base a quante volte vorrai allenarti. Potrai fare sia Crossfit sia Olympic Weightlifting ma anche scegliere di dedicarti ad entrambi.\\n\\nCompetitors\\u0027 Program\\nSe cerchi una sfida maggiore e vuoi prepararti per competere nelle gare di Crossfit, ti potrai preparare con la Programmazione pi\\u00f9 efficace e diffusa in Italia, con un roster di pi\\u00f9 di 500 atleti, targata Matteo Fuzzi - Reebok Crossfit Ravenna.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2581\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2581\\/featured_images\\/11822574_1635303566716226_7130154153085343767_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2581\\/featured_images\\/12027779_1660895284157054_4596835063078945784_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2581\\/featured_images\\/15800630_1850612365185344_2858979180599224287_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2581\\/featured_images\\/18198771_1911203272459586_380855727933922274_n.jpg\"],\"address\":{\"street\":\"Via Zenone di Elea, 46\",\"town\":\"Roma\",\"postal_code\":\"00124\",\"country\":\"Italia\"},\"location\":{\"latitude\":41.7513101,\"longitude\":12.3368608},\"contact_info\":{\"email\":\"info@crossfitcasalpalocco.it\",\"phone\":\"+39 3273485196\"},\"social_media\":{\"instagram\":\"crossfit.casalpalocco\",\"facebook\":\"https:\\/\\/www.facebook.com\\/Crossfit-Casalpalocco-1459935097586408\\/\"}},{\"id_application\":\"43603923\",\"id_lead\":null,\"name\":\"CrossFit Roude Leiw\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/43603923\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/43603923\\/featured_images\\/30264426_1000893516741466_5734817504975037956_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/43603923\\/featured_images\\/30710234_1005147169649434_2842075099331239461_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/43603923\\/featured_images\\/33635780_1028932633937554_2596561743387820032_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/43603923\\/featured_images\\/54520872_1249318148565667_6604635446037184512_n.jpg\"],\"address\":{\"street\":\"Rue des artisans\",\"town\":\"Foetz\",\"postal_code\":\"L-3895\",\"country\":\"Luxembourg\"},\"location\":{\"latitude\":49.5253397,\"longitude\":6.0106914},\"contact_info\":{\"email\":\"contact@crossfitroudeleiw.com\",\"phone\":\"+352691856789\"},\"social_media\":{\"instagram\":\"crossfitroudeleiw\",\"facebook\":\"https:\\/\\/www.facebook.com\\/cfroudeleiw\"}},{\"id_application\":\"59176621\",\"id_lead\":null,\"name\":\"Felidae CrossFit\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/59176621\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Route de Gimeaux, 3\",\"town\":\"Saint-Bonnet-pr\\u00e9s-Riom\",\"postal_code\":\"63200\",\"country\":\"France\"},\"location\":{\"latitude\":45.932262,\"longitude\":3.110248},\"contact_info\":{\"email\":\"felidaecrossfit@nubapp-clients.com\",\"phone\":\"+33 4 73 67 75 43\"},\"social_media\":{\"instagram\":\"felidae_crossfit\",\"facebook\":\"\"}},{\"id_application\":\"60811178\",\"id_lead\":null,\"name\":\"Phys Ed\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/60811178\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Rue des V\\u00e9t\\u00e9rinaires, 47\",\"town\":\"Anderlecht\",\"postal_code\":\"1070\",\"country\":\"Belgium\"},\"location\":{\"latitude\":50.834445,\"longitude\":4.3263954},\"contact_info\":{\"email\":\"info@physed.be\",\"phone\":\"0032472507135\"},\"social_media\":{\"instagram\":\"phys_ed_bxl\",\"facebook\":\"\"}},{\"id_application\":\"20461901\",\"id_lead\":null,\"name\":\"CrossFit Sainte Consorce\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/20461901\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/20461901\\/featured_images\\/Logo_CrossFit_Sainte_Consorce.jpg\"],\"address\":{\"street\":\"2b rue des marronniers\",\"town\":\"Sainte Consorce\",\"postal_code\":\"69280\",\"country\":\"France\"},\"location\":{\"latitude\":45.776373,\"longitude\":4.695921},\"contact_info\":{\"email\":\"contact@crossfitsainteconsorce.com\",\"phone\":\"+33 6 82 58 51 61\"},\"social_media\":{\"instagram\":\"crossfit_sainteconsorce\",\"facebook\":\"CrossFit Sainte Consorce\"}},{\"id_application\":null,\"id_lead\":\"2981\",\"name\":\"Crossfit Santo Reino\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2981\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2981\\/featured_images\\/11051833_530770670404619_7713586290217288930_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2981\\/featured_images\\/11951287_545026818979004_7875224159104596609_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2981\\/featured_images\\/876977360img_1520.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2981\\/featured_images\\/IMG_1749.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2981\\/featured_images\\/IMG_20180908_095543_1.jpg\"],\"address\":{\"street\":\"Calle Bedmar, 62, parcela 114\",\"town\":\"Ja\\u00e9n\",\"postal_code\":\"23009\",\"country\":\"Spain\"},\"location\":{\"latitude\":37.7930169,\"longitude\":-3.7931042},\"contact_info\":{\"email\":\"info@crossfitsantoreino.com\",\"phone\":\"953104748\"},\"social_media\":{\"instagram\":\"crossfitsantoreino\",\"facebook\":\"@CrossFitSR\"}},{\"id_application\":null,\"id_lead\":\"2632\",\"name\":\"CrossFit Deed\",\"description\":\"CrossFit DeeD \\u00e8 il Centro Allenamento a Lodi che contiene la pi\\u00f9 innovativa rivoluzione del fitness moderno: il CrossFit.\\n\\nCrossFit Deed tramite il CrossFit, ha come obiettivo, la cura, la qualit\\u00e0 per i dettagli tecnici, gli impatti motivazionali, le risposte mentali, che sono solo alcuni aspetti di un allenamento in cui l\\u2019unica vera sfida \\u00e8 raggiungere la miglior espressione di se stessi. Lavorare sui punti di forza e di debolezza, insieme, per migliorarci, sempre.\\nDa 15 anni mi occupo con passione di fitness, faccio ricerca e sviluppo e con il CrossFit voglio farvi conoscere la nuova cultura fitness oramai consolidata negli Stati Uniti, voglio farvi conoscere la sua forza, la sua unicit\\u00e0, l\\u2019energia, l\\u2019intensit\\u00e0, la tecnica e la precisione. Nuovi approcci, nuovi stili, nuovi risultati! Nuovi professionisti che sapranno coinvolgervi con un entusiasmo dirompente, che il NUOVO abbia inizio!\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2632\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2632\\/featured_images\\/44368401_2112063479046955_5884588173182369792_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2632\\/featured_images\\/46479608_2127301800856456_1528697045261484032_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2632\\/featured_images\\/48123077_2140462256207077_3505932437370699776_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2632\\/featured_images\\/48421480_2147877445465558_5225036085922365440_n.jpg\"],\"address\":{\"street\":\"Via Selvagreca, 6\",\"town\":\"Lodi\",\"postal_code\":\"26900\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.3090354,\"longitude\":9.5093815},\"contact_info\":{\"email\":\"crossfitdeed@aol.com\",\"phone\":\"+39 328 453 6293\"},\"social_media\":{\"instagram\":\"crossfitdeed\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitdeed\\/\"}},{\"id_application\":null,\"id_lead\":\"3025\",\"name\":\"Singular box\",\"description\":\"M\\u00e1s de 1.400m2 di\\u00e1fanos divididos en varias zonas de entrenamiento con m\\u00e1s de 8m de altura en las que podr\\u00e1s entrenar al m\\u00e1ximo de revoluciones sin preocuparte por el espacio. Adem\\u00e1s, podr\\u00e1s descansar, comer y beber en nuestra amplia y confortable \\u00abZona Community\\u00bb, el lugar perfecto para conversar con tus compa\\u00f1eros antes del entreno y para comentar los resultados tras finalizarlo. Tambi\\u00e9n puedes aprovechar para relajar tus m\\u00fasculos en nuestra sala de fisioterapia o para hablar con nuestro nutricionista para mejorar tu alimentaci\\u00f3n.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3025\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3025\\/featured_images\\/crossfit-1.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3025\\/featured_images\\/crossfit-singular-box-madrid.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3025\\/featured_images\\/crossfit-singular-box.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3025\\/featured_images\\/jaula-web-grande.jpg\"],\"address\":{\"street\":\"C\\/ Ram\\u00f3n de Aguinaga, 13\",\"town\":\"Madrid\",\"postal_code\":\"28028\",\"country\":\"Spain\"},\"location\":{\"latitude\":40.426858,\"longitude\":-3.6646657},\"contact_info\":{\"email\":\"madrid@crossfitsingularbox.com\",\"phone\":\"917 250 728\"},\"social_media\":{\"instagram\":\"crossfitsingularboxoficial\",\"facebook\":\"@crossfitsingularboxoficial\"}},{\"id_application\":\"50277846\",\"id_lead\":null,\"name\":\"Crossfit Tago\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/50277846\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"9 Rue de la Taillanderie\",\"town\":\"Tagolsheim\",\"postal_code\":\"68720\",\"country\":\"Francia\"},\"location\":{\"latitude\":47.6571818,\"longitude\":7.2665991},\"contact_info\":{\"email\":\"lionel@crossfit-tago.fr\",\"phone\":\"0687952811\"},\"social_media\":{\"instagram\":\"crossfittago?igsh=MTYyYTBlYTNyMGRxcQ%3D%3D\\u0026utm_source=qr\",\"facebook\":\"https:\\/\\/www.facebook.com\\/profile.php?id=61556552564560\"}},{\"id_application\":\"48578877\",\"id_lead\":null,\"name\":\"Move Xperience\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/48578877\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/48578877\\/featured_images\\/Logo_Move.png\"],\"address\":{\"street\":\"Chem. de Marjovet C7\",\"town\":\"Echallens\",\"postal_code\":\"1040\",\"country\":\"Switzerland\"},\"location\":{\"latitude\":46.6382056,\"longitude\":6.6275183},\"contact_info\":{\"email\":\"movexperience@nubapp-clients.com\",\"phone\":\"+41795437602\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2655\",\"name\":\"CrossFit Suzzara\",\"description\":\"Il Box CrossFit Suzzara non \\u00e8 una delle solite e classiche palestra: \\u00e8 un lungo dove ogni volta si possono imparare nuovi esercizi e si pu\\u00f2 gareggiare o contro se stessi o contro gli altri, superando e mettendo alla prova i propri limiti. All\\u2019interno del palazzetto dello sport A. Marmiroli, troverete una struttura moderna di 200m\\u00b2. Nel nostro Box, attraverso l\\u2019utilizzo del proprio corpo, di bilancieri e di tutto quello che pu\\u00f2 servire per praticare CrossFit, viene svolto il WOD del giorno.\\n\\npalestra-300x189\\n\\nLa professionalit\\u00e0 dei nostri istruttori, sempre pronti ad ascoltarti e correggerti immediatamente, la fondatezza del metodo ed il TUO impegno, ti garantiranno un risultato sicuro, coinvolgendoti totalmente in uno spirito di passione e divertimento.\\n\\nSe cerchi qualcosa di stimolante e meno noioso delle palestre convenzionali, perch\\u00e9 magari ti senti poco seguito e non sei convinto delle classiche schede di allenamento, qui trovi il posto che fa per te.\\n\\nIl nostro Box \\u00e8 il secondo centro affiliato a CrossFit\\u00ae di tutta la provincia di MANTOVA. Per ulteriori informazioni visita le altre sezioni del sito oppure la pagina Facebook Ufficiale: CrossFit Suzzara \\u2013 Forming Lion\\u2019s Spirits.\\n\\nL\\u2019A.s.d Obelix Gym \\u2013 CROSSFIT SUZZARA nasce per educare le persone a riappropriarsi di esse attraverso l\\u2019esecuzione dei pi\\u00f9 naturali movimenti esistenti. I metodi sono antichi e spartani ma efficaci. Qui le macchine siete voi e non importata l\\u2019et\\u00e0, il sesso o il tuo stato di forma ma soltanto la volont\\u00e0 di affrontare nuove sfide e superare i propri limiti!\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2655\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2655\\/featured_images\\/48414055_1800725980054230_9208540934961102848_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2655\\/featured_images\\/52759717_1889355524524608_3748155003588575232_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2655\\/featured_images\\/52914604_1889362524523908_4240007889458036736_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2655\\/featured_images\\/52940731_1889441204516040_4531505017735086080_o.jpg\"],\"address\":{\"street\":\"Via Lombardia, 6\\/a\",\"town\":\"Suzzara\",\"postal_code\":\"46029\",\"country\":\"Italia\"},\"location\":{\"latitude\":44.9843523,\"longitude\":10.7658422},\"contact_info\":{\"email\":\"crossfitsuzzara@gmail.com\",\"phone\":\"+3903761694181\"},\"social_media\":{\"instagram\":\"crossfitsuzzara\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitsuzzara\\/\"}},{\"id_application\":null,\"id_lead\":\"3040\",\"name\":\"985 Crossfit\",\"description\":\"Bienvenido al CrossFit\\nBox afiliado de CrossFit a escasos metros de la playa del Arbeyal, en Gij\\u00f3n.\\nParking privado.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3040\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3040\\/featured_images\\/48424485_2242636809325730_1890455994505363456_n.jpg\"],\"address\":{\"street\":\"Avda. de Eduardo Castro, 94\",\"town\":\"Gijon\",\"postal_code\":\"33212\",\"country\":\"Spain\"},\"location\":{\"latitude\":43.5455362,\"longitude\":-5.6995289},\"contact_info\":{\"email\":\"hola@985crossfit.es\",\"phone\":\"985329793\"},\"social_media\":{\"instagram\":\"985crossfit\",\"facebook\":\"@985CrossFit\"}},{\"id_application\":null,\"id_lead\":\"2885\",\"name\":\"Quimera Crossfit\",\"description\":\"PRIMER BOX DE ALCOBENDAS con m\\u00e1s de 3 a\\u00f1os de experiencia formando atletas y llevando la marca de CrossFit cada vez m\\u00e1s alto.\\n\\nSomos un box que ofrece un espacio deportivo profesional donde disfrutar de la pr\\u00e1ctica de CrossFit en el ambiente m\\u00e1s agradable. Siempre en constante renovaci\\u00f3n, porque somos exigentes y queremos ofrecerte siempre lo mejor!!!!\\n\\nCreemos en tu potencial f\\u00edsico y mental y por eso nos esforzamos cada d\\u00eda en ofrecer los mejores entrenamientos, clases y atenci\\u00f3n personalizada, para que disfrutes de un deporte que te aportar\\u00e1 grandes satisfacciones.\\n\\nSomos tu centro de CrossFit Oficial con todos nuestros entrenadores certificados y formados para que aprendas y disfrutes con total seguridad.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2885\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2885\\/featured_images\\/1554.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2885\\/featured_images\\/DSC_3333copia.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2885\\/featured_images\\/DSC_3496copia.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2885\\/featured_images\\/frdptk7z.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2885\\/featured_images\\/maxresdefault.jpg\"],\"address\":{\"street\":\"Av. Doctor Severo Ochoa, 37\",\"town\":\"Alcobendas\",\"postal_code\":\"916574661\",\"country\":\"Spain\"},\"location\":{\"latitude\":40.540131,\"longitude\":-3.6563004},\"contact_info\":{\"email\":\"info@quimeracrossfit.es\",\"phone\":\"916574661\"},\"social_media\":{\"instagram\":\"quimeracrossfitalcobendas\",\"facebook\":\"@Quimeracrossfit\"}},{\"id_application\":null,\"id_lead\":\"2796\",\"name\":\"Ubox Crossfit Mataro\",\"description\":\"Crossfit Matar\\u00f3 es el primer box de Crossfit Oficial en todo el Maresme con m\\u00e1s de 750 metros cuadrados practicables para entrenar.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2796\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2796\\/featured_images\\/Slider4-940x626.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2796\\/featured_images\\/background-web.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2796\\/featured_images\\/inst7-940x626.jpg\"],\"address\":{\"street\":\"Carrer Abat Escarr\\u00e9, 25\",\"town\":\"Matar\\u00f3\",\"postal_code\":\"08302\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.5287904,\"longitude\":2.4244072},\"contact_info\":{\"email\":\"info@crossfitmataro.com\",\"phone\":\"930153930\"},\"social_media\":{\"instagram\":\"crossfitmataro\",\"facebook\":\"@crossfitmataro\"}},{\"id_application\":null,\"id_lead\":\"2869\",\"name\":\"Mibox Crossfit\",\"description\":\"Box Oficial de Crossfit en Sedav\\u00ed (Valencia).\\nSistema de entrenamiento funcional e intensivo.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2869\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2869\\/featured_images\\/13235322_963533190434033_4452961689364577081_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2869\\/featured_images\\/27912575_1577923408995005_5894760200090707421_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2869\\/featured_images\\/58571136_2172377722882901_5421204495214313472_n.jpg\"],\"address\":{\"street\":\"C\\/Sequ\\u00eda de Calvera, 28\",\"town\":\"Sedav\\u00ed\",