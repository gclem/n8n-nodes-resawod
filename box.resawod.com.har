al_code\":\"26100\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.1463606,\"longitude\":10.028758},\"contact_info\":{\"email\":\"info@crossfitcremona.com\",\"phone\":\"+39 333 538 1788\"},\"social_media\":{\"instagram\":\"crossfitcremona\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitcremona\\/\"}},{\"id_application\":\"69242867\",\"id_lead\":null,\"name\":\"1789 CrossFit\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/69242867\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Rue Claude Nicolas Ledoux\",\"town\":\"Aix-en-Provence\",\"postal_code\":\"13854\",\"country\":\"France\"},\"location\":{\"latitude\":43.4816538,\"longitude\":5.3858164},\"contact_info\":{\"email\":\"1789crossfit@frenchrevo.com\",\"phone\":\"0442227762\"},\"social_media\":{\"instagram\":\"1789crossfit\",\"facebook\":\"https:\\/\\/www.facebook.com\\/1789crossfit\"}},{\"id_application\":null,\"id_lead\":\"2918\",\"name\":\"CrossFit Aurillac\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2918\\/featured_images\\/15156915_610413385812246_501232739789261685_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2918\\/featured_images\\/17796001_675089339344650_5190423487364604213_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2918\\/featured_images\\/22042105_754924234694493_5085393169338642043_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2918\\/featured_images\\/22048132_754924164694500_2572309561799915147_o.jpg\"],\"address\":{\"street\":\"23 Rue de Gutenberg\",\"town\":\"Aurillac\",\"postal_code\":\"15000\",\"country\":\"France\"},\"location\":{\"latitude\":44.9145529,\"longitude\":2.4265947},\"contact_info\":{\"email\":\"crossfit.vulcain@gmail.com\",\"phone\":\"+33 9 67 82 66 53\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitAurillac\\/\"}},{\"id_application\":null,\"id_lead\":\"2859\",\"name\":\"Kom Crossfit\",\"description\":\"KOM CrossFit se encuentra en el centro de Madrid, entre Cuatro Caminos y el Paseo de la Castellana. 600 m2 di\\u00e1fanos dedicados a CrossFit, con 6 plataformas de halterofilia, jaula para 26 personas, remos, trineos, assault bikes, cajones, balones medicinales, cuerdas, farmers, kettlebells, combas\\u2026 y un sin fin de equipamiento con el que haremos que te olvides de cualquier rutina.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2859\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2859\\/featured_images\\/kombox_web.jpg\"],\"address\":{\"street\":\"C\\/ Trevi\\u00f1o 5\",\"town\":\"Madrid\",\"postal_code\":\"28003\",\"country\":\"Spain\"},\"location\":{\"latitude\":40.4460233,\"longitude\":-3.7041605},\"contact_info\":{\"email\":\"hola@komcrossfit.com\",\"phone\":\"910713458\"},\"social_media\":{\"instagram\":\"komcrossfit\",\"facebook\":\"@komcrossfit\"}},{\"id_application\":null,\"id_lead\":\"2697\",\"name\":\"Sweat Tear Crossfit\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2697\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2697\\/featured_images\\/29792013_424608624628370_8457413763820598083_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2697\\/featured_images\\/Bildschirmfoto-2018-05-12-um-23.32.24.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2697\\/featured_images\\/Bildschirmfoto-2018-05-12-um-23.32.33.png\"],\"address\":{\"street\":\"Balanstrasse 34 |\",\"town\":\"M\\u00fcnchen\",\"postal_code\":\"81669\",\"country\":\"Deutschland\"},\"location\":{\"latitude\":48.1244354,\"longitude\":11.5936609},\"contact_info\":{\"email\":\"info@sweat-tears-crossfit.com\",\"phone\":\"\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/SweatandTearsCrossFit\\/\"}},{\"id_application\":\"67747840\",\"id_lead\":null,\"name\":\"CrossFit Portixol\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/67747840\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"carrer de Lelicia Fuster 52\",\"town\":\"Palma\",\"postal_code\":\"07006\",\"country\":\"Espa\\u00f1a\"},\"location\":{\"latitude\":39.56226732,\"longitude\":2.66654917},\"contact_info\":{\"email\":\"contacto@crossfit-portixol.es\",\"phone\":\"871039932\"},\"social_media\":{\"instagram\":\"crossfitportixol\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"3021\",\"name\":\"Costa Daurada Crossfit\",\"description\":\"M\\u00e1s de 450m2 di\\u00e1fanos divididos en varias zonas de entrenamiento con m\\u00e1s de 8m de altura en las que podr\\u00e1s entrenar al m\\u00e1ximo. Adem\\u00e1s, en breve podr\\u00e1s descansar, comer y beber en nuestra zona \\u201cOpen CDC\\u201d, el lugar perfecto para conversar con tus compa\\u00f1eros antes del entreno y para comentar los resultados tras finalizarlo.\\n\\nTambi\\u00e9n disponemos de una sala de fisioterapia en la que nuestro experto fisioterapeuta te har\\u00e1 unas magn\\u00edficas sesiones. \\u00a1Preg\\u00fantanos por sus servicios!\\n\\nContamos con el mejor material Rogue, barras y discos de entrenamiento y competici\\u00f3n, kettlebells, cajones, balones, bancos de press, remos, cuerdas, bandas de estiramiento, combas, anillas, jaula de CrossFit con racks de potencia, barras de dominadas\\u2026\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3021\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3021\\/featured_images\\/16601603_629970670521589_7262110854353700346_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3021\\/featured_images\\/16649195_629969433855046_8712993182960135865_n.jpg\"],\"address\":{\"street\":\"Carrer de les Comes. 5F\",\"town\":\"Vilaseca\",\"postal_code\":\"43480\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.1181808,\"longitude\":1.146586},\"contact_info\":{\"email\":\"contacto@costadauradacrossfit.com\",\"phone\":\"677823036\"},\"social_media\":{\"instagram\":\"costadauradacrossfit\",\"facebook\":\"@CostaDauradaCrossFit\"}},{\"id_application\":null,\"id_lead\":\"2907\",\"name\":\"Crossfit Do Box\",\"description\":\"Somos el primer Box de CrossFit en abrir en El Vendrell. Somos un centro de entrenamiento y acondicionamiento f\\u00edsico oficial de CrossFit afiliado y certificado, bajo licencia de CrossFit Inc. U.S.A. en El Vendrell. Aqu\\u00ed nuestros entrenadores te ayudaran a fortalecer tu cuerpo, generar confianza, hacer nuevas amistades y principalmente a divertirse.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2907\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2907\\/featured_images\\/20031552_1938967089714036_3947765419621759479_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2907\\/featured_images\\/23275481_1992913097652768_8708854057897448067_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2907\\/featured_images\\/23668970_2000185240258887_8519731196732284015_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2907\\/featured_images\\/img-20180330-162013-692.jpg\"],\"address\":{\"street\":\"C\\/ Les Mates, N\\u00ba 36, Nave 2\",\"town\":\"El Vendrell\",\"postal_code\":\"43700\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.229534,\"longitude\":1.5463853},\"contact_info\":{\"email\":\"crossfitdobox@gmail.com\",\"phone\":\"977942992\"},\"social_media\":{\"instagram\":\"do_box\",\"facebook\":\"@crossfitdobox\"}},{\"id_application\":null,\"id_lead\":\"3068\",\"name\":\"Crossfit Badalona\",\"description\":\"BE AN ICON\\n\\nCrossFit\\nEntrenamiento Personal\\nEntrenamiento para grupos\\nFisioterapia\\nRecuperaci\\u00f3n \\nReadaptaci\\u00f3n\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3068\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3068\\/featured_images\\/3529c44a-ab5d-43b4-95d4-f3cb8c1b0391_1680.jpg\"],\"address\":{\"street\":\"Camelia, 36 bajo\",\"town\":\"Badalona\",\"postal_code\":\"08912\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.4534298,\"longitude\":2.2414691},\"contact_info\":{\"email\":\"info@crossfitbadalona.es\",\"phone\":\"620 45 73 59\"},\"social_media\":{\"instagram\":\"crossfitbadalona\",\"facebook\":\"@crossfitbadalona\"}},{\"id_application\":null,\"id_lead\":\"2875\",\"name\":\"Crossfit v 173\",\"description\":\"El objetivo de la familia V173 es conseguir que sus miembros se encuentren sanos y felices. Queremos proporcionar un camino divertido para alcanzar su objetivo de salud y fitness. Entrenamientos variados, intensos, divertidos y en familia. En nuestra comunidad necesitamos el apoyo de todos nuestros miembros para animar y celebrar el \\u00e9xito de cada uno.\\nLos objetivos podr\\u00e1n ser diferentes, pero nosotros podemos adaptar nuestro plan de entrenamiento a cualquier situaci\\u00f3n y necesidad. No tienes que estar en forma para empezar, nos encanta comenzar con personas sedentarias a las cuales introducimos nuestros m\\u00e9todos de entrenamiento y salud, logrando sus objetivos. Para nosotros es satisfactorio hacer feliz a nuestros socios haciendo lo que m\\u00e1s nos gusta.\\n\\nEnse\\u00f1amos a la gente a realizar los ejercicios correctamente con una mec\\u00e1nica correcta, evitando lesiones y consiguiendo as\\u00ed atletas saludables.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2875\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2875\\/featured_images\\/18403370_1334644623271396_1945763608649345546_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2875\\/featured_images\\/18422208_1335074729895052_6855866369549955726_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2875\\/featured_images\\/18423247_1335074879895037_269446450684925284_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2875\\/featured_images\\/18449296_1335074949895030_1476075685328913436_o.jpg\"],\"address\":{\"street\":\"C\\/ Alba\\u00f1iler\\u00eda, 20\",\"town\":\"La Orotava\",\"postal_code\":\"38312\",\"country\":\"Spain\"},\"location\":{\"latitude\":28.394644,\"longitude\":-16.541502},\"contact_info\":{\"email\":\"clientes@crossfitv173.com\",\"phone\":\"922080560\"},\"social_media\":{\"instagram\":\"crossfitv173\",\"facebook\":\"@crossfitv173\"}},{\"id_application\":null,\"id_lead\":\"3192\",\"name\":\"Crossfit am Gr\\u00fcn\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3192\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3192\\/featured_images\\/Bildschirmfoto%202019-07-04%20um%2011.08.50.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3192\\/featured_images\\/Bildschirmfoto%202019-07-04%20um%2011.08.59.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3192\\/featured_images\\/Bildschirmfoto%202019-07-04%20um%2011.09.17.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3192\\/featured_images\\/Bildschirmfoto%202019-07-04%20um%2011.09.23.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3192\\/featured_images\\/Bildschirmfoto%202019-07-04%20um%2011.09.36.png\"],\"address\":{\"street\":\"Am Gr\\u00fcn 52\",\"town\":\"Marburg\",\"postal_code\":\"35037\",\"country\":\"Germany\"},\"location\":{\"latitude\":50.8049544,\"longitude\":8.769076},\"contact_info\":{\"email\":\"mail@crossfitamgruen.de\",\"phone\":\"+49 64218406940\"},\"social_media\":{\"instagram\":\"crossfit_am_gruen\",\"facebook\":\"https:\\/\\/www.facebook.com\\/eversports\"}},{\"id_application\":null,\"id_lead\":\"3020\",\"name\":\"Alpha Link Crossfit\",\"description\":\"Alpha Link CrossFit\\n\\nSurge del deseo de compartir la pasi\\u00f3n por este deporte convirti\\u00e9ndose en un peque\\u00f1o eslab\\u00f3n dentro de la gran comunidad de CrossFit.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3020\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3020\\/featured_images\\/17760856_231453903996660_6573557434878386361_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3020\\/featured_images\\/alpha-link-crossfit-2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3020\\/featured_images\\/alpha-link-crossfit-4.jpg\"],\"address\":{\"street\":\"Roger de flor, 213\",\"town\":\"Barcelona\",\"postal_code\":\"08025\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.4013547,\"longitude\":2.1669156},\"contact_info\":{\"email\":\"info@alphalinkcrossfit.com\",\"phone\":\"678 56 07 49\"},\"social_media\":{\"instagram\":\"alphalinkcrossfit\",\"facebook\":\"@alphalinkcrossfit\"}},{\"id_application\":null,\"id_lead\":\"2691\",\"name\":\"Crossfit EO\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2691\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2691\\/featured_images\\/Bildschirmfoto%202019-04-12%20um%2009.23.28.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2691\\/featured_images\\/Bildschirmfoto%202019-04-12%20um%2009.23.43.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2691\\/featured_images\\/Bildschirmfoto%202019-04-12%20um%2009.24.03.png\"],\"address\":{\"street\":\"Weltenburgerstr. 6\",\"town\":\"M\\u00fcnchen\",\"postal_code\":\"81677\",\"country\":\"Germany\"},\"location\":{\"latitude\":48.1409067,\"longitude\":11.6256757},\"contact_info\":{\"email\":\"info@crossfit-eo.de\",\"phone\":\"+49 8945667845\"},\"social_media\":{\"instagram\":\"CrossFiteo\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFiteo\\/\"}},{\"id_application\":null,\"id_lead\":\"3026\",\"name\":\"Crossfit Rabasa\",\"description\":\"Sobre CrossFit Rabasa\\nSomos el \\u00fanico CENTRO OFICIAL en el que poder realizar CrossFit en Alicante. Esto significa entrenadores titulados, material de entrenamiento homologado y acceso exclusivo al mundo CrossFit.\\n\\nEl CrossFit no es solo un deporte, es una filosof\\u00eda de vida, es un tipo de entrenamiento que mezcla ejercicios funcionales, constantemente variados, ejecutados a alta intensidad y llenos de creatividad.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3026\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3026\\/featured_images\\/11112840_435919553252398_5689343472935862269_o.jpg\"],\"address\":{\"street\":\"C\\/ Fortuny 5\",\"town\":\"Alicante\",\"postal_code\":\"03009\",\"country\":\"Spain\"},\"location\":{\"latitude\":38.3751525,\"longitude\":-0.5026828},\"contact_info\":{\"email\":\"info@crossfitrabasa.com\",\"phone\":\"661 17 55 94\"},\"social_media\":{\"instagram\":\"crossfitrabasa\",\"facebook\":\"@crossfitrabasa\"}},{\"id_application\":\"18701909\",\"id_lead\":null,\"name\":\"Crossfit Ontos\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/18701909\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Technoparc Futura\",\"town\":\"Verquigneul\",\"postal_code\":\"62400\",\"country\":\"France\"},\"location\":{\"latitude\":50.5135275,\"longitude\":2.6606927},\"contact_info\":{\"email\":\"florent@crossfit-ontos.fr\",\"phone\":\"0699345017\"},\"social_media\":{\"instagram\":\"crossfit_ontos\",\"facebook\":\"@crossfit.ontos\"}},{\"id_application\":null,\"id_lead\":\"2588\",\"name\":\"Eschilo Crossfit\",\"description\":\"Un team, con un progetto nato da un\\u0027esigenza, da una necessit\\u00e0, da un desiderio, quello di condividere con voi tutti la PASSIONE per questo \\u0022Sport\\u0022. E\\u0027 uno stile di vita.. IL VOSTRO.. IL NOSTRO, che ha l\\u0027obiettivo di cambiare finalmente in meglio il corpo e la mente. Provare per credere, CREDERE PER ESSERE. \\nBelieve in yourself \\n- Staff Eschilo Crossfit -\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2588\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2588\\/featured_images\\/45713850_429259444271221_7367902042783744000_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2588\\/featured_images\\/45719568_428137127716786_4802723384909627392_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2588\\/featured_images\\/49095477_452030598660772_3757156975868116992_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2588\\/featured_images\\/51443352_475275493002949_753481656223924224_n.jpg\"],\"address\":{\"street\":\"Via Eschilo 99\",\"town\":\"Roma\",\"postal_code\":\"00125\",\"country\":\"Italia\"},\"location\":{\"latitude\":41.7605006,\"longitude\":12.3704537},\"contact_info\":{\"email\":\"info@eschilocrossfit.it\",\"phone\":\"+39 06 5236 1672\"},\"social_media\":{\"instagram\":\"eschilocrossfit\",\"facebook\":\"https:\\/\\/www.facebook.com\\/eschilocrossfit\\/\"}},{\"id_application\":null,\"id_lead\":\"2858\",\"name\":\"G2 Training\",\"description\":\"En tu nuevo box te espera una forma de entrenar diferente.\\nEn CrossFit G2 somos especialistas en ofrecer nada menos que la mejor experiencia de entrenamiento posible. Nos basamos en la metodolog\\u00eda de entrenamiento altamente eficaz, CrossFit. Hemos dise\\u00f1ado una formaci\\u00f3n con un enfoque \\u00fanico para obtener los mejores resultados posibles, independientemente de si tu objetivo es perder peso, ganar masa muscular o aumentar tu rendimiento deportivo. Nuestro equipo t\\u00e9cnico te proporcionar\\u00e1 los conocimientos, las herramientas y el apoyo que necesitas para alcanzar tus objetivos de fitness, tanto si aspiras a ser un\\/a competidor\\/a de primer nivel, como si eres completamente nuev@ en la disciplina. Hacemos un seguimiento de tu progreso y adaptamos tu entrenamiento, bas\\u00e1ndonos en datos objetivos y cuantificables, para asegurarnos de que tu formaci\\u00f3n est\\u00e1 siempre logrando los mejores resultados.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2858\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2858\\/featured_images\\/IMG_1766%20%281%29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2858\\/featured_images\\/IMG_1766.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2858\\/featured_images\\/maxresdefault.jpg\"],\"address\":{\"street\":\"Rotonda de Pit\\u00e1goras, 1, nave 703\",\"town\":\"Alcal\\u00e1 de Henares\",\"postal_code\":\"28806\",\"country\":\"Spain\"},\"location\":{\"latitude\":40.491029,\"longitude\":-3.3866402},\"contact_info\":{\"email\":\"info@crossfitg2.com\",\"phone\":\"617556622\"},\"social_media\":{\"instagram\":\"crossfit_g2\",\"facebook\":\"@crossfit_g2\"}},{\"id_application\":null,\"id_lead\":\"2733\",\"name\":\"Crossft Seven Eleven\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2733\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2733\\/featured_images\\/04fotounten.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2733\\/featured_images\\/Bildschirmfoto%202019-04-26%20um%2012.10.35.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2733\\/featured_images\\/Bildschirmfoto%202019-04-26%20um%2012.10.40.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2733\\/featured_images\\/Bildschirmfoto%202019-04-26%20um%2012.11.03.png\"],\"address\":{\"street\":\"Fuchseckstr. 21 B\",\"town\":\"Stuttgart\",\"postal_code\":\"70188\",\"country\":\"Deutschland\"},\"location\":{\"latitude\":48.7813927,\"longitude\":9.2046533},\"contact_info\":{\"email\":\"info@crossfit-seven-eleven.com\",\"phone\":\"+49 (0)176 \\/ 215 234 61\"},\"social_media\":{\"instagram\":\"crossfit_four_horsemen\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitfourhorsemen\\/\"}},{\"id_application\":null,\"id_lead\":\"2772\",\"name\":\"CrossFit ALC\",\"description\":\"Nuestro objetivo es poner a disposici\\u00f3n de cualquier persona, de su familia y amigos un programa de entrenamiento adecuado y eficaz para mejorar su forma f\\u00edsica y su calidad de vida. Queremos conseguir que la gente que nos importa se levante de sus sillones y empiece a moverse, que comience un programa de entrenamiento sincero, adaptado a sus limitaciones y realidades.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2772\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2772\\/featured_images\\/ace57b_3d8307dbb06c48a5bd2045f489d4767f_mv2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2772\\/featured_images\\/descarga-1.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2772\\/featured_images\\/descarga.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2772\\/featured_images\\/logo-crossfit-alc.png\"],\"address\":{\"street\":\"Poeta Pastor nave 10,\",\"town\":\"Alicante\",\"postal_code\":\"03007\",\"country\":\"Spain\"},\"location\":{\"latitude\":38.3442302,\"longitude\":0.5205378},\"contact_info\":{\"email\":\"info@crossfitalc.com\",\"phone\":\"+34 661 567 082\"},\"social_media\":{\"instagram\":\"crossfitalc\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitAlc\\/\"}},{\"id_application\":null,\"id_lead\":\"2656\",\"name\":\"CrossFit Mantova\",\"description\":\"Chi siamo\\nIl trainer Francesco Panigalli \\u00e8 allenatore e preparatore professionista di rugby e preparatore CrossFit certificato di 1\\u00ba livello. \\u00c8 inoltre giudice di gara.\\n\\nSiamo aperti dal luned\\u00ec al sabato e offriamo diverse tipologie di corsi per ogni esigenza. Vienici a trovare.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2656\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2656\\/featured_images\\/11949508_720578628069114_3661249604960102284_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2656\\/featured_images\\/1505174_425455187581461_2100496408_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2656\\/featured_images\\/25594273_1373584529435184_9145726354533338061_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2656\\/featured_images\\/6.jpg\"],\"address\":{\"street\":\"Strada Cipata, 2\",\"town\":\"Mantova\",\"postal_code\":\"46100\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.1620507,\"longitude\":10.8108276},\"contact_info\":{\"email\":\"info@crossfitmantova.com\",\"phone\":\"+39 347 187 0159\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitmantova\\/\"}},{\"id_application\":\"55203989\",\"id_lead\":null,\"name\":\"CrossFit Dortmund\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/55203989\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/55203989\\/featured_images\\/CrossfitDortmund-8.jpeg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/55203989\\/featured_images\\/CrossfitDortmund001%20Kopie.jpeg\"],\"address\":{\"street\":\"Am Sp\\u00f6rkel 36-42\",\"town\":\"Dortmund\",\"postal_code\":\"44227\",\"country\":\"Deu