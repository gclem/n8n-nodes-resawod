w\":\"Rajouter l\\u0027utilisateur au tirage au sort\"},\"choose_sports\":\"Choisissez les sports\",\"choose_resources\":\"Choisissez les \\u00e9quipements\",\"choose_times\":\"S\\u00e9lectionnez les horaires %categories%\",\"draws_warning_text\":{\"1\":\"En aucun cas, la demande de r\\u00e9servation ne vous garantira la r\\u00e9servation elle-m\\u00eame.\",\"2\":\"Si vous n\\u0027\\u00eates finalement pas en mesure de participer, vous devez nous en informer au moins 24 heures \\u00e0 l\\u0027avance afin qu\\u0027un autre membre puisse utiliser l\\u0027espace.\",\"3\":\"Vous pouvez v\\u00e9rifier si le court vous a \\u00e9t\\u00e9 attribu\\u00e9 tous les jeudis \\u00e0 partir de 12h00 dans la section \\u0027Disponibilit\\u00e9 de la cat\\u00e9gorie\\u0027.\"},\"delete_linked_course_category_error\":{\"2001\":\"Vous ne pouvez pas supprimer cette cat\\u00e9gorie car il y a des cours qui y sont associ\\u00e9s.\"},\"delete_unique_course_category_error\":{\"2002\":\"Vous ne pouvez pas supprimer la seule cat\\u00e9gorie de cours que vous avez\"},\"admin_activity_deleted\":\"Votre r\\u00e9servation a \\u00e9t\\u00e9 annul\\u00e9e\",\"admin_activity_deleted_sentence\":\"Oups! Votre inscription n\\u0027a pas \\u00e9t\\u00e9 prise en compte car vous n\\u0027avez pas effectu\\u00e9 le paiement \\u00e0 temps. Merci de nous contacter si vous rencontrez un probl\\u00e8me avec notre syst\\u00e8me.\",\"admin_course_deleted\":\"Votre inscription a \\u00e9t\\u00e9 annul\\u00e9e.\",\"admin_course_deleted_sentence\":\"Oups! votre inscription n\\u0027a malheureusement pas pu \\u00eatre confirm\\u00e9e car vous n\\u0027avez pas effectu\\u00e9 le paiement \\u00e0 temps. Merci de nous appeler si vous rencontrez un probl\\u00e8me avec notre syst\\u00e8me.\",\"date_of_inscription\":\"Date d\\u0027inscription\",\"enrolment_start_date\":\"Date de d\\u00e9but d\\u0027inscription\",\"enrolment_end_date\":\"Date de fin d\\u0027inscription\",\"user_profile\":\"Profil de l\\u0027utilisateur\",\"quick_view\":\"Aper\\u00e7u\",\"automatically_deleted\":\"Supprim\\u00e9 automatiquement\",\"automatically\":\"Automatiquement\",\"unknown\":\"Inconnu\",\"position_waiting_list\":\"Position dans la liste d\\u0027attente :\",\"add_user_waiting_list\":\"Ajouter un utilisateur dans la liste d\\u0027attente\",\"draw_will_be_made\":\"Le tirage au sort aura lieu le\",\"no_sessions_planned_yet\":\"Aucune session pr\\u00e9vue pour le moment\",\"operation_not_completed_course_previously_paid\":\"Cette op\\u00e9ration n\\u0027a pas pu \\u00eatre compl\\u00e9t\\u00e9e car le cours a d\\u00e9j\\u00e0 \\u00e9t\\u00e9 pay\\u00e9.\",\"pending_payment_already_in_remittance\":\"Cette op\\u00e9ration n\\u0027a pas pu \\u00eatre men\\u00e9e \\u00e0 bien car elle est d\\u00e9j\\u00e0 en cours de pr\\u00e9l\\u00e8vement.\",\"zoom_meeting_details\":\"Voici les d\\u00e9tails de la r\\u00e9union\",\"meeting_id\":\"R\\u00e9union ID\",\"open_in_zoom\":\"Ouvrir dans l\\u0027application Zoom\",\"other_users\":\"Autres utilisateurs\",\"activity_chat\":\"Chat de l\\u0027activit\\u00e9\",\"create_activity_chat\":\"Cr\\u00e9er un chat de l\\u0027activit\\u00e9\",\"activity_full\":\"L\\u0027utilisateur n\\u0027a pas pu \\u00eatre ajout\\u00e9. L\\u0027activit\\u00e9 est compl\\u00e8te\",\"waiting_list_full\":\"L\\u0027utilisateur n\\u0027a pas pu \\u00eatre ajout\\u00e9. La liste d\\u0027attente est pleine\",\"waiting_list_available\":\"Liste d\\u0027attente disponible\",\"activity_overbooking\":\"L\\u0027activit\\u00e9 est compl\\u00e8te. Voulez-vous forcer la r\\u00e9servation ?\",\"mailbox\":\"Messages\",\"conversation\":\"Conversation\",\"conversations\":\"Conversations\",\"no_conversations\":\"Aucune conversation\",\"chat\":\"Chat\",\"chat_info\":\"nfo chat\",\"chat_name\":\"Nom du chat\",\"open_chat_with\":\"Ouvrir une conversation avec...\",\"group_chat\":\"Chat de groupe\",\"new_group\":\"Nouveau groupe\",\"broadcast\":\"Diffuser\",\"new_conversation_confirmation\":\"Souhaitez-vous cr\\u00e9er