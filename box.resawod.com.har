\\u00e9 Biollat\",\"town\":\"Anthy-sur-L\\u00e9man\",\"postal_code\":\"74200\",\"country\":\"France\"},\"location\":{\"latitude\":46.3500212,\"longitude\":6.4371514},\"contact_info\":{\"email\":\"crossfitcorsaire@gmail.com\",\"phone\":\"+33 4 56 35 63 45\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitcorsaire\\/\"}},{\"id_application\":null,\"id_lead\":\"2855\",\"name\":\"Crossfit Raval\",\"description\":\"En THE BLACK BOX encontrar\\u00e1s una comunidad de personas comprometidas, que se dedican constantemente a establecer y alcanzar nuevos objetivos.\\n\\nEn nuestras instalaciones no encontrar\\u00e1s m\\u00e1quinas resultonas, s\\u00f3lo las herramientas b\\u00e1sicas para un entrenamiento de verdad, junto con su programa adecuado,que te proporcionar\\u00e1 los resultados que esperas.\\n\\nEs algo que tienes que experimentar para apreciarlo y entenderlo.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2855\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2855\\/featured_images\\/14525187_1776142849291700_6701252317427631597_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2855\\/featured_images\\/crossfit.jpg\"],\"address\":{\"street\":\"Reina Amalia 26\",\"town\":\"Barcelona\",\"postal_code\":\"08001\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.3764987,\"longitude\":2.1656205},\"contact_info\":{\"email\":\"info@theblackboxbcn.com\",\"phone\":\"620404376 \\/ 628869418\"},\"social_media\":{\"instagram\":\"crossfitraval\",\"facebook\":\"@crossfitraval\"}},{\"id_application\":null,\"id_lead\":\"2862\",\"name\":\"Crossfit M\\u00fchlheim am Main\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2862\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2862\\/featured_images\\/59499619_450510322374739_9218596894421869282_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2862\\/featured_images\\/image-1.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2862\\/featured_images\\/image-2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2862\\/featured_images\\/image-3.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2862\\/featured_images\\/image.jpg\"],\"address\":{\"street\":\"Otto-Hahn-Stra\\u00dfe 33\",\"town\":\"M\\u00fchlheim am Main\",\"postal_code\":\"63165\",\"country\":\"Germany\"},\"location\":{\"latitude\":50.1130738,\"longitude\":8.8476459},\"contact_info\":{\"email\":\"info@crossfit-muehlheim-main.de\",\"phone\":\"0049163 - 796 74 72\"},\"social_media\":{\"instagram\":\"crossfitmuehlheimmain\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitmuehlheimmain\\/\"}},{\"id_application\":null,\"id_lead\":\"2787\",\"name\":\"555 Crossfit\",\"description\":\"Box de CrossFit en pleno centro de Madrid,con mas de 500 metros de instalaciones!ven a entrenar!!!!\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2787\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2787\\/featured_images\\/555-crossfit-madrid.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2787\\/featured_images\\/entrenamiento_555_crossfit.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2787\\/featured_images\\/images8H82MT94.jpg\"],\"address\":{\"street\":\"C\\/ Guzm\\u00e1n el Bueno, 36\",\"town\":\"Madrid\",\"postal_code\":\"28015\",\"country\":\"Spain\"},\"location\":{\"latitude\":40.4345961,\"longitude\":-3.7152487},\"contact_info\":{\"email\":\"info@555crossfit.com\",\"phone\":\"913 92 85 82\"},\"social_media\":{\"instagram\":\"555crossfit\",\"facebook\":\"@555-CrossFit\"}},{\"id_application\":\"27836370\",\"id_lead\":null,\"name\":\"Crossfit Electron\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/27836370\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/27836370\\/featured_images\\/14589659_539521859579371_6327695305975897718_ojpg-1524570863158.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/27836370\\/featured_images\\/35026365_820288024836085_3554191952628940800_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/27836370\\/featured_images\\/maxresdefault%20%281%29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/27836370\\/featured_images\\/maxresdefault%20%282%29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/27836370\\/featured_images\\/maxresdefault.jpg\"],\"address\":{\"street\":\"Chemin du Bois de la Lave\",\"town\":\"Ch\\u00e2tillon-le-Duc\",\"postal_code\":\"25870\",\"country\":\"France\"},\"location\":{\"latitude\":47.2890584,\"longitude\":5.9985945},\"contact_info\":{\"email\":\"contact@crossfitelectron.fr\",\"phone\":\"0967443740\"},\"social_media\":{\"instagram\":\"crossfitelectron\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitelectron\"}},{\"id_application\":null,\"id_lead\":\"2626\",\"name\":\"Crossfit 27010\",\"description\":\"CROSSFIT \\u00c8 UN REGIME DI FITNESS SVILUPPATO DA GREG GLASSMAN NELL\\u2019ARCO DI DIVERSI DECENNI.\\nGlassman, fondatore e CEO di CrossFit, \\u00e8 stata la prima persona nella storia a definire il fitness in un modo misurabile e significativo. Ha poi creato un programma specificamente progettato per migliorare la forma fisica e la salute.\\n\\nCrossFit \\u00e8 il flusso costante di svariati movimenti funzionali eseguiti ad alta intensit\\u00e0. Tutti gli allenamenti CrossFit si basano su movimenti funzionali, e questi movimenti riflettono gli aspetti migliori della ginnastica, del sollevamento pesi, della corsa, del canottaggio e altro ancora.\\n\\nRESISTENZA CARDIOVASCOLARE\\nSTAMINA (RESISTENZA MUSCOLARE SPECIFICA)\\n\\nQUESTI SONO I MOVIMENTI DI BASE DELLA VITA.\\nSi muovono i pi\\u00f9 grandi carichi le distanze pi\\u00f9 lunghe, in modo che siano l\\u2019ideale per massimizzare la quantit\\u00e0 di lavoro svolto nel minor tempo possibile. L\\u2019intensit\\u00e0 \\u00e8 essenziale per ottenere risultati ed \\u00e8 misurabile come il lavoro diviso per il tempo. Pi\\u00f9 movimento si fa in meno tempo, o con maggiore potenza, pi\\u00f9 intenso \\u00e8 lo sforzo.\\n\\nL\\u2019IMPORTANZA DELLA COMUNIT\\u00c0\\nLa comunit\\u00e0 che nasce spontaneamente quando la gente fa questi allenamenti insieme \\u00e8 un componente chiave del perch\\u00e9 CrossFit \\u00e8 cos\\u00ec efficace, e ha dato vita ad una rete globale di affiliati CrossFit che supera le 13.000 unit\\u00e0. Sfruttando il naturale cameratismo, la competizione e il divertimento dello sport che si fa gioco si produce un affiatamento imparagonabile.\\n\\nIL PROGRAMMA\\nIl programma CrossFit \\u00e8 guidato dai dati. Utilizzando lavagne per segnare i punteggi e una serie di registrazioni accurate impostate su tempi ed esercizi, si va a definire una serie di regole standard per le prestazioni. Questo non solo stimola il successo ma consente di avere delle metriche relative e assolute in ogni allenamento. Questi dati hanno un valore fondamentale.\\nIl programma prepara gli allievi per ogni evenienza, non solo fisica.\\n\\nUN ALLENAMENTO PER TUTTI\\nCrossFit \\u00e8 una grande sfida, ma il programma \\u00e8 progettato per essere scalabile, il che rende l\\u2019applicazione perfetta per ogni individuo impegnato, a prescindere dall\\u2019esperienza o dall\\u2019et\\u00e0. Noi scaliamo carico e l\\u2019intensit\\u00e0; non cambiamo il programma.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2626\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2626\\/featured_images\\/22089552_374568639662861_4543728434374563063_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2626\\/featured_images\\/22405752_381983962254662_8512351460137750668_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2626\\/featured_images\\/30709818_512751635844560_2479219951211118592_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2626\\/featured_images\\/30724850_512751532511237_8618496897612513280_n.jpg\"],\"address\":{\"street\":\"Via Villanterio 32\",\"town\":\"Gerenzago\",\"postal_code\":\"27010\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.2108748,\"longitude\":9.3619598},\"contact_info\":{\"email\":\"info@crossfit27010.com\",\"phone\":\"+39 3496560504\"},\"social_media\":{\"instagram\":\"crossfit_27010\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFit-27010-206144113171982\\/\"}},{\"id_application\":\"43323938\",\"id_lead\":null,\"name\":\"CrossFit Nancy\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/43323938\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"26 Boulevard du 26\\u00e8me R. I.\",\"town\":\"Nancy\",\"postal_code\":\"54000\",\"country\":\"France\"},\"location\":{\"latitude\":48.6971839,\"longitude\":6.1893984},\"contact_info\":{\"email\":\"no-reply@crossfit-nancy.fr\",\"phone\":\"0652755426\"},\"social_media\":{\"instagram\":\"crossfitnancy\",\"facebook\":\"\"}},{\"id_application\":\"21243034\",\"id_lead\":null,\"name\":\"Goldenback CrossFit\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/21243034\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/21243034\\/featured_images\\/news-logo-golden-back.png\"],\"address\":{\"street\":\"77 boulevard Pierre Mendes France\",\"town\":\"Wattrelos\",\"postal_code\":\"59150\",\"country\":\"France\"},\"location\":{\"latitude\":50.6954079,\"longitude\":3.2142692},\"contact_info\":