:{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossfitLaRocheSurYon\\/\"}},{\"id_application\":\"35237223\",\"id_lead\":null,\"name\":\"CrossFit Galea\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/35237223\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"1 impasse Jean Perrin\",\"town\":\"Laudun l\\u0027ardoise\",\"postal_code\":\"30290\",\"country\":\"France\"},\"location\":{\"latitude\":44.1050625,\"longitude\":4.6968125},\"contact_info\":{\"email\":\"contact@crossfitgalea.fr\",\"phone\":\"06 34 90 87 98\"},\"social_media\":{\"instagram\":\"crossfit.galea\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFit.Galea\"}},{\"id_application\":null,\"id_lead\":\"2707\",\"name\":\"Crossfit Westgym\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2707\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2707\\/featured_images\\/Bildschirmfoto%202019-04-15%20um%2013.41.01.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2707\\/featured_images\\/Bildschirmfoto%202019-04-15%20um%2013.41.06.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2707\\/featured_images\\/Bildschirmfoto%202019-04-15%20um%2013.41.12.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2707\\/featured_images\\/Bildschirmfoto%202019-04-15%20um%2013.41.21.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2707\\/featured_images\\/Bildschirmfoto%202019-04-15%20um%2013.41.27.png\"],\"address\":{\"street\":\"Boschstr. 15A,\",\"town\":\"Hamburg\",\"postal_code\":\"22761\",\"country\":\"Deutschland\"},\"location\":{\"latitude\":53.5670865,\"longitude\":9.9131515},\"contact_info\":{\"email\":\"cfwestgym@gmail.com\",\"phone\":\"+49 1636784744\"},\"social_media\":{\"instagram\":\"cf_westgym_hamburg\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFit.WestGym\\/\"}},{\"id_application\":null,\"id_lead\":\"2645\",\"name\":\"Valseriana CrossFit\",\"description\":\"Cos\\u0027\\u00e8 CrossFit\\nCrossFit \\u00e8 un sistema estremamente sicuro, efficiente ed efficace per arrivare ad ottenere una forma fisica eccellente.\\nCrossFit \\u00e8 nato in una palestra povera e anticonvenzionale di Santa Cruz negli Stati Uniti d\\u2019America, \\u00e8 si \\u00e8 diffuso rapidamente tra gli atleti professionisti, corpi di polizia, unit\\u00e0 militari altamente specializzate, campioni di arti marziali, e tra le persone comuni di tutti i giorni in cerca di un modo diverso di iniziare un serio programma di fitness.\\nGli allenamenti CrossFit sono funzionali, vari e intensi di breve o lunga durata.\\nEssi sono inoltre adattabili e modulabili per qualsiasi livello di abilit\\u00e0, infatti i nostri clienti variano da atleti d\\u2019elite a persone di una certa et\\u00e0 ....Dunque qualunque sia la forma fisica di partenza, sarete in grado di iniziare a praticarlo senza alcun problema.\\nValseriana CrossFit \\u00e8 riconosciuto e certificato da CrossFit\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2645\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2645\\/featured_images\\/12891635_1125220800831819_3486926818066839428_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2645\\/featured_images\\/14206143_1226170754070156_5815117293154796363_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2645\\/featured_images\\/16473541_1377081665645730_420129938759940478_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2645\\/featured_images\\/18057850_1460168364003726_3218377954070259525_n.jpg\"],\"address\":{\"street\":\"Via caduti, 93, Cene\",\"town\":\"Bergamo\",\"postal_code\":\"24020\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.7686023,\"longitude\":9.8176766},\"contact_info\":{\"email\":\"info@valserianacrossfit.com\",\"phone\":\"+39 3388310859\"},\"social_media\":{\"instagram\":\"valseriana_crossfit\",\"facebook\":\"https:\\/\\/www.facebook.com\\/valserianacrossfit\\/\"}},{\"id_application\":\"23545588\",\"id_lead\":null,\"name\":\"Crossfit La Possession\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/23545588\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/23545588\\/featured_images\\/19221495_1900580936873322_6901430257670360783_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/23545588\\/featured_images\\/20785838_1931589833772432_2233525978458699983_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/23545588\\/featured_images\\/22498964_1959664450964970_4411878806391036585_o.jpg\"],\"address\":{\"street\":\"rue Thomas Sankara\",\"town\":\"La Possession\",\"postal_code\":\"97419\",\"country\":\"France\"},\"location\":{\"latitude\":-20.9648168,\"longitude\":55.3917982},\"contact_info\":{\"email\":\"info@crossfitpossession.re\",\"phone\":\"06 92 79 62 24\"},\"social_media\":{\"instagram\":\"crossfit_possession\",\"facebook\":\"\"}},{\"id_application\":\"79394717\",\"id_lead\":null,\"name\":\"CrossFit Louviers\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/79394717\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"10 Rue des Entrep\\u00f4ts\",\"town\":\"Louviers\",\"postal_code\":\"27400\",\"country\":\"France\"},\"location\":{\"latitude\":49.2285535,\"longitude\":1.1703284},\"contact_info\":{\"email\":\"contact@crossfitlouviers.fr\",\"phone\":\"06 13 64 56 80\"},\"social_media\":{\"instagram\":\"crossfit_louviers\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitlouviers\"}},{\"id_application\":null,\"id_lead\":\"3131\",\"name\":\"Affenstark Crossfit\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3131\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3131\\/featured_images\\/CrossFit_Fundamentals.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3131\\/featured_images\\/CrossFit_Gymnastics.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3131\\/featured_images\\/Photo-by-Victor-Freitas-on-Unsplash_Jedermann.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3131\\/featured_images\\/Photo-by-Victor-Freitas-on-Unsplash_Lifting.jpg\"],\"address\":{\"street\":\"Wilhelm-Binder-Strasse 19\",\"town\":\"Villingen-Schwenningen\",\"postal_code\":\"78048\",\"country\":\"Germany\"},\"location\":{\"latitude\":48.0650654,\"longitude\":8.4542345},\"contact_info\":{\"email\":\"banane@crossfit-affenstark.de\",\"phone\":\"+49 1778586441\"},\"social_media\":{\"instagram\":\"crossfitaffenstark\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitAffenstark\"}},{\"id_application\":null,\"id_lead\":\"2593\",\"name\":\"CrossFit Myland\",\"description\":\"Ci trovi in via Riccardo Lombardi 19\\/12, Milano, MI\\nSiamo in zona strategica al confine con i comuni di: Settimo M.se \\u2013 Cusago \\u2013 Seguro \\u2013 Baggio\\nDalla tangenziale Ovest di Milano prendi l\\u2019uscita Cusago.\\nTi aspettiamo da Luned\\u00ec a Venerd\\u00ec 11.00-14.00 16.00-21.30 \\/ Sabato 11.00-14.00\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2593\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2593\\/featured_images\\/15129484_977564339054966_7876580749072524957_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2593\\/featured_images\\/18057684_1089322461212486_1977115097236937983_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2593\\/featured_images\\/20292979_1158701880941210_7299227846277986981_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2593\\/featured_images\\/42156887_1472704999540895_2490369793685716992_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2593\\/featured_images\\/42568159_1478176472327081_698966675717881856_n.jpg\"],\"address\":{\"street\":\"via Riccardo Lombardi 19\\/12\",\"town\":\"Milano\",\"postal_code\":\"20153\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.46268,\"longitude\":9.0643611},\"contact_info\":{\"email\":\"info@mylandcrossfit.com\",\"phone\":\"+39 02 87 196 967\"},\"social_media\":{\"instagram\":\"myland_crossfit\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossfitMilano\"}},{\"id_application\":null,\"id_lead\":\"2688\",\"name\":\"Crossfit my Buddy\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2688\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2688\\/featured_images\\/EmptyName-3-1024x683.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2688\\/featured_images\\/MyBuddy-17-1024x683.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2688\\/featured_images\\/MyBuddy-20-1024x683.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2688\\/featured_images\\/MyBuddy-5-1024x683-1.jpg\"],\"address\":{\"street\":\"Ziegeleiweg 26\",\"town\":\"Pinneberg\",\"postal_code\":\"25421\",\"country\":\"Deutschland\"},\"location\":{\"latitude\":53.6675782,\"longitude\":9.7813772},\"contact_info\":{\"email\":\"hello@crossfitmybuddy.com\",\"phone\":\"004917670632956\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2754\",\"name\":\"Crossfitt Box Heidelberg\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2754\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2754\\/featured_images\\/20180424_070716.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2754\\/featured_images\\/Bildschirmfoto%202019-05-15%20um%2010.20.03.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2754\\/featured_images\\/Lacee-4.jpg\"],\"address\":{\"street\":\"Fabriksfra\\u00dfe 42\",\"town\":\"Heidelberg\",\"postal_code\":\"69126\",\"country\":\"Germany\"},\"location\":{\"latitude\":49.3831593,\"longitude\":8.6803538},\"contact_info\":{\"email\":\"info@crossfit-heidelberg.de\",\"phone\":\"\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitheidelberg.de\\/\"}},{\"id_application\":\"24237521\",\"id_lead\":null,\"name\":\"CrossFit P\\u00e9lissanne\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/24237521\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/24237521\\/featured_images\\/6564b5db7b21f.jpg\"],\"address\":{\"street\":\"9 Impasse des Glycines\",\"town\":\"P\\u00e9lissanne\",\"postal_code\":\"13330\",\"country\":\"France\"},\"location\":{\"latitude\":43.631049,\"longitude\":5.150567},\"contact_info\":{\"email\":\"crossfitpelissanne@nubapp-clients.com\",\"phone\":\"06 22 34 30 47\"},\"social_media\":{\"instagram\":\"crossfitpelissanne\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2719\",\"name\":\"CrossFit Venezia\",\"description\":\"CrossFit Venezia \\u00e8 un team di allenatori dedicati che si sforzano di creare un ambiente accogliente e familiare, fornendo alla nostra comunit\\u00e0 il miglior servizio possibile. Vogliamo che i nostri atleti siano pi\\u00f9 forti, pi\\u00f9 snelli, pi\\u00f9 veloci e pi\\u00f9 coordinati. Crediamo che le basi della salute e fitness siano un buon sistema cardiorespiratorio e l\\u2019abilit\\u00e0 di eseguire pi\\u00f9 movimenti possibili. Il nostro obiettivo e farvi raggiungere una forma fisica d\\u2019elite.\\n\\nA CrossFit Venezia c\\u2019\\u00e8 una comunit\\u00e0 composta da persone diverse: dottori, insegnanti, atleti, vigili del fuoco, architetti, mamme, pap\\u00e0, nonni, bambini. Quello che abbiamo in comune sono la motivazione, il duro lavoro e la correttezza. Queste sono le caratteristiche sulle quali abbiamo costruito la nostra comunit\\u00e0.\\n\\nGli allenamenti sono sempre diversi e mai noiosi. Ogni allenamento viene adattato, tramite il carico e l\\u2019intensit\\u00e0, per soddisfare le esigenze di ogni persona in base al relativo livello di fitness in modo che agonisti e nonne possano allenarsi insieme.\\n\\nCrossFit non \\u00e8 un allenamento comune. Ma \\u00e8 per la gente comune in cerca di risultati.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2719\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2719\\/featured_images\\/23916623_513309522372551_7565677483279675424_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2719\\/featured_images\\/24852631_517988001904703_1141411650238377192_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2719\\/featured_images\\/24900071_517987758571394_2321255508989708897_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2719\\/featured_images\\/47295566_729946787375489_2047458751643910144_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2719\\/featured_images\\/56531190_806209209749246_9099868976653008896_n.jpg\"],\"address\":{\"street\":\"Via Bottenigo 147\\/R\",\"town\":\"Venezia\",\"postal_code\":\"30175\",\"country\":\"Italy\"},\"location\":{\"latitude\":45.4619722,\"longitude\":12.2128279},\"contact_info\":{\"email\":\"info@crossfitvenezia.com\",\"phone\":\"+39 041 937795\"},\"social_media\":{\"instagram\":\"crossfitvenezia\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitVenezia\\/\"}},{\"id_application\":null,\"id_lead\":\"2602\",\"name\":\"CrossFit M1\",\"description\":\"Non hai mai fatto CrossFit?\\nPer iniziare\\n\\nIl nostro staff ti guider\\u00e0 passo passo nel tuo primo mese di frequenza presso il nostro Box attraverso il nostro programma di avviamento chiamato Elements.\\n\\nLe prime 5 lezioni le farai guidato one to one con uno dei nostri Coach, finite queste lezioni della durata di 45 minuti sarai in grado fin da subito di partecipare alle classi in autonomia e concludere il mese iniziale allenandoti come se avessi un abbonamento open.\\n\\nSe il nostro istruttore riterr\\u00e0 opportuno invece che tu venga ancora seguito dopo le prime 5 lezioni ti proporr\\u00e0 un programma guidato aggiuntivo.\\n\\nAlla fine della seconda parte di Coaching guidato sarai sicuramente in grado di affrontare in autonomia gli allenamenti di CrossFit presso il nostro box CrossFit.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2602\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2602\\/featured_images\\/11219100_1142306905797429_7055277623425222740_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2602\\/featured_images\\/12227075_1161121707249282_8842588709881443933_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2602\\/featured_images\\/26814761_1908292582532187_6622302338579909130_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2602\\/featured_images\\/48417852_2365088043519303_2105319387119484928_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2602\\/featured_images\\/921173_643599482334843_2064709305_o.jpg\"],\"address\":{\"street\":\"Via Legnone, 54\",\"town\":\"Milano\",\"postal_code\":\"20158\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.5019537,\"longitude\":9.180771},\"contact_info\":{\"email\":\"info@crossfitm1.com\",\"phone\":\"+39 02 4547 1120\"},\"social_media\":{\"instagram\":\"crossfitm1\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitm1\\/\"}},{\"id_application\":\"23275825\",\"id_lead\":null,\"name\":\"360 Functional\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/23275825\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Heselst\\u00fccken 10\",\"town\":\"Hamburg\",\"postal_code\":\"22453\",\"country\":\"Germany\"},\"location\":{\"latitude\":53.616153,\"longitude\":9.9990828},\"contact_info\":{\"email\":\"info@360functional.de\",\"phone\":\"015221753913\\t\"},\"social_media\":{\"instagram\":\"360.functional\",\"facebook\":\"\"}},{\"id_application\":\"85639588\",\"id_lead\":null,\"name\":\"Evolv Studio\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/85639588\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"4 rue Gillois\",\"town\":\"Volgelsheim\",\"postal_code\":\"68600\",\"country\":\"France\"},\"location\":{\"latitude\":48.0112867,\"longitude\":7.5452646},\"contact_info\":{\"email\":\"info@evolvstudio.fr \",\"phone\":\"0977996069\"},\"social_media\":{\"instagram\":\"evolv_studio\",\"facebook\":\"\"}},{\"id_application\":\"48790234\",\"id_lead\":null,\"name\":\"North Gym\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/48790234\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"K\\u00f6sliner Weg 19\",\"town\":\"Norderstedt\",\"postal_code\":\"22850\",\"country\":\"Germany\"},\"location\":{\"latitude\":53.6909794,\"longitude\":9.9791046},\"contact_info\":{\"email\":\"fitness@northgym.de\",\"phone\":\"+49 040 35777931\"},\"social_media\":{\"instagram\":\"northgym.norderstedt\",\"facebook\":\"https:\\/\\/www.facebook.com\\/NORTHGYM2013\"}},{\"id_application\":null,\"id_lead\":\"2598\",\"name\":\"CrossFit Sempione\",\"description\":\"Il Crossfit \\u00e8 un programma di allenamento a 360\\u00b0, basato su movimenti funzionali costantemente variati ed eseguiti ad alta intensit\\u00e0. Regala al tuo fisico, ogni giorno, un\\u2019ora di puro benessere. Contattaci e vieni a trovarci per una prova gratuita. Ti aspettiamo!\\n\\n\\nIl Crossfit non annoia mai\\nLa sua \\u201cspecialit\\u00e0\\u201d \\u00e8 proprio la non specializzazione. il Crossfit evita la routine e propone ogni giorno un WOD (workout of the day) diverso, con lo scopo di raggiungere un\\u2019alta competenza e migliorare le 10 abilit\\u00e0 fisiche : Resistenza cardiovascolare\\/respiratoria,Resistenza, Forza, Flessibilit\\u00e0, Potenza, Velocit\\u00e0, Coordinazione, Agilit\\u00e0,Equilibrio, Precisione.\\n\\n\\nAdatto a tutti e per tutte le esigenze\\nIl Crossfit \\u00e8 un sport democratico. L\\u2019atleta, la persona sedentaria, il soggetto allenato, l\\u2019anziano, il bambino, tutti possono praticare il Crossfit \\u2013 ovviamente nella giusta dose, in base all\\u2019et\\u00e0. Intensit\\u00e0 e carico variano, gli esercizi e la loro esecuzione rimangono invece gli stessi.\\n\\n\\nNon utilizziamo macchine\\nLe macchine sono i muscoli di chi si allena. Utilizziamo per\\u00f2 bilancieri,kettlebells, palle mediche, anelli, corde, bumpers e tutto ci\\u00f2 che serve per svolgere un ottimale esercizio fisico, alternando ginnastica, pesistica ed esercitazioni monostrutturali, noti come \\u201ccardio\\u201d. Per funzionare al meglio si lavorer\\u00e0 sulla tecnica di esecuzione, che i nostri coach sapranno insegnare al meglio.\\nScopri un nuovo modo di star bene con te stesso con CrossFit Sempione.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2598\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2598\\/featured_images\\/10446150_1591839441084996_6726718713346238261_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2598\\/featured_images\\/12371009_1652712758330997_2761863297708653689_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2598\\/featured_images\\/13173340_1711076645827941_7379817210351133880_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2598\\/featured_images\\/23794762_1989236904678579_4403257654262011686_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2598\\/featured_images\\/35077400_2088959281373007_5280054732948242432_n.jpg\"],\"address\":{\"street\":\"via per Castellanza, 15\",\"town\":\"Milano\",\"postal_code\":\"20025\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.605146,\"longitude\":8.9087537},\"contact_info\":{\"email\":\"info@crossfitsempione.com\",\"phone\":\"+39 342 5218180\"},\"social_media\":{\"instagram\":\"crossfit_sempione\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitsempione\\/\"}},{\"id_application\":\"39194991\",\"id_lead\":null,\"name\":\"One Life Training\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/39194991\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"C\\/ de Pi i Margall, 55\",\"town\":\"Barcelona\",\"postal_code\":\"08024\",\"country\":\"Espa\\u00f1a\"},\"location\":{\"latitude\":41.4091871,\"longitude\":2.1637318},\"contact_info\":{\"email\":\"hola@onelife.cat\",\"phone\":\"611180239\"},\"social_media\":{\"instagram\":\"one.life.training\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2583\",\"name\":\"CrossFit Frascati\",\"description\":\"CROSSFIT FRASCATI\\n\\nCi alleniamo in classi, o mini gruppi, che vanno dalle 5 alle 15 persone.\\n\\nVerrai sempre seguito da uno o due dei nostri Coach certificati. \\n\\nNon ti preoccupare. \\n\\nDimenticati noiose palestre di fitness ed esercizi inutili: la nostra missione \\u00e8 quella di perfezionare il movimento dell\\u0027uomo e la sua salute attraverso movimenti funzionali ad alta intensit\\u00e0 costantemente variati: solleva, salta, corri, spingi, tira ed arrampica! \\n\\nDa Noi si allenano atleti, impiegati, mamme e ragazzi, casalinghe, nonni, Forze dell\\u0027Ordine, corpi militari e disabili per migliorare la loro forma fisica e la loro vita.\\n\\nPer capire davvero cos\\u0027\\u00e8 il CrossFit, il migliore modo \\u00e8 quello di venire a provarlo!\\n\\nDa noi la noia non esiste!\\n\\n \\n\\n \\n\\n\\n\\n\\nIL BOX\\n\\n400mq di spazio interamente dedicato al CrossFit, con bilancieri olimpionici, bumpers, rower, bike, ghd, pi\\u00f9 di 15 postazioni per i Pull Up, anelli per i muscle up, kettlebell, dumbbell, climbing rope e molto altro POWERED BY HATLEX.\\n\\n100mq di spogliatoi, ampio parcheggio privato e, cosa ancora pi\\u00f9 importante, troverai un luogo che in breve tempo chiamerai casa con un gruppo di persone guidate da coaches esperti che ti motiveranno e ti aiuteranno ad allenarti, a migliorarti e divertirti.\\n\\nStai sicuro che ogni volta che verrai, avrai la certezza di uscire pi\\u00f9 in forma di quando sei entrato.\\n\\n\\nCLASSI\\n\\nCrossFit Class\\n\\nQuesta \\u00e8 la classica lezione di CrossFit. Imparerai o migliorerai i vari movimenti funzionali del CrossFit e prenderai parte al \\u201cworkout of the day\\u201d (W.O.D.) in cui ci si allener\\u00e0 ad alta intensit\\u00e0 variando costantemente la modalit\\u00e0. Troverai ogni giorno un allenamento diverso, (dal luned\\u00ec alla domenica) che verr\\u00e0 ripetuto pi\\u00f9 volte nell\\u0027arco della giornata per permetterti di scegliere l\\u0027orario pi\\u00f9 adatto alle tue esigenze.\\n\\nOpen Gym\\n\\nOltre alle varie classi siamo aperti in diversi orari in modalit\\u00e0 Open Gym, durante questi orari potrai venire al box (se ritenuto idoneo) ed allenarti da solo o con altri atleti seguendo la tua programmazione personale. Il box \\u00e8 a tua disposizione, prendi questi momenti come occasione per migliorare le tue skills oppure prepararti ad un eventuale competizione. Il box \\u00e8 anche un po\\u2019 casa tua.\\n\\nSpecial Class\\n\\nStretching e Mobility: Rieducare la postura e la capacit\\u00e0 del corpo a raggiungere determinati range di movimento con la massima naturalezza sar\\u00e0 fondamentale per allenarsi, sopratutto con i sovraccarichi, in maniera sicura e al 100% di se stessi. Infatti solo cos\\u00ec potremo affrontare qualsiasi sfida che il nostro WOD ci metter\\u00e0 davanti esprimendo davvero tutta la forza che abbiamo in corpo.\\n\\n\\nMetCon\\/Cardio: Praticheremo sforzi di intensit\\u00e0 media o alta che potranno durare anche solo pochi minuti, comprendenti varie tecniche, con l\\u0027obiettivo di migliorare la funzione cardiovascolare e ridurre il grasso corporeo, con coseguente aumento di Potenza, Velocit\\u00e0, Forza e Massa muscolare.\\n\\n\\nWeightlifting: Classi interamente dedicate allo Snatch e al Clean\\u0026Jerk in italiano Strappo e Slancio! Sono due movimenti in grado di migliorare la forza, la velocit\\u00e0, la potenza, l\\u0027agilit\\u00e1 e la coordinazione, tutte abilit\\u00e0 fondamentali nel CrossFit!\\n\\nNon perdertele se vuoi migliorare la tua PERFORMANCE atletica e diventare pi\\u00f9 efficiente all\\u0027interno dei WOD! \\n\\n\\nSaranno questi e tanti altri gli argomenti di specializzazione che andremo a trattare ogni marted\\u00ec e gioved\\u00ec.\\n\\n\\nOn Ramp\\n\\n5 classi di inserimento obbligatorie per tutti, per consentire di apprendere i movimenti base con cui iniziare ad affrontare le classi in tutta sicurezza.\\n\\nPERSONAL TRAINING\\n\\nLo Staff CROSSFIT FRASCATI offre un servizio di Personal Training mirato a migliorare, sia a livello tecnico che pratico, le varie competenze del CrossFit.\\nChe tu voglia prepararti per una competizione o che il tuo obbiettivo sia migliorare i tuoi movimenti o i tuoi massimali, puoi affidati ad uno dei nostri Coaches Certificati per lezioni private.\\n\\n\\nF.A.Q.\\n\\nIl CrossFit \\u00e8 adatto me?\\n\\nCerto, il CrossFit \\u00e8 adatto a tutti, indipendentemente dalle abilit\\u00e0 fisiche. Il CrossFit \\u00e8 stato studiato per essere adattabile e scalabile in base alle competenze di ognuno. Abbiamo atleti professionisti e mamme che si tengono in forma. Il CrossFit \\u00e8 per tutti.\\n\\nDevo avere particolari esperienze per partecipare ad una classe?\\n\\nNo. Nessuna esperienza in particolare. I nostri Coaches ti aiuteranno e ti insegneranno le basi dei movimenti.\\n\\nSono MOLTO fuori forma, \\u00e8 rischioso provare CrossFit?\\n\\nAssolutamente no. Fidati di noi. In ogni caso, se ti fa piacere, passa dal box e fai due chiacchiere con uno dei nostri coaches, sar\\u00e0 lieto  di spiegarti bene qual \\u00e8 il nostro metodo di lavoro. E potrai anche vedere dal vivo una classe.\\n\\nCome funziona la prova gratuita?\\n\\nParteciperai ad una classe regolare di CrossFit assieme ad altri atleti, esperti e novizi. In ogni classe si andr\\u00e0 a studiare un movimento funzionale e alla fine si prender\\u00e0 parte al W.O.D.\\n\\nCosa devo portare?\\n\\nSolo te stesso. E la tua voglia di allenarti e di migliorare.\\n\\nPosso arrivare prima e fare Stretching o Warm Up?\\n\\nDurante la classe c\\u2019\\u00e8 sempre una fase di Warm Up e una di Mobility \\u0026 Stretching, ma se vuoi venire prima per scaldarti, fare un po\\u2019 di tecnica da solo o semplicemente stare in compagnia sei liberissimo di farlo.\\n\\nConsigliate di allenarsi tutti i giorni?\\n\\nNo. Il CrossFit \\u00e8 un programma per stare bene ed in salute e il riposo fa parte del programma ed ha la stessa importanza del duro allenamento. Oltre a prevenire gli infortuni evita di farti andare in sovrallenamento. Impara ad ascoltare il tuo corpo e i segnali che ti da. Se ti senti stanco fai Rest. Sarai sorpreso dall\\u2019energia che avrai il giorno dopo. Ti sentirai pi\\u00f9 in forma che mai.\\n\\nPerch\\u00e9 CrossFit Frascati?\\n\\nLa nostra passione \\u00e8 il nostro lavoro. Il CrossFit \\u00e8 un programma che ti far\\u00e0 diventare migliore. E per diventare migliore affidarsi a persone che mettono passione in quello che fanno fa la differenza. Resterai stupito dai miglioramenti che vedrai su te stesso.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2583\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2583\\/featured_images\\/18446891_1016182385185010_3558780907474660986_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2583\\/featured_images\\/21192715_1085999928203255_531482905133799917_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2583\\/featured_images\\/21457366_1089215974548317_4891340900580338588_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2583\\/featured_images\\/35464033_1261030390700207_27206843998666752_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2583\\/featured_images\\/46521077_1400393410097237_3145855723737448448_n.jpg\"],\"address\":{\"street\":\"Vicolozzo di Spinetta, 5\",\"town\":\"Roma\",\"postal_code\":\"00044\",\"country\":\"Italia\"},\"location\":{\"latitude\":41.8147562,\"longitude\":12.6851752},\"contact_info\":{\"email\":\"info@crossfitfrascati.it\",\"phone\":\"+39  069426084\"},\"social_media\":{\"instagram\":\"crossfitfrascati\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitfrascati\\/\"}},{\"id_application\":\"74615901\",\"id_lead\":null,\"name\":\"CrossFit Heol\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/74615901\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/74615901\\/featured_images\\/451760205_7876140092467296_4829802779204971662_n.jpg\"],\"address\":{\"street\":\"11 ZA ti boutic\",\"town\":\"Plomeur\",\"postal_code\":\"29120\",\"country\":\"France\"},\"location\":{\"latitude\":47.847101,\"longitude\":-4.251963},\"contact_info\":{\"email\":\"crossfitpab@gmail.com\",\"phone\":\"06 67 39 65 68\"},\"social_media\":{\"instagram\":\"crossfit__heol\",\"facebook\":\"crossfit heol\"}},{\"id_application\":null,\"id_lead\":\"2834\",\"name\":\"Crossfit PobleNou\",\"description\":\"CrossFit PobleNou. Nuevo box oficial en Barcelona. 1000m2 de instalaciones. 470 m2 de zona exclusiva de entreno equipada con material de la marca ROGUE.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2834\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2834\\/featured_images\\/CrossPNou_01-1024x622.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2834\\/featured_images\\/CrossPNou_03.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2834\\/featured_images\\/CrossPNou_20-1090x600.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2834\\/featured_images\\/maxresdefault.jpg\"],\"address\":{\"street\":\"Carrer de Joan d\\u0027Austria, 95\",\"town\":\"Barcelona\",\"postal_code\":\"08018\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.3951733,\"longitude\":2.1863441},\"contact_info\":{\"email\":\"info@crossfitpoblenou.com\",\"phone\":\"931620640\"},\"social_media\":{\"instagram\":\"crossfitpoblenou_barcelona\",\"facebook\":\"@CrossFit-PobleNou-1601141436782847\"}},{\"id_application\":null,\"id_lead\":\"3226\",\"name\":\"Crossfit Dachau\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3226\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3226\\/featured_images\\/Bildschirmfoto%202019-07-16%20um%2011.11.47.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3226\\/featured_images\\/Bildschirmfoto%202019-07-16%20um%2011.12.01.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3226\\/featured_images\\/Bildschirmfoto%202019-07-16%20um%2011.12.11.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3226\\/featured_images\\/Bildschirmfoto%202019-07-16%20um%2011.12.17.png\"],\"address\":{\"street\":\"Fraunhoferstra\\u00dfe 7\",\"town\":\"Dachau\",\"postal_code\":\"85221\",\"country\":\"Germany\"},\"location\":{\"latitude\":48.2626042,\"longitude\":11.4725631},\"contact_info\":{\"email\":\"info@crossfit-dachau.com\",\"phone\":\"\"},\"social_media\":{\"instagram\":\"crossfit_dachau\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitDachau\\/\"}},{\"id_application\":null,\"id_lead\":\"3066\",\"name\":\"Crossfit Albatross\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3066\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3066\\/featured_images\\/Bildschirmfoto%202019-06-07%20um%2012.06.58.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3066\\/featured_images\\/Bildschirmfoto%202019-06-07%20um%2012.07.05.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3066\\/featured_images\\/Bildschirmfoto%202019-06-07%20um%2012.07.10.png\"],\"address\":{\"street\":\"Auerbachstra\\u00dfe 8\",\"town\":\"Regensburg\",\"postal_code\":\"93057\",\"country\":\"Germany\"},\"location\":{\"latitude\":49.0647905,\"longitude\":12.1329761},\"contact_info\":{\"email\":\"info@crossfitalbatross.de\",\"phone\":\"+49 17620136615\"},\"social_media\":{\"instagram\":\"crossfit_albatross\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitAlbatross\\/\"}},{\"id_application\":\"57650288\",\"id_lead\":null,\"name\":\"CrossFit Korrigan\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/57650288\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/57650288\\/featured_images\\/37340850_233767163930345_4167806199267328_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/57650288\\/featured_images\\/37349449_233767093930352_733830514397413376_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/57650288\\/fea