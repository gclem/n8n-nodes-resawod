e% \\u00e0 %time%.\",\"error_no_title\":\"Erreur, pas de titre\",\"error_no_message\":\"Erreur, pas de message\",\"yes\":\"Oui\",\"no\":\"Non\",\"confirmation_required\":\"Confirmation demand\\u00e9e\",\"delete_file\":\"Etes-vous s\\u00fbr de vouloir supprimer ce fichier ?\",\"delete_post\":\"Etes-vous s\\u00fbr de vouloir supprimer ce post ?\",\"delete_page\":\"Etes-vous s\\u00fbr de vouloir supprimer cette page ?\",\"delete_comment\":\"Etes-vous s\\u00fbr de vouloir supprimer ce commentaire ?\",\"delete_category\":\"Voulez-vous vraiment supprimer cette cat\\u00e9gorie?\",\"featured\":\"s\\u00e9lectionn\\u00e9\",\"title_help\":\"Mettez ici le titre de votre post\",\"title_help_page\":\"Renseignez le titre de votre page\",\"draft\":\"Brouillon\",\"publish\":\"Publi\\u00e9\",\"featured_image\":\"Image\",\"this_post_is_private\":\"cette publication est priv\\u00e9e\",\"this_post_is_public\":\"cette publication est priv\\u00e9e\",\"this_category_is_private\":\"Cette cat\\u00e9gorie est priv\\u00e9e\",\"this_category_is_public\":\"Cette publication est publique\",\"private\":\"Priv\\u00e9\",\"public\":\"Publique\",\"private_category\":\"Cat\\u00e9gorie priv\\u00e9e?\",\"warning\":{\"empty_title\":\"Vous devez donner un titre au message\"},\"cant_notify\":\"Les notifications de nouvelles \\u00e0 l\\u0027\\u00e9tat de brouillon ne peuvent pas \\u00eatre notifi\\u00e9es.\",\"error\":{\"fetch_post\":\"Erreur de r\\u00e9cup\\u00e9ration des posts\",\"create_post\":\"Erreur lors de la cr\\u00e9ation d\\u0027un post\",\"edit_post\":\"Erreur dans l\\u0027\\u00e9dition du post\",\"delete_post\":\"Erreur de suppression du post\",\"notify_post\":\"Erreur de notification du post\"}},\"mgym\":{\"exercise_name\":\"Nom\",\"exercise_description_comments\":\"Description \\/ Commentaires\",\"exercise_group\":\"Groupe\",\"image\":\"Image\",\"exercise\":\"Exercice\",\"chest\":\"Poitrine\",\"back\":\"Dos\",\"other\":\"Autre\",\"legs\":\"Jambes\",\"shoulders\":\"Epaules\",\"cardio\":\"Cardio\",\"method\":\"M\\u00e9thode\",\"forearms\":\"Avant-Bras\",\"biceps\":\"Biceps\",\"triceps\":\"Triceps\",\"abdom\":\"Abdomen\",\"no_exercises\":\"Aucun exercice disponible\",\"no_file_selected\":\"Aucun fichier s\\u00e9lectionn\\u00e9\",\"choose_file\":\"Choisir un fichier\",\"upload_logo\":\"T\\u00e9l\\u00e9charger votre image\",\"current_logo\":\"Image courante\",\"Genroutine\":\"Programmes g\\u00e9n\\u00e9riques\",\"routines\":\"Programmes\",\"routine\":\"Programme\",\"no_routines\":\"Aucun programme disponible\",\"no_outstanding_routines\":\"Aucun programme disponible en attente\",\"title\":\"Titre\",\"number_of_days\":\"Nombre de jours du programme\",\"generic\":\"G\\u00e9n\\u00e9rique\",\"non_generic\":\"Non g\\u00e9n\\u00e9rique\",\"order\":\"Ordre\",\"series\":\"S\\u00e9ries\",\"rep\":\"R\\u00e9p\\u00e9titions\",\"delete\":\"Supprimer\",\"no_lines\":\"Aucune ligne disponible\",\"exercises\":\"Exercices\",\"exercises_order_des\":\"Exercices : ordre invers\\u00e9 (du plus r\\u00e9cent au plus ancien)\",\"insert\":\"Ins\\u00e9rer\",\"all\":\"Tout\",\"newLine\":\"Nouvelle ligne\",\"updLine\":\"Mettre \\u00e0 jour une ligne\",\"update\":\"Mettre \\u00e0 jour\",\"asign\":\"Assigner\",\"user\":\"Utilisateur\",\"routine-outstanding\":\"Programmes en cours\",\"future_routine_description\":\"Demandes \\/ Description du programme\",\"appointments\":\"Rendez-vous\",\"history\":\"Historique\",\"view\":\"Vue\",\"date\":\"Date\",\"no_user_routine\":\"Aucun programme encore assign\\u00e9\",\"day1\":\"Jour 1\",\"day2\":\"Jour 2\",\"day3\":\"Jour 3\",\"day4\":\"Jour 4\",\"day5\":\"Jour 5\",\"day6\":\"Jour 6\",\"day7\":\"Jour 7\",\"loading_content\":\"Chargement des donn\\u00e9es\",\"day1exercises\":\"Jour 1 : Exercices\",\"day2exercises\":\"Jour 2 : Exercices\",\"day3exercises\":\"Jour 3 : Exercices\",\"day4exercises\":\"Jour 4 : Exercices\",\"day5exercises\":\"Jour 5 : Exercices\",\"day6exercises\":\"Jour 6 : Exercices\",\"day7exercises\":\"Jour 7 : Exercices\",\"time\":\"Temps\",\"rest\":\"Reste\",\"Training-methods\":\"M\\u00e9thode d\\u0027entra\\u00eenement\",\"methodselect\":\"S\\u00e9lectionner un programme d\\u0027entra\\u00eenement\",\"select\":\"S\\u00e9lectionner un exercice\",\"info\":\"Info\",\"exercise_video\":\"Vid\\u00e9o de l\\u0027exercice\",\"view_video\":\"Voir la vid\\u00e9o\",\"no_video\":\"D\\u00e9sol\\u00e9, il n\\u0027y a pas de vid\\u00e9o pour cette exercice.\",\"exercise_video_html\":\"Ins\\u00e9rer le code HTML pour int\\u00e9grer la vid\\u00e9o ici\",\"error_1\":\"Ce programme n\\u0027existe pas\",\"1\":\"Lev\\u00e9es de jambe verticales alternative\",\"2\":\"Lev\\u00e9es de jambe verticales\",\"3\":\"Lev\\u00e9es de jambe horizontales\",\"4\":\"Sit-ups banc inclin\\u00e9\",\"5\":\"Sit-ups\",\"6\":\"Mollets sur des relev\\u00e9s de banc\",\"7\":\"\\u00c9l\\u00e9vation des jambes sur banc\",\"8\":\"\\u00c9l\\u00e9vation des jambes inclin\\u00e9es sur le banc\",\"9\":\"\\u00c9l\\u00e9vations des jambes inclin\\u00e9es\",\"10\":\"Crunches\",\"11\":\"\\u00c9chelle des abdominaux en salle de sport\",\"12\":\"Bonjour\",\"13\":\"Flexions lat\\u00e9rales avec une barre\",\"14\":\"Flexions lat\\u00e9rales avec halt\\u00e8res\",\"15\":\"Broomstick twists\",\"16\":\"Chin ups - Traction de menton\",\"17\":\"Chin-ups assist\\u00e9es\",\"18\":\"Barbell shrugs (fr: \\u00c9l\\u00e9vations de barre)\",\"19\":\"Haussements d\\u0027\\u00e9paules avec halt\\u00e8res\",\"20\":\"R\\u00e9tr\\u00e9cissements de machine\",\"21\":\"Extensions dorsales\",\"22\":\"Traction lat\\u00e9rale\",\"23\":\"Les tractions dorsales \\u00e0 la machine\",\"24\":\"Soulevez d\\u0027une main droite la barre au sol.\",\"25\":\"Tirages de lat\\u00e9raux \\u00e0 bras tendus\",\"26\":\"Les rang\\u00e9es verticales\",\"27\":\"Rang\\u00e9es d\\u0027halt\\u00e8res \\u00e0 un bras\",\"28\":\"Rang\\u00e9es courb\\u00e9es\",\"29\":\"Rang\\u00e9es assises\",\"30\":\"Les boucles\",\"31\":\"Barbell curls (curls avec une barre)\",\"32\":\"Boucles de concentration\",\"33\":\"Curl biceps \\u00e0 la poulie basse\",\"34\":\"Curl pr\\u00e9dicateur avec halt\\u00e8res\",\"35\":\"Curl de marteau\",\"36\":\"Curl pr\\u00e9dicateur avec une barre\",\"37\":\"Tractions \\u00e0 concentration\",\"38\":\"Mouvements d\\u0027halt\\u00e8res\",\"39\":\"Vol d\\u0027oiseau avec appareil pectoral\",\"40\":\"C\\u00e2bles crois\\u00e9s pour les mouvements d\\u0027\\u00e9largissement de la poitrine.\",\"41\":\"Pompes sur banc\",\"42\":\"Barres parall\\u00e8les pour les dips\",\"43\":\"Pompes\",\"44\":\"Pressoir \\u00e0 banc\",\"45\":\"Presses avec halt\\u00e8res\",\"46\":\"Refusez les presses.\",\"47\":\"Refusez les presses avec halt\\u00e8res\",\"48\":\"Presses inclin\\u00e9es.\",\"49\":\"Presses avec halt\\u00e8res inclin\\u00e9s\",\"50\":\"Barbell pullovers - Pullovers \\u00e0 la barre\",\"51\":\"\\u00c9cart\\u00e9 avec halt\\u00e8res.\",\"52\":\"Barbell reverse wrist curls (Curl inverso de mu\\u00f1eca con barra)\",\"53\":\"Curl de poignet invers\\u00e9 avec halt\\u00e8re\",\"54\":\"Flexions des poignets avec une barre\",\"55\":\"Curl de poignet avec halt\\u00e8res.\",\"56\":\"Adductions \\u00e0 la machine\",\"57\":\"C\\u00e2ble adductions\",\"60\":\"Lying leg curls - Extensions de jambes allong\\u00e9\",\"61\":\"\\u00c9l\\u00e9vations des mollets debout\",\"62\":\"Extensions des jambes\",\"63\":\"Squats avec halt\\u00e8res\",\"64\":\"Bonjour matins\",\"65\":\"Presses \\u00e9lectriques\",\"66\":\"Presse \\u00e0 jambes inclin\\u00e9es\",\"67\":\"Squats\",\"68\":\"Front squats\",\"69\":\"Hack squats\",\"70\":\"Squats en multipower\",\"71\":\"Power Squats\",\"72\":\"Fentes avec halt\\u00e8res\",\"73\":\"\\u00c9l\\u00e9vation avant avec halt\\u00e8res\",\"74\":\"\\u00c9l\\u00e9vations avant avec une barre\",\"75\":\"\\u00c9l\\u00e9vations lat\\u00e9rales \\u00e0 la poulie basse\",\"76\":\"\\u00c9l\\u00e9vations lat\\u00e9rales avec halt\\u00e8res\",\"77\":\"Relev\\u00e9es lat\\u00e9rales pench\\u00e9es.\",\"78\":\"\\u00c9l\\u00e9vation lat\\u00e9rale en position allong\\u00e9e sur le c\\u00f4t\\u00e9\",\"79\":\"Les presses assises devant\",\"80\":\"Presses avec halt\\u00e8res assis\",\"81\":\"Triceps dips = Dips pour les triceps\",\"82\":\"Rang\\u00e9es droites\",\"83\":\"Extension de triceps avec une barre\",\"84\":\"Un bras inverse push downs\",\"85\":\"Extensiones de tr\\u00edceps con mancuernas sentado\",\"86\":\"Descendre\",\"87\":\"Exercices de traction arri\\u00e8re\",\"88\":\"Extensions de triceps avec halt\\u00e8re \\u00e0 un bras\",\"89\":\"Les Dips\",\"90\":\"Extensions de triceps\",\"91\":\"Machine \\u00e0 ski\",\"92\":\"Machine de cyclisme 1\",\"93\":\"Machine cyclisme 2\",\"94\":\"Machine \\u00e0 ramer\",\"95\":\"Tapis de course\",\"96\":\"Skipping\",\"97\":\"----------- SUPERS\\u00c9RIES -----------\",\"98\":\"-------------- TRIS\\u00c9RIES --------------\",\"99\":\"QUADRI-S\\u00c9RIES\",\"100\":\"-------------- NORMAL --------------\"},\"gym\":{\"print\":\"Imprimer\",\"print_no_img\":\"Imprimer sans les images\"},\"mgymd\":{\"1\":\"Soutenez le corps en reposant les coudes sur les coussinets. Positionnez le dos contre le support dorsal. Inspirez et levez alternativement les genoux vers la poitrine, arrondissant le dos afin de contracter la sangle abdominale. Expirez \\u00e0 la fin du mouvement.\",\"2\":\"Soutenez le corps en reposant les coudes sur les coussinets. Positionnez le dos contre le support dorsal. Inspirez et levez les genoux vers la poitrine, arrondissant le dos afin de contracter la sangle abdominale. Expirez \\u00e0 la fin du mouvement.\",\"3\":\"Allongez-vous sur un banc. Inspirez et levez les jambes \\u00e0 l\\u0027horizontale.\",\"4\":\"Positionnez les pieds sous les tampons, le torse suspendu dans les airs, les mains pr\\u00e8s des oreilles. Inspirez et soulevez le torse, en essayant d\\u0027amener la t\\u00eate vers les genoux tout en arrondissant la colonne vert\\u00e9brale. Expirez \\u00e0 la fin de la contraction.\",\"5\":\"Allongez-vous sur le dos, avec les genoux pli\\u00e9s, les pieds \\u00e0 plat sur le sol et les mains derri\\u00e8re la t\\u00eate. Inspirez et soulevez le torse en arrondissant le dos. Expirez \\u00e0 la fin du mouvement. Revenez \\u00e0 la position initiale sans toucher le sol. Continuez jusqu\\u0027\\u00e0 ressentir une sensation de br\\u00fblure dans les muscles abdominaux.\",\"6\":\"Allongez-vous sur le dos avec vos mollets pos\\u00e9s sur un banc d\\u0027exercice plat. Placez vos mains derri\\u00e8re votre t\\u00eate. Inspirez et soulevez vos \\u00e9paules du sol. Essayez de toucher vos genoux avec votre t\\u00eate. Expirez lorsque vous effectuez le mouvement.\",\"7\":\"Allongez-vous sur un banc. Inspirez et levez les jambes \\u00e0 l\\u0027horizontal, puis soulevez le bassin, enroulant la colonne vert\\u00e9brale vers le haut comme si vous essayiez de rapprocher les genoux de la t\\u00eate.\",\"8\":\"Asseyez-vous sur un banc. Avec votre torse inclin\\u00e9, inspirez et levez les jambes \\u00e0 l\\u0027horizontale.\",\"9\":\"Allongez-vous sur un banc inclin\\u00e9 et agrippez les barres ou les poign\\u00e9es. Inspirez et levez les jambes \\u00e0 l\\u0027horizontale, puis soulevez le bassin en roulant la colonne vert\\u00e9brale vers le haut comme si vous essayiez d\\u0027amener les genoux vers la t\\u00eate.\",\"10\":\"Allongez-vous sur le dos, les mains derri\\u00e8re la t\\u00eate, les cuisses \\u00e0 la verticale et les genoux pli\\u00e9s. Inspirez et soulevez les \\u00e9paules du sol, rapprochant les genoux et la t\\u00eate l\\u0027un vers l\\u0027autre en effectuant un mouvement de flexion, ce qui signifie arrondir le dos et rouler la colonne vert\\u00e9brale vers le haut. Expirez \\u00e0 la fin du mouvement.\",\"11\":\"Allongez-vous sur le sol, face vers le haut, et placez les pieds entre deux barres de l\\u0027\\u00e9chelle, avec les cuisses \\u00e0 la verticale et les mains derri\\u00e8re la t\\u00eate. Inspirez et soulevez le torse aussi haut que possible, en arrondissant la colonne vert\\u00e9brale. Expirez \\u00e0 la fin du mouvement.\",\"12\":\"Tenez-vous debout avec les pieds l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9s et la barre reposant sur les trap\\u00e8zes ou un peu plus bas sur le delto\\u00efde post\\u00e9rieur. Inspirez et pliez le torse vers l\\u0027avant, en gardant le dos droit. Revenez \\u00e0 la position initiale et expirez. Pour rendre l\\u0027exercice plus facile, pliez l\\u00e9g\\u00e8rement les genoux.\",\"13\":\"Tenez-vous debout avec les jambes l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9es, en tenant une barre d\\u0027halt\\u00e8res sur les trap\\u00e8zes au-dessus du delto\\u00efde post\\u00e9rieur. Pliez le torse d\\u0027un c\\u00f4t\\u00e9. Revenez \\u00e0 la position initiale ou au-del\\u00e0 avec une flexion passive du torse et tournez de l\\u0027autre c\\u00f4t\\u00e9.\",\"14\":\"Restez debout avec les jambes l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9es, une main derri\\u00e8re la t\\u00eate et tenant un halt\\u00e8re dans l\\u0027autre main. Pliez le torse sur le c\\u00f4t\\u00e9 oppos\\u00e9 \\u00e0 l\\u0027halt\\u00e8re. Revenez \\u00e0 la position initiale ou au-del\\u00e0 avec une flexion passive du torse. Alternez les s\\u00e9ries en changeant de c\\u00f4t\\u00e9 avec l\\u0027halt\\u00e8re sans vous reposer.\",\"15\":\"Tenez-vous debout avec les jambes \\u00e9cart\\u00e9es, tenant un b\\u00e2ton\\/une barre au-dessus du delto\\u00efde post\\u00e9rieur, les mains reposant sur le b\\u00e2ton sans pousser. Tournez le torse d\\u0027un c\\u00f4t\\u00e9 \\u00e0 l\\u0027autre en gardant le bassin fixe gr\\u00e2ce \\u00e0 une contraction isom\\u00e9trique des muscles fessiers.\",\"16\":\"Accrochez-vous \\u00e0 une barre fixe avec une prise tr\\u00e8s large en pronation. Inspirez et tirez la poitrine jusqu\\u0027au niveau de la barre. Expirez \\u00e0 la fin du mouvement.\",\"17\":\"Accrochez-vous \\u00e0 la machine avec une prise tr\\u00e8s large en supination. Inspirez et tirez la poitrine jusqu\\u0027au niveau de la barre. Expirez \\u00e0 la fin du mouvement.\",\"18\":\"Mettez-vous debout avec les jambes l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9es et faites face \\u00e0 la barre qui est soit au sol, soit sur un support. Saisissez la barre avec une prise en pronation, les mains l\\u00e9g\\u00e8rement plus larges que la largeur des \\u00e9paules, ou utilisez une prise en supination si le poids est lourd. Haussez les \\u00e9paules en gardant les bras d\\u00e9tendus, le dos droit et les muscles abdominaux contract\\u00e9s.\",\"19\":\"Tenez-vous debout avec les jambes l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9es, la t\\u00eate droite ou l\\u00e9g\\u00e8rement inclin\\u00e9e vers l\\u0027avant, et les bras d\\u00e9tendus le long du corps en tenant un halt\\u00e8re dans chaque main. Haussez les \\u00e9paules avec une rotation ant\\u00e9rieure \\u00e0 post\\u00e9rieure. Revenez \\u00e0 la position initiale.\",\"20\":\"Tenez-vous face \\u00e0 la machine et tenez les poign\\u00e9es avec une prise sup\\u00e9rieure l\\u00e9g\\u00e8rement plus large que les \\u00e9paules, ou si la machine le permet, avec les paumes tourn\\u00e9es l\\u0027une vers l\\u0027autre. Levez les \\u00e9paules, en gardant la t\\u00eate et le dos droits.\",\"21\":\"Allongez-vous face contre terre sur une chaise romaine et placez les chevilles sous les patins du rouleau. \\u00c9tant donn\\u00e9 que l\\u0027axe de flexion passe par les articulations coxof\\u00e9morales, l\\u0027os pubien ne doit pas reposer sur le coussin de soutien. Avec le torse pench\\u00e9 en avant, \\u00e9tendez le dos jusqu\\u0027\\u00e0 l\\u0027horizontale. Levez la t\\u00eate et poursuivez en hyperextension en cambrant la colonne lombaire. Cela doit \\u00eatre fait avec pr\\u00e9caution pour prot\\u00e9ger votre bas du dos.\",\"22\":\"Asseyez-vous face \\u00e0 la machine avec les jambes positionn\\u00e9es sous les coussinets, en tenant la barre avec une prise large par-dessus. Inspirez et tirez la barre vers l\\u0027encoche sternale tout en gonflant la poitrine et en ramenant les coudes en arri\\u00e8re. Expirez \\u00e0 la fin du mouvement.\",\"23\":\"Asseyez-vous face \\u00e0 la machine avec les cuisses positionn\\u00e9es sous les coussinets, en tenant la barre avec une prise large en pronation. Inspirez et tirez la barre vers l\\u0027arri\\u00e8re du cou, en ramenant les coudes le long du corps. Expirez \\u00e0 la fin du mouvement.\",\"24\":\"Faites face \\u00e0 la barre, les jambes l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9es avec les muscles abdominaux contract\\u00e9s et le dos l\\u00e9g\\u00e8rement cambr\\u00e9. Pliez les genoux jusqu\\u0027\\u00e0 ce que les cuisses soient parall\\u00e8les au sol (Les cuisses seront parall\\u00e8les pour quelqu\\u0027un ayant des f\\u00e9murs et des bras courts. Les cuisses seront plus hautes que parall\\u00e8les pour quelqu\\u0027un ayant des f\\u00e9murs et des bras longs). Agrippez la barre avec les bras tendus en prise sup\\u00e9rieure, un peu plus large que la largeur des \\u00e9paules (inverser la prise d\\u0027une main \\u00e9vite \\u00e0 la barre de rouler, ce qui vous permet d\\u0027utiliser des poids beaucoup plus lourds). Inspirez, retenez votre respiration et contractez les muscles abdominaux et le bas du dos pour soulever la barre en redressant les jambes et en permettant \\u00e0 la barre de glisser le long des tibias. Lorsque la barre atteint les genoux, redressez le torse tout en redressant les jambes. Expirez \\u00e0 la fin de l\\u0027effort. Pendant tout l\\u0027exercice, ne redressez jamais le dos.\",\"25\":\"Restez debout et faites face \\u00e0 la machine avec les pieds l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9s. Saisissez la barre avec une prise sup\\u00e9rieure, les bras tendus et \\u00e0 la largeur des \\u00e9paules. Maintenez le dos droit et contractez les muscles abdominaux. Inspirez et amenez la barre jusqu\\u0027aux cuisses en gardant les bras tendus (les coudes peuvent \\u00eatre l\\u00e9g\\u00e8rement pli\\u00e9s). Expirez \\u00e0 la fin du mouvement.\",\"26\":\"Tenez-vous debout avec les jambes l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9es, en gardant le dos droit et en saisissant la barre avec une prise en pronation. La prise devrait \\u00eatre de la largeur d\\u0027une main ou l\\u00e9g\\u00e8rement plus large. Inspirez et tirez la barre le long de l\\u0027avant du corps jusqu\\u0027au menton, en levant les coudes aussi haut que possible. Expirez et baissez la barre avec un mouvement contr\\u00f4l\\u00e9.\",\"27\":\"Saisissez une barre avec la paume tourn\\u00e9e vers l\\u0027int\\u00e9rieur. Utilisez l\\u0027autre main et le genou sur le banc pour soutenir le dos. Inspirez et soulevez le bras sup\\u00e9rieur et le coude aussi haut que possible pr\\u00e8s du corps, avec le coude pli\\u00e9. Expirez \\u00e0 la fin du mouvement.\",\"28\":\"Tenez-vous debout avec les jambes l\\u00e9g\\u00e8rement fl\\u00e9chies, en tenant la barre avec une prise invers\\u00e9e et les mains plus \\u00e9cart\\u00e9es que la largeur des \\u00e9paules. Le dos droit, penchez-vous en avant au niveau de la taille \\u00e0 45 degr\\u00e9s, de sorte que la barre se trouve au niveau des genoux. Inspirez et retenez votre souffle pendant une contraction isom\\u00e9trique des muscles abdominaux, et tirez la barre jusqu\\u0027\\u00e0 la poitrine. Revenez \\u00e0 la position initiale et expirez.\",\"29\":\"Asseyez-vous face \\u00e0 la machine, les pieds pos\\u00e9s sur le repose-pied et le torse pench\\u00e9 en avant. Inspirez et amenez la poign\\u00e9e \\u00e0 la base du sternum en redressant le dos et en tirant les coudes vers l\\u0027arri\\u00e8re autant que possible. Expirez \\u00e0 la fin du mouvement et revenez en douceur \\u00e0 la position initiale.\",\"30\":\"Tenez-vous assis, tenant un halt\\u00e8re dans chaque main, les bras le long du corps et les paumes des mains tourn\\u00e9es vers le corps. Inspirez et pliez le coude, en tournant la paume vers le haut avant que l\\u0027avant-bras n\\u0027atteigne l\\u0027horizontale. Poursuivez en soulevant les coudes \\u00e0 la fin du mouvement.\",\"31\":\"Tenez-vous debout avec le dos droit, en tenant la barre avec une prise invers\\u00e9e et les mains l\\u00e9g\\u00e8rement plus larges que la largeur des \\u00e9paules. Inspirez et soulevez la barre en pliant les coudes, en veillant \\u00e0 stabiliser le torse et la colonne vert\\u00e9brale en contractant isom\\u00e9triquement les muscles fessiers, abdominaux et spinaux. Expirez \\u00e0 la fin du mouvement.\",\"32\":\"Assis(e) en tenant un halt\\u00e8re avec la paume tourn\\u00e9e vers l\\u0027avant et le coude positionn\\u00e9 contre la cuisse interne. Inspirez et soulevez l\\u0027avant-bras en pliant le coude. Expirez \\u00e0 la fin de l\\u0027effort.\",\"33\":\"Faites face \\u00e0 la machine, en saisissant les poign\\u00e9es avec une prise en dessous (les pouces tourn\\u00e9s l\\u0027un vers l\\u0027autre). Inspirez et pliez les coudes pour soulever les avant-bras. Expirez \\u00e0 la fin du mouvement.\",\"34\":\"Asseyez-vous sur la machine et saisissez les halt\\u00e8res avec une prise par en dessous. Inspirez et levez les avant-bras en pliant les coudes. Expirez \\u00e0 la fin de l\\u0027effort.\",\"35\":\"Tenez-vous debout ou asseyez-vous en tenant un halt\\u00e8re dans chaque main, les paumes tourn\\u00e9es l\\u0027une vers l\\u0027autre. Inspirez et soulevez les avant-bras ensemble ou alternativement. Expirez \\u00e0 la fin du mouvement.\",\"36\":\"Tenez-vous debout avec les bras reposant sur le coussin de support et saisissez la barre avec une prise en dessous. Inspirez et soulevez les avant-bras en pliant les coudes. Expirez \\u00e0 la fin de l\\u0027effort.\",\"37\":\"Accrochez-vous \\u00e0 une barre avec une prise en supination, les mains se touchant ou l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9es. Inspirez et poussez votre poitrine vers l\\u0027ext\\u00e9rieur tout en relevant le menton vers la barre. Expirez \\u00e0 la fin du mouvement.\",\"38\":\"Allongez-vous sur un banc \\u00e9troit qui n\\u0027interf\\u00e8re pas avec le mouvement des \\u00e9paules et tenez un halt\\u00e8re dans chaque main, les bras \\u00e9tendus ou l\\u00e9g\\u00e8rement pli\\u00e9s pour soulager la pression sur l\\u0027articulation. Inspirez et ouvrez les bras \\u00e0 l\\u0027horizontale. Levez les bras \\u00e0 la verticale tout en expirant. Effectuez une petite contraction isom\\u00e9trique \\u00e0 la fin du mouvement pour mettre l\\u0027accent sur le travail de la t\\u00eate sternale du grand pectoral.\",\"39\":\"Asseyez-vous sur la machine avec les bras ouverts et horizontaux, pli\\u00e9s au niveau des coudes. Reposez les avant-bras sur les coussinets, en les laissant d\\u00e9tendus. Inspirez et serrez les bras ensemble. Expirez \\u00e0 la fin du mouvement.\",\"40\":\"Tenez-vous debout avec les jambes l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9es et penchez le haut du corps l\\u00e9g\\u00e8rement en avant, les bras \\u00e9cart\\u00e9s et les coudes l\\u00e9g\\u00e8rement fl\\u00e9chis. Inspirez et serrez les bras ensemble jusqu\\u0027\\u00e0 ce que les poignets se touchent. Expirez \\u00e0 la fin de la contraction.\",\"41\":\"Soutenez-vous face contre terre, avec les bras tendus, les mains \\u00e9cart\\u00e9es de la largeur des \\u00e9paules (ou plus) et une dans chaque banc, les pieds touchant ou l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9s reposant sur la barre murale. Inspirez et pliez les coudes pour rapprocher la cage thoracique du sol sans cambrer excessivement le bas du dos. Poussez pour revenir \\u00e0 une extension compl\\u00e8te des bras. Expirez \\u00e0 la fin du mouvement.\",\"42\":\"Accrochez-vous aux barres parall\\u00e8les avec les bras tendus et les jambes suspendues. Inspirez et pliez les coudes pour amener la poitrine au niveau des barres. Revenez \\u00e0 la position des bras tendus. Expirez \\u00e0 la fin de l\\u0027effort.\",\"43\":\"Soutenez-vous sur le sol, face contre terre, avec les bras tendus, les mains \\u00e0 la largeur des \\u00e9paules (ou plus), et les pieds coll\\u00e9s ou l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9s. Inspirez et pliez les coudes pour rapprocher la cage thoracique du sol sans cambrer excessivement le bas du dos. Poussez-vous vers le haut jusqu\\u0027\\u00e0 l\\u0027extension compl\\u00e8te des bras. Expirez \\u00e0 la fin du mouvement.\",\"44\":\"Allongez-vous sur un banc horizontal, les fesses sur le banc et les pieds \\u00e0 plat sur le sol. Saisissez la barre avec une prise en pronation plus large que la largeur des \\u00e9paules. Inspirez et descendez la barre jusqu\\u0027\\u00e0 la poitrine avec un mouvement contr\\u00f4l\\u00e9. \\u00c9tendez les bras et expirez \\u00e0 la fin de l\\u0027effort. Si vous avez des probl\\u00e8mes de dos ou souhaitez isoler les muscles pectoraux, effectuez l\\u0027extension avec les jambes lev\\u00e9es. Cet exercice peut \\u00e9galement \\u00eatre r\\u00e9alis\\u00e9 dans un cadre qui guide la barre. En ex\\u00e9cutant l\\u0027extension avec les coudes pr\\u00e8s du corps, le travail se concentre sur le muscle delto\\u00efde ant\\u00e9rieur. Varier la largeur des mains isole diff\\u00e9rentes parties du muscle (mains rapproch\\u00e9es pour la partie centrale des pectoraux et mains \\u00e9cart\\u00e9es pour isoler les parties lat\\u00e9rales des pectoraux).\",\"45\":\"Allongez-vous sur un banc horizontal, les pieds \\u00e0 plat sur le sol pour plus de stabilit\\u00e9, avec les coudes pli\\u00e9s et en tenant des halt\\u00e8res avec une prise en supination au niveau de la poitrine. Inspirez et \\u00e9tendez les bras verticalement tout en faisant pivoter les avant-bras de sorte que les paumes se font face. Une fois que les mains se font face, effectuez une contraction isom\\u00e9trique pour concentrer l\\u0027effort sur la partie sternale du grand pectoral. Expirez \\u00e0 la fin du mouvement.\",\"46\":\"Allongez-vous sur un banc inclin\\u00e9 (entre 20 et 40 degr\\u00e9s), avec la t\\u00eate en bas et les pieds fix\\u00e9s pour \\u00e9viter de glisser, et saisissez la barre avec une prise largeur d\\u0027\\u00e9paules ou plus en pronation. Inspirez et descendez la barre jusqu\\u0027aux pectoraux inf\\u00e9rieurs avec un mouvement contr\\u00f4l\\u00e9. \\u00c9tendez les bras et expirez \\u00e0 la fin du mouvement.\",\"47\":\"Allongez-vous sur un banc inclin\\u00e9 (entre 20 et 40 degr\\u00e9s), avec la t\\u00eate inclin\\u00e9e vers le bas, les pieds \\u00e0 plat sur le sol pour la stabilit\\u00e9 et les coudes pli\\u00e9s, tenant des halt\\u00e8res avec une prise en pronation au niveau de la poitrine. Inspirez et abaissez les halt\\u00e8res jusqu\\u0027aux pectoraux inf\\u00e9rieurs avec un mouvement contr\\u00f4l\\u00e9. \\u00c9tendez les bras et expirez \\u00e0 la fin du mouvement.\",\"48\":\"Asseyez-vous sur un banc inclin\\u00e9 inclin\\u00e9 \\u00e0 45 \\u00e0 60 degr\\u00e9s, saisissez la barre avec une prise sup\\u00e9rieure \\u00e0 la largeur des \\u00e9paules. Inspirez et abaissez la barre jusqu\\u0027\\u00e0 l\\u0027encoche sternale. \\u00c9tendez les bras. Expirez \\u00e0 la fin du mouvement.\",\"49\":\"Asseyez-vous sur un banc avec un angle de pas plus de 60 degr\\u00e9s (pour \\u00e9viter un travail excessif des delto\\u00efdes), les coudes pli\\u00e9s et en tenant les halt\\u00e8res avec une prise invers\\u00e9e. Inspirez et tendez les bras verticalement, en rapprochant les halt\\u00e8res l\\u0027un de l\\u0027autre. Expirez \\u00e0 la fin du mouvement.\",\"50\":\"Avec les bras tendus, tenez la barre avec une prise en pronation et les mains \\u00e9cart\\u00e9es de la largeur des \\u00e9paules. Inspirez et gonflez la poitrine autant que possible, en abaissant la barre derri\\u00e8re la t\\u00eate en pliant l\\u00e9g\\u00e8rement les coudes. Expirez en revenant \\u00e0 la position initiale.\",\"51\":\"Allongez-vous sur un banc avec les pieds \\u00e0 plat sur le sol et tenez un halt\\u00e8re dans les paumes des deux mains, les pouces entourant la poign\\u00e9e et les bras tendus. Inspirez et abaissez l\\u0027halt\\u00e8re derri\\u00e8re la t\\u00eate, en pliant l\\u00e9g\\u00e8rement les coudes. Expirez et revenez \\u00e0 la position initiale.\",\"52\":\"Asseyez-vous avec les avant-bras reposant sur les cuisses ou sur un banc et saisissez la barre avec une prise sup\\u00e9rieure et gardez les poignets d\\u00e9tendus. Levez les mains en les \\u00e9tendant au niveau des poignets.\",\"53\":\"Asseyez-vous avec les avant-bras pos\\u00e9s sur les cuisses ou sur un banc et saisissez l\\u0027halt\\u00e8re avec une prise par-dessus et gardez les poignets d\\u00e9tendus. Levez la main en vous \\u00e9tendant aux poignets. R\\u00e9p\\u00e9tez le mouvement pour l\\u0027autre main.\",\"54\":\"Asseyez-vous avec les avant-bras reposant sur les cuisses ou sur un banc et saisissez la barre avec une prise invers\\u00e9e, en gardant les poignets d\\u00e9tendus. Inspirez et levez les mains en fl\\u00e9chissant les poignets.\",\"55\":\"Asseyez-vous avec les avant-bras reposant sur les cuisses ou sur un banc et saisissez l\\u0027halt\\u00e8re avec une prise invers\\u00e9e, les poignets d\\u00e9tendus. Inspirez et levez la main en fl\\u00e9chissant les poignets. R\\u00e9p\\u00e9tez le mouvement pour l\\u0027autre main.\",\"56\":\"Asseyez-vous sur la machine avec les jambes \\u00e9cart\\u00e9es. Contractez les cuisses pour rapprocher les jambes. Revenez \\u00e0 la position initiale avec un mouvement contr\\u00f4l\\u00e9.\",\"57\":\"Tenez-vous sur une jambe, avec l\\u0027autre jambe dans le bracelet de cheville et la main de la jambe de soutien tenant la machine. Tirez le c\\u00e2ble \\u00e0 travers la jambe de soutien.\",\"60\":\"Allongez-vous face contre terre sur la machine, en tenant les poign\\u00e9es, les jambes tendues et les chevilles positionn\\u00e9es sous les coussinets des chevilles. Inspirez et pliez les deux jambes en m\\u00eame temps, en essayant de toucher les muscles fessiers avec les talons. Exhalez \\u00e0 la fin de l\\u0027effort. Retournez \\u00e0 la position initiale avec un mouvement contr\\u00f4l\\u00e9.\",\"61\":\"Tenez-vous debout devant la machine, le dos droit, les \\u00e9paules sous les coussinets, et les balles des pieds sur la plaque, avec les mollets d\\u00e9tendus et les talons qui pendent. Levez-vous en \\u00e9tendant les pieds, en gardant les genoux droits.\",\"62\":\"Asseyez-vous sur la machine et saisissez les poign\\u00e9es ou le si\\u00e8ge pour maintenir le torse immobile. Pliez les genoux et placez les chevilles sous les coussins de cheville. Inspirez et levez les jambes \\u00e0 l\\u0027horizontale. Expirez \\u00e0 la fin de l\\u0027exercice.\",\"63\":\"Mettez-vous debout avec les pieds l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9s, un halt\\u00e8re dans chaque main et les bras d\\u00e9tendus, en regardant droit devant. Inspirez, cambrer l\\u00e9g\\u00e8rement le dos et pliez les genoux. Lorsque les cuisses atteignent l\\u0027horizontale, \\u00e9tendez les jambes pour revenir \\u00e0 la position initiale. Expirez \\u00e0 la fin de l\\u0027effort.\",\"64\":\"Tenez-vous debout avec les pieds l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9s et la barre reposant sur le trap\\u00e8ze ou un peu plus bas sur le delto\\u00efde post\\u00e9rieur. Inspirez et penchez le buste vers l\\u0027avant, en maintenant le dos droit. L\\u0027axe de rotation doit passer \\u00e0 travers les articulations coxof\\u00e9morales. Revenez \\u00e0 la position initiale et expirez. Pour rendre l\\u0027exercice plus facile, pliez l\\u00e9g\\u00e8rement les genoux.\",\"65\":\"Positionnez le dos correctement contre le dossier d\\u0027une machine, les pieds l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9s. Inspirez et rel\\u00e2chez les barres de s\\u00e9curit\\u00e9, puis pliez compl\\u00e8tement les genoux de mani\\u00e8re \\u00e0 ce que les cuisses touchent ou presque le torse. Revenez \\u00e0 la position initiale, en expirant \\u00e0 la fin du mouvement.\",\"66\":\"Positionnez votre dos correctement contre le dossier de la machine, les pieds l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9s. Inspirez et lib\\u00e9rez les barres de s\\u00e9curit\\u00e9, puis pliez compl\\u00e8tement les genoux de mani\\u00e8re \\u00e0 ce que les cuisses touchent ou presque le torse. Revenez \\u00e0 la position initiale, expirez \\u00e0 la fin du mouvement.\",\"67\":\"Avec la barre reposant sur un support, glissez-vous sous la barre et placez-la sur le trap\\u00e8ze un peu plus haut que le delto\\u00efde post\\u00e9rieur. Saisissez fermement la barre avec les mains \\u00e0 une largeur confortable et les coudes en arri\\u00e8re. Inspirez profond\\u00e9ment, cambrant l\\u00e9g\\u00e8rement le dos en faisant pivoter le bassin vers l\\u0027avant, contractez les abdominaux, regardez droit devant vous et enlevez la barre du support. Reculez d\\u0027un ou deux pas et arr\\u00eatez-vous avec les deux pieds parall\\u00e8les et espac\\u00e9s d\\u0027environ la largeur des \\u00e9paules. Penchez-vous en avant depuis les hanches et \\u00e9vitez d\\u0027arrondir le dos afin de pr\\u00e9venir les blessures. Lorsque les cuisses sont horizontales au sol, tendez les jambes et redressez le torse pour revenir \\u00e0 la position initiale. Expirez \\u00e0 la fin du mouvement.\",\"68\":\"Tenez-vous debout, les jambes \\u00e9cart\\u00e9es \\u00e0 la largeur des \\u00e9paules, en tenant la barre avec une prise par-dessus pendant qu\\u0027elle repose sur les muscles pectoraux sup\\u00e9rieurs et les delto\\u00efdes ant\\u00e9rieurs. Inspirez profond\\u00e9ment pour maintenir une pression intrathoracique, ce qui emp\\u00eache le torse de s\\u0027affaisser vers l\\u0027avant, l\\u00e9g\\u00e8rement cambrer le bas du dos, contracter la sangle abdominale et plier les genoux pour abaisser les cuisses \\u00e0 l\\u0027horizontale. Revenez \\u00e0 la position initiale et expirez \\u00e0 la fin du mouvement.\",\"69\":\"Tenez-vous debout avec les jambes tendues et les pieds l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9s, le dos contre le dossier, et les \\u00e9paules positionn\\u00e9es sous les coussinets d\\u0027\\u00e9paule. Inspirez et rel\\u00e2chez la s\\u00e9curit\\u00e9, pliez les genoux, puis revenez \\u00e0 la position initiale. Expirez \\u00e0 la fin de l\\u0027exercice.\",\"70\":\"Avec la barre reposant sur un support, glissez-vous sous la barre et placez-la sur le trap\\u00e8ze l\\u00e9g\\u00e8rement plus haut que le delto\\u00efde post\\u00e9rieur. Saisissez fermement la barre avec les mains \\u00e0 une largeur confortable et les coudes en arri\\u00e8re. Inspirez profond\\u00e9ment, arquez l\\u00e9g\\u00e8rement le dos en faisant pivoter le bassin vers l\\u0027avant, contractez les muscles abdominaux, regardez droit devant vous et d\\u00e9verrouillez la barre. Les deux pieds parall\\u00e8les et \\u00e9cart\\u00e9s d\\u0027environ la largeur des \\u00e9paules, penchez-vous en avant depuis les hanches et \\u00e9vitez de vous arrondir le dos afin de pr\\u00e9venir les blessures. Lorsque les cuisses sont parall\\u00e8les au sol, tendez les jambes et redressez le torse pour revenir \\u00e0 la position initiale. Expirez \\u00e0 la fin du mouvement.\",\"71\":\"Avec la barre reposant sur un support, glissez-vous sous la barre et placez-la sur le trap\\u00e8ze un peu plus haut que le delto\\u00efde post\\u00e9rieur. Saisissez fermement la barre avec les mains \\u00e0 une largeur confortable et les coudes en arri\\u00e8re. Respirez profond\\u00e9ment, arquez l\\u00e9g\\u00e8rement le dos en faisant pivoter le bassin vers l\\u0027avant, contractez la sangle abdominale, regardez droit devant vous et retirez la barre du support. Reculez d\\u0027un ou deux pas et arr\\u00eatez-vous avec les deux pieds parall\\u00e8les l\\u0027un \\u00e0 l\\u0027autre et \\u00e0 environ une largeur et demie d\\u0027\\u00e9paule, les orteils tourn\\u00e9s vers l\\u0027ext\\u00e9rieur. Penchez-vous en avant \\u00e0 partir des hanches et \\u00e9vitez de vous arrondir le dos afin de pr\\u00e9venir les blessures. Lorsque les cuisses sont horizontales par rapport au sol, redressez les jambes et soulevez le torse pour revenir \\u00e0 la position initiale. Expirez \\u00e0 la fin du mouvement.\",\"72\":\"Tenez-vous debout, les jambes l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9es et tenez un halt\\u00e8re dans chaque main. Inspirez et faites un grand pas en avant, en gardant le torse aussi droit que possible. Lorsque la cuisse avant atteint l\\u0027horizontale ou l\\u00e9g\\u00e8rement en dessous, utilisez une extension tonique pour revenir \\u00e0 la position initiale. Expirez \\u00e0 la fin du mouvement.\",\"73\":\"Allongez-vous sur un banc, le visage vers le bas. Inspirez et soulevez les halt\\u00e8res bras tendus jusqu\\u0027au niveau des yeux. Expirez \\u00e0 la fin du mouvement. Cet exercice peut \\u00eatre effectu\\u00e9 en position debout, avec les jambes l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9es et le dos droit, en contractant les muscles abdominaux et en tenant les halt\\u00e8res avec une prise invers\\u00e9e.\",\"74\":\"Allongez-vous sur un banc, face contre terre. Inspirez et soulevez la barre avec les bras tendus jusqu\\u0027au niveau des yeux. Expirez \\u00e0 la fin du mouvement. Cet exercice peut \\u00eatre ex\\u00e9cut\\u00e9 en position debout, avec les jambes l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9es et le dos droit, en contractant les muscles abdominaux et en tenant la barre avec une prise sup\\u00e9rieure.\",\"75\":\"Saisissez la poign\\u00e9e avec le bras pr\\u00e8s du corps. Inspirez et levez le bras \\u00e0 l\\u0027horizontale. Expirez \\u00e0 la fin du mouvement.\",\"76\":\"Tenez-vous debout avec le dos droit, les jambes l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9es, les bras qui pendent \\u00e0 c\\u00f4t\\u00e9 du corps, tenant une barre de musculation dans chaque main. Levez les bras \\u00e0 l\\u0027horizontale avec les coudes l\\u00e9g\\u00e8rement fl\\u00e9chis. Revenez \\u00e0 la position initiale. Il existe trois variations pour la position initiale : halt\\u00e8res sur le c\\u00f4t\\u00e9 du corps, halt\\u00e8res derri\\u00e8re et halt\\u00e8res devant le corps.\",\"77\":\"Tenez-vous debout, les jambes l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9es et les genoux l\\u00e9g\\u00e8rement fl\\u00e9chis, et penchez-vous en avant \\u00e0 partir de la taille tout en gardant le dos droit. Avec les bras le long du corps, saisissez les halt\\u00e8res avec les coudes l\\u00e9g\\u00e8rement fl\\u00e9chis. Inspirez et levez les bras \\u00e0 l\\u0027horizontale. Expirez \\u00e0 la fin de l\\u0027effort.\",\"78\":\"Allongez-vous sur le c\\u00f4t\\u00e9 par terre ou sur un banc en tenant un halt\\u00e8re avec une prise sup\\u00e9rieure. Inspirez et levez le bras \\u00e0 la verticale. Expirez \\u00e0 la fin du mouvement.\",\"79\":\"Asseyez-vous le dos droit et tenez la barre avec une prise par-dessus, en la reposant sur la partie sup\\u00e9rieure de la poitrine. Inspirez et \\u00e9tendez la barre verticalement. Expirez \\u00e0 la fin du mouvement.\",\"80\":\"Asseyez-vous sur un banc en gardant le dos droit et tenez les halt\\u00e8res au niveau des \\u00e9paules avec une prise sup\\u00e9rieure (les pouces pointant vers l\\u0027int\\u00e9rieur). Inspirez et \\u00e9tendez les bras verticalement. Expirez \\u00e0 la fin du mouvement.\",\"81\":\"Asseyez-vous avec le dos droit, en tenant la barre derri\\u00e8re le cou avec une prise en main sup\\u00e9rieure. Inspirez et soulevez la barre droit vers le haut, en gardant le bas du dos droit autant que possible. Expirez \\u00e0 la fin du mouvement.\",\"82\":\"Tenez-vous debout, les jambes l\\u00e9g\\u00e8rement \\u00e9cart\\u00e9es et le dos droit. Saisissez la barre avec une prise en supination l\\u00e9g\\u00e8rement plus large que la largeur des \\u00e9paules, alors qu\\u0027elle repose contre les cuisses. Inspirez et tirez la barre le long du corps jusqu\\u0027au menton en gardant les coudes aussi hauts que possible. Abaissez la barre de mani\\u00e8re contr\\u00f4l\\u00e9e, sans mouvements brusques. Expirez \\u00e0 la fin de l\\u0027effort.\",\"83\":\"Asseyez-vous ou tenez-vous debout et saisissez une barre (ou une barre en Z) avec une prise sup\\u00e9rieure et les bras verticaux. Inspirez et pliez les coudes pour descendre la barre derri\\u00e8re la t\\u00eate. Revenez \\u00e0 la position initiale et expirez \\u00e0 la fin de l\\u0027extension.\",\"84\":\"Tenez-vous debout ou assis face \\u00e0 la machine et saisissez la poign\\u00e9e avec une prise invers\\u00e9e. Inspirez et \\u00e9tendez l\\u0027avant-bras. Expirez \\u00e0 la fin du mouvement.\",\"85\":\"Asseyez-vous et saisissez un halt\\u00e8re, en le tenant derri\\u00e8re le cou. Inspirez et \\u00e9tendez l\\u0027avant-bras. Expirez \\u00e0 la fin du mouvement.\",\"86\":\"Tenez-vous devant la machine et saisissez la poign\\u00e9e avec une prise sup\\u00e9rieure, en gardant les coudes coll\\u00e9s au corps. Inspirez et \\u00e9tendez les avant-bras, en gardant les coudes coll\\u00e9s au corps. expirez \\u00e0 la fin du mouvement. Cet exercice peut \\u00e9galement \\u00eatre r\\u00e9alis\\u00e9 avec une corde.\",\"87\":\"Tenez-vous dos \\u00e0 la machine et saisissez la poign\\u00e9e avec une prise sup\\u00e9rieure, en gardant les coudes coll\\u00e9s au corps. Inspirez et \\u00e9tendez les avant-bras, en gardant les coudes coll\\u00e9s au corps. Expirez \\u00e0 la fin du mouvement. Cet exercice peut \\u00e9galement \\u00eatre r\\u00e9alis\\u00e9 \\u00e0 l\\u0027aide d\\u0027une corde.\",\"88\":\"Asseyez-vous ou tenez-vous debout et saisissez un halt\\u00e8re d\\u0027une main avec le bras vertical. Inspirez et pliez le coude pour abaisser l\\u0027halt\\u00e8re derri\\u00e8re la t\\u00eate jusqu\\u0027au cou. Revenez \\u00e0 la position initiale. Expirez \\u00e0 la fin du mouvement. Contractez le noyau abdominal pour \\u00e9viter de cambrer le bas du dos. Utilisez si possible un banc avec un soutien pour le bas du dos.\",\"89\":\"Suspendez le corps entre deux barres parall\\u00e8les. Inspirez, puis fl\\u00e9chissez les coudes en vous abaissant et relevez-vous en \\u00e9tendant les avant-bras. Expirez \\u00e0 la fin du mouvement.\",\"90\":\"Allongez-vous sur un banc horizontal et saisissez la barre avec une prise en pronation, les bras verticaux. Inspirez et descendez la barre jusqu\\u0027au front ou derri\\u00e8re la t\\u00eate en pliant les coudes. Revenez \\u00e0 la position initiale. Soufflez \\u00e0 la fin de l\\u0027effort. Utiliser une barre E-Z permet de pr\\u00e9venir une tension excessive au niveau des poignets.\",\"91\":\"\",\"92\":\"\",\"93\":\"\",\"94\":\"\",\"95\":\"\",\"96\":\"\",\"97\":\"Deux exercices\",\"98\":\"Trois exercices\",\"99\":\"Quatre exercices\",\"100\":\"Normal\"},\"mgymR\":{\"1\":\"Programme de perte de poids - Premier mois\",\"2\":\"Programme de perte de poids mois deux\",\"3\":\"Programme g\\u00e9n\\u00e9rique de perte de poids\",\"4\":\"Routine de 30 minutes\",\"5\":\"Circuit trainning v1\",\"6\":\"Circuit trainning v2\",\"7\":\"Circuit trainning v3\",\"8\":\"Formation de volume allemand - premier mois\",\"9\":\"Perte de poids et gain musculaire premier mois\",\"10\":\"Perte de poids et gain musculaire deuxi\\u00e8me mois\",\"11\":\"Circuit training pour femme\",\"12\":\"Rutina de 3 d\\u00edas para mujeres v1.\",\"13\":\"30 minutes routine for women - Routine de 30 minutes pour les femmes\",\"14\":\"Routine compl\\u00e8te pour femmes\",\"15\":\"3 jours de routine pour femmes v2\",\"16\":\"Rutina de 3 d\\u00edas para hombres con ganancia muscular\",\"17\":\"Entra\\u00eenement de volume allemand - deuxi\\u00e8me mois\",\"18\":\"Routine de tonification pour les hommes\",\"19\":\"Routine de tonification pour les femmes.\",\"20\":\"Routine g\\u00e9n\\u00e9rique de circuit\",\"21\":\"Rutina de p\\u00e9rdida de peso utilizando triseries\"},\"mgymRd\":{\"1\":\"RESTEZ : aussi longtemps qu\\u0027il faut pour passer d\\u0027une machine \\u00e0 une autre, entre les supers\\u00e9ries, reposez-vous pendant 1 minute. Pour perdre du poids, vous devez augmenter la dur\\u00e9e de votre entra\\u00eenement cardio et combiner \\u00e0 la fois la routine et le cardio avec une alimentation saine.\",\"2\":\"R\\u00e9p\\u00e9tez chaque circuit 2 fois. REPOS : 20 secondes entre les exercices, 1 minute entre les circuits. Pour perdre du poids, vous devez augmenter l\\u0027intensit\\u00e9 de votre entra\\u00eenement cardio et combiner \\u00e0 la fois la routine et le cardio avec une alimentation saine.\",\"3\":\"Augmentez le poids de chaque exercice chaque semaine. Reposez-vous aussi longtemps qu\\u0027il faut pour passer d\\u0027une machine \\u00e0 l\\u0027autre. ENTRA\\u00ceNEMENT CARDIO : 5 minutes avant la s\\u00e9ance et 30 minutes apr\\u00e8s l\\u0027avoir termin\\u00e9e.\",\"4\":\"OPTIONNEL: faire 20 minute de cardio 2-3 fois par semaine\",\"5\":\"R\\u00e9p\\u00e9tez ce circuit trois\\/quatre fois, reposez-vous une minute avant chaque r\\u00e9p\\u00e9tition. ENTRA\\u00ceNEMENT CARDIO: 5 minutes avant la routine et 20 minutes apr\\u00e8s l\\u0027avoir termin\\u00e9e.\",\"6\":\"R\\u00e9p\\u00e9tez ce circuit deux fois. REPOS : 30 secondes entre les s\\u00e9ries, 1 minute entre chaque r\\u00e9p\\u00e9tition. ENTRA\\u00ceNEMENT CARDIO : 5 minutes avant la routine et 20 minutes apr\\u00e8s l\\u0027avoir termin\\u00e9e.\",\"7\":\"R\\u00e9p\\u00e9tez ce circuit deux fois. REPOS : 30 secondes entre les s\\u00e9ries. 1 minute entre chaque r\\u00e9p\\u00e9tition. ENTRA\\u00ceNEMENT CARDIO : 5 minutes avant la routine et 20 minutes apr\\u00e8s l\\u0027avoir termin\\u00e9e.\",\"8\":\"Ne pas r\\u00e9p\\u00e9ter cette routine plus de 4 semaines\",\"9\":\"REPOS : commencez \\u00e0 vous reposer pendant 60 secondes entre les exercices. Diminuez le temps de repos entre les exercices chaque semaine. Vous devez combiner la routine avec une alimentation saine pour am\\u00e9liorer les r\\u00e9sultats. ENTRA\\u00ceNEMENT CARDIO : 30 minutes par jour, cinq jours par semaine.\",\"10\":\"REPOS : commencez \\u00e0 vous reposer pendant 60 secondes entre les exercices. Diminuez le temps de repos entre les exercices chaque semaine. Vous devez combiner la routine et une alimentation saine pour am\\u00e9liorer les r\\u00e9sultats. ENTRA\\u00ceNEMENT CARDIO : 30 minutes par jour, cinq jours par semaine.\",\"11\":\"R\\u00e9p\\u00e9tez ce circuit trois\\/quatre fois. ENTRAINEMENT CARDIO : apr\\u00e8s avoir termin\\u00e9 la routine, effectuez un entra\\u00eenement cardio de 30 \\u00e0 45 minutes.\",\"12\":\"Reposez-vous pendant 1 minute entre les s\\u00e9ries, ENTRA\\u00ceNEMENT CARDIO : 10 minutes avant la routine et 30 minutes apr\\u00e8s l\\u0027avoir termin\\u00e9e.\",\"13\":\"Faites cette routine 3 jours par semaine, en laissant un jour entre chaque jour o\\u00f9 vous effectuez cet entra\\u00eenement. Exemple : lundi, mercredi, vendredi.\",\"14\":\"Effectuez cette routine 3 jours par semaine, en laissant un jour entre chaque jour o\\u00f9 vous effectuez cet entra\\u00eenement. Exemple : lundi, mercredi, vendredi.\",\"15\":\"\\u00c9chauffez-vous pendant 5 minutes avant de commencer la routine ou faites 20 minutes de cardio. REPOS : 1 minute entre les s\\u00e9ries.\",\"16\":\"Reposez-vous pendant 40 secondes entre les s\\u00e9ries. FACULTATIF : faites 20 minutes d\\u0027entra\\u00eenement cardiovasculaire 2 \\u00e0 3 jours par semaine.\",\"17\":\"Lorsque vous travaillez avec cette routine, vous devez travailler 4 jours par semaine, en recommen\\u00e7ant \\u00e0 partir du premier jour une fois que vous avez termin\\u00e9 les trois jours. Exemple : 1\\u00e8re semaine, Jour 1 : lundi, Jour 2 : mardi, Jour 3 : jeudi, Jour 1 : vendredi. 2\\u00e8me semaine, Jour 2 : lundi, Jour 3 : mardi, Jour 1 : jeudi, Jour 2 : vendredi. Ne restez pas plus de 4 semaines avec cette routine.\",\"18\":\"CARDIO ENTRAINEMENT: 30 minutes 2-3 fois par semaine\",\"19\":\"CARDIO ENTRAINEMENT: 30 minutes 2-3 fois par semaine\",\"20\":\"Effectuez cette routine 2 \\u00e0 3 fois. REPOS : deux minutes apr\\u00e8s avoir termin\\u00e9 chaque r\\u00e9p\\u00e9tition de la routine.\",\"21\":\"REPOS : 10 secondes entre les exercices, entre les triseries reposez-vous pendant 2 minutes.\"},\"mpos\":{\"pos\":\"Point de vente\",\"cashier\":\"Caisse\",\"category\":\"Cat\\u00e9gorie\",\"categories\":\"Cat\\u00e9gories\",\"items\":\"Articles\",\"new_item\":\"Ajouter un article\",\"items_and_stock\":\"Articles et stock\",\"orders\":\"Commandes\",\"order_log\":\"Registre des commandes\",\"order_number\":\"Num\\u00e9ro de commande\",\"cancel_order\":\"Annuler cette commande\",\"tab\":\"Table\",\"order\":{\"automatic_status\":\"Ce statut est attribu\\u00e9 automatiquement\"},\"items_deleted\":\"\\u00c9l\\u00e9ments supprim\\u00e9s avec succ\\u00e8s !\",\"items_online_enabled\":\"Les articles en ligne ont \\u00e9t\\u00e9 activ\\u00e9s avec succ\\u00e8s !\",\"items_online_disabled\":\"Articles en ligne d\\u00e9sactiv\\u00e9s avec succ\\u00e8s !\",\"cost_price\":\"Co\\u00fbt d\\u0027achat\",\"unit_price\":\"Prix TTC\",\"item_price\":\"Prix de l\\u0027article\",\"bar_code\":\"Code barre\",\"vat\":\"TVA\",\"add_new_category\":\"Ajouter une nouvelle cat\\u00e9gorie\",\"empty_category\":\"Cette cat\\u00e9gorie est vide\",\"stock_tip\":\"Si vous ne voulez pas utiliser le stock pour cet article, laissez le champs vide.\",\"choose_from_library\":\"Choisir depuis la biblioth\\u00e8que\",\"saving_item\":\"Erreur dans l\\u0027enregistrement de l\\u0027article\",\"click_here_to_edit_items\":\"Cliquez ici pour acc\\u00e9der aux articles\",\"click_here_to_edit_price\":\"Cliquez ici pour \\u00e9diter le prix\",\"click_here_to_delete_transaction\":\"Cliquez ici pour supprimer la transaction\",\"click_here_to_delete_item\":\"Cliquez ici pour supprimer l\\u0027article\",\"click_here_to_delete_items\":\"Cliquez ici pour supprimer des articles\",\"click_here_to_delete_all_items\":\"Cliquez ici pour supprimer tous les articles\",\"low_stock\":\"Stock bas de l\\u0027article\",\"going_to_delete_order\":\"Vous allez supprimer cette commande\",\"going_to_delete_ticket\":\"Vous allez supprimer ce ticket\",\"