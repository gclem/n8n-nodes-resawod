pp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3167\\/featured_images\\/image-1.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3167\\/featured_images\\/image-2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3167\\/featured_images\\/image-3.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3167\\/featured_images\\/image.jpg\"],\"address\":{\"street\":\"Haverkamp 10\",\"town\":\"Selent\",\"postal_code\":\"24238\",\"country\":\"Germany\"},\"location\":{\"latitude\":54.2887335,\"longitude\":10.4131126},\"contact_info\":{\"email\":\"info@crossfitselent.com\",\"phone\":\"\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitSelent\\/\"}},{\"id_application\":null,\"id_lead\":\"2802\",\"name\":\"Crossfit Lleida\",\"description\":\"Box oficial de Crossfit, entrenaments personals, microgrups i grups d\\u0027entrenament\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2802\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2802\\/featured_images\\/cflleida.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2802\\/featured_images\\/crossfit-lleida.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2802\\/featured_images\\/unnamed.jpg\"],\"address\":{\"street\":\"Josep Sarrate i Forga, 9\",\"town\":\"Lleida\",\"postal_code\":\"25191\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.610375,\"longitude\":0.6581903},\"contact_info\":{\"email\":\"info@crossfitlleida.com\",\"phone\":\"653156881\"},\"social_media\":{\"instagram\":\"crossfitlleidaoficial\",\"facebook\":\"@crossfitlleida\"}},{\"id_application\":\"35731170\",\"id_lead\":null,\"name\":\"Athletic Department\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/35731170\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Tecklenburger Damm 59\",\"town\":\"Ibbenb\\u00fcren\",\"postal_code\":\"49477\",\"country\":\"Germany\"},\"location\":{\"latitude\":52.3000513,\"longitude\":8.0105823},\"contact_info\":{\"email\":\"crossfitosnabrueck@nubapp-clients.com\",\"phone\":\"015202156527\\t\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2735\",\"name\":\"Crossfit Bayreuth\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2735\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2735\\/featured_images\\/Bildschirmfoto%202019-04-29%20um%2009.57.55.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2735\\/featured_images\\/Bildschirmfoto%202019-04-29%20um%2009.58.08.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2735\\/featured_images\\/Bildschirmfoto%202019-04-29%20um%2009.58.32.png\"],\"address\":{\"street\":\"Bernecker Stra\\u00dfe 17\",\"town\":\"Bayreuth\",\"postal_code\":\"95448\",\"country\":\"Deutschland\"},\"location\":{\"latitude\":49.9549676,\"longitude\":11.5919984},\"contact_info\":{\"email\":\"info@crossfit-bayreuth.de\",\"phone\":\"+49 15140734088\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitbayreuth\"}},{\"id_application\":\"86985086\",\"id_lead\":null,\"name\":\"Crossfit Pamplona\",\"description\":\"FILOSOF\\u00cdA CROSSFIT PAMPLONA\\n\\n\\u003Ciframe width=\\u0022560\\u0022 height=\\u0022315\\u0022 src=\\u0022https:\\/\\/www.youtube.com\\/embed\\/1ZrBQ72jh_U\\u0022 frameborder=\\u00220\\u0022 allow=\\u0022accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture\\u0022 allowfullscreen\\u003E\\u003C\\/iframe\\u003E\\n\\n\\u00bfQu\\u00e9 es el CrossFit? Entrevista a nuestros coaches \\n\\nLos Coaches de CrossFit Pamplona hablan sobre el CrossFit y qu\\u00e9 significa para ellos.\\n\\nCrossFit nace para llevar el entrenamiento funcional a todo el mundo.\\n\\nHasta ahora los entrenamientos funcionales eran utilizados \\u00fanicamente por deportistas de \\u00e9lite y la gente normal que hacia fitness (deporte para mejorar su d\\u00eda a d\\u00eda) utilizaba maquinas que limitan los movimientos y el riesgo de lesi\\u00f3n, pero tambi\\u00e9n los progresos, y la efectividad de los entrenamientos. As\\u00ed que cuando haces CrossFit tienes que controlar al m\\u00e1ximo la t\\u00e9cnica y contar con la ayuda de un buen entrenador que conozca a la perfecci\\u00f3n los beneficios y los riesgos que entra\\u00f1a cada movimiento. Por eso nosotros no nos conformamos con el t\\u00edtulo. Como deportistas con amplias carreras en el mundo de la competici\\u00f3n conocemos muy de cerca este tipo de entrenamiento y podemos aconsejar a nuestros alumnos desde nuestra experiencia.\\n\\nPara nosotros Crossfit no es una moda, es un deporte: El deporte del Fitness.\\n\\nNos apasiona el deporte, donde lo importante no son las apariencias ni las marcas, sino crear un ambiente donde nadie sea m\\u00e1s que nadie y, todos, sea cual sea nuestro nivel, podamos entrenar juntos y conseguir nuestros objetivos.\\n\\nEsta es la grandeza del CrossFit, poder trabajar codo con codo, y disfrutar con la ilusi\\u00f3n del que empieza y la experiencia de el veterano en cada sesi\\u00f3n. Por eso aqu\\u00ed todo el mundo es importante. \\n\\nNuestra pasi\\u00f3n es entrenar a personas y ver sus progresos. En CrossFit Pamplona estamos pendientes de ti.\\n\\nNuestra Head Coach Miren Le\\u00f3n, Diploma Ol\\u00edmpico en Sydney 2000 y deportista de elite, es la encargada de programar las sesiones de entrenamiento. Estos entrenamientos ser\\u00e1n adaptados a cada deportista. \\n\\n \\n\\n \\n\\nEn nuestro Box vas a encontrar barras y pesas para levantar, cajones para saltar, cuerdas, escaleras y anillas para colgarte, y un gran espacio abierto para correr. Pero no encontraras espejos para mirarte, ni maquinas que limiten tus movimientos, ni luces, ni sof\\u00e1s, ni lujos que te acomoden. A CrossFit Pamplona se viene a entrenar. Vas a sudar, vas a cansarte, vas a mejorar, vas a conocer gente incre\\u00edble, y todo en un ambiente familiar en el que te encontrar\\u00e1s c\\u00f3modo, donde puedas olvidarte de todo y centrarte en lo importante: Entrenar\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/86985086\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/86985086\\/featured_images\\/image%20cfpamplona.jpg\"],\"address\":{\"street\":\"Hermanos Noain\",\"town\":\"Ansoain\",\"postal_code\":\"31013\",\"country\":\"Espa\\u00f1a\"},\"location\":{\"latitude\":42.83214,\"longitude\":-1.6464},\"contact_info\":{\"email\":\"info@crossfitpamplona.es\",\"phone\":\"(+34) 948 384 761\"},\"social_media\":{\"instagram\":\"crossfitpamplona\",\"facebook\":\"CrossFitPamplona\"}},{\"id_application\":\"95115895\",\"id_lead\":null,\"name\":\"CrossFit Heliaca\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/95115895\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Av. de Lambusart 25\",\"town\":\"Fleurus\",\"postal_code\":\"6220\",\"country\":\"Belgium\"},\"location\":{\"latitude\":50.4552704,\"longitude\":4.5429033},\"contact_info\":{\"email\":\"cf_heliaca@nubapp-clients.com\",\"phone\":\"003271405339\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"3001\",\"name\":\"Dark Lion Crossfit\",\"description\":\"Existen multitud de diferencias entre un Box de CrossFit y un gimnasio t\\u00edpico, pero la que marca la diferencia, y por la que conseguir\\u00e1s alcanzar las metas que te propongas, ser\\u00e1 el hecho de que durante una sesi\\u00f3n de CrossFit tendr\\u00e1s entrenadores especializados ense\\u00f1\\u00e1ndote y corrigiendo tu t\\u00e9cnica en todo momento, adem\\u00e1s de exigirte para que consigas superarte a ti mismo en cada entrenamiento.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3001\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3001\\/featured_images\\/18556584_1577358228949721_5349425845358596660_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3001\\/featured_images\\/20369951_1647627191922824_8906249008335141007_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3001\\/featured_images\\/20689651_1662985607053649_6698904617981173540_o.jpg\"],\"address\":{\"street\":\"Pol\\u00edgono La Carrera, nave 4 bajo\",\"town\":\"Siero\",\"postal_code\":\"33519\",\"country\":\"Spain\"},\"location\":{\"latitude\":43.3867998,\"longitude\":-5.7168278},\"contact_info\":{\"email\":\"darklioncrossfit@hotmail.com\",\"phone\":\"636321703\"},\"social_media\":{\"instagram\":\"darklioncrossfit\",\"facebook\":\"@darklioncrossfit\"}},{\"id_application\":null,\"id_lead\":\"3031\",\"name\":\"Condal Crossfit\",\"description\":\"Queremos que cuando vengas al box sea la mejor parte de tu d\\u00eda\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3031\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3031\\/featured_images\\/Condal-CrossFit-Barcelona1.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3031\\/featured_images\\/condal-crossfit-maragall-remos-1000x667.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3031\\/featured_images\\/condal-crossfit-maragall-sala.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3031\\/featured_images\\/condal-crossfit-maragall.jpg\"],\"address\":{\"street\":\"Passatge Rustullet, 18\",\"town\":\"Barcelona\",\"postal_code\":\"08041\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.41228,\"longitude\":2.161495},\"contact_info\":{\"email\":\"info@condalcrossfit.com\",\"phone\":\"649761006\"