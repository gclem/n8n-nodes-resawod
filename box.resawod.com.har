rt_deporwin_images\":\"Importer les images des utilisateurs Deporwin\",\"import_deporwin_documents\":\"Importer les documents des utilisateurs Deporwin\",\"start_deporwin_automatic_step\":\"Import Deporwin automatic step\",\"user_not_imported\":\"L\\u0027utilisateur %user_name% n\\u0027a pas pu \\u00eatre import\\u00e9.\",\"deporwin_database_error\":\"Une erreur s\\u0027est produite lors de la connexion \\u00e0 la base de donn\\u00e9es Deporwin. Veuillez r\\u00e9initialiser l\\u0027importation ou contacter le support.\",\"file_not_imported\":\"Le fichier %file_name% n\\u0027a pu \\u00eatre import\\u00e9\",\"failed_to_download_documents_file\":\"\\u00c9chec du t\\u00e9l\\u00e9chargement du fichier de documents.\",\"failed_to_download_images_file\":\"\\u00c9chec du t\\u00e9l\\u00e9chargement du fichier d\\u0027images.\",\"document_file_not_found\":\"Le fichier %file_name% est introuvable.\",\"no_discounts_to_import_memberships\":\"Il n\\u0027y a pas de remise pour les abonnements import\\u00e9s. L\\u0027abonnement %membership_name% b\\u00e9n\\u00e9ficie d\\u0027une remise, mais celle-ci n\\u0027existe pas dans l\\u0027application.\",\"invalid_dates_for_membership\":\"L\\u0027abonnement %membership_name% a des dates de d\\u00e9but et de fin non valides pour IdAbono : %id_abono%.\",\"membership_not_imported\":\"Un probl\\u00e8me a \\u00e9t\\u00e9 d\\u00e9tect\\u00e9 avec l\\u0027abonnement %membership_name% pour l\\u0027utilisateur %user_name%.\",\"discount_not_found_for_membership\":\"Tentative d\\u0027importation de  %membership_name%  avec une remise non d\\u00e9finie.\",\"membership_not_found_at_deporwin\":\"Abonnement %membership_name% introuvable dans le syst\\u00e8me Deporwin.\",\"long_term_category_from_serie_not_imported\":\"La s\\u00e9rie \\u00e0 long terme %serie_name% n\\u0027est associ\\u00e9e \\u00e0 aucune cat\\u00e9gorie.\",\"membership_vat_not_imported\":\"La TVA de l\\u0027abonnement  %membership_name% n\\u0027a pas encore \\u00e9t\\u00e9 import\\u00e9e.\",\"long_term_serie_has_no_resource\":\"La cat\\u00e9gorie %resource_name% n\\u0027a aucune s\\u00e9rie associ\\u00e9e.\",\"technical_error_suggestion\":\"Il s\\u0027agit d\\u0027une erreur technique. Veuillez contacter le support.\",\"import_long_term_categories_suggestion\":\"Veuillez d\\u0027abord importer les cat\\u00e9gories \\u00e0 long terme ou contacter le support technique.\",\"file_error_suggestion\":\"V\\u00e9rifiez le format du fichier ou contactez le service support.\",\"file_not_found_suggestion\":\"Assurez-vous que le fichier existe dans le dossier t\\u00e9l\\u00e9charg\\u00e9 ou contactez le support.\",\"application_must_have_cashier\":\"Pour importer les cotisations des utilisateurs, l\\u0027application doit disposer d\\u0027au moins une caisse.\",\"import_discounts_suggestion\":\"Importez d\\u0027abord les remises de l\\u0027application\",\"import_vats_suggestion\":\"Importer d\\u0027abord la TVA de l\\u0027application\",\"check_membership_dates_suggestion\":\"V\\u00e9rifiez les dates de cotisation des utilisateurs.\",\"import_manually_suggestion\":\"You can try to import this item manually after finishing the Deporwin importation.\"},\"error_boundary\":{\"title\":\"Une erreur s\\u0027est produite.\",\"something_went_wrong\":\"Une erreur s\\u0027est produite. Veuillez rafra\\u00eechir la page ou revenir en arri\\u00e8re.\",\"technical_details\":\"D\\u00e9tails techniques\",\"stack_trace\":\"Suivi de pile\",\"component_stack\":\"Composant de pile\",\"additional_details\":\"D\\u00e9tails suppl\\u00e9mentaires\",\"help_message\":\"Notre \\u00e9quipe technique a d\\u00e9j\\u00e0 \\u00e9t\\u00e9 inform\\u00e9e du probl\\u00e8me et travaille \\u00e0 sa correction. Veuillez r\\u00e9essayer dans quelques minutes.\",\"reload_page\":\"Recharger la page\",\"go_back\":\"Retour\"},\"musers\":{\"owner\":\"Propri\\u00e9taire\",\"until\":\"Jusqu\\u0027\\u00e0\",\"since\":\"Depuis\",\"users\":\"Utilisateurs\",\"users_profile\":\"Profil de l\\u0027utilisateur\",\"change_user\":\"Changer l\\u0027utilisateur\",\"change_user_not_possible\":\"Changer l\\u0027utilisateur n\\u0027est pas possible pour payer les r\\u00e9servations\",\"event\":\"Ev\\u00e8nement\",\"delete_booking\":\"Supprimer la r\\u00e9servation\",\"delete_booking_not_possible\":\"Impossible de supprimer la r\\u00e9servation\",\"delete_paid_booking\":\"Attention ! Cette r\\u00e9servation est pay\\u00e9e\",\"invoice\":\"Facture\",\"coming_soon\":\"Bient\\u00f4t disponible\",\"permissions_and_online_access\":\"Autorisations et acc\\u00e8s en ligne\",\"family_members_and_referrals\":\"Membres de la famille et parrainage\",\"add_referral\":\"Ajouter une relation\",\"add_referred_by\":\"Ajouter recommand\\u00e9 par\",\"select_referral\":\"Choisir la relation\",\"delete_referral\":\"Parrainage supprim\\u00e9e avec succ\\u00e8s\",\"referral_added\":\"Parrainage ajout\\u00e9e avec succ\\u00e8s\",\"booking_info\":\"Info de la r\\u00e9servation\",\"upcoming_bookings\":\"R\\u00e9servations \\u00e0 venir\",\"previous_bookings\":\"R\\u00e9servations pr\\u00e9c\\u00e9dentes\",\"this_week_bookings\":\"Cette semaine\",\"this_month_bookings\":\"Ce mois\",\"cancelled_bookings\":\"R\\u00e9servations annul\\u00e9es\",\"deleted_bookings\":\"R\\u00e9servations annul\\u00e9es\",\"paid\":\"Pay\\u00e9\",\"number_of_bookings\":\"Nombre de r\\u00e9servations\",\"group_by_dayweek\":\"Groupe par jour de la semaine\",\"required\":\"Requis\",\"field_required\":\"Ce champ est requis.\",\"field_required_number\":\"Ce champ doit comporter un nombre.\",\"field_required_email\":\"Ce champ ne comporte pas une adresse mail valide.\",\"field_required_date\":\"Ce n\\u0027est pas une date valide. \\u003Csmall\\u003E(jj\\/mm\\/aaaa)\\u003C\\/small\\u003E\",\"select_value\":\"S\\u00e9lectionner une valeur.\",\"next_step\":\"Prochaine \\u00e9tape\",\"username_not_valid\":\"Nom d\\u0027utilisateur d\\u00e9j\\u00e0 pris ou trop court. 4 caract\\u00e8res minimum\",\"processing_users\":\"Traitement des utilisateurs\",\"search_users\":\"Rechercher des utilisateurs\",\"add_users\":\"Ajouter des utilisateurs\",\"add_new\":\"Ajouter nouveau\",\"reset_password\":\"R\\u00e9initialiser le mot de passe\",\"password_warning\":\"L\\u0027utilisateur n\\u0027a pas encore chang\\u00e9 de mot de passe.  Il est vivement recommand\\u00e9 de le faire.\",\"allow_online_access\":\"Permettre \\u00e0 l\\u0027utilisateur de se connecter sur le web et l\\u0027application mobile\",\"user_can_online_access\":\"L\\u0027utilisateur peut se connecter sur le web et \\u00e0 l\\u0027application mobile.\",\"user_can_not_online_access\":\"L\\u0027utilisateur ne peut pas se connecter sur le web ni l\\u0027application mobile.\",\"password_reset_confirm\":\"Voulez-vous r\\u00e9initialiser le mot de passe de l\\u0027utilisateur? Etes-vous s\\u00fbr?\",\"password_reset_confirm_mail\":\"Un email avec les nouveaux identifiants a \\u00e9t\\u00e9 envoy\\u00e9 \\u00e0 l\\u0027adresse %email%.\",\"password_reset_confirm_no_mail\":\"Le mot de passe de l\\u0027utilisateur a \\u00e9t\\u00e9 r\\u00e9initialis\\u00e9 mais l\\u0027utilisateur n\\u0027a pas pu \\u00eatre notifi\\u00e9 car il n\\u0027a pas d\\u0027adresse e-mail.\",\"print_online_info\":\"Imprimer l\\u0027information en ligne\",\"booking_log\":\"Historique de la r\\u00e9servation\",\"divided_payment\":\"Diviser le paiement\",\"no_divided_payment\":\"Ne pas diviser le paiement\",\"emails_sent_last_30_days\":\"E-mails envoy\\u00e9s au cours des 30 derniers jours\",\"sent_email\":\"E-mail envoy\\u00e9\",\"opening\":\"Ouverture\",\"view_notes\":\"Voir ou \\u00e9diter une note\",\"number_of_users_in_booking\":\"Il y a %n% utilisateurs dans cette r\\u00e9servation\",\"create_event\":\"Cr\\u00e9er un \\u00e9v\\u00e8nement\",\"view_event\":\"Voir un \\u00e9v\\u00e8nement\",\"do_yow_want_create_event\":\"Voulez-vous cr\\u00e9er un \\u00e9v\\u00e8nement pour cette r\\u00e9servation\",\"how_do_you_want_to_pay\":\"Comment souhaitez-vous payer cette r\\u00e9servation ?\",\"shared_payment_event\":\"Rencontre en paiement partag\\u00e9\",\"delete_booking_confirm\":\"Voulez-vous vraiment supprimer cette r\\u00e9servation?\",\"leave_booking_confirm\":\"Etes-vous s\\u00fbr de vouloir retirer cet utilisateur de cette r\\u00e9servation ?\",\"leave_activity_confirm\":\"Etes-vous s\\u00fbr de vouloir retirer cet utilisateur de cette activit\\u00e9 ?\",\"select_cancellation_reason\":\"S\\u00e9lectionnez un motif d\\u0027annulation\",\"cancellation_reason_title\":\"Motif de l\\u0027annulation\",\"cancellation_reason_text_placeholder\":\"Tapez la raison ici\",\"remove_from_waiting_list_confirm\":\"Voulez-vous supprimer cet utilisateur de la liste d\\u0027attente ?\",\"remove_from_list_confirm\":\"Voulez-vous supprimer cet utilisateur de la liste ?\",\"leave_course_confirm\":\"Souhaitez-vous que l\\u0027utilisateur quitte ce cours\\u00a0? \\u00cates-vous s\\u00fbr\\u00a0? Vous pouvez \\u00e9galement modifier la date de fin de cours. Lorsque la date de d\\u00e9part arrive, l\\u0027utilisateur ne sera plus inscrit mais restera dans le cours. Si le cours n\\u0027a pas encore commenc\\u00e9, tous les paiements effectu\\u00e9s seront rembours\\u00e9s\",\"pay_booking_confirm\":\"Voulez-vous changer le statut de cette r\\u00e9servation en \\u003Cstrong\\u003Epay\\u00e9\\u003C\\/strong\\u003E? Etes-vous s\\u00fbr?\",\"unpay_booking_confirm\":\"Voulez-vous changer le statut de cette r\\u00e9servation en \\u003Cstrong\\u003Enon pay\\u00e9\\u003C\\/strong\\u003E? Etes-vous s\\u00fbr?\",\"deposit_confirm\":\"Voulez-vous encaisser le reste de la r\\u00e9servation ou rembourser l\\u0027acompte?\",\"block_booking_confirm\":\"Cette r\\u00e9servation fait partie d\\u0027un bloc de r\\u00e9servations. Que voulez-vous faire? Voulez-vous changer le statut de toutes les r\\u00e9servations ou de celle-ci uniquement ?\",\"delete_block_booking_tip\":\"Cette r\\u00e9servation fait partie d\\u0027un bloc de r\\u00e9servation. Souhaitez-vous supprimer toutes les r\\u00