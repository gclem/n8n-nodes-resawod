nstagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfit.brauhauban.tarbes\\/\"}},{\"id_application\":null,\"id_lead\":\"3081\",\"name\":\"Cefiro Crossfit\",\"description\":\"En el box de Crossfit m\\u00e1s grande de Salamanca, trabajamos movimientos funcionales, constantemente variados y ejecutados a alta intensidad.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3081\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3081\\/featured_images\\/1.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3081\\/featured_images\\/2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3081\\/featured_images\\/3.jpg\"],\"address\":{\"street\":\"Wesley, 14\",\"town\":\"Carbajosa de la Sagrada\",\"postal_code\":\"37008\",\"country\":\"Spain\"},\"location\":{\"latitude\":40.9454533,\"longitude\":-5.6599693},\"contact_info\":{\"email\":\"info@crosscube.es\",\"phone\":\"677 55 27 03\"},\"social_media\":{\"instagram\":\"cefirocrossfit\",\"facebook\":\"@cefirocrossfit\"}},{\"id_application\":\"79380172\",\"id_lead\":null,\"name\":\"POLARIS FITNESS\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/79380172\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Rue C\\u00e9sar de Paepe 43\",\"town\":\"Oupeye\",\"postal_code\":\"4683\",\"country\":\"B\\u00e9lgica\"},\"location\":{\"latitude\":50.6990063,\"longitude\":5.6550642},\"contact_info\":{\"email\":\"crossfitraiseup@gmail.com\",\"phone\":\"0471274837\"},\"social_media\":{\"instagram\":\"https:\\/\\/www.instagram.com\\/polaris.fitness.center\\/\",\"facebook\":\"https:\\/\\/www.facebook.com\\/profile.php?id=61570099167770\\u0026locale=fr_FR\\u0026_rdr\"}},{\"id_application\":null,\"id_lead\":\"3218\",\"name\":\"Crossfit Ludwigsburg\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3218\\/featured_images\\/Bildschirmfoto%202019-07-12%20um%2012.38.17.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3218\\/featured_images\\/Bildschirmfoto%202019-07-12%20um%2012.38.24.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3218\\/featured_images\\/Bildschirmfoto%202019-07-12%20um%2012.38.28.png\"],\"address\":{\"street\":\"Carl-Jordan-Str. 18\",\"town\":\"Kolbermoor\",\"postal_code\":\"83059\",\"country\":\"Germany\"},\"location\":{\"latitude\":47.8442421,\"longitude\":12.0611974},\"contact_info\":{\"email\":\"info@crossfitludwigsburg.com\",\"phone\":\"+49 1717451022\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2610\",\"name\":\"CrossFit Saronno Wolf\",\"description\":\"CrossFit Saronno Wolf nasce da un idea di Omar Mohamed Al\\u00ec, attualmente socio e Coach di CrossFit Saronno Wolf.\\n\\nDal 2001 al 2010 Omar ha lavorato come militare professionista nei reparti Elite delle Truppe Alpine dell\\u2019esercito Italiano, ha prestato servizio nell\\u2019intelligence del Dipartimento Di Stato Americano, ha svolto indagini investigative in ambito privato in Italia e in svariate parti del mondo.\\n\\nDurante questo periodo Omar conosce il mondo del CrossFit in ambito militare e acquisisce anche le qualifiche e i diplomi di Personal Trainer, Body Building, Ipertrofia Muscolare, Alimentazione, Supplementazione, Circuiti per il dimagrimento, TRX e infine CrossFit L1.\\n\\nAttualmente Omar \\u00e8 un Ultra Runner e trova nella corsa estrema la passione che riempie il suo spirito d\\u2019avventura, ha partecipato alle Ultra Trail pi\\u00f9 importanti e nel febbraio del 2016 ha attraversato a piedi in 7 giorni e 12 ore la distanza di 300miglia nel freddo artico dello Yukon Canadese trainando una slitta con all\\u2019interno tutto il materiale necessario per sopravvivere a temperature che sono arrivate a -35\\u00b0.\\n\\nLa riuscita di questa impresa la deve anche alla combinazione di un allenamento Endurance misto al CrossFit che lo ha portato ad un miglioramento fisico di alto livello.\\n\\nGiacomo Giannelli \\u00e8 un allievo di Omar che crede e sposa il progetto CrossFit Saronno Wolf, anche lui ex militare delle Truppe Alpine dell\\u2019esercito, ex calciatore professionista, attualmente Broker assicurativo e preparatore dei portieri di diverse societ\\u00e0 calcistiche della zona\\n\\nIl giovane imprenditore e Omar realizzano cos\\u00ec una nuova realt\\u00e0 nel cuore della citt\\u00e0 di Saronno.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2610\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2610\\/featured_images\\/14633132_1812202092325562_7078428930260829896_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2610\\/featured_images\\/19800772_1930036310542139_5107907417497032379_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2610\\/featured_images\\/22712299_1974421046103665_119791011947507650_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2610\\/featured_images\\/40952027_2157225001156601_6175330606986035200_n.jpg\"],\"address\":{\"street\":\"Via S. Francesco, 3\",\"town\":\"Saronno\",\"postal_code\":\"21047\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.6329913,\"longitude\":9.0348606},\"contact_info\":{\"email\":\"info@crossfitsaronnowolf.com\",\"phone\":\"+39 338 422 9961\"},\"social_media\":{\"instagram\":\"crossfitsaronnowolf\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitsaronnowolf\\/\"}},{\"id_application\":null,\"id_lead\":\"2742\",\"name\":\"Crossfit am Rhein\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2742\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2742\\/featured_images\\/Bildschirmfoto%202019-05-10%20um%2010.56.22.png\",\"https:\\