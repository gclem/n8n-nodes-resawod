98304\\/featured_images\\/1.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/59698304\\/featured_images\\/2.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/59698304\\/featured_images\\/3.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/59698304\\/featured_images\\/4.png\"],\"address\":{\"street\":\"112 route de chateauneuf\",\"town\":\"Mont\\u00e9limar\",\"postal_code\":\"26200\",\"country\":\"France\"},\"location\":{\"latitude\":44.5341194,\"longitude\":4.7383034},\"contact_info\":{\"email\":\"crossfitmontelimar26@nubapp-clients.com\",\"phone\":\"0668664839\"},\"social_media\":{\"instagram\":\"crossfitmontelimar_26\",\"facebook\":\"@CrossFitMontelimar26\"}},{\"id_application\":\"19396468\",\"id_lead\":null,\"name\":\"SaiyaGym CrossFit\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/19396468\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/19396468\\/featured_images\\/22089807_1200388156729170_8721891139431621702_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/19396468\\/featured_images\\/22089811_1200388130062506_7468399349021595306_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/19396468\\/featured_images\\/22141078_1200388126729173_5210741800453713414_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/19396468\\/featured_images\\/22154373_1200388290062490_1247353833432380765_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/19396468\\/featured_images\\/23004436_1223426577758661_1550895000567143760_o.jpg\"],\"address\":{\"street\":\"Avenue de l\\u0027europe\",\"town\":\"LEMPDES\",\"postal_code\":\"63370\",\"country\":\"France\"},\"location\":{\"latitude\":45.7761838,\"longitude\":3.1808292},\"contact_info\":{\"email\":\"imadehamma@saiyagymcrossfit.com\",\"phone\":\"695992220\"},\"social_media\":{\"instagram\":\"saiyagymcrossfit\",\"facebook\":\"https:\\/\\/www.facebook.com\\/SaiyagymCrossFit\"}},{\"id_application\":\"29049286\",\"id_lead\":null,\"name\":\"CrossFit Marignane\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/29049286\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"65 av Jacqueline Auriol, Zac des Florides\",\"town\":\"Marignane\",\"postal_code\":\"13700\",\"country\":\"France\"},\"location\":{\"latitude\":43.4212739,\"longitude\":5.218332},\"contact_info\":{\"email\":\"crossfitmarignane@gmail.com\",\"phone\":\"0953483067\"},\"social_media\":{\"instagram\":\"crossfit_marignane\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitMarignane\"}},{\"id_application\":null,\"id_lead\":\"3103\",\"name\":\"CrossFit Gavroche 2\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3103\\/featured_images\\/16462945_246568475799208_1642320013619541644_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3103\\/featured_images\\/18358798_293022567820465_2964320389401971779_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3103\\/featured_images\\/18422433_293607837761938_6809115424193968553_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3103\\/featured_images\\/18451462_293194661136589_5854810445254872568_o.jpg\"],\"address\":{\"street\":\"10 avenue du Qu\\u00e9bec, Batiment Fuschia, BP520, Entr\\u00e9e 5\",\"town\":\"Villebon-sur-Yvette\",\"postal_code\":\"91140\",\"country\":\"France\"},\"location\":{\"latitude\":48.686723,\"longitude\":2.210681},\"contact_info\":{\"email\":\"contact@crossfitgavroche.com\",\"phone\":\"6 64 87 27 04\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/gavroche2\\/\"}},{\"id_application\":null,\"id_lead\":\"2617\",\"name\":\"CrossFit Peschiera Borromeo\",\"description\":\"Il CrossFit \\u00e8 lo sport ideale per costruire massa muscolare e favorire la perdita di peso.\\n\\nIl CrossFit \\u00e8 lo sport che modella il tuo corpo, che ha come focus primario quello di raggiungere la migliore forma fisica.\\n\\nDurante le classi, vengono eseguiti un mix di esercizi:\\n\\n\\u2611\\ufe0f cardio;\\n\\n\\u2611\\ufe0f a corpo libero;\\n\\u2611\\ufe0f di sollevamento pesi;\\n\\nOgni giorno gli esercizi sono diversi e implicano l\\u2019impiego della maggior parte dei muscoli del nostro corpo,\\nmuscoli che non useremmo mai nelle normali attivit\\u00e0 fitness, parola di Coach.\\n\\nIl CrossFit \\u00e8 davvero adatto a tutti,\\n\\n\\u2705 a chi vuole scolpire il proprio corpo,\\n\\u2705 ma anche a chi desidera dimagrire.\\n\\nVieni a fare la tua prova gratuita quando vuoi, in questi orari:\\n\\n\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2617\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2617\\/featured_images\\/43588764_2199008747038613_2240249731798269952_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2617\\/featured_images\\/49676495_2257771661162321_7037656015914926080_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2617\\/featured_images\\/51493009_2277584879180999_3751537371938553856_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2617\\/featured_images\\/51818565_2277586335847520_476324873992404992_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2617\\/featured_images\\/51964370_2286984481574372_3696094545352589312_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2617\\/featured_images\\/52602161_2286982614907892_1826316056713494528_o.jpg\"],\"address\":{\"street\":\"Via Milano, 6\\/2\",\"town\":\"Milano\",\"postal_code\":\"20068\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.4273871,\