bapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/76251906\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Grande Rue, 11\",\"town\":\"Corcelles-Ferri\\u00e8res\",\"postal_code\":\"25410\",\"country\":\"France\"},\"location\":{\"latitude\":47.2298164,\"longitude\":5.8060104},\"contact_info\":{\"email\":\"crossfitsandglass@nubapp-clients.com\",\"phone\":\"0683366469\"},\"social_media\":{\"instagram\":\"crossfitsandglass\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2899\",\"name\":\"Crossfit Veintiocho grados norte\",\"description\":\"Localizado en la Isla de Fuerteventura en las Islas Canarias, est\\u00e1 situado a 5 minutos del Aeropuerto y a 10 de la Capital (Puerto del Rosario). Veintiocho Grados Norte es un lugar ideal para practicar CrossFit ya que cuenta con unas amplias instalaciones y equipamiento de la marca Rogue Fitness.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2899\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2899\\/featured_images\\/23847475_133824077272545_3821093290331382606_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2899\\/featured_images\\/24130210_133824043939215_2738133213468108142_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2899\\/featured_images\\/38828068_225869931401292_3028287994806140928_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2899\\/featured_images\\/46503615_265832404071711_6090163230867456000_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2899\\/featured_images\\/47396475_270500333604918_7880487100863217664_o.jpg\"],\"address\":{\"street\":\"C\\/ El Diviso S\\/N Nave 1-2\",\"town\":\"Antigua\",\"postal_code\":\"35610\",\"country\":\"Spain\"},\"location\":{\"latitude\":28.4203445,\"longitude\":-13.8632002},\"contact_info\":{\"email\":\"veintiochogradosnorte@gmail.com\",\"phone\":\"644301905\"},\"social_media\":{\"instagram\":\"CrossFitVeintiochoGradosNorte\",\"facebook\":\"@crossfitveintiochogradosnorte\"}},{\"id_application\":\"88557426\",\"id_lead\":null,\"name\":\"Fitness Body Training\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/88557426\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/88557426\\/featured_images\\/Fitness%20Body%20Training%20foto%20Resasocial.jpg\"],\"address\":{\"street\":\"Malakoff\",\"town\":\"Plaintel\",\"postal_code\":\"22940\",\"country\":\"France\"},\"location\":{\"latitude\":48.40794,\"longitude\":-2.817707},\"contact_info\":{\"email\":\"no-reply@nubapp-clients.com\",\"phone\":\"+33 6 22 99 17 48\"},\"social_media\":{\"instagram\":\"fitnessbodytraining_\",\"facebook\":\"https:\\/\\/fr-fr.facebook.com\\/NicolasMorinCoaching\\/?ref=page_internal\"}},{\"id_application\":null,\"id_lead\":\"2585\",\"name\":\"Officine Mandrione CrossFit\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2585\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2585\\/featured_images\\/12304469_537685513064934_4432731249563696345_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2585\\/featured_images\\/12802940_573810362785782_3090425530824067740_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2585\\/featured_images\\/22552362_872747166225432_9034731035442007337_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2585\\/featured_images\\/25487232_902305513269597_19292575669278653_o.jpg\"],\"address\":{\"street\":\"Via del Mandrione, 105,\",\"town\":\"Roma\",\"postal_code\":\"00181\",\"country\":\"Italia\"},\"location\":{\"latitude\":41.8790612,\"longitude\":12.5343882},\"contact_info\":{\"email\":\"officinemandrionecrossfit@gmail.com\",\"phone\":\"+39 340 125 5371\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/Officine-Mandrione-518926731607479\\/\"}},{\"id_application\":null,\"id_lead\":\"2708\",\"name\":\"Crossfit Convensstra\\u00dfe\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2708\\/featured_images\\/gym_pictures35.png\"],\"address\":{\"street\":\"Convent Strasse 8-10\",\"town\":\"Hamburg\",\"postal_code\":\"22089\",\"country\":\"Germany\"},\"location\":{\"latitude\":53.5641365,\"longitude\":10.0342427},\"contact_info\":{\"email\":\"\",\"phone\":\"\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2853\",\"name\":\"Crossfit Jaen\",\"description\":\"CrossFit Ja\\u00e9n est\\u00e1 formado por un grupo de entrenadores que aman el deporte y que, esto es imprescindible, disfrutan entrenando a otras personas. Queremos destacar la palabra \\u201cpersonas\\u201d, y es que nuestro principal objetivo es la mejora del nivel de condici\\u00f3n f\\u00edsica de todos los que se acercan por el box y, de esta manera, mejorar su calidad de vida. Nosotros no pretendemos que todos los que crucen la puerta sean competidores de CrossFit, NO, aunque tampoco vamos a ser nosotros los que os pongamos l\\u00edmites porque no los ten\\u00e9is.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2853\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2853\\/featured_images\\/IMG_5731-1000x907.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2853\\/featured_images\\/IMG_5945-1000x750.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2853\\/featured_images\\/esto-es-crossfit.jpg\"],\"address\":{\"street\":\"Pol. Los Olivares. Calle Iznatoraf, n\\u00ba2\",\"town\":\"Ja\\u00e9n\",\"postal_code\":\"23009\",\"country\":\"Spain\"},\"location\":{\"latitude\":37.803522,\"longitude\":-3.7832693},\"contact_info\":{\"email\":\"crossfitjaen@gmail.com\",\"phone\":\"667951077\"},\"social_media\":{\"instagram\":\"crossfit_jaen\",\"facebook\":\"@crossfitjaen\"}},{\"id_application\":null,\"id_lead\":\"2766\",\"name\":\"Crossfit Ansbach\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2766\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2766\\/featured_images\\/B_Wlowerfinal%20%283%20von%2036%29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2766\\/featured_images\\/Crossfit%20Website%20%2840%20von%2027%29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2766\\/featured_images\\/Crossfit%20Website%20%2848%20von%2027%29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2766\\/featured_images\\/Crossfit%20Website%20%2861%20von%2027%29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2766\\/featured_images\\/crossfit-about-03.jpg\"],\"address\":{\"street\":\"Franz-Brombach-Str. 11-13\",\"town\":\"Erding\",\"postal_code\":\"85435\",\"country\":\"Germany\"},\"location\":{\"latitude\":48.31275,\"longitude\":11.8883913},\"contact_info\":{\"email\":\"info@crossfitansbach.com\",\"phone\":\"+49 15156676198\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitansbach\"}},{\"id_application\":null,\"id_lead\":\"2988\",\"name\":\"Crossfit Alicante\",\"description\":\"icen que la uni\\u00f3n hace la fuerza. Y nosotros estamos seguros que as\\u00ed es. Sabemos que los mayores progresos f\\u00edsicos surgen de la mejor programaci\\u00f3n y planificaci\\u00f3n. Sabemos que la clave del fitness es la variedad en los ejercicios y est\\u00edmulos. Sabemos que para sentirte en forma debes ser capaz de superar cualquier obst\\u00e1culo f\\u00edsico o psicol\\u00f3gico en la vida real y que la mejor forma de conseguirlo es mediante un entrenamiento lo m\\u00e1s funcional posible.\\nara que por fin todo el mundo pueda acceder a este entrenamiento Alma Fitness Club y CrossFit ALC se han unido para crear CrossFit Alicante. La uni\\u00f3n hace la fuerza y la experiencia y recorrido en el mundo del fitness de Alma Fitness Club se unen a la eficacia y planificaci\\u00f3n del entrenamiento de CrossFit Alc. Esto nos hace diferentes. Y queremos que todo el mundo tenga cabida en este programa de entrenamiento que cambiar\\u00e1 tu vida y tu f\\u00edsico para siempre.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2988\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2988\\/featured_images\\/23213113_998303540309758_5086664023668959174_o.jpg\"],\"address\":{\"street\":\"Actor Arturo Lled\\u00f3 3\",\"town\":\"Alicante\",\"postal_code\":\"03008\",\"country\":\"Spain\"},\"location\":{\"latitude\":38.3363967,\"longitude\":-0.5110372},\"contact_info\":{\"email\":\"info@crossfitalicante.com\",\"phone\":\"637618793\"},\"social_media\":{\"instagram\":\"crossfitalicante\",\"facebook\":\"@crossfitalicante\"}},{\"id_application\":null,\"id_lead\":\"3076\",\"name\":\"Shaka Crossfit\",\"description\":\"En Shaka CrossFit creemos en la unidad que trae el deporte, y estamos convencidos de que\\neste deporte no se basa en la competitividad, si no en el compa\\u00f1erismo. No nos interesa que\\nhagas mejores marcas que tus compa\\u00f1eros. Queremos que tu meta sea siempre superarte a ti\\nmismo. Por eso, nuestros programas de entrenamiento te ofrecen un seguimiento f\\u00e1cil de tus\\nmejoras, para que siempre est\\u00e9s motivado con tus propios logros. Y no te preocupes, porque\\nnosotros no medimos la cantidad de peso que puedes levantar, si no el esfuerzo que te supone\\npasar de un nivel a otro. Nada nos har\\u00e1 m\\u00e1s feliz que ver como mejoras d\\u00eda tras d\\u00eda, porque\\neso es lo que hace la familia: enorgullecerse de todos sus miembros.\\nPara que puedas convertirte en el gran atleta que sabemos que eres, hemos preparado unas\\ninstalaciones donde desarrollar y mejorar tus habilidades. Tenemos murales dise\\u00f1ados en\\nexclusiva para nosotros del artista PORRONCIO (@porroncio) llenos de color y energ\\u00eda.\\nCuando entres a Shaka CrossFit te encontrar\\u00e1s 200mts2 con las mejor equipaci\\u00f3n: Racks,\\nbalones medicinales, kettlebells, mancuernas\\u2026 todo completamente nuevo y con nuestro\\ncompromiso de que siempre estar\\u00e1 cuidado y listo para su uso. T\\u00fa solo tienes que venir a\\nShaka Crossfit con ilusi\\u00f3n y ganas, y nosotros te ofrecemos todo lo dem\\u00e1s.\\nAdem\\u00e1s, disponemos de una zona de Chill donde podr\\u00e1s quedarte a charlar con tus\\ncompa\\u00f1eros, relajarte, comer, trabajar\\u2026 \\u00a1Como si quieres echarte una cabezada! Para\\nnosotros es esencial que te sientas como en casa.\\nSomos conscientes de que ten\\u00e9is un trabajo y una vida, y como queremos que vengas a\\nentrenar con ganas, vamos a activarte de todas las maneras posibles: entrenamientos\\nespeciales, concursos, actividades fuera del box, y muchas m\\u00e1s sorpresas para motivarte.\\nPuede que vengas solo para hacer CrossFit, pero te aseguramos que vamos a darte mucho m\\u00e1s\\nque un box donde practicar CrossFit en Madrid.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3076\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3076\\/featured_images\\/57073692_651027358682891_6976253776176873472_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3076\\/featured_images\\/57297698_651027422016218_4853392424065564672_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3076\\/featured_images\\/57308925_651027335349560_3002812735592333312_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3076\\/featured_images\\/57611774_651027242016236_5636357149580853248_o.jpg\"],\"address\":{\"street\":\"Paseo de los Melanc\\u00f3licos, 11\",\"town\":\"Madrid\",\"postal_code\":\"28005\",\"country\":\"Spain\"},\"location\":{\"latitude\":40.4091421,\"longitude\":-3.7208487},\"contact_info\":{\"email\":\"shakacrossfit@gmail.com\",\"phone\":\"675967155\"},\"social_media\":{\"instagram\":\"shakacrossfit\",\"facebook\":\"@Shaka-CrossFit-647116165740677\"}},{\"id_application\":null,\"id_lead\":\"2871\",\"name\":\"Crossfit Edelweiss\",\"description\":\"No somos un gimnasio tradicional. CrossFit Edelweiss es el primer y \\u00fanico Box oficial de CrossFit de Sabadell. Los 8 metros de altura del box y su espacio totalmente di\\u00e1fano, permiten realizar la ilimitada variedad de ejercicios del mundo del CrossFit. El equipo de CrossFit Edelweiss aporta su experiencia y pasi\\u00f3n para que tu nuevo entrenamiento sea un \\u00e9xito y alcances tus metas.\\n\\nDisponemos de zonas amplias de aparcamiento y de f\\u00e1cil acceso ya sea en coche (salida Sabadell Sud y Sabadell Centro), tren (Renfe: Sabadell Sud, Ferrocarrils Catalans: Sabadell Estaci\\u00f3) a dos minutos a pie.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2871\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2871\\/featured_images\\/box-crossfit.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2871\\/featured_images\\/dsc-0025.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2871\\/featured_images\\/dsc-0177.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2871\\/featured_images\\/trineos.jpg\"],\"address\":{\"street\":\"Raim\\u00f3n Caselles, n\\u00ba 1-3\",\"town\":\"Sabadell\",\"postal_code\":\"08205\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.5360004,\"longitude\":2.0984947},\"contact_info\":{\"email\":\"info@crossfitedelweiss.com\",\"phone\":\"931704302\"},\"social_media\":{\"instagram\":\"crossfitedelweiss\",\"facebook\":\"@crossfitedelweiss\"}},{\"id_application\":null,\"id_lead\":\"3072\",\"name\":\"Crossfit Gand\\u00eda\",\"description\":\"El Box es como se llama al lugar donde entrenamos, pero no es solo eso, es un sitio para divertirse, compartir esfuerzo y conocer gente que comparte tu pasi\\u00f3n.\\n\\nLas clases las hacemos todos juntos y se adaptan a tu nivel con plazas limitadas y un coach siempre pendiente de ti.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3072\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3072\\/featured_images\\/54729866_629689324147951_4573105173315977216_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3072\\/featured_images\\/55443372_629689694147914_7398544212079149056_o.jpg\"],\"address\":{\"street\":\"Avenida Alicante 74\",\"town\":\"Gand\\u00eda\",\"postal_code\":\"46701\",\"country\":\"Spain\"},\"location\":{\"latitude\":38.9590545,\"longitude\":-0.187235},\"contact_info\":{\"email\":\"crossfitgandia@hotmail.com\",\"phone\":\"627 218 282\"},\"social_media\":{\"instagram\":\"crossfit_gandia\",\"facebook\":\"@CrossFit-Gand\\u00eda-571611003289117\\/\"}},{\"id_application\":null,\"id_lead\":\"2965\",\"name\":\"Crossfit Burgdorf\",\"description\":\"Tanto si eres crossfiter@ como si te quieres iniciar, te invitamos a un aut\\u00e9ntico box de crossfit en San Javier (Murcia).\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2965\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2965\\/featured_images\\/Bildschirmfoto%202019-05-31%20um%2010.18.44.png\"],\"address\":{\"street\":\"Sierra de la Muela s\\/n\",\"town\":\"San Javier\",\"postal_code\":\"30730\",\"country\":\"Murcia\"},\"location\":{\"latitude\":37.809444,\"longitude\":-0.8451557},\"contact_info\":{\"email\":\"info@crossfitkalunga.com\",\"phone\":\"626155728\"},\"social_media\":{\"instagram\":\"crossfitkalunga\",\"facebook\":\"@CrossFit-Kalunga-216932958688528\"}},{\"id_application\":null,\"id_lead\":\"2732\",\"name\":\"Crossfit four Hoursmen\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2732\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2732\\/featured_images\\/Bildschirmfoto%202019-04-26%20um%2011.45.07.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2732\\/featured_images\\/thumbs_CrossFit-Four-Horsemen-Box-Bild1.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2732\\/featured_images\\/thumbs_CrossFit-Four-Horsemen-Box-Bild2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2732\\/featured_images\\/thumbs_CrossFit-Four-Horsemen-Box-Bild4.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2732\\/featured_images\\/thumbs_CrossFit-Four-Horsemen-Box-Bild5.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2732\\/featured_images\\/thumbs_CrossFit-Four-Horsemen-Box-Bild7.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2732\\/featured_images\\/thumbs_CrossFit-Four-Horsemen-Box-Bild9.jpg\"],\"address\":{\"street\":\"Tr\\u00e4nkestra\\u00dfe 13\",\"town\":\"Deutschland\",\"postal_code\":\"70597\",\"country\":\"Stuttgart\"},\"location\":{\"latitude\":48.7363459,\"longitude\":9.1646122},\"contact_info\":{\"email\":\"mail@crossfitfourhorsemen.de\",\"phone\":\"\"},\"social_media\":{\"instagram\":\"crossfit_711\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfit711\"}},{\"id_application\":null,\"id_lead\":\"3058\",\"name\":\"Crossfit Central Wiesabaden\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3058\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3058\\/featured_images\\/cache_2485184592.jpg\"],\"address\":{\"street\":\"Wallufer Strasse 1\",\"town\":\"Wiesbaden\",\"postal_code\":\"65197\",\"country\":\"Germany\"},\"location\":{\"latitude\":50.0750668,\"longitude\":8.2278166},\"contact_info\":{\"email\":\"marco@crossfitcentralwiesbaden.com\",\"phone\":\"+49 15786211975\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":\"86193898\",\"id_lead\":null,\"name\":\"Lev-Athletics-Box\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/86193898\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Ernst-Bloch-Stra\\u00dfe, 19\",\"town\":\"Leverkusen\",\"postal_code\":\"51377\",\"country\":\"Deutschland\"},\"location\":{\"latitude\":51.0570576,\"longitude\":7.0604761},\"contact_info\":{\"email\":\"lab@nubapp-clients.com\",\"phone\":\"+49 152 53253955\"},\"social_media\":{\"instagram\":\"https:\\/\\/www.instagram.com\\/levathleticsbox\\/\",\"facebook\":\"www.facebook.com\\/levathleticsbox\"}},{\"id_application\":\"31179737\",\"id_lead\":null,\"name\":\"Community Fitness Sarajevo\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/31179737\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/31179737\\/featured_images\\/Screenshot%20Sarajevo%20App.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/31179737\\/featured_images\\/Screenshot%20Sarajevo%20App1.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/31179737\\/featured_images\\/Screenshot%20Sarajevo%20App2.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/31179737\\/featured_images\\/Screenshot%20Sarajevo%20App3.png\"],\"address\":{\"street\":\"Patriotske lige 35\",\"town\":\"Sarajevo\",\"postal_code\":\"71000\",\"country\":\"Bosnia and Herzegovina\"},\"location\":{\"latitude\":43.8743564,\"longitude\":18.4119428},\"contact_info\":{\"email\":\"info@crossfitsarajevo.com\",\"phone\":\"+387 61 691 483\"},\"social_media\":{\"instagram\":\"crossfitsarajevo\",\"facebook\":\"\"}},{\"id_application\":\"21351483\",\"id_lead\":null,\"name\":\"CrossFit Reveal\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/21351483\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/21351483\\/featured_images\\/40352550_675288639507779_9085950203122417664_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/21351483\\/featured_images\\/40407491_675288446174465_1052731432398487552_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/21351483\\/featured_images\\/40424772_675288679507775_1274537089890779136_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/21351483\\/featured_images\\/56391607_794997944203514_2327917607811809280_o.jpg\"],\"address\":{\"street\":\"Rue Maurice Hallbwachs\",\"town\":\"Reims\",\"postal_code\":\"51100\",\"country\":\"France\"},\"location\":{\"latitude\":49.2702776,\"longitude\":4.0022022},\"contact_info\":{\"email\":\"contact@crossfitreveal.fr\",\"phone\":\"0788696044\"},\"social_media\":{\"instagram\":\"crossfitreveal\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitReveal\"}},{\"id_application\":null,\"id_lead\":\"2650\",\"name\":\"MAS CrossFit\",\"description\":\"MAS CrossFit Brescia\\nParlare di CrossFit significa parlare di una disciplina costituita da un\\u2019ampia gamma di movimenti e che offre una visione a 360\\u00b0 di tutte le capacit\\u00e0 fisiche generali che l\\u2019uomo pu\\u00f2 sviluppare durante l\\u2019esercizio fisico. Se svolto correttamente chiunque pu\\u00f2 trarne dei grandi benefici indipendentemente dall\\u2019et\\u00e0, dal genere e dallo stato di salute. Il movimento \\u00e8 una funzione organica indispensabile per la crescita e l\\u2019evoluzione dell\\u2019uomo. Mantenere la pratica abituale di questa funzione ritarda il processo involutivo d\\u2019invecchiamento al quale siamo tutti destinati. CrossFit utilizza quelle forme di movimento per cui l\\u2019uomo \\u00e8 concepito strutturalmente e fisiologicamente e che rispecchiano quindi le esigenze tipiche della vita quotidiana. Il nostro obiettivo \\u00e8 quello di aiutare questa macchina perfetta a rimanere il pi\\u00f9 efficienti e funzionale possibile nel tempo.\\nLa Filosofia del BOX\\nIl nome \\u201cMAS\\u201d si riferisce alle lettere iniziali della frase latina \\u201cMemento audere semper\\u201d. La locuzione significa \\u201cRicorda di osare sempre\\u201d ed \\u00e8 proprio la filosofia che caratterizza questo box. Senza mai osare, non puoi sperare di ricevere niente di ci\\u00f2 che ardentemente desideri. Se hai un obiettivo la nostra sfida \\u00e8 quella di aiutarti a raggiungerlo in modo corretto, sicuro e piacevole cercando di trasmetterti questa passione che da anni ormai per noi \\u00e8 diventata uno stile di vita.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2650\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2650\\/featured_images\\/52830880_2245741605488860_27187404976685056_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2650\\/featured_images\\/52895312_2245741035488917_2648976699634483200_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2650\\/featured_images\\/53317886_2245742382155449_1848393026133557248_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2650\\/featured_images\\/53395696_2245737888822565_3998340980339113984_o.jpg\"],\"address\":{\"street\":\"Via Dalmazia, 15\",\"town\":\"Brescia\",\"postal_code\":\"25126\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.5345868,\"longitude\":10.2036091},\"contact_info\":{\"email\":\"info@mascrossfit.it\",\"phone\":\"+39 030 535 7586\"},\"social_media\":{\"instagram\":\"mas_crossfit_brescia\",\"facebook\":\"https:\\/\\/www.facebook.com\\/MASCrossFit\\/\"}},{\"id_application\":null,\"id_lead\":\"2816\",\"name\":\"Crossfit Virus\",\"description\":\"El box oficial de CrossFit mas grande y equipado de la provincia de Almer\\u00eda. 100% equipamiento Rogue.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2816\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2816\\/featured_images\\/descarga%20%282%29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2816\\/featured_images\\/descarga-1%20%281%29.jpg\"],\"address\":{\"street\":\"Sierra de la Controversia. 9\",\"town\":\"Viator\",\"postal_code\":\"04240\",\"country\":\"Spain\"},\"location\":{\"latitude\":36.8829364,\"longitude\":-2.422565},\"contact_info\":{\"email\":\"info@crossfitvirus.es\",\"phone\":\"675144418\"},\"social_media\":{\"instagram\":\"crossfit_virus\",\"facebook\":\"@CrossFitVirus\"}},{\"id_application\":\"94398359\",\"id_lead\":null,\"name\":\"Crossfit Ambiorix\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/94398359\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/94398359\\/featured_images\\/box1.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/94398359\\/featured_images\\/box2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/94398359\\/featured_images\\/box3.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/94398359\\/featured_images\\/box4.jpg\"],\"address\":{\"street\":\"Rue Princesse Astrid 23\",\"town\":\"Ath\",\"postal_code\":\"7804\",\"country\":\"Belgium\"},\"location\":{\"latitude\":50.6608514,\"longitude\":3.7933758},\"contact_info\":{\"email\":\"info@crossfitambiorix.be\",\"phone\":\"0498476746\"},\"social_media\":{\"instagram\":\"crossfitambiorix\",\"facebook\":\"CrossFitAmbiorix\"}},{\"id_application\":nul