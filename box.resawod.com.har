ook\":\"https:\\/\\/www.facebook.com\\/H2OCrossFit\\/\"}},{\"id_application\":\"42552637\",\"id_lead\":null,\"name\":\"The Pit Malta\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/42552637\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/42552637\\/featured_images\\/Captura.JPG\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/42552637\\/featured_images\\/Captura1.JPG\"],\"address\":{\"street\":\"The Pit Victor Tedesco Stadium  Mile end Road\",\"town\":\"Hamrun\",\"postal_code\":\"\",\"country\":\"Malta\"},\"location\":{\"latitude\":35.8870251,\"longitude\":14.493402},\"contact_info\":{\"email\":\"contact@pitmalta.com\",\"phone\":\"35699048514\"},\"social_media\":{\"instagram\":\"thepitmalta\",\"facebook\":\"thepitmalta\"}},{\"id_application\":null,\"id_lead\":\"2960\",\"name\":\"Stadium Venecia\",\"description\":\"El CrossFit es una t\\u00e9cnica de entrenamiento que encadena movimientos de diferentes disciplinas al mismo tiempo, tales como la halterofilia, el entrenamiento metab\\u00f3lico o el gimn\\u00e1stico.\\nLa meta es desarrollar las capacidades y habilidades humanas: resistencia cardiovascular y respiratoria, resistencia muscular, fuerza, flexibilidad, potencia, velocidad, agilidad, coordinaci\\u00f3n , equilibrio y precisi\\u00f3n.\\nExponiendo a la persona a tantos escenarios y combinaciones de movimientos como sea posible se logra una adaptaci\\u00f3n que la prepara para lo desconocido y lo poco probable.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2960\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2960\\/featured_images\\/18673217_209841506191405_6713383229138525165_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2960\\/featured_images\\/18739249_211385346037021_6551802656542883061_o.jpg\"],\"address\":{\"street\":\"Fray Juli\\u00e1n Garc\\u00e9s, 100\",\"town\":\"Zaragoza\",\"postal_code\":\"50007\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.6252514,\"longitude\":-0.8934438},\"contact_info\":{\"email\":\"crossfit@stadiumvenecia.com\",\"phone\":\"976384000\"},\"social_media\":{\"instagram\":\"crossfitvenecia\",\"facebook\":\"@crossfitvenecia\"}},{\"id_application\":null,\"id_lead\":\"2938\",\"name\":\"Crossfit 37\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2938\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2938\\/featured_images\\/cf37_collage.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2938\\/featured_images\\/stronger_with_a_coach.png\"],\"address\":{\"street\":\"Eversburger Str. 38\",\"town\":\"Osnabr\\u00fcck\",\"postal_code\":\"49090\",\"country\":\"Germany\"},\"location\":{\"latitude\":52.3022894,\"longitude\":8.0038642},\"contact_info\":{\"email\":\"info@crossfit37.de\",\"phone\":\"+49 15229746292\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":\"61782147\",\"id_lead\":null,\"name\":\"CrossFit Gerland\",\"description\":\"Situ\\u00e9 en plein c\\u0153ur du 7\\u00e8me arrondissement de Lyon, \\u00e0 quelques pas de la place Jean Jaur\\u00e8s, CrossFit Gerland vous accueille dans sa nouvelle box rue Croix Barret.\\n\\nNotre mission est de vous offrir le meilleur des coaching dans des conditions optimales d\\u2019entra\\u00eenement, encadr\\u00e9s par nos coachs exp\\u00e9riment\\u00e9s et certifi\\u00e9s Level 1.\\n\\nAVEC 1000 M2 DE SUPERFICIE, UNE CHARPENTE APPARENTE ET UN D\\u00c9COR BRUT, CROSSFIT GERLAND VOUS PERMET DE PRATIQUER LE CROSSFIT DANS UN ENDROIT UNIQUE.\\n\\nProfitez de 4 aires d\\u2019entra\\u00eenements, d\\u2019une zone de r\\u00e9cup\\u00e9ration et de d\\u00e9tente. Tout est mis en oeuvre pour que chacun d\\u2019entre vous puisse progresser dans la discipline.\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/61782147\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/61782147\\/featured_images\\/image%20cf%20gerland.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/61782147\\/featured_images\\/image%20cf%20gerland2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/61782147\\/featured_images\\/image%20cf%20gerland3.jpg\"],\"address\":{\"street\":\"Croix Barret\",\"town\":\"Lyon\",\"postal_code\":\"69007\",\"country\":\"France\"},\"location\":{\"latitude\":45.7362986,\"longitude\":4.8416518},\"contact_info\":{\"email\":\"contact@crossfitgerland.com\",\"phone\":\"(+33) 07 84 93 29 13\"},\"social_media\":{\"instagram\":\"crossfitgerland\",\"facebook\":\"crossfitgerland\"}},{\"id_application\":null,\"id_lead\":\"2863\",\"name\":\"Crossfit LCS\",\"description\":\"En Crossfit Les Corts tenemos los mejores entrenadores, clases variadas y equipo nuevo! Ofrecemos no solo WODs, pero tambi\\u00e9n clases de halterofilia, mobility, powerlifting y gymnastics!\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2863\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2863\\/featured_images\\/13241254_1073357186057955_4905963569790550713_n-848x447.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2863\\/featured_images\\/IMG_2104%202.JPG\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2863\\/featured_images\\/crossfit-lcs-principal-1024x683.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2863\\/featured_images\\/zentauroepp37424395-barcelona-2017-barcelona-deportistas-inviden170226153748-1488120043969.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2863\\/featured_images\\/zentauroepp37424756-barcelona-2017-barcelona-deportistas-inviden1702261538