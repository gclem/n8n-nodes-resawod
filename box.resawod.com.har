,\"social_media\":{\"instagram\":\"crossfitdole\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitdole\"}},{\"id_application\":null,\"id_lead\":\"3170\",\"name\":\"Crossfit Barebel Bros\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3170\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3170\\/featured_images\\/Bildschirmfoto%202019-07-02%20um%2012.17.28.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3170\\/featured_images\\/Bildschirmfoto%202019-07-02%20um%2012.28.45.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3170\\/featured_images\\/CrossFit-3-1030x686.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3170\\/featured_images\\/CrossFit1-1030x686.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3170\\/featured_images\\/CrossFit2-1030x686.jpg\"],\"address\":{\"street\":\"43\",\"town\":\"Pleidelsheimer Stra\\u00dfe\",\"postal_code\":\"74321\",\"country\":\"Bietigheim-Bissingen\"},\"location\":{\"latitude\":49.7175974,\"longitude\":11.9137099},\"contact_info\":{\"email\":\"info@crossfitbarbellbros.com\",\"phone\":\"+49 17642060939\"},\"social_media\":{\"instagram\":\"crossfit_barbell_bros\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitbarbellbros\"}},{\"id_application\":null,\"id_lead\":\"2615\",\"name\":\"CrossFit Navigli\",\"description\":\"Il CrossFit \\u00e8 oramai riconosciuto come la pi\\u00f9 grande rivoluzione del Fitness moderno. qui troverai l\\u2019antitesi di quello che esiste nelle grandi palestre di fitness e la loro visione di allenamento.\\n\\nQuesto posto \\u00e8 dedicato a chi cerca un allenamento dove il concetto di forma fisica si esprime a livelli molto superiori rispetto agli standard convenzionali del fitness moderno, a chi vuole abbandonare le solite noiose routine di allenamento, a chi con determinazione vuole essere fautore del proprio cambiamento, diventando pi\\u00f9 forte mentalmente e fisicamente.\\n\\nLa nostra scelta \\u00e8 stata dedicare questo spazio ad un numero limitato di persone, focalizzandoci sulla personalizzazione degli allenamenti e sulla massima cura tecnica dei movimenti, un posto dove l\\u2019Individuo, lo studio dei suoi punti di forza e quelli di debolezza rimangono sempre in primo piano.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2615\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2615\\/featured_images\\/10255204_446936888786445_8131227006506755127_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2615\\/featured_images\\/1063852_295459373934198_1028472193_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2615\\/featured_images\\/10734256_567720773374722_7350244147839153398_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2615\\/featured_images\\/10931458_618285551651577_3238268782971026469_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2615\\/featured_images\\/28616510_1352362911577167_8784326629909116516_o.jpg\"],\"address\":{\"street\":\"Ripa di Porta Ticinese, 75\",\"town\":\"Milano\",\"postal_code\":\"20143\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.4501541,\"longitude\":9.1684804},\"contact_info\":{\"email\":\"info@crossfitnavigli.com\",\"phone\":\"+39 348 121 1373\"},\"social_media\":{\"instagram\":\"crossfitnavigli\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitNavigli\\/\"}},{\"id_application\":\"27105444\",\"id_lead\":null,\"name\":\"CrossFit Des Sacres \",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/27105444\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"27 Rue du commerce\",\"town\":\"Cormontreuil\",\"postal_code\":\"51350\",\"country\":\"France\"},\"location\":{\"latitude\":49.2225361,\"longitude\":4.0505847},\"contact_info\":{\"email\":\"contact@crossfit-des-sacres.com\",\"phone\":\"0351423106\"},\"social_media\":{\"instagram\":\"crossfitdessacres\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2577\",\"name\":\"CrossFit Minus\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2577\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2577\\/featured_images\\/40301226_238417803534687_8037643768154816512_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2577\\/featured_images\\/44099520_252070845502716_1393513254562562048_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2577\\/featured_images\\/44112798_252070985502702_3674105682891636736_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2577\\/featured_images\\/44159784_252065062169961_6374996554176004096_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2577\\/featured_images\\/47575471_272561416786992_1076659163355938816_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2577\\/featured_images\\/51092619_292433274799806_5700102598921551872_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2577\\/featured_images\\/51960815_296125724430561_1014866133133557760_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2577\\/featured_images\\/52384655_297765680933232_6859908914629050368_o.jpg\"],\"address\":{\"street\":\"Via di Affogalasino, 34\",\"town\":\"Roma\",\"postal_code\":\"00148\",\"country\":\"Italia\"},\"location\":{\"latitude\":41.8629325,\"longitude\":12.433244},\"contact_info\":{\"email\":\"asdblacksamba@gmail.com\",\"phone\":\"+39 393 567 8379\"},\"social_media\":{\"instagram\":\"crossfit_minus\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitMinus\\/\"}},{\"id_application\":null,\"id_lead\":\"3075\",\"name\":\"Crossfit Horta\",\"description\":\"Es una empresa innovadora que nace de la fusi\\u00f3n del CrossFit, los servicios de rehabilitaci\\u00f3n y readaptaci\\u00f3n, la medicina china y la acupuntura est\\u00e9tica.\\n\\nSomos entusiastas y apasionados que vivimos en un mundo en constante evoluci\\u00f3n y eso hace que siempre queramos estar actualizados para poder ofrecer los mejores servicios.\\n\\nOfreceremos un estudio de salud personalizado y nos enfocamos en un servicio m\\u00e1s exclusivo donde entrenar\\u00e1n un m\\u00e1ximo de 12 clientes a en la misma clase.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3075\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3075\\/featured_images\\/56790921_414115626069226_5282500222902075392_n.jpg\"],\"address\":{\"street\":\"Carrer de Dante Alighieri, 6\",\"town\":\"Barcelona\",\"postal_code\":\"08032\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.4291072,\"longitude\":2.1597275},\"contact_info\":{\"email\":\"info@messaluthorta.com\",\"phone\":\"691 93 94 35\"},\"social_media\":{\"instagram\":\"crossfithorta\",\"facebook\":\"@crossfithorta\"}},{\"id_application\":\"94308071\",\"id_lead\":null,\"name\":\"HX TRAINING\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/94308071\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/94308071\\/featured_images\\/33734201_2056609547946595_3192978026144989184_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/94308071\\/featured_images\\/34268622_2060660507541499_9129537919244042240_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/94308071\\/featured_images\\/34268897_2060660440874839_6956314506469310464_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/94308071\\/featured_images\\/34306508_2060660380874845_5446363232518275072_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/94308071\\/featured_images\\/34365159_2060660437541506_8270909162897014784_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/94308071\\/featured_images\\/34394508_2060660534208163_3328062895157149696_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/94308071\\/featured_images\\/34411835_2060660484208168_2678074939856125952_n.jpg\"],\"address\":{\"street\":\"route de laghet\",\"town\":\"la trinite\",\"postal_code\":\"06340\",\"country\":\"France\"},\"location\":{\"latitude\":43.7480444,\"longitude\":7.3337134},\"contact_info\":{\"email\":\"contact@hxtraining.fr\",\"phone\":\"09 81 86 35 37\"},\"social_media\":{\"instagram\":\"crossfith3_h4training\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfith3\"}},{\"id_application\":null,\"id_lead\":\"2633\",\"name\":\"Crossfit Pavia\",\"description\":\"Crediamo nel nostro lavoro e nel significato di esclusivit\\u00e0!\\n\\nUn\\u2019equipe di professionisti specializzati nella preparazione fisico-atletica nel 2012 ha dato vita al primo BOX affiliato CrossFit\\u00ae di tutta la provincia pavese per aiutare gli appassionati dello sport a migliorare la propria condizione fisica e mentale.\\nIl box CrossFit Pavia soddisfa una vasta serie di necessit\\u00e0, offrendo orari flessibili e numerose classi ogni giorno, dalla mattina alla sera, dove la ricerca e lo sviluppo dei servizi \\u00e8 in continuo movimento.\\nLa professionalit\\u00e0 dello staff e la qualit\\u00e0 specifica delle attrezzature, mirate per soddisfare le esigenze di tutti, rappresentano il punto di partenza per intraprendere programmi di lavoro seri e personalizzati, al fine di raggiungere i tuoi obbiettivi.\\n\\nTi apettano:\\n\\nServizio a 360\\u00b0\\nForte community\\nVasta gamma di orari delle lezioni\\nAll inclusive (frequenza libera di tutti i corsi)\\nMigliori attrezzature sul mercato\\nVantaggi per studenti UNIVERSITARI e FDO\\nFacilmente raggiungibile in auto o con i mezzi pubblici\\nGrande disponibilit\\u00e0 di parcheggi gratuiti\\nFree WI-FI\\n\\u2026e molto altro!\\nIl box \\u00e8 dotato di un defibrillatore. Tutto lo staff di CrossFit Pavia \\u00e8 stato formato all\\u2019utilizzo, con tanto di certificato IRC (Italian Resuscitation Council), per garantirvi un allenamento sereno, in tutta sicurezza.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2633\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2633\\/featured_images\\/12670613_808172862627574_7173219613256068344_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2633\\/featured_images\\/12687915_802516106526583_3011334976458818008_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2633\\/featured_images\\/21272428_1266907723420750_8157516035165546173_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2633\\/featured_images\\/24174196_1341420929302762_8632843729378333060_n.jpg\"],\"address\":{\"street\":\"Via Vigentina 11\\/C\",\"town\":\"Pavia\",\"postal_code\":\"27100\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.1996061,\"longitude\":9.1693424},\"contact_info\":{\"email\":\"info@crosstrainingstudio.it\",\"phone\":\"+39 0382560170\"},\"social_media\":{\"instagram\":\"crossfitpavia\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitpavia\\/\"}},{\"id_application\":null,\"id_lead\":\"2773\",\"name\":\"Crossfit 27\",\"description\":\"CrossFit\\nM\\u00e9todo de entrenamiento motivante y divertido que te har\\u00e1 mejorar todas tus cualidades f\\u00edsicas!\\n\\u00a1Para todo el mundo!\\nM\\u00e1s info en www.crossfit27.com o p\\u00e1sate por nuestro box!\\n\\u00bfTe atreves?\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2773\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2773\\/featured_images\\/CrossFit27_01.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2773\\/featured_images\\/clase-mh0gxji7kmnq0222kz1b3jny873ustsj5n0xj50nnc.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2773\\/featured_images\\/cuba-snatch-mh0gxfqutaiz18cj86hisjp44cjbu5rfmk9h13qpo4.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2773\\/featured_images\\/training-camp-mh0gx885am8ogcngg38i8llfd9ke4kxkxj1l6w1v1w.jpg\"],\"address\":{\"street\":\"C.C Cosmo, Calle Galicia, s\\/n\",\"town\":\"Santa Cruz de Tenerife\",\"postal_code\":\"38660\",\"country\":\"Spain\"},\"location\":{\"latitude\":28.0875176,\"longitude\":-16.7278863},\"contact_info\":{\"email\":\"info@crossfit27.com\",\"phone\":\"679158193\"},\"social_media\":{\"instagram\":\"crossfit27tenerife\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFit27\\/\"}},{\"id_application\":null,\"id_lead\":\"3166\",\"name\":\"Crossfit Biberach\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3166\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3166\\/featured_images\\/f1fa67_8a6435e5d6ee4d88b550135f81e53420~mv2_d_3648_2056_s_2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3166\\/featured_images\\/f1fa67_c6e5c5bb21aa41b38c2b3076472ab627~mv2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3166\\/featured_images\\/f1fa67_d6543878d82144a693193073c23dc379~mv2_d_2043_2043_s_2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3166\\/featured_images\\/f1fa67_dae3d185fd604f939df56cf025fba9e1~mv2.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3166\\/featured_images\\/f1fa67_fd33b8baed2c464dbff0541b6c60bbd7~mv2.jpg\"],\"address\":{\"street\":\"Ringstra\\u00dfe 76\",\"town\":\"Ertingen\",\"postal_code\":\"88521\",\"country\":\"Germany\"},\"location\":{\"latitude\":48.104802