en Miranda de Ebro. Salud integral para toda condici\\u00f3n f\\u00edsica o estado en 1000 m2 y 500 m2 de aparcamiento privado.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3023\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3023\\/featured_images\\/slide1.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3023\\/featured_images\\/slide2.jpg\"],\"address\":{\"street\":\"Camino Fuentebasilio, 3\",\"town\":\"Miranda de Ebro\",\"postal_code\":\"09200\",\"country\":\"Spain\"},\"location\":{\"latitude\":42.6854068,\"longitude\":-2.9630116},\"contact_info\":{\"email\":\"info@crossfitdissidents.com\",\"phone\":\"678 34 37 75\"},\"social_media\":{\"instagram\":\"crossfitdissidentsmiranda\",\"facebook\":\"@crossfitdissidentsmiranda\"}},{\"id_application\":\"89418889\",\"id_lead\":null,\"name\":\"Crossfit Aguio\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/89418889\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/89418889\\/featured_images\\/31381183_602495990130966_2399410143067373568_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/89418889\\/featured_images\\/34880142_621546608225904_5742473104131620864_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/89418889\\/featured_images\\/42790928_715556242158273_7944082879183585280_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/89418889\\/featured_images\\/54517422_815312798849283_7299242562445901824_n.jpg\"],\"address\":{\"street\":\"rue Tavertin\",\"town\":\"Eguilles\",\"postal_code\":\"13510\",\"country\":\"France\"},\"location\":{\"latitude\":43.5686589,\"longitude\":5.354234},\"contact_info\":{\"email\":\"contact@crossfit-aguio.fr\",\"phone\":\"07 66 88 09 28\"},\"social_media\":{\"instagram\":\"crossfitaguio\",\"