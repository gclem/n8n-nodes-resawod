-west-1.amazonaws.com\\/leads\\/2721\\/featured_images\\/15965911_1816946448553648_7073382439344805054_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2721\\/featured_images\\/53859522_2250457085202580_4492754109098622976_o.jpg\"],\"address\":{\"street\":\"Via Giorgio la Pira 5\\/B\",\"town\":\"Venezia\",\"postal_code\":\"30027\",\"country\":\"Italy\"},\"location\":{\"latitude\":45.65251,\"longitude\":12.541744},\"contact_info\":{\"email\":\"info@crossfit30027.com\",\"phone\":\"+39 0421 65506\"},\"social_media\":{\"instagram\":\"crossfit30027\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfit30027\\/\"}},{\"id_application\":\"81028748\",\"id_lead\":null,\"name\":\"Forge Fitness\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/81028748\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"7 Rue des Cordonniers\",\"town\":\"Istres\",\"postal_code\":\"13800\",\"country\":\"France\"},\"location\":{\"latitude\":43.516845,\"longitude\":4.96147},\"contact_info\":{\"email\":\"guillaumegarcia@nubapp-clients.com\",\"phone\":\"06 59 54 11 10\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"\"}},{\"id_application\":null,\"id_lead\":\"2939\",\"name\":\"CrossFit Biarritz\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2939\\/featured_images\\/21764824_1653672641331525_4223080191967414919_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2939\\/featured_images\\/28337327_1823116127720508_4217040558224636494_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2939\\/featured_images\\/28701084_1822889324409855_3661445476745031424_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2939\\/featured_images\\/28947674_1845706935461427_2706572157633691873_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2939\\/featured_images\\/43033966_2111393272226124_4221120513075838976_o.jpg\"],\"address\":{\"street\":\"1 All\\u00e9e Marie Politzer\",\"town\":\"Biarritz\",\"postal_code\":\"64200\",\"country\":\"France\"},\"location\":{\"latitude\":43.0929437,\"longitude\":-2.2832088},\"contact_info\":{\"email\":\"contact@bestrainingbiarritz.com\",\"phone\":\"05 59 23 76 07\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/BestrainingBiarritz\\/\"}},{\"id_application\":\"29874854\",\"id_lead\":null,\"name\":\"Crossfit MaeStria\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/29874854\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/29874854\\/featured_images\\/436353927_987767709576546_1563622192888935648_n.jpg\"],\"address\":{\"street\":\"All. des Plantains 16\",\"town\":\"Walcourt\",\"postal_code\":\"5650\",\"country\":\"Belgium\"},\"location\":{\"latitude\":50.2688655,\"longitude\":4.4551145},\"contact_info\":{\"email\":\"cf_meastria@nubapp-clients.com\",\"phone\":\"0032 493185476\"},\"social_media\":{\"instagram\":\"crossfitmaestria\",\"facebook\":\"crossfitmaestria\"}},{\"id_application\":null,\"id_lead\":\"2620\",\"name\":\"Crossfit Cenisio by Tiger Gym\",\"description\":\"Il progetto Crossfit Cenisio nasce dalla passione di Francesco e Simone, entrambi laureati in Scienze Motorie, che avvicinati al Crossfit non lo hanno pi\\u00f9 lasciato. Il continuo aggiornamento sulle tecniche innovative di allenamento e sulle migliori metodologie ci permettono di andare incontro a tutte le esigenze dei nostri clienti, rivolgendoci non solo ad atleti ma a chiunque senta l\\u0027esigenza di rimettersi o semplicemente mantenersi in forma. La specialit\\u00e0 di Crossfit Cenisio \\u00e8 infatti quella di proporre allenamenti adatti a qualsiasi persona e prepararla a qualsiasi evenienza. Per questo ci impegniamo ogni giorno a perfezionare il movimento umano attraverso esercizi funzionali costantemente variati, eseguiti ad alta intensit\\u00e0 come saltare, correre, tirare, spingere e vogare, tutte attivit\\u00e0 che per noi e per la nostra community sono all\\u0027ordine del giorno.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2620\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2620\\/featured_images\\/12377606_588048541342555_1394533225461799918_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2620\\/featured_images\\/13592190_671151006365641_4550034517809658405_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2620\\/featured_images\\/14708284_724698414344233_4968730378280429058_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2620\\/featured_images\\/15241298_750354841778590_1669364781826285131_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2620\\/featured_images\\/20294088_884816461665760_271101257191637826_n.jpg\"],\"address\":{\"street\":\"Via Aosta 2\",\"town\":\"Milano\",\"postal_code\":\"20155\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.4916547,\"longitude\":9.1666343},\"contact_info\":{\"email\":\"info@crossfitcenisio.it\",\"phone\":\"+39 346 948 4874\"},\"social_media\":{\"instagram\":\"crossfitcenisio\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitCenisio\\/\"}},{\"id_application\":\"60387120\",\"id_lead\":null,\"name\":\"CrossFit Cord\\u00e9e\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/60387120\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Rue du Quarr\\u00e9, 521\",\"town\":\"Amancy\",\"postal_code\":\"74800\",\"country\":\"France\"},\"location\":{\"latitude\":46.0741813,\"longitude\":6.314715},\"contact_info\":{\"email\":\"info@crossfitcordee.com\",\"phone\":\"0671010042\"},\"social_media\":{\"instagram\":\"cfcordee\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitcordee\"}},{\"id_application\":null,\"id_lead\":\"2813\",\"name\":\"Full Crossfit\",\"description\":\"Ubicado en la playa de la Patacona a 100m del paseo mar\\u00edtimo, se encuentra nuestro centro de deportivo de CrossFit, especialmente dise\\u00f1ado para atender todas las necesidades de nuestros atletas\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2813\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2813\\/featured_images\\/Full_CrossFIt_LaPatacona-32.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2813\\/featured_images\\/Full_CrossFIt_LaPatacona-33.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2813\\/featured_images\\/Full_CrossFIt_LaPatacona-34.jpg\"],\"address\":{\"street\":\"Av. Vicente Blasco Ib\\u00e1\\u00f1ez Novelista, 6\",\"town\":\"Alboraya\",\"postal_code\":\"46120\",\"country\":\"Spain\"},\"location\":{\"latitude\":39.4886625,\"longitude\":-0.3653664},\"contact_info\":{\"email\":\"hola@fullcrossfit.com\",\"phone\":\"615998417\"},\"social_media\":{\"instagram\":\"full_crossfit\",\"facebook\":\"@fullcrossfit\"}},{\"id_application\":\"20206086\",\"id_lead\":null,\"name\":\"Mana Functional Fitness\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/20206086\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"ZA de la Gruette\",\"town\":\"Chey\",\"postal_code\":\"79120\",\"country\":\"France\"},\"location\":{\"latitude\":46.3044374,\"longitude\":-0.0507407},\"contact_info\":{\"email\":\"mana.functionalfitness@gmail.com\",\"phone\":\"06.61.51.18.10\"},\"social_media\":{\"instagram\":\"mana.functionalfitness\",\"facebook\":\"https:\\/\\/www.facebook.com\\/share\\/15WKXHoGMV\\/?mibextid=wwXIfr\"}},{\"id_application\":\"71869231\",\"id_lead\":null,\"name\":\"CrossFit Aubagne-G\\u00e9menos\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/71869231\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/71869231\\/featured_images\\/02.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/71869231\\/featured_images\\/03.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/71869231\\/featured_images\\/04.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/71869231\\/featured_images\\/23319483_1697967973578720_2735775438409467510_n.jpg\"],\"address\":{\"street\":\"Avenue de Fonfr\\u00e8ge\",\"town\":\"G\\u00e9menos\",\"postal_code\":\"13420\",\"country\":\"France\"},\"location\":{\"latitude\":43.2771688,\"longitude\":5.6152703},\"contact_info\":{\"email\":\"crossfitaubagne@gmail.com\",\"phone\":\"07 77 30 83 52\"},\"social_media\":{\"instagram\":\"crossfit.aubagne_gemenos\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitaubagnegemenos\"}},{\"id_application\":null,\"id_lead\":\"3134\",\"name\":\"Crossfit Bad Kreuznach\",\"description\":\"\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3134\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/3134\\/featured_images\\/Bildschirmfoto%202019-06-24%20um%2010.12.27.png\"],\"address\":{\"street\":\"Schwabenheimer Weg 58\",\"town\":\"Bad Kreuznach\",\"postal_code\":\"55543\",\"country\":\"Germany\"},\"location\":{\"latitude\":49.8498838,\"longitude\":7.8876399},\"contact_info\":{\"email\":\"info@crossfit-badkreuznach.de\",\"phone\":\"+49 67184157908\"},\"social_media\":{\"instagram\":\"crossfitbadkreuznach\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitBadKreuznach\"}},{\"id_application\":\"51272221\",\"id_lead\":null,\"name\":\"CrossFit Riviera\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/51272221\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/51272221\\/featured_images\\/1.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/51272221\\/featured_images\\/2.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/51272221\\/featured_images\\/3.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/51272221\\/featured_images\\/4.png\"],\"address\":{\"street\":\"Route du Verney 18\",\"town\":\"Puidoux\",\"postal_code\":\"1070\",\"country\":\"Switzerland\"},\"location\":{\"latitude\":46.4905396,\"longitude\":6.7649148},\"contact_info\":{\"email\":\"info@crossfitriviera.ch\",\"phone\":\"41797754946\"},\"social_media\":{\"instagram\":\"crossfitriviera\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitriviera\"}},{\"id_application\":null,\"id_lead\":\"2717\",\"name\":\"CrossFit Never Stop\",\"description\":\"Il 1\\u00b0 CrossFit Box certificato di Vicenza, dove si fa CrossFit. E basta.\\ncrossfit_vicenza_try_crossfit_for_free2wod contatti\\n \\n\\n\\n \\nQuesti siamo noi.\\nOgnuno fatto a modo suo.\\nTanti caratteri, mille difetti, pure qualche buon pregio\\u2026 e la voglia di stare insieme per trovare l\\u2019energia.\\n\\nPrendere coraggio. Mettersi alla prova. Superare gli ostacoli.\\n\\nOgni WOD \\u00e8 una conferma: possiamo allenare la mente a non costruirci dei limiti. Abbiamo capito che la sfida sta nel fissare sempre nuovi traguardi\\u2026 E sappiamo di poterli raggiungere. Continuando a guardare oltre. Mai fermarsi.\\n\\nNever Stop.\\n\\n\\ncrossfit vicenza coach\\n\\nIL NOSTRO COACH\\n30 anni dedicati allo sport. Prima come atleta, poi come trainer.\\nLaureato in Scienze Motorie, certificato CrossFit Level 1, Gymnastic, Olympic Lifting, Mobility.\\n\\nVivrebbe preferibilmente oltre i 3000 mt d\\u2019altitudine, dove c\\u2019\\u00e8 silenzio, l\\u2019aria \\u00e8 frizzantina e volano le aquile.\\n\\nConsigli per l\\u2019uso: parlategli di montagna, sci alpinismo e pallamano, e l\\u2019avrete conquistato. In tutti gli altri casi\\u2026 frasi brevi e diritte al punto: meglio una parola in meno e una ripetizione in pi\\u00f9! Offre e cerca impegno, seriet\\u00e0, disciplina e alta motivazione.\\n\\nObiettivo: allenare le persone a fronteggiare i propri limiti\\u2026 che esistono solo allo scopo di essere superati. In due parole:\\n\\nNever Stop.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2717\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2717\\/featured_images\\/11210438_948872225186347_3839992775533119034_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2717\\/featured_images\\/28685979_1871793122894248_1218488971948269924_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2717\\/featured_images\\/377272_219848971422013_1873314163_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2717\\/featured_images\\/56730586_2613085682098318_2617085356280905728_n.jpg\"],\"address\":{\"street\":\"Via Piazzon 27\",\"town\":\"Creazzo\",\"postal_code\":\"36051\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.5310253,\"longitude\":11.4992777},\"contact_info\":{\"email\":\"crossfitneverstop.creazzo@gmail.com\",\"phone\":\"+39 340 658 6933\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitNeverStop\\/\"}},{\"id_application\":\"84048307\",\"id_lead\":null,\"name\":\"Black Sunset Barbell Crew\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/84048307\\/logos\\/logo.png\",\"images\":[],\"address\":{\"street\":\"Hirschfeldspitz 100\",\"town\":\"Neusiedl am See\",\"postal_code\":\"7100\",\"country\":\"Austria\"},\"location\":{\"latitude\":47.9680598,\"longitude\":16.8336116},\"contact_info\":{\"email\":\"blacksunsetcrossfit@nubapp-clients.com\",\"phone\":\"0034664 303