bapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2687\\/featured_images\\/Bildschirmfoto%202019-04-10%20um%2011.46.05.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2687\\/featured_images\\/Bildschirmfoto%202019-04-10%20um%2011.46.14.png\"],\"address\":{\"street\":\"Luxemburger Str. 154\",\"town\":\"K\\u00f6ln\",\"postal_code\":\"50937\",\"country\":\"Deutschland\"},\"location\":{\"latitude\":50.9201592,\"longitude\":6.9295632},\"contact_info\":{\"email\":\"\",\"phone\":\"+49 151 43 26 60 49\"},\"social_media\":{\"instagram\":\"crossfitamdom\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitAmDom\\/\"}},{\"id_application\":null,\"id_lead\":\"2612\",\"name\":\"Valax CrossFit Seregno\",\"description\":\"Presenti sul territorio da diversi anni, con la nuova sede, inaugurata nel Settembre 2017, siamo indubbiamente diventati uno dei Box CrossFit pi\\u00f9 grandi, funzionali e meglio attrezzati del nostro Paese. Siamo stati tra i primi in Italia a insegnare questo sport e, grazie alla nostra grande esperienza, nulla \\u00e8 stato lasciato al caso: siamo provvisti di Trainers certificati e preparati, di spaziosi ed efficienti spogliatoi, di una notevole area riservata all\\u2019allenamento con attrezzature made in U.S.A. Again Faster, le migliori sul mercato\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2612\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2612\\/featured_images\\/31706369_2145423545679428_6736783639750639616_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2612\\/featured_images\\/43878654_2268324716722643_7264624584874262528_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2612\\/featured_images\\/52445489_2352168508338263_2434950915837394944_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2612\\/featured_images\\/52679704_2352171398337974_2950469239011540992_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2612\\/featured_images\\/52823471_2352174435004337_1832012995824189440_o.jpg\"],\"address\":{\"street\":\"Via J. Strauss, 20\",\"town\":\"Seregno\",\"postal_code\":\"20831\",\"country\":\"Italia\"},\"location\":{\"latitude\":45.6386127,\"longitude\":9.2238455},\"contact_info\":{\"email\":\"info@crossfitvalax.it\",\"phone\":\"+39 3284751728\"},\"social_media\":{\"instagram\":\"crossfit_valax\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfitseregno\\/\"}},{\"id_application\":null,\"id_lead\":\"2916\",\"name\":\"CrossFit Antipolis\",\"description\":\"\",\"logo\":null,\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2916\\/featured_images\\/10277278_1614794362086296_1202881412225759024_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2916\\/featured_images\\/11215707_1641833636049035_1449769900927580950_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2916\\/featured_images\\/18222369_1994501450782250_2454808393065785497_n.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2916\\/featured_images\\/18297_1621171138115285_4436734017036959807_n.jpg\"],\"address\":{\"street\":\"659 Route de Tiragon\",\"town\":\"Mouans-Sartoux\",\"postal_code\":\"06370\",\"country\":\"France\"},\"location\":{\"latitude\":43.6138242,\"longitude\":6.9613193},\"contact_info\":{\"email\":\"contact@crossfitantipolis.com\",\"phone\":\"+33 7 56 95 90 95\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/CrossFitAntipolis\\/\"}},{\"id_application\":\"13607245\",\"id_lead\":null,\"name\":\"CrossFit Khaleesi\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/13607245\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/13607245\\/featured_images\\/Cf%20Khaleesi%20fum%C3%A9e%20grise%20fd%202.jpg\"],\"