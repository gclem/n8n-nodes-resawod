ubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2978\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2978\\/featured_images\\/Bildschirmfoto%202019-06-03%20um%2011.04.19.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2978\\/featured_images\\/Bildschirmfoto%202019-06-03%20um%2011.04.25.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2978\\/featured_images\\/Bildschirmfoto%202019-06-03%20um%2011.04.30.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2978\\/featured_images\\/Bildschirmfoto%202019-06-03%20um%2011.04.36.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2978\\/featured_images\\/Bildschirmfoto%202019-06-03%20um%2011.04.40.png\"],\"address\":{\"street\":\"Freiburgerstr. 13\",\"town\":\"Weinheim\",\"postal_code\":\"69469\",\"country\":\"Germany\"},\"location\":{\"latitude\":49.5476518,\"longitude\":8.6279463},\"contact_info\":{\"email\":\"info@crossfit2burgen.com\",\"phone\":\"+49 15202720915\"},\"social_media\":{\"instagram\":\"\",\"facebook\":\"https:\\/\\/www.facebook.com\\/crossfit2burgen\\/\"}},{\"id_application\":\"96202914\",\"id_lead\":null,\"name\":\"CrossFit LBL \\/ La Box\",\"description\":\"400 m\\u00e8tres carr\\u00e9s r\\u00e9serv\\u00e9s exclusivement \\u00e0 la pratique du CrossFit. Vous y trouverez tout le mat\\u00e9riel n\\u00e9cessaire \\u00e0 la discipline (box jump, kettlebells, rameurs, ghd sit up, wall ball, barres et poids associ\\u00e9s, etc.). Une structure de plus de neuf m\\u00e8tres de long est pos\\u00e9e au milieu de la salle et permet de r\\u00e9aliser tous les mouvements inspir\\u00e9s de la gymnastique. Un v\\u00e9ritable garage gym \\u00e0 l\\u0027am\\u00e9ricaine des grandes portes sectionnelles pour faciliter les WOD en ext\\u00e9rieur. \\n\\nACC\\u00c8S\\n\\n10 minutes \\u00e0 pied du M\\u00e9tro Les Pr\\u00e9s \\u00e0 Villeneuve d\\u0027Ascq (650m), en plein coeur de la zone industrielle de la Pilaterie.\\n\\n\\u003Ciframe width=\\u0022560\\u0022 height=\\u0022315\\u0022 src=\\u0022https:\\/\\/www.youtube.com\\/embed\\/h737sp6cqHM\\u0022 frameborder=\\u00220\\u0022 allow=\\u0022accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture\\u0022 allowfullscreen\\u003E\\u003C\\/iframe\\u003E\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/96202914\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/96202914\\/featured_images\\/image%20lbl%202.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/96202914\\/featured_images\\/image%20lbl%203.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/96202914\\/featured_images\\/image%20lbl.jpg\"],\"address\":{\"street\":\"Rue des Champs\",\"town\":\"Wasquehal\",\"postal_code\":\"59290\",\"country\":\"France\"},\"location\":{\"latitude\":50.6525268,\"longitude\":3.1221075},\"contact_info\":{\"email\":\"contact@crossfitlbl.fr\",\"phone\":\"(+33) 07 83 18 10 88\"},\"social_media\":{\"instagram\":\"crossfitlbl\",\"facebook\":\"crossfitlbl\"}},{\"id_application\":null,\"id_lead\":\"2848\",\"name\":\"Crossfit La Orotava\",\"description\":\"En nuestro Box, adem\\u00e1s de entrenar duro, formarte y crear comunidad, tambi\\u00e9n queremos que sea confortable tu estancia.\\n\\nTendr\\u00e1s a tu disposici\\u00f3n taquillas para vuestros objetos personales, agua, bebidas isot\\u00f3nicas, suplementaci\\u00f3n, tienda de ropa, complementos,  y gabinete de Kinesiolog\\u00eda y Suplementaci\\u00f3n Deportiva (cons\\u00faltalo con tu Coach)\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2848\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2848\\/featured_images\\/53391180_1046331802229628_5382157066330701824_o.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2848\\/