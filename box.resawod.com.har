":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2909\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2909\\/featured_images\\/crossfit-loom-suelo-caucho-energy.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2909\\/featured_images\\/crossfit-loom-suelo-goma-energy.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2909\\/featured_images\\/maxresdefault%20%281%29.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2909\\/featured_images\\/maxresdefault.jpg\"],\"address\":{\"street\":\"Carrer de Cuba, 7\",\"town\":\"Sabadell\",\"postal_code\":\"08205\",\"country\":\"Spain\"},\"location\":{\"latitude\":41.545092,\"longitude\":2.093488},\"contact_info\":{\"email\":\"box@crossfit-loom.com\",\"phone\":\"93 518 47 71\"},\"social_media\":{\"instagram\":\"crossfitloom\",\"facebook\":\"@crossfitloom\"}},{\"id_application\":\"34788224\",\"id_lead\":null,\"name\":\"Iguana Fitness\",\"description\":\"\",\"logo\":\"https:\\/\\/public-nubapp.s3.eu-west-1.amazonaws.com\\/sport\\/applications\\/34788224\\/logos\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/34788224\\/featured_images\\/01.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/34788224\\/featured_images\\/02.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/34788224\\/featured_images\\/03.jpg\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/applications\\/34788224\\/featured_images\\/04.jpg\"],\"address\":{\"street\":\"Route de Griselles\",\"town\":\"Saint Martin\",\"postal_code\":\"97150\",\"country\":\"France\"},\"location\":{\"latitude\":18.09678,\"longitude\":-63.035612},\"contact_info\":{\"email\":\"info@discovercrossfit.com\",\"phone\":\"0676459236\"},\"social_media\":{\"instagram\":\"discover.crossfit\",\"facebook\":\"https:\\/\\/www.facebook.com\\/discovercrossfit\"}},{\"id_application\":null,\"id_lead\":\"2799\",\"name\":\"Crossfit Riders\",\"description\":\"El CrossFit es un sistema de entrenamiento basado en la realizaci\\u00f3n de movimientos funcionales, constantemente variados y a una alta intensidad. El sistema de entreno es grupal e individual; grupal porque durante el entrenamiento diario todos los compa\\u00f1eros hacen los mismos ejercicios, e individual porque el \\u00fanico rival a superar eres tu mismo. Los ejercicios son muy variados y en cada WOD (Workout of Day) o entrenamiento del d\\u00eda utilizas casi todos los m\\u00fasculos. Se puede decir que se divide en varias fases; calentamiento, t\\u00e9cnica, WOD y estiramiento no llevando todo esto m\\u00e1s de 75 minutos. Entrenamiento divertido, completo y en poco tiempo.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2799\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2799\\/featured_images\\/5%20%281%29.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2799\\/featured_images\\/5.png\",\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2799\\/featured_images\\/google_place_photo.jpg\"],\"address\":{\"street\":\"Calle Huesca nave 3\",\"town\":\"Mog\\u00e1n\",\"postal_code\":\"35130\",\"country\":\"Spain\"},\"location\":{\"latitude\":27.800836,\"longitude\":-15.6989847},\"contact_info\":{\"email\":\"crossfitriders@gmail.com\",\"phone\":\"928560686\"},\"social_media\":{\"instagram\":\"crossfitriders\",\"facebook\":\"@CrossFit.riders.gran.canaria\"}},{\"id_application\":null,\"id_lead\":\"2843\",\"name\":\"Crossfit Rookie\\u0027s Box\",\"description\":\"CrossFit Rookie\\u0027s Box posee uno de los mayores centros de Espa\\u00f1a, cuenta con 800 metros de instalaciones equipadas con los mejores materiales del mercado.\",\"logo\":\"https:\\/\\/nubapp-social.s3.eu-west-1.amazonaws.com\\/leads\\/2843\\/logo\\/logo.png\",\"images\":[\"https:\\/\\/nubapp-social.s3.